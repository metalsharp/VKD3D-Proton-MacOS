+set(SHARED_LIBRARY TRUE)
+
+add_dxilconv_project_library(dxbcconverter SHARED
+  dxbcconverter-mac.cpp
+)
+
+target_link_libraries(dxbcconverter PRIVATE
+  DxbcConverter
+  LLVMBitWriter
+  LLVMDXIL
+  LLVMDxilContainer
+  LLVMDxilRootSignature
+  LLVMDxilValidation
+  LLVMMSSupport
+  LLVMScalarOpts
+)
+
+set_target_properties(dxbcconverter PROPERTIES OUTPUT_NAME "dxbcconverter")
diff --git a/projects/dxilconv/tools/dxbcconverter-mac/dxbcconverter-mac.cpp b/projects/dxilconv/tools/dxbcconverter-mac/dxbcconverter-mac.cpp
new file mode 100644
index 00000000..c96a8d3a
--- /dev/null
+++ b/projects/dxilconv/tools/dxbcconverter-mac/dxbcconverter-mac.cpp
@@ -0,0 +1,126 @@
+///////////////////////////////////////////////////////////////////////////////
+// dxbcconverter-mac.cpp: MetalSharp's C interface to dxilconv's DXBC to DXIL converter, for platforms without
+// dxilconv.dll (MoltenVK's Metal Shader Converter bridge loads it).
+//
+//   int DxbcConverterConvertToDXIL(const void *dxbc, uint32_t dxbc_size, void **dxil, uint32_t *dxil_size,
+//                                  char **error);
+//     Converts a DXBC container (SM 4.0 to 5.1) to a DXIL container. Returns 0 and a malloc'd container, or an
+//     HRESULT and, when there is one, a malloc'd UTF-8 message. Either is freed with DxbcConverterFree. Thread-safe.
+//   void DxbcConverterFree(void *p);
+//
+// This file is distributed under the University of Illinois Open Source License, as DirectXShaderCompiler is.
+///////////////////////////////////////////////////////////////////////////////
+
+#include "dxc/Support/WinIncludes.h"
+
+#include "dxc/Support/Global.h"
+#include "dxc/Support/microcom.h"
+#include "dxc/dxcapi.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/ManagedStatic.h"
+
+#include "DxbcConverter.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+HRESULT CreateDxbcConverter(REFIID riid, LPVOID *ppv);
+
+namespace {
+std::once_flag g_init_once;
+HRESULT g_init_hr = E_FAIL;
+
+void init() {
+  g_init_hr = DxcInitThreadMalloc();
+  if (FAILED(g_init_hr))
+    return;
+  DxcSetThreadMallocToDefault();
+  if (::llvm::sys::fs::SetupPerThreadFileSystem())
+    g_init_hr = E_FAIL;
+  DxcClearThreadMalloc();
+}
+
+char *dup_message(const char *text) {
+  size_t len = strlen(text);
+  char *copy = (char *)malloc(len + 1);
+  if (copy)
+    memcpy(copy, text, len + 1);
+  return copy;
+}
+
+char *wide_to_utf8(const wchar_t *text) {
+  std::string out;
+  for (; *text; text++) {
+    uint32_t c = (uint32_t)*text;
+    if (c < 0x80)
+      out += (char)c;
+    else if (c < 0x800)
+      out += (char)(0xc0 | (c >> 6)), out += (char)(0x80 | (c & 0x3f));
+    else if (c < 0x10000)
+      out += (char)(0xe0 | (c >> 12)), out += (char)(0x80 | ((c >> 6) & 0x3f)), out += (char)(0x80 | (c & 0x3f));
+    else
+      out += (char)(0xf0 | (c >> 18)), out += (char)(0x80 | ((c >> 12) & 0x3f)),
+          out += (char)(0x80 | ((c >> 6) & 0x3f)), out += (char)(0x80 | (c & 0x3f));
+  }
+  return dup_message(out.c_str());
+}
+} // namespace
+
+extern "C" __attribute__((visibility("default"))) int
+DxbcConverterConvertToDXIL(const void *dxbc, uint32_t dxbc_size, void **dxil, uint32_t *dxil_size, char **error) {
+  *dxil = nullptr;
+  *dxil_size = 0;
+  if (error)
+    *error = nullptr;
+  std::call_once(g_init_once, init);
+  if (FAILED(g_init_hr)) {
+    if (error)
+      *error = dup_message("The DXBC converter could not initialize.");
+    return (int)g_init_hr;
+  }
+
+  HRESULT hr = S_OK;
+  LPVOID out = nullptr;
+  UINT32 out_size = 0;
+  LPWSTR diag = nullptr;
+  {
+    DxcThreadMalloc thread_malloc(nullptr);
+    try {
+      CComPtr<IDxbcConverter> converter;
+      hr = CreateDxbcConverter(__uuidof(IDxbcConverter), (void **)&converter);
+      if (SUCCEEDED(hr))
+        hr = converter->Convert(dxbc, dxbc_size, nullptr, &out, &out_size, &diag);
+    } catch (const std::exception &e) {
+      hr = E_FAIL;
+      if (error && !*error)
+        *error = dup_message(e.what());
+    } catch (...) {
+      hr = E_FAIL;
+    }
+  }
+
+  if (diag) {
+    if (error && !*error)
+      *error = wide_to_utf8(diag);
+    CoTaskMemFree(diag);
+  }
+  if (SUCCEEDED(hr) && out && out_size) {
+    void *copy = malloc(out_size);
+    if (!copy)
+      hr = E_OUTOFMEMORY;
+    else {
+      memcpy(copy, out, out_size);
+      *dxil = copy;
+      *dxil_size = out_size;
+    }
+  } else if (SUCCEEDED(hr)) {
+    hr = E_FAIL;
+  }
+  if (out)
+    CoTaskMemFree(out);
+  return SUCCEEDED(hr) ? 0 : (int)hr;
+}
+
+extern "C" __attribute__((visibility("default"))) void DxbcConverterFree(void *p) { free(p); }
