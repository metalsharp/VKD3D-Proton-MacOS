+///////////////////////////////////////////////////////////////////////////////
+// DxilConvShims.h: MetalSharp. What dxilconv uses from the Windows SDK beyond DXC's Windows adapter and
+// DirectX-Headers' d3dcommon.h and d3d12shader.h, for platforms without the SDK.
+//
+// This file is distributed under the University of Illinois Open Source License, as DirectXShaderCompiler is.
+///////////////////////////////////////////////////////////////////////////////
+#pragma once
+#ifndef _WIN32
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifndef INT64
+typedef int64_t INT64;
+#endif
+
+#ifndef CONST
+#define CONST const
+#endif
+#ifndef _UI8_MAX
+#define _UI8_MAX 0xffu
+#endif
+
+#ifndef __override
+#define __override
+#endif
+#ifndef __assume
+#define __assume(x) __builtin_assume(x)
+#endif
+#ifdef __cplusplus
+#include <algorithm>
+using std::max;
+using std::min;
+#endif
+
+// d3d10.h and d3d11.h limits
+#define D3D10_REQ_CONSTANT_BUFFER_ELEMENT_COUNT 4096
+#define D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT 14
+#define D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT 128
+#define D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT 16
+#define D3D11_COMMONSHADER_TEMP_REGISTER_COUNT 4096
+#define D3D11_SHADER_MAX_INTERFACES 253
+
+// SAL annotations
+#ifndef __in_range
+#define __in_range(lo, hi)
+#endif
+#ifndef __out_ecount
+#define __out_ecount(n)
+#endif
+#ifndef __in_ecount
+#define __in_ecount(n)
+#endif
+#ifndef __in
+#define __in
+#endif
+#ifndef __out
+#define __out
+#endif
+#ifndef __inout
+#define __inout
+#endif
+#ifndef __in_opt
+#define __in_opt
+#endif
+#ifndef __field_ecount_part
+#define __field_ecount_part(size, count)
+#endif
+#ifndef _Field_size_full_
+#define _Field_size_full_(n)
+#endif
+#ifndef _In_reads_bytes_
+#define _In_reads_bytes_(n)
+#endif
+
+// strsafe.h
+static inline HRESULT StringCchCopyA(char *dst, size_t cch, const char *src) {
+  if (!cch)
+    return E_INVALIDARG;
+  size_t len = strlen(src);
+  if (len >= cch) {
+    memcpy(dst, src, cch - 1);
+    dst[cch - 1] = 0;
+    return E_INVALIDARG; // STRSAFE_E_INSUFFICIENT_BUFFER
+  }
+  memcpy(dst, src, len + 1);
+  return S_OK;
+}
+#endif
