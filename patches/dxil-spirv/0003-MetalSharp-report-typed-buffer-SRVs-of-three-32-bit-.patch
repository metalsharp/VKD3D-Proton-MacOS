+
+			// MetalSharp: typed resource properties carry the component count in bits 8-15.
+			if (use.resource_kind == DXIL::ResourceKind::TypedBuffer && use.resource_type == DXIL::ResourceType::SRV)
+				impl.note_typed_srv_components(use.component_type, (params >> 8) & 0xff);
