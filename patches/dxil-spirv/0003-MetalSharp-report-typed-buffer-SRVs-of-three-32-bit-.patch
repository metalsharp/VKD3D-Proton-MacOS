 	                                        converter->workgroup_size[1],
 	                                        converter->workgroup_size[2]);
@@ -1738,6 +1740,13 @@ dxil_spv_result dxil_spv_converter_is_multiview_compatible(
 	return DXIL_SPV_SUCCESS;
 }
 
+dxil_spv_result dxil_spv_converter_declares_three_component_typed_srv(
+		dxil_spv_converter converter, dxil_spv_bool *result)
+{
+	*result = converter->declares_three_component_typed_srv ? DXIL_SPV_TRUE : DXIL_SPV_FALSE;
+	return DXIL_SPV_SUCCESS;
+}
+
