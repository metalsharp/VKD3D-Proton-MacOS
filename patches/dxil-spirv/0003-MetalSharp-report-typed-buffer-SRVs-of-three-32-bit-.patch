From aff163d8ddfcc348a1df7047df290f6c04f07588 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 6 Nov 2026 02:33:15 -0700
Subject: [PATCH 3/9] MetalSharp: report typed buffer SRVs of three 32-bit
 components

dxil_spv_converter_declares_three_component_typed_srv says whether the shader declares a typed buffer SRV of three
32-bit components (Buffer<float3>, Buffer<uint3>, Buffer<int3>), from the resource variable's element type (SM 6.5 and
before) or the annotateHandle properties' component count (SM 6.6, heap-indexed and bound). Metal has no texel format
for such views, so VKD3D-Proton keeps those shaders off Metal Shader Converter.
---
 dxil_converter.cpp                | 38 +++++++++++++++++++++++++++++++
 dxil_converter.hpp                |  1 +
 dxil_spirv_c.cpp                  |  9 ++++++++
 dxil_spirv_c.h                    |  5 ++++
 opcodes/converter_impl.hpp        |  4 ++++
 opcodes/opcodes_dxil_builtins.cpp | 19 +++++++++++++++-
 6 files changed, 75 insertions(+), 1 deletion(-)

diff --git a/dxil_converter.cpp b/dxil_converter.cpp
index f94b77ec..aea4f750 100644
--- a/dxil_converter.cpp
+++ b/dxil_converter.cpp
@@ -137,6 +137,27 @@ bool Converter::is_multiview_compatible() const
 	       impl->options.multiview.view_index_to_view_instance_spec_id != UINT32_MAX;
 }
 
+bool Converter::declares_three_component_typed_srv() const
+{
+	return impl->declares_three_component_typed_srv;
+}
+
+void Converter::Impl::note_typed_srv_components(DXIL::ComponentType type, unsigned count)
+{
+	if (count != 3)
+		return;
+	switch (type)
+	{
+	case DXIL::ComponentType::I32:
+	case DXIL::ComponentType::U32:
+	case DXIL::ComponentType::F32:
+		declares_three_component_typed_srv = true;
+		break;
+	default:
+		break;
+	}
+}
+
 bool Converter::shader_requires_feature(ShaderFeature feature) const
 {
 	switch (feature)
@@ -1304,6 +1325,23 @@ bool Converter::Impl::emit_srvs(const llvm::MDNode *srvs, const llvm::MDNode *re
 				stride = get_constant_metadata(tags, 1);
 		}
 
+		// MetalSharp: Buffer<float3> and the like declare their element vector in the variable's type.
+		if (resource_kind == DXIL::ResourceKind::TypedBuffer && srv->getOperand(1))
+		{
+			if (auto *variable = llvm::dyn_cast<llvm::ConstantAsMetadata>(srv->getOperand(1)))
+			{
+				const llvm::Type *type = variable->getValue()->getType();
+				if (type->getTypeID() == llvm::Type::TypeID::PointerTyID)
+					type = type->getPointerElementType();
+				while (type->getTypeID() == llvm::Type::TypeID::ArrayTyID)
+					type = type->getArrayElementType();
+				if (type->getTypeID() == llvm::Type::TypeID::StructTyID && type->getStructNumElements() >= 1)
+					type = type->getStructElementType(0);
+				if (type->getTypeID() == llvm::Type::TypeID::VectorTyID)
+					note_typed_srv_components(actual_component_type, type->getVectorNumElements());
+			}
+		}
+
 		unsigned alignment = resource_kind == DXIL::ResourceKind::RawBuffer ? 16 : (stride & -int(stride));
 
 		DescriptorTableEntry local_table_entry = {};
diff --git a/dxil_converter.hpp b/dxil_converter.hpp
