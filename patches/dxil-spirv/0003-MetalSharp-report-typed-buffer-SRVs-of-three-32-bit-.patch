+		{
+			// MetalSharp: the same properties on bound SM 6.6 resources.
+			auto *constant = llvm::dyn_cast<llvm::ConstantAggregate>(instruction->getOperand(2));
+			if (constant && constant->getNumOperands() == 2 &&
+			    DXIL::ResourceKind(constant->getOperand(0)->getUniqueInteger().getZExtValue() & 0xff) ==
+			    DXIL::ResourceKind::TypedBuffer)
+			{
+				uint32_t params = constant->getOperand(1)->getUniqueInteger().getZExtValue();
+				impl.note_typed_srv_components(DXIL::ComponentType(params & 0xff), (params >> 8) & 0xff);
+			}
+		}
+
+		if (meta.resource_op == DXIL::Op::CreateHandleFromBinding ||
 		         meta.resource_op == DXIL::Op::CreateHandleForLib)
 		{
 			if (meta.resource_type == DXIL::ResourceType::UAV)
