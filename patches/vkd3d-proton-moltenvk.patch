+++ b/libs/vkd3d/state.c
@@ -6388,7 +6388,14 @@ static HRESULT d3d12_pipeline_state_init_static_pipeline(struct d3d12_pipeline_s
         }
 
         if (!graphics->pipeline)
+        {
             d3d12_pipeline_state_cleanup_graphics_msc(state);
+            /* MoltenVK fails a bridge pipeline with the depth bounds test where Metal has none (it emulates the test
+             * in the fragment shader): later depth bounds PSOs go to SPIR-V without trying. */
+            if (graphics->ds_desc.depthBoundsTestEnable &&
+                    !vkd3d_atomic_uint32_exchange_explicit(&state->device->msc.depth_bounds_emulated, 1, vkd3d_memory_order_relaxed))
