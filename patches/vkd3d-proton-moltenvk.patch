+static void d3d12_command_list_track_upload_copy_hoist_barriers(struct d3d12_command_list *list,
+        UINT barrier_count, const D3D12_RESOURCE_BARRIER *barriers)
+{
+    UINT i;
+
+    if (list->upload_copy_hoist.disabled)
+        return;
+
+    for (i = 0; i < barrier_count; i++)
+    {
+        switch (barriers[i].Type)
+        {
+            case D3D12_RESOURCE_BARRIER_TYPE_TRANSITION:
+                d3d12_command_list_block_upload_copy_resource(list,
+                        impl_from_ID3D12Resource(barriers[i].Transition.pResource));
+                break;
+            case D3D12_RESOURCE_BARRIER_TYPE_UAV:
+                d3d12_command_list_block_upload_copy_resource(list,
+                        impl_from_ID3D12Resource(barriers[i].UAV.pResource));
+                break;
+            case D3D12_RESOURCE_BARRIER_TYPE_ALIASING:
+                d3d12_command_list_block_upload_copy_resource(list,
+                        impl_from_ID3D12Resource(barriers[i].Aliasing.pResourceBefore));
+                d3d12_command_list_block_upload_copy_resource(list,
+                        impl_from_ID3D12Resource(barriers[i].Aliasing.pResourceAfter));
+                break;
+            default:
+                list->upload_copy_hoist.disabled = true;
+                break;
+        }
+    }
