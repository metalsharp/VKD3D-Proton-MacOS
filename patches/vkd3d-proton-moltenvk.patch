From 63b6b60883162323201c90eafd532ec52866f0c6 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 6 Nov 2026 10:38:40 -0700
Subject: [PATCH 63/63] MetalSharp: the bridge reuses typed views of a buffer's
 ranges

Each typed buffer descriptor whose range isn't the resource's own got a texel view of
its own, made and destroyed with the descriptor: 1.2 us per write, nearly all of it
Metal's newTextureWithDescriptor:offset:bytesPerRow:. Views of other ranges now live
in a per-resource map, shared by descriptors of the same range, until the resource
goes, up to 4096 views (then as before). A ring buffer reusing 2000 ranges: 0.10 us
per write (probe scene typed_view_ring, 6.2 to 0.5 ms CPU per frame, GPU -40%).
---
 libs/vkd3d/resource.c      | 42 ++++++++++++++++++++++++++++++++++++++
 libs/vkd3d/vkd3d_private.h |  4 ++++
 2 files changed, 46 insertions(+)

diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index 448f8a77..25cef5b2 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -4067,6 +4067,12 @@ static void d3d12_resource_destroy(struct d3d12_resource *resource, struct d3d12
 
     vkd3d_view_map_destroy(&resource->view_map, resource->device);
     vkd3d_msc_release_resource_views(device, resource);
+    if (resource->msc_view_map)
+    {
+        vkd3d_view_map_destroy(resource->msc_view_map, resource->device);
+        vkd3d_free(resource->msc_view_map);
+        resource->msc_view_map = NULL;
+    }
 
     vkd3d_descriptor_debug_unregister_cookie(device->descriptor_qa_global_info, resource->res.cookie);
 
@@ -6460,11 +6466,39 @@ static void vkd3d_buffer_view_get_bound_range_ssbo(
  * is to own (d3d12_desc_msc_own_view) when it was made for it: such views are on the resource's list, which destroys
  * their Vulkan views with the resource. Three-component 32-bit formats have no Metal texel format: no view
  * (VKD3D-Proton keeps the shaders that declare such SRVs on SPIR-V). */
+/* Views of a range per resource, shared by the entries that view it, and kept until the resource goes. */
+#define VKD3D_MSC_VIEW_MAP_LIMIT 4096
+
+static struct vkd3d_view_map *vkd3d_msc_resource_view_map(struct d3d12_device *device, struct d3d12_resource *resource)
+{
+    struct vkd3d_view_map *map, *previous;
+
+    if ((map = vkd3d_atomic_ptr_load_explicit(&resource->msc_view_map, vkd3d_memory_order_acquire)))
+        return map;
+    if (!(map = vkd3d_malloc(sizeof(*map))))
+        return NULL;
+    if (FAILED(vkd3d_view_map_init(map)))
+    {
+        vkd3d_free(map);
+        return NULL;
+    }
+    /* Another thread may have made one first. */
+    if ((previous = vkd3d_atomic_ptr_compare_exchange(&resource->msc_view_map, NULL, map,
+            vkd3d_memory_order_acq_rel, vkd3d_memory_order_acquire)))
+    {
+        vkd3d_view_map_destroy(map, device);
+        vkd3d_free(map);
+        return previous;
+    }
+    return map;
+}
+
 static struct vkd3d_view *vkd3d_msc_typed_view(struct d3d12_device *device, struct d3d12_resource *resource,
         DXGI_FORMAT format, unsigned int vk_flags, uint64_t first_element, uint64_t num_elements,
         uint32_t structure_stride, VkDescriptorType vk_descriptor_type, uint64_t *handle)
 {
     const struct vkd3d_format *vkd3d_format;
+    struct vkd3d_view_map *map;
     struct vkd3d_view_key key;
     VkDeviceSize element_size;
     struct vkd3d_view *view;
@@ -6507,6 +6541,14 @@ static struct vkd3d_view *vkd3d_msc_typed_view(struct d3d12_device *device, stru
         *handle = vkd3d_msc_get_view_handle(device, view, vk_descriptor_type);
         return NULL;
     }
+    /* Views of other ranges live in the bridge's own map while it has room, as long as the resource does. */
+    if ((map = vkd3d_msc_resource_view_map(device, resource)) &&
+            ((view = vkd3d_view_map_get_view(map, device, &key)) ||
+            (map->map.used_count < VKD3D_MSC_VIEW_MAP_LIMIT && (view = vkd3d_view_map_create_view(map, device, &key)))))
+    {
+        *handle = vkd3d_msc_get_view_handle(device, view, vk_descriptor_type);
+        return NULL;
+    }
     if (!vkd3d_create_buffer_view(device, &key.u.buffer, &view))
         return NULL;
     vkd3d_msc_track_view(device, resource, view);
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index f4d64db1..cb78b17c 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -1242,6 +1242,10 @@ struct d3d12_resource
         size_t capacity;
         uint32_t count;
     } msc_views;
+    /* The bridge's views of ranges that aren't the resource's own (made on first need, up to
+     * VKD3D_MSC_VIEW_MAP_LIMIT views, then entry views as above): ring buffers reuse their ranges every lap, and
+     * making a Metal texel view is most of a typed descriptor write's cost. */
+    struct vkd3d_view_map *msc_view_map;
     struct vkd3d_subresource_layout *subresource_layouts;
     struct vkd3d_format_compatibility_list format_compatibility_list;
 
