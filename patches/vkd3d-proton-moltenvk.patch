From 7289d6b2db4462f97ba24265970ae8be6c334dab Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Fri, 23 Oct 2026 16:59:26 -0600
Subject: [PATCH 03/37] device: accept FTZ-only FP32 denorm control on MoltenVK
 for SM 6.2

---
 libs/vkd3d/device.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 836a7441..e4eecfcf 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -9814,6 +9814,12 @@ static void d3d12_device_caps_init_shader_model(struct d3d12_device *device)
             {
                 denorm_behavior = device->device_info.vulkan_1_2_properties.shaderDenormFlushToZeroFloat32 &&
                         device->device_info.vulkan_1_2_properties.shaderDenormPreserveFloat32;
+
+                /* MoltenVK: Apple GPUs always flush FP32 denorms and Metal has no preserve control.
+                 * DXIL defaults to "any" denorm mode, so only shaders that explicitly request
+                 * preserve (-denorm preserve) observe a deviation. Accept FTZ-only. */
+                if (!denorm_behavior && device->device_info.vulkan_1_2_properties.driverID == VK_DRIVER_ID_MOLTENVK)
+                    denorm_behavior = device->device_info.vulkan_1_2_properties.shaderDenormFlushToZeroFloat32;
             }
         }
 
-- 
