+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+#include "vkd3d_debug.h"
+#include "vkd3d_common.h"
+
+#define VKD3D_MSC_BLOB_MAGIC 0x4d534358u /* "XCSM" in memory */
+#define VKD3D_MSC_BLOB_VERSION 1u
+#define VKD3D_MSC_STAGE_COMPUTE 0u
+#define VKD3D_MSC_MAX_TOP_LEVEL_SIZE 4096u
+
+struct vkd3d_msc_blob_header
+{
+    uint32_t magic;
+    uint32_t version;
+    uint32_t stage;
+    uint32_t dxil_offset;
+    uint32_t dxil_size;
+    uint32_t root_sig_offset;
+    uint32_t root_sig_size;
+    uint32_t reserved;
+};
+
+/* Words per entry of the flattened root signature. */
+#define VKD3D_MSC_ROOT_SIG_HEADER_WORDS 4u
+#define VKD3D_MSC_ROOT_PARAM_WORDS 7u
+#define VKD3D_MSC_RANGE_WORDS 6u
+#define VKD3D_MSC_STATIC_SAMPLER_WORDS 13u
+
+bool vkd3d_msc_requested(void)
+{
+    char value[8];
+    return vkd3d_get_env_var("METALSHARP_MSC", value, sizeof(value)) && !strcmp(value, "1");
+}
+
+void vkd3d_msc_bridge_init(struct d3d12_device *device)
+{
+    device->msc.enabled = false;
+
+    if (!vkd3d_msc_requested())
+        return;
+
+    if (!device->vk_info.NVX_image_view_handle || !device->vk_procs.vkGetImageViewHandle64NVX)
+    {
+        INFO("METALSHARP_MSC=1, but VK_NVX_image_view_handle is unavailable; compute stays on SPIR-V.\n");
+        return;
+    }
+
+    if (!device->device_info.vulkan_1_2_features.bufferDeviceAddress)
+    {
+        INFO("METALSHARP_MSC=1, but buffer device address is unavailable; compute stays on SPIR-V.\n");
+        return;
+    }
+
+    /* Shadow heaps are only kept by the descriptor set model's write and copy paths. */
+    if (d3d12_device_use_descriptor_heap(device) || d3d12_device_uses_descriptor_buffers(device) ||
+            d3d12_device_use_embedded_mutable_descriptors(device))
+    {
+        INFO("METALSHARP_MSC=1, but the device does not use descriptor sets; compute stays on SPIR-V.\n");
+        return;
+    }
+
+    device->msc.enabled = true;
+    INFO("Metal Shader Converter bridge enabled for compute pipelines.\n");
+}
+
+uint64_t vkd3d_msc_get_view_handle(struct d3d12_device *device, struct vkd3d_view *view,
+        VkDescriptorType vk_descriptor_type)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkImageViewHandleInfoNVX info;
+    uint64_t handle;
+
+    if (!view)
+        return 0;
+
+    if ((handle = vkd3d_atomic_uint64_load_explicit(&view->msc_handle, vkd3d_memory_order_relaxed)))
+        return handle;
+
+    info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_HANDLE_INFO_NVX;
+    info.pNext = NULL;
+    info.imageView = VK_NULL_HANDLE;
+    info.descriptorType = vk_descriptor_type;
+    info.sampler = VK_NULL_HANDLE;
+
+    switch (view->type)
+    {
+        case VKD3D_VIEW_TYPE_IMAGE:
+            info.imageView = view->vk_image_view;
+            break;
+        case VKD3D_VIEW_TYPE_BUFFER:
+            /* Private to the bridge: with a texel buffer type, imageView carries a VkBufferView. */
+            info.imageView = (VkImageView)(uint64_t)view->vk_buffer_view;
+            break;
+        case VKD3D_VIEW_TYPE_SAMPLER:
+            info.sampler = view->vk_sampler;
+            break;
+        default:
+            return 0;
+    }
+
+    handle = VK_CALL(vkGetImageViewHandle64NVX(device->vk_device, &info));
+    vkd3d_atomic_uint64_store_explicit(&view->msc_handle, handle, vkd3d_memory_order_relaxed);
+    return handle;
+}
+
+uint64_t vkd3d_msc_buffer_metadata(uint32_t range, uint32_t element_offset, bool typed)
+{
+    if (element_offset > 0xff)
+    {
+        FIXME_ONCE("Typed buffer element offset %u does not fit the converter's buffer metadata, using 255.\n",
+                element_offset);
+        element_offset = 0xff;
+    }
+
+    return range | ((uint64_t)element_offset << 32) | (typed ? (1ull << 63) : 0);
+}
+
+HRESULT d3d12_descriptor_heap_init_msc(struct d3d12_descriptor_heap *descriptor_heap)
+{
+    const D3D12_DESCRIPTOR_HEAP_DESC *desc = &descriptor_heap->desc;
+    struct d3d12_device *device = descriptor_heap->device;
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkDeviceSize size;
+    void *mapped;
+    VkResult vr;
+    HRESULT hr;
+
+    if (!device->msc.enabled ||
+            (desc->Type != D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV && desc->Type != D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER))
+        return S_OK;
+
+    size = max(1u, desc->NumDescriptors) * sizeof(struct vkd3d_msc_descriptor);
+
+    /* CPU heaps only need the entries for copies. */
+    if (!(desc->Flags & D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE))
+    {
+        if (!(descriptor_heap->msc.entries = vkd3d_calloc(1, size)))
+            return E_OUTOFMEMORY;
+        return S_OK;
+    }
+
+    if (FAILED(hr = vkd3d_create_buffer_explicit_usage(device,
+            VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+            size, "msc-shadow-heap", &descriptor_heap->msc.vk_buffer)))
+        return hr;
+
+    if (FAILED(hr = vkd3d_allocate_internal_buffer_memory(device, descriptor_heap->msc.vk_buffer,
+            device->memory_info.descriptor_heap_memory_properties, 0, &descriptor_heap->msc.device_allocation)))
+        return hr;
+
+    if ((vr = VK_CALL(vkMapMemory(device->vk_device, descriptor_heap->msc.device_allocation.vk_memory,
+            0, VK_WHOLE_SIZE, 0, &mapped))))
+    {
+        ERR("Failed to map shadow heap, vr %d.\n", vr);
+        return hresult_from_vk_result(vr);
+    }
+
+    memset(mapped, 0, size);
+    descriptor_heap->msc.va = vkd3d_get_buffer_device_address(device, descriptor_heap->msc.vk_buffer);
+    descriptor_heap->msc.entries = mapped;
+    return S_OK;
+}
+
+void d3d12_descriptor_heap_cleanup_msc(struct d3d12_descriptor_heap *descriptor_heap)
+{
+    struct d3d12_device *device = descriptor_heap->device;
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+
+    if (descriptor_heap->msc.vk_buffer)
+    {
+        VK_CALL(vkDestroyBuffer(device->vk_device, descriptor_heap->msc.vk_buffer, NULL));
+        vkd3d_free_device_memory(device, &descriptor_heap->msc.device_allocation);
+    }
+    else
+        vkd3d_free(descriptor_heap->msc.entries);
+
+    memset(&descriptor_heap->msc, 0, sizeof(descriptor_heap->msc));
+}
+
+static uint32_t vkd3d_msc_float_bits(float f)
+{
+    uint32_t u;
+    memcpy(&u, &f, sizeof(u));
+    return u;
+}
+
+void d3d12_root_signature_init_msc(struct d3d12_root_signature *root_signature,
+        struct d3d12_device *device, const D3D12_ROOT_SIGNATURE_DESC2 *desc)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    struct vkd3d_msc_root_parameter *parameters = NULL;
+    VkPipelineLayoutCreateInfo layout_info;
+    VkPushConstantRange push_range;
+    uint32_t *words, *param, *range, *sampler;
+    unsigned int range_count = 0;
+    uint64_t offset = 0;
+    size_t word_count;
+    unsigned int i, j;
+    VkResult vr;
+
+    if (!device->msc.enabled)
+        return;
+
+    /* SM 6.6 heap indexing is out of scope for version 1 of the bridge. */
+    if (desc->Flags & (D3D12_ROOT_SIGNATURE_FLAG_LOCAL_ROOT_SIGNATURE |
+            D3D12_ROOT_SIGNATURE_FLAG_CBV_SRV_UAV_HEAP_DIRECTLY_INDEXED |
+            D3D12_ROOT_SIGNATURE_FLAG_SAMPLER_HEAP_DIRECTLY_INDEXED))
+        return;
+
+    if (desc->NumParameters && !(parameters = vkd3d_calloc(desc->NumParameters, sizeof(*parameters))))
+        return;
+
+    /* Top-level argument buffer layout ("Explicit layout via Root Signatures" in the converter's manual):
+     * constants are 4-byte aligned, root descriptors and tables are 8-byte aligned and 8 bytes. */
+    for (i = 0; i < desc->NumParameters; i++)
+    {
+        const D3D12_ROOT_PARAMETER1 *p = &desc->pParameters[i];
+
+        parameters[i].type = p->ParameterType;
+
+        if (p->ParameterType == D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS)
+        {
+            offset = align(offset, sizeof(uint32_t));
+            parameters[i].offset = min(offset, UINT16_MAX);
+            parameters[i].constant_count = p->Constants.Num32BitValues;
+            offset += (uint64_t)p->Constants.Num32BitValues * sizeof(uint32_t);
+        }
+        else
+        {
+            offset = align(offset, sizeof(uint64_t));
+            parameters[i].offset = min(offset, UINT16_MAX);
+            offset += sizeof(uint64_t);
+
+            if (p->ParameterType == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+            {
+                range_count += p->DescriptorTable.NumDescriptorRanges;
+                /* A table holds samplers only or no samplers. */
+                parameters[i].sampler_table = p->DescriptorTable.NumDescriptorRanges &&
+                        p->DescriptorTable.pDescriptorRanges[0].RangeType == D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER;
+            }
+        }
+    }
+
+    offset = align(offset, sizeof(uint64_t));
+    if (offset > VKD3D_MSC_MAX_TOP_LEVEL_SIZE)
+    {
+        TRACE("Top-level argument buffer of %"PRIu64" bytes is too large for the bridge.\n", offset);
+        vkd3d_free(parameters);
+        return;
+    }
+
+    word_count = VKD3D_MSC_ROOT_SIG_HEADER_WORDS +
+            desc->NumParameters * VKD3D_MSC_ROOT_PARAM_WORDS +
+            range_count * VKD3D_MSC_RANGE_WORDS +
+            desc->NumStaticSamplers * VKD3D_MSC_STATIC_SAMPLER_WORDS;
+
+    if (!(words = vkd3d_calloc(word_count, sizeof(*words))))
+    {
+        vkd3d_free(parameters);
+        return;
+    }
+
+    words[0] = desc->NumParameters;
+    words[1] = range_count;
+    words[2] = desc->NumStaticSamplers;
+    words[3] = desc->Flags;
+
+    param = words + VKD3D_MSC_ROOT_SIG_HEADER_WORDS;
+    range = param + desc->NumParameters * VKD3D_MSC_ROOT_PARAM_WORDS;
+    range_count = 0;
+
+    for (i = 0; i < desc->NumParameters; i++, param += VKD3D_MSC_ROOT_PARAM_WORDS)
+    {
+        const D3D12_ROOT_PARAMETER1 *p = &desc->pParameters[i];
+
+        param[0] = p->ParameterType;
+        param[1] = p->ShaderVisibility;
+
+        switch (p->ParameterType)
+        {
+            case D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE:
+                param[2] = range_count;
+                param[3] = p->DescriptorTable.NumDescriptorRanges;
+
+                for (j = 0; j < p->DescriptorTable.NumDescriptorRanges; j++, range += VKD3D_MSC_RANGE_WORDS)
+                {
+                    const D3D12_DESCRIPTOR_RANGE1 *r = &p->DescriptorTable.pDescriptorRanges[j];
+                    range[0] = r->RangeType;
+                    range[1] = r->NumDescriptors;
+                    range[2] = r->BaseShaderRegister;
+                    range[3] = r->RegisterSpace;
+                    range[4] = r->Flags;
+                    range[5] = r->OffsetInDescriptorsFromTableStart;
+                }
+
+                range_count += p->DescriptorTable.NumDescriptorRanges;
+                break;
+
+            case D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS:
+                param[2] = p->Constants.ShaderRegister;
+                param[3] = p->Constants.RegisterSpace;
+                param[4] = p->Constants.Num32BitValues;
+                break;
+
+            default:
+                param[2] = p->Descriptor.ShaderRegister;
+                param[3] = p->Descriptor.RegisterSpace;
+                param[4] = p->Descriptor.Flags;
+                break;
+        }
+    }
+
+    /* Static samplers as D3D12_STATIC_SAMPLER_DESC (1.1): the 1.2 Flags are dropped. */
+    sampler = range;
+    for (i = 0; i < desc->NumStaticSamplers; i++, sampler += VKD3D_MSC_STATIC_SAMPLER_WORDS)
+    {
+        const D3D12_STATIC_SAMPLER_DESC1 *s = &desc->pStaticSamplers[i];
+        sampler[0] = s->Filter;
+        sampler[1] = s->AddressU;
+        sampler[2] = s->AddressV;
+        sampler[3] = s->AddressW;
+        sampler[4] = vkd3d_msc_float_bits(s->MipLODBias);
+        sampler[5] = s->MaxAnisotropy;
+        sampler[6] = s->ComparisonFunc;
+        sampler[7] = s->BorderColor;
+        sampler[8] = vkd3d_msc_float_bits(s->MinLOD);
+        sampler[9] = vkd3d_msc_float_bits(s->MaxLOD);
+        sampler[10] = s->ShaderRegister;
+        sampler[11] = s->RegisterSpace;
+        sampler[12] = s->ShaderVisibility;
+    }
+
+    /* No descriptor sets, one compute push-constant range covering the top-level argument buffer. */
+    push_range.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    push_range.offset = 0;
+    push_range.size = offset;
+
+    memset(&layout_info, 0, sizeof(layout_info));
+    layout_info.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+    layout_info.pushConstantRangeCount = offset ? 1 : 0;
+    layout_info.pPushConstantRanges = &push_range;
+
+    if ((vr = VK_CALL(vkCreatePipelineLayout(device->vk_device, &layout_info, NULL,
+            &root_signature->msc.vk_pipeline_layout))) < 0)
+    {
+        WARN("Failed to create bridge pipeline layout, vr %d.\n", vr);
+        vkd3d_free(parameters);
+        vkd3d_free(words);
+        return;
+    }
+
+    root_signature->msc.root_sig = words;
+    root_signature->msc.root_sig_size = word_count * sizeof(*words);
+    root_signature->msc.parameters = parameters;
+    root_signature->msc.parameter_count = desc->NumParameters;
+    root_signature->msc.top_level_size = offset;
+}
+
+void d3d12_root_signature_cleanup_msc(struct d3d12_root_signature *root_signature,
+        struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+
+    VK_CALL(vkDestroyPipelineLayout(device->vk_device, root_signature->msc.vk_pipeline_layout, NULL));
+    vkd3d_free(root_signature->msc.root_sig);
+    vkd3d_free(root_signature->msc.parameters);
+}
+
+bool vkd3d_msc_shader_is_dxil(const D3D12_SHADER_BYTECODE *code)
+{
+    const uint8_t *data = code->pShaderBytecode;
+    size_t size = code->BytecodeLength;
+    uint32_t chunk_count, chunk_offset;
+    uint32_t i;
+
+    /* DXBC container: "DXBC", checksum[16], version, total size, chunk count, chunk offsets[];
+     * each chunk starts with its FourCC. DXIL lives in a "DXIL" chunk. */
+    if (!data || size < 32 || memcmp(data, "DXBC", 4))
+        return false;
+
+    memcpy(&chunk_count, data + 28, sizeof(chunk_count));
+    if (chunk_count > (size - 32) / sizeof(uint32_t))
+        return false;
+
+    for (i = 0; i < chunk_count; i++)
+    {
+        memcpy(&chunk_offset, data + 32 + i * sizeof(uint32_t), sizeof(chunk_offset));
+        if (chunk_offset <= size - 8 && !memcmp(data + chunk_offset, "DXIL", 4))
+            return true;
+    }
+
+    return false;
+}
+
+HRESULT vkd3d_msc_create_compute_pipeline(struct d3d12_device *device,
+        const struct d3d12_root_signature *root_signature, const D3D12_SHADER_BYTECODE *code,
+        VkPipeline *vk_pipeline)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkComputePipelineCreateInfo pipeline_info;
+    VkShaderModuleCreateInfo module_info;
+    struct vkd3d_msc_blob_header *header;
+    VkShaderModule vk_module;
+    size_t blob_size;
+    uint8_t *blob;
+    VkResult vr;
+
+    if (code->BytecodeLength > UINT32_MAX - sizeof(*header) - 3 - root_signature->msc.root_sig_size)
+        return E_INVALIDARG;
+
+    /* Header, DXIL container, flattened root signature; every section 4-byte aligned. */
+    blob_size = align(sizeof(*header) + code->BytecodeLength, sizeof(uint32_t));
+    blob_size += root_signature->msc.root_sig_size;
+
+    if (!(blob = vkd3d_calloc(1, blob_size)))
+        return E_OUTOFMEMORY;
+
+    header = (struct vkd3d_msc_blob_header *)blob;
+    header->magic = VKD3D_MSC_BLOB_MAGIC;
+    header->version = VKD3D_MSC_BLOB_VERSION;
+    header->stage = VKD3D_MSC_STAGE_COMPUTE;
+    header->dxil_offset = sizeof(*header);
+    header->dxil_size = code->BytecodeLength;
+    header->root_sig_offset = align(sizeof(*header) + code->BytecodeLength, sizeof(uint32_t));
+    header->root_sig_size = root_signature->msc.root_sig_size;
+    header->reserved = 0;
+    memcpy(blob + header->dxil_offset, code->pShaderBytecode, code->BytecodeLength);
+    memcpy(blob + header->root_sig_offset, root_signature->msc.root_sig, root_signature->msc.root_sig_size);
+
+    memset(&module_info, 0, sizeof(module_info));
+    module_info.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+    module_info.codeSize = blob_size;
+    module_info.pCode = (const uint32_t *)blob;
+
+    vr = VK_CALL(vkCreateShaderModule(device->vk_device, &module_info, NULL, &vk_module));
+    vkd3d_free(blob);
+    if (vr < 0)
+        return hresult_from_vk_result(vr);
+
+    memset(&pipeline_info, 0, sizeof(pipeline_info));
+    pipeline_info.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO;
+    pipeline_info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    pipeline_info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    pipeline_info.stage.module = vk_module;
+    /* MoltenVK takes the entry point from the converter's reflection. */
+    pipeline_info.stage.pName = "main";
+    pipeline_info.layout = root_signature->msc.vk_pipeline_layout;
+    pipeline_info.basePipelineIndex = -1;
+
+    /* No pipeline cache: MoltenVK keeps bridge pipelines out of it. */
+    vr = VK_CALL(vkCreateComputePipelines(device->vk_device, VK_NULL_HANDLE, 1, &pipeline_info, NULL, vk_pipeline));
+    VK_CALL(vkDestroyShaderModule(device->vk_device, vk_module, NULL));
+
+    if (vr < 0)
+    {
+        *vk_pipeline = VK_NULL_HANDLE;
+        return hresult_from_vk_result(vr);
+    }
+
+    return S_OK;
+}
