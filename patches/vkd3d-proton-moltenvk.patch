         UINT barrier_count, const D3D12_RESOURCE_BARRIER *barriers)
 {
@@ -13963,6 +14021,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_ResourceBarrier(d3d12_command_l
      * so keep it as simple as it can be for now. */
     if (d3d12_command_list_check_resource_barrier_trivial_copy_resource(list, barrier_count, barriers))
         return;
+    if (d3d12_command_list_check_resource_barrier_read_only_noop(list, barrier_count, barriers))
+        return;
 
     d3d12_command_list_flush_dgc_batch(list);
     d3d12_command_list_end_current_render_pass(list, false);
