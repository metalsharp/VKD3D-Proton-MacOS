+/* On MoltenVK every split render pass costs a new Metal render encoder, its load and store actions and
+ * one more encoder for the driver to submit, and Apple GPUs can't place a memory barrier inside a render
+ * pass. A D3D12 UAV barrier only orders UAV accesses, so draws that use no UAVs can't observe it: while
+ * the open pass draws without UAVs, keep it open and emit the barrier when it ends, or before the first
+ * draw whose pipeline uses UAVs (d3d12_command_list_begin_render_pass()). Engines put UAV barriers for
+ * their compute work between draws of a pass. */
+static bool d3d12_command_list_defer_uav_barrier_in_render_pass(
+    struct d3d12_command_list *list, UINT barrier_count, const D3D12_RESOURCE_BARRIER *barriers)
+{
+    struct d3d12_resource *resource;
+    UINT i;
+
+    if (!barrier_count || list->device->device_info.vulkan_1_2_properties.driverID != VK_DRIVER_ID_MOLTENVK)
+        return false;
+    if (!(list->rendering_info.state_flags & VKD3D_RENDERING_ACTIVE) || d3d12_command_list_graphics_pipeline_uses_uavs(list))
+        return false;
+
+    for (i = 0; i < barrier_count; i++)
+    {
+        if (barriers[i].Type != D3D12_RESOURCE_BARRIER_TYPE_UAV || barriers[i].Flags)
+            return false;
+        /* Acceleration structures and their scratch buffers go through the RTAS batch. */
+        resource = impl_from_ID3D12Resource(barriers[i].UAV.pResource);
+        if (!resource || d3d12_resource_is_acceleration_structure(resource))
+            return false;
+        if (d3d12_resource_is_buffer(resource) && list->rtas_batch.pending_rtas_work)
+            return false;
+    }
+
+    list->cmd.pending_render_pass_uav_barrier = true;
+    list->cmd.clear_uav_pending = false;
+    return true;
+}
