diff --git a/libs/vkd3d/msc_bridge.c b/libs/vkd3d/msc_bridge.c
new file mode 100644
index 00000000..1da79506
--- /dev/null
+++ b/libs/vkd3d/msc_bridge.c
@@ -0,0 +1,486 @@
+/*
+ * Metal Shader Converter bridge, VKD3D-Proton side (docs/MSC-BRIDGE-CONTRACT.md in MetalSharp Wine).
+ *
+ * With METALSHARP_MSC=1, compute PSOs whose shader is DXIL are handed to MoltenVK as a blob of DXIL plus the
+ * flattened root signature, which MoltenVK converts with Apple's Metal Shader Converter. The converted shader
+ * reads its resources through the converter's top-level argument buffer, which VKD3D-Proton pushes as push
+ * constants, and through shadow descriptor heaps of 24-byte entries that VKD3D-Proton keeps next to every
+ * descriptor heap.
+ *
