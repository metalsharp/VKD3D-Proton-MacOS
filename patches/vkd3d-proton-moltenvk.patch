From 9dc54f2ea21292fd7389d5f44820913fb5da3f2f Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Tue, 27 Oct 2026 16:14:03 -0600
Subject: [PATCH 30/37] METALSHARP_TRACE=gpu: check a bridge pipeline's
 arguments before each draw and dispatch (root descriptors without an address,
 tables without a heap or past it, heap indexing without a heap) and log the
 first 200 problems

---
 libs/vkd3d/command.c       | 65 ++++++++++++++++++++++++++++++++++++++
 libs/vkd3d/vkd3d_private.h |  1 +
 2 files changed, 66 insertions(+)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index dd2bddd0..d97a47e8 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -8723,6 +8723,62 @@ static void d3d12_command_list_check_pre_compute_barrier(
 
 /* Builds the Metal Shader Converter's top-level argument buffer (contract section 2) from the compute or
  * graphics bindings and pushes all of it with the bridge layout. */
+/* METALSHARP_TRACE=gpu: what in a bridge pipeline's arguments a converted shader can't read safely (no bounds on root
+ * descriptors and table bases), logged for the first draws and dispatches it affects. */
+static void d3d12_command_list_check_msc_arguments(struct d3d12_command_list *list, bool graphics,
+        const struct vkd3d_pipeline_bindings *bindings, const VkDeviceAddress *root_descriptor_vas)
+{
+    const struct d3d12_root_signature *root_signature = list->state->root_signature;
+    const struct vkd3d_msc_root_parameter *p;
+    static unsigned int reported;
+    uint64_t vs = 0, ps = 0;
+    const char *problem;
+    uint32_t count;
+    unsigned int i;
+
+    if (reported >= 200)
+        return;
+
+    if (graphics)
+    {
+        vs = list->state->graphics.code[0].meta.hash;
+        ps = list->state->graphics.code[1].meta.hash;
+    }
+    else
+        vs = list->state->compute.code.meta.hash;
+
+    if (root_signature->msc.heaps_offset != VKD3D_MSC_NO_HEAPS && !list->msc.shadow_va_resource && reported++ < 200)
+        VKD3D_MS_TRACE(GPU, "MSC check: %s %016"PRIx64" %016"PRIx64": heap-indexing root signature without a bound CBV/SRV/UAV heap.",
+                graphics ? "vs/ps" : "cs", vs, ps);
+
+    for (i = 0; i < root_signature->msc.parameter_count; i++)
+    {
+        p = &root_signature->msc.parameters[i];
+        problem = NULL;
+        switch (p->type)
+        {
+            case D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS:
+                break;
+            case D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE:
+                count = p->sampler_table ? list->msc.sampler_heap_count : list->msc.resource_heap_count;
+                if (!(p->sampler_table ? list->msc.shadow_va_sampler : list->msc.shadow_va_resource))
+                    problem = "table without a bound heap";
+                else if (bindings->descriptor_tables[i] >= count)
+                    problem = "table starting past the heap";
+                break;
+            default:
+                if (!root_descriptor_vas[i])
+                    problem = "root descriptor without an address";
+                break;
+        }
+        if (problem && reported++ < 200)
+            VKD3D_MS_TRACE(GPU, "MSC check: %s %016"PRIx64" %016"PRIx64": root parameter %u (type %u): %s (table start %u, heap size %u).",
+                    graphics ? "vs/ps" : "cs", vs, ps, i, p->type, problem,
+                    p->type == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE ? bindings->descriptor_tables[i] : 0,
+                    p->sampler_table ? list->msc.sampler_heap_count : list->msc.resource_heap_count);
+    }
+}
+
 static void d3d12_command_list_push_msc_arguments(struct d3d12_command_list *list, bool graphics)
 {
     const struct d3d12_root_signature *root_signature = list->state->root_signature;
@@ -8740,6 +8796,9 @@ static void d3d12_command_list_push_msc_arguments(struct d3d12_command_list *lis
     if (!root_signature->msc.push_size)
         return;
 
+    if (VKD3D_MS_TRACE_ON(GPU))
+        d3d12_command_list_check_msc_arguments(list, graphics, bindings, root_descriptor_vas);
+
     memset(data, 0, root_signature->msc.push_size);
 
     for (i = 0; i < root_signature->msc.parameter_count; i++)
@@ -15077,9 +15136,15 @@ static void d3d12_command_list_set_descriptor_heaps_sets(struct d3d12_command_li
         if (heap->msc.entries)
         {
             if (heap->desc.Type == D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV)
+            {
                 list->msc.shadow_va_resource = heap->msc.va;
+                list->msc.resource_heap_count = heap->desc.NumDescriptors;
+            }
             else
+            {
                 list->msc.shadow_va_sampler = heap->msc.va;
+                list->msc.sampler_heap_count = heap->desc.NumDescriptors;
+            }
         }
     }
 
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 0d497ea2..1d718b48 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -3651,6 +3651,7 @@ struct d3d12_command_list
     {
         VkDeviceAddress shadow_va_resource;
         VkDeviceAddress shadow_va_sampler;
+        uint32_t resource_heap_count, sampler_heap_count; /* For the checks METALSHARP_TRACE=gpu makes. */
         VkDeviceAddress root_descriptor_vas[D3D12_MAX_ROOT_COST];
         VkDeviceAddress graphics_root_descriptor_vas[D3D12_MAX_ROOT_COST];
         /* Set around ExecuteIndirect: bind the SPIR-V pipeline of a bridge PSO. */
