+    memset(&portability, 0, sizeof(portability));
+    /* VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PORTABILITY_SUBSET_FEATURES_KHR, a beta extension enum. */
+    portability.sType = (VkStructureType)1000163000;
+    /* A driver that doesn't know the structure leaves it alone: not a portability subset, so it has the bias. */
+    portability.samplerMipLodBias = VK_TRUE;
+    memset(&features, 0, sizeof(features));
+    features.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+    features.pNext = &portability;
