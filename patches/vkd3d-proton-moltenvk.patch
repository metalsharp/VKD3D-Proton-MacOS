+ * when the shader has no reflection, by any typed buffer SRV it declares (SHDR/SHEX dcl_resource_buffer). */
+static bool vkd3d_msc_dxbc_may_read_three_component_typed_srv(const D3D12_SHADER_BYTECODE *code)
