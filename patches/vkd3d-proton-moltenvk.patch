+++ b/libs/vkd3d/metalfx.c
@@ -0,0 +1,391 @@
+/*
+ * MetalSharp: MetalFX upscaling recorded in a D3D12 command list (IMTLD3D12CommandListExt, vkd3d_metalfx.h), which
+ * Mullion's NGX core uses for DLSS Super Resolution (MetalFX's temporal scaler) and Ray Reconstruction (its denoised
+ * scaler). The scales go to MoltenVK chained to a barrier (mvk_metalfx.h).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+#include "vkd3d_metalfx.h"
+
+/* A feature's scaler is MoltenVK's, under an id of ours. Destroy() can come after the device is gone, so the ids it
+ * releases wait here, for any device's next scale to pass on (an id a device does not have is nothing to it). */
+struct vkd3d_metalfx_upscaler
+{
+    IMTLD3D12Upscaler IMTLD3D12Upscaler_iface;
+    uint64_t id;
+};
+
+static spinlock_t vkd3d_metalfx_release_lock;
+static uint64_t vkd3d_metalfx_released_ids[64];
+static uint32_t vkd3d_metalfx_released_count;
+static uint64_t vkd3d_metalfx_next_id;
+
+static void STDMETHODCALLTYPE vkd3d_metalfx_upscaler_Destroy(IMTLD3D12Upscaler *iface)
+{
+    struct vkd3d_metalfx_upscaler *upscaler = CONTAINING_RECORD(iface, struct vkd3d_metalfx_upscaler, IMTLD3D12Upscaler_iface);
+
+    spinlock_acquire(&vkd3d_metalfx_release_lock);
+    if (vkd3d_metalfx_released_count < ARRAY_SIZE(vkd3d_metalfx_released_ids))
+        vkd3d_metalfx_released_ids[vkd3d_metalfx_released_count++] = upscaler->id;
+    spinlock_release(&vkd3d_metalfx_release_lock);
+    vkd3d_free(upscaler);
+}
+
+static const IMTLD3D12UpscalerVtbl vkd3d_metalfx_upscaler_vtbl =
+{
+    vkd3d_metalfx_upscaler_Destroy,
+};
+
+/* The id of the feature's scaler, made at its first scale. */
+static uint64_t vkd3d_metalfx_upscaler_id(IMTLD3D12Upscaler **iface)
+{
+    struct vkd3d_metalfx_upscaler *upscaler;
+
+    if (*iface)
+    {
+        if ((*iface)->lpVtbl != &vkd3d_metalfx_upscaler_vtbl)
+            return 0;
+        return CONTAINING_RECORD(*iface, struct vkd3d_metalfx_upscaler, IMTLD3D12Upscaler_iface)->id;
+    }
+    if (!(upscaler = vkd3d_malloc(sizeof(*upscaler))))
+        return 0;
+    upscaler->IMTLD3D12Upscaler_iface.lpVtbl = &vkd3d_metalfx_upscaler_vtbl;
+    upscaler->id = vkd3d_atomic_uint64_increment(&vkd3d_metalfx_next_id, vkd3d_memory_order_relaxed);
+    *iface = &upscaler->IMTLD3D12Upscaler_iface;
+    return upscaler->id;
+}
+
+/* Whether MoltenVK's driverInfo has the word (mvk_metalfx.h). */
+bool vkd3d_metalfx_driver_has(const struct d3d12_device *device, const char *word)
+{
+    const char *info = device->device_info.vulkan_1_2_properties.driverInfo, *found;
+    size_t length = strlen(word);
+
+    if (device->device_info.vulkan_1_2_properties.driverID != VK_DRIVER_ID_MOLTENVK)
+        return false;
+    for (found = strstr(info, word); found; found = strstr(found + 1, word))
+    {
+        if ((found == info || found[-1] == ' ') && (!found[length] || found[length] == ' '))
+            return true;
+    }
+    return false;
+}
+
+/* The format MetalFX reads an image as: a float for an integer-typed one (a typeless depth or exposure), and a float
+ * pair or quad for motion vectors; VK_FORMAT_UNDEFINED for the image's own. */
+static VkFormat vkd3d_metalfx_read_format(const struct d3d12_resource *resource, bool motion)
+{
+    switch (resource->format->vk_format)
+    {
+        case VK_FORMAT_R32_UINT:
+        case VK_FORMAT_R32_SINT:
+            return VK_FORMAT_R32_SFLOAT;
+        case VK_FORMAT_R16_UINT:
+        case VK_FORMAT_R16_SINT:
+            return VK_FORMAT_R16_SFLOAT;
+        case VK_FORMAT_R32G32_UINT:
+        case VK_FORMAT_R32G32_SINT:
+            return VK_FORMAT_R32G32_SFLOAT;
+        case VK_FORMAT_R16G16_UINT:
+        case VK_FORMAT_R16G16_SINT:
+        case VK_FORMAT_R16G16_UNORM:
+        case VK_FORMAT_R16G16_SNORM:
+            return motion ? VK_FORMAT_R16G16_SFLOAT : VK_FORMAT_UNDEFINED;
+        case VK_FORMAT_R16G16B16A16_UINT:
+        case VK_FORMAT_R16G16B16A16_SINT:
+        case VK_FORMAT_R16G16B16A16_UNORM:
+        case VK_FORMAT_R16G16B16A16_SNORM:
+            return motion ? VK_FORMAT_R16G16B16A16_SFLOAT : VK_FORMAT_UNDEFINED;
+        default:
+            return VK_FORMAT_UNDEFINED;
+    }
+}
+
+static inline struct d3d12_command_list *impl_from_IMTLD3D12CommandListExt(IMTLD3D12CommandListExt *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d12_command_list, IMTLD3D12CommandListExt_iface);
+}
+
+extern HRESULT STDMETHODCALLTYPE d3d12_command_list_QueryInterface(d3d12_command_list_iface *iface,
+        REFIID iid, void **object);
+extern ULONG STDMETHODCALLTYPE d3d12_command_list_AddRef(d3d12_command_list_iface *iface);
+extern ULONG STDMETHODCALLTYPE d3d12_command_list_Release(d3d12_command_list_iface *iface);
+
+static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_QueryInterface(IMTLD3D12CommandListExt *iface,
+        REFIID iid, void **object)
+{
+    struct d3d12_command_list *list = impl_from_IMTLD3D12CommandListExt(iface);
+    return d3d12_command_list_QueryInterface(&list->ID3D12GraphicsCommandList_iface, iid, object);
+}
+
+ULONG STDMETHODCALLTYPE d3d12_command_list_metalfx_AddRef(IMTLD3D12CommandListExt *iface)
+{
+    struct d3d12_command_list *list = impl_from_IMTLD3D12CommandListExt(iface);
+    return d3d12_command_list_AddRef(&list->ID3D12GraphicsCommandList_iface);
+}
+
+static ULONG STDMETHODCALLTYPE d3d12_command_list_metalfx_Release(IMTLD3D12CommandListExt *iface)
+{
+    struct d3d12_command_list *list = impl_from_IMTLD3D12CommandListExt(iface);
+    return d3d12_command_list_Release(&list->ID3D12GraphicsCommandList_iface);
+}
+
+static BOOL STDMETHODCALLTYPE d3d12_command_list_metalfx_SupportsTemporalUpscale(IMTLD3D12CommandListExt *iface)
+{
+    struct d3d12_command_list *list = impl_from_IMTLD3D12CommandListExt(iface);
+    return vkd3d_metalfx_driver_has(list->device, VK_MVK_METALFX_DRIVER_INFO);
+}
+
+static BOOL STDMETHODCALLTYPE d3d12_command_list_metalfx_SupportsDenoisedUpscale(IMTLD3D12CommandListExt *iface)
+{
+    struct d3d12_command_list *list = impl_from_IMTLD3D12CommandListExt(iface);
+    return vkd3d_metalfx_driver_has(list->device, VK_MVK_METALFX_DENOISED_DRIVER_INFO);
+}
+
+/* Puts the resource at `index` in the scale; false for one that is not a texture of this device's. */
+static bool vkd3d_metalfx_set_image(VkMetalFXScaleInfoMVK *info, struct d3d12_resource **resources,
+        VkMetalFXImageMVK index, ID3D12Resource *iface, bool motion)
+{
+    struct d3d12_resource *resource;
+
+    if (!iface)
+        return true;
+    resource = impl_from_ID3D12Resource(iface);
+    if (d3d12_resource_is_buffer(resource))
+        return false;
+    resources[index] = resource;
+    info->images[index] = resource->res.vk_image;
+    info->formats[index] = vkd3d_metalfx_read_format(resource, motion);
+    return true;
+}
+
+/* Records the scale, passing on the scalers released since the last one. */
+static void vkd3d_metalfx_record(struct d3d12_command_list *list, VkMetalFXScaleInfoMVK *info,
+        struct d3d12_resource **resources)
+{
+    uint64_t released[ARRAY_SIZE(vkd3d_metalfx_released_ids)];
+
+    spinlock_acquire(&vkd3d_metalfx_release_lock);
+    memcpy(released, vkd3d_metalfx_released_ids, vkd3d_metalfx_released_count * sizeof(*released));
+    info->releaseScalerIdCount = vkd3d_metalfx_released_count;
+    vkd3d_metalfx_released_count = 0;
+    spinlock_release(&vkd3d_metalfx_release_lock);
+    info->pReleaseScalerIds = released;
+
+    d3d12_command_list_metalfx_scale(list, info, resources, VK_METALFX_IMAGE_COUNT_MVK);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_TemporalUpscale(IMTLD3D12CommandListExt *iface,
+        const MTL_TEMPORAL_UPSCALE_D3D12_DESC *desc, IMTLD3D12Upscaler **upscaler)
+{
+    struct d3d12_command_list *list = impl_from_IMTLD3D12CommandListExt(iface);
+    struct d3d12_resource *resources[VK_METALFX_IMAGE_COUNT_MVK] = {0};
+    VkMetalFXScaleInfoMVK info;
+    static bool warned;
+
+    TRACE("iface %p, desc %p, upscaler %p.\n", iface, desc, upscaler);
+
+    if (!desc || !upscaler || !desc->Color || !desc->Depth || !desc->MotionVector || !desc->Output)
+        return E_INVALIDARG;
+    if (!vkd3d_metalfx_driver_has(list->device, VK_MVK_METALFX_DRIVER_INFO))
+        return E_NOTIMPL;
+    if (desc->MotionVectorInDisplayRes && !warned)
+    {
+        warned = true;
+        WARN("MetalFX: motion vectors at the output resolution are not supported yet.\n");
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.sType = VK_STRUCTURE_TYPE_METALFX_SCALE_INFO_MVK;
+    if (!vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_COLOR_MVK, desc->Color, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_DEPTH_MVK, desc->Depth, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_MOTION_MVK, desc->MotionVector, true) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_OUTPUT_MVK, desc->Output, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_EXPOSURE_MVK, desc->ExposureTexture, false))
+        return E_INVALIDARG;
+    if (!(info.scalerId = vkd3d_metalfx_upscaler_id(upscaler)))
+        return E_OUTOFMEMORY;
+
+    info.scalerType = VK_METALFX_SCALER_TYPE_TEMPORAL_MVK;
+    info.flags = (desc->AutoExposure ? VK_METALFX_SCALE_AUTO_EXPOSURE_BIT_MVK : 0) |
+            (desc->InReset ? VK_METALFX_SCALE_RESET_BIT_MVK : 0) |
+            (desc->DepthReversed ? VK_METALFX_SCALE_DEPTH_REVERSED_BIT_MVK : 0);
+    info.inputContentWidth = desc->InputContentWidth;
+    info.inputContentHeight = desc->InputContentHeight;
+    info.motionVectorScaleX = desc->MotionVectorScaleX;
+    info.motionVectorScaleY = desc->MotionVectorScaleY;
+    info.jitterOffsetX = desc->JitterOffsetX;
+    info.jitterOffsetY = desc->JitterOffsetY;
+    info.preExposure = desc->PreExposure;
+    vkd3d_metalfx_record(list, &info, resources);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_DenoisedUpscale(IMTLD3D12CommandListExt *iface,
+        const MTL_DENOISED_UPSCALE_D3D12_DESC *desc, IMTLD3D12Upscaler **upscaler)
+{
+    struct d3d12_command_list *list = impl_from_IMTLD3D12CommandListExt(iface);
+    struct d3d12_resource *resources[VK_METALFX_IMAGE_COUNT_MVK] = {0};
+    ID3D12Resource *roughness;
+    VkMetalFXScaleInfoMVK info;
+    static bool warned;
+
+    TRACE("iface %p, desc %p, upscaler %p.\n", iface, desc, upscaler);
+
+    roughness = desc && desc->RoughnessInNormalAlpha ? desc->Normals : desc ? desc->Roughness : NULL;
+    if (!desc || !upscaler || !desc->Color || !desc->Depth || !desc->MotionVector || !desc->Output ||
+            !desc->DiffuseAlbedo || !desc->SpecularAlbedo || !desc->Normals || !roughness)
+        return E_INVALIDARG;
+    if (!vkd3d_metalfx_driver_has(list->device, VK_MVK_METALFX_DENOISED_DRIVER_INFO))
+        return E_NOTIMPL;
+    if (desc->RoughnessInNormalAlpha && !warned)
+    {
+        warned = true;
+        WARN("MetalFX: roughness in the normals' alpha is read from their first channel.\n");
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.sType = VK_STRUCTURE_TYPE_METALFX_SCALE_INFO_MVK;
+    if (!vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_COLOR_MVK, desc->Color, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_DEPTH_MVK, desc->Depth, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_MOTION_MVK, desc->MotionVector, true) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_OUTPUT_MVK, desc->Output, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_EXPOSURE_MVK, desc->ExposureTexture, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_DIFFUSE_ALBEDO_MVK, desc->DiffuseAlbedo, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_SPECULAR_ALBEDO_MVK, desc->SpecularAlbedo, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_NORMALS_MVK, desc->Normals, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_ROUGHNESS_MVK, roughness, false) ||
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_SPECULAR_HIT_DISTANCE_MVK,
+                    desc->SpecularHitDistance, false))
+        return E_INVALIDARG;
+    if (!(info.scalerId = vkd3d_metalfx_upscaler_id(upscaler)))
+        return E_OUTOFMEMORY;
+
+    info.scalerType = VK_METALFX_SCALER_TYPE_DENOISED_MVK;
+    info.flags = (desc->AutoExposure ? VK_METALFX_SCALE_AUTO_EXPOSURE_BIT_MVK : 0) |
+            (desc->InReset ? VK_METALFX_SCALE_RESET_BIT_MVK : 0) |
+            (desc->DepthReversed ? VK_METALFX_SCALE_DEPTH_REVERSED_BIT_MVK : 0);
+    info.motionVectorScaleX = desc->MotionVectorScaleX;
+    info.motionVectorScaleY = desc->MotionVectorScaleY;
+    info.jitterOffsetX = desc->JitterOffsetX;
+    info.jitterOffsetY = desc->JitterOffsetY;
+    info.preExposure = desc->PreExposure;
+    memcpy(info.worldToViewMatrix, desc->WorldToView, sizeof(info.worldToViewMatrix));
+    memcpy(info.viewToClipMatrix, desc->ViewToClip, sizeof(info.viewToClipMatrix));
+    vkd3d_metalfx_record(list, &info, resources);
+    return S_OK;
+}
