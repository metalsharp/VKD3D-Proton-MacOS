diff --git a/libs/vkd3d/msc_bridge.c b/libs/vkd3d/msc_bridge.c
index fdb13c14..804d7a7a 100644
--- a/libs/vkd3d/msc_bridge.c
+++ b/libs/vkd3d/msc_bridge.c
@@ -56,6 +56,9 @@ struct vkd3d_msc_blob_header
     uint32_t vertex_input_count;
 };
 
+/* The register space of AMD's shader intrinsics UAV (AGS_DX12_SHADER_INTRINSICS_SPACE_ID). */
+#define VKD3D_MSC_AGS_REGISTER_SPACE 0x7fff0adeu
+
 /* Words per entry of the flattened root signature. */
 #define VKD3D_MSC_ROOT_SIG_HEADER_WORDS 4u
 #define VKD3D_MSC_ROOT_PARAM_WORDS 7u
@@ -397,6 +400,23 @@ void d3d12_root_signature_init_msc(struct d3d12_root_signature *root_signature,
     if (desc->Flags & D3D12_ROOT_SIGNATURE_FLAG_LOCAL_ROOT_SIGNATURE)
         return;
 
+    /* AMD's shader intrinsics (AGS: WMMA, wave intrinsics) are calls on a UAV in register space 0x7fff0ade, which
+     * dxil-spirv implements; the converter would see an ordinary buffer. Their PSOs stay on SPIR-V. */
+    for (i = 0; i < desc->NumParameters; i++)
+    {
+        const D3D12_ROOT_PARAMETER1 *p = &desc->pParameters[i];
+
+        if (p->ParameterType == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+        {
+            for (j = 0; j < p->DescriptorTable.NumDescriptorRanges; j++)
+                if (p->DescriptorTable.pDescriptorRanges[j].RegisterSpace == VKD3D_MSC_AGS_REGISTER_SPACE)
+                    return;
+        }
+        else if (p->ParameterType != D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS &&
+                p->Descriptor.RegisterSpace == VKD3D_MSC_AGS_REGISTER_SPACE)
+            return;
+    }
+
     if (desc->NumParameters && !(parameters = vkd3d_calloc(desc->NumParameters, sizeof(*parameters))))
         return;
 
