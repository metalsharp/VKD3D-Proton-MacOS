index 00000000..f8a4e51b
--- /dev/null
+++ b/include/private/vkd3d_metalsharp_trace.h
@@ -0,0 +1,58 @@
+/*
+ * MetalSharp trace flag: METALSHARP_TRACE=<category>[+heavy][,...] turns on the diagnostics a problem needs.
+ *
+ *   shader    shader and pipeline compiles: dumps, pipeline library hits, per-pipeline compile times
+ *   present   swap chain: one line per Present (frame, interval, time in Present), latency markers
+ *   memory    memory budget and every device memory allocation and free
+ *   resource  resource and heap creation; +heavy adds GPU descriptor validation
+ *   sync      fence signals and waits, queue Signal/Wait
+ *   gpu       device-lost diagnostics: breadcrumbs and device faults; +heavy synchronizes every submission
+ *   cpu       queue timeline (Chrome trace JSON); +heavy adds extra timeline events
+ *   api       (Vulkan call trace, in MoltenVK)
+ *   pass      (render passes, in MoltenVK)
+ *   all       every category; all+heavy adds every heavy mode
+ *
+ * Logs go to METALSHARP_TRACE_DIR, or <METALSHARP_HOME or ~/.metalsharp>/logs/trace/<exe>/: vkd3d.log here,
+ * moltenvk.log from MoltenVK, with the previous launch's kept as *.prev.log. A setting already present in the
+ * environment (VKD3D_CONFIG, VKD3D_SHADER_DUMP_PATH, ...) is never overridden; VKD3D_CONFIG flags are appended.
+ */
+
+#ifndef __VKD3D_METALSHARP_TRACE_H
+#define __VKD3D_METALSHARP_TRACE_H
+
+#include <stdint.h>
+
+#define VKD3D_MS_TRACE_SHADER   (1u << 0)
+#define VKD3D_MS_TRACE_PRESENT  (1u << 1)
+#define VKD3D_MS_TRACE_MEMORY   (1u << 2)
+#define VKD3D_MS_TRACE_RESOURCE (1u << 3)
+#define VKD3D_MS_TRACE_SYNC     (1u << 4)
+#define VKD3D_MS_TRACE_GPU      (1u << 5)
+#define VKD3D_MS_TRACE_CPU      (1u << 6)
+#define VKD3D_MS_TRACE_API      (1u << 7)
+#define VKD3D_MS_TRACE_PASS     (1u << 8)
+
+/* Expands METALSHARP_TRACE into the environment once; vkd3d_get_env_var() calls it before any lookup. */
+void vkd3d_metalsharp_trace_init(void);
+
+/* Categories turned on, and those turned on with +heavy. */
+uint32_t vkd3d_metalsharp_trace_mask(void);
+uint32_t vkd3d_metalsharp_trace_heavy_mask(void);
+
+/* The directory the logs go to (a DOS path), or "" when tracing is off. */
+const char *vkd3d_metalsharp_trace_dir(void);
+
+/* Milliseconds since the trace started. */
+double vkd3d_metalsharp_trace_time_ms(void);
+
+void vkd3d_metalsharp_trace_printf(uint32_t category, const char *fmt, ...);
+
+#define VKD3D_MS_TRACE(cat, ...) \
+    do { \
+        if (vkd3d_metalsharp_trace_mask() & VKD3D_MS_TRACE_##cat) \
+            vkd3d_metalsharp_trace_printf(VKD3D_MS_TRACE_##cat, __VA_ARGS__); \
+    } while (0)
+
+#define VKD3D_MS_TRACE_ON(cat) (!!(vkd3d_metalsharp_trace_mask() & VKD3D_MS_TRACE_##cat))
+
+#endif
diff --git a/libs/vkd3d-common/meson.build b/libs/vkd3d-common/meson.build
index c3c22abf..972dfe28 100644
--- a/libs/vkd3d-common/meson.build
+++ b/libs/vkd3d-common/meson.build
@@ -6,6 +6,7 @@ vkd3d_common_src = [
   'string.c',
