+/* A batch of texture transitions between read-only states needs no synchronization (read after
+ * read). Recognizing it before the barrier code ends the render pass keeps the pass open: Unity
+ * and other engines transition textures between shader stages between draws, and every split
+ * render pass reloads and stores its attachments. MoltenVK has no image layouts, so a layout
+ * change between read-only states needs nothing there either. */
+static bool d3d12_command_list_check_resource_barrier_read_only_noop(
+    struct d3d12_command_list *list, UINT barrier_count, const D3D12_RESOURCE_BARRIER *barriers)
+{
+    const VkAccessFlags2 write_access = VK_ACCESS_2_SHADER_WRITE_BIT | VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT |
+            VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+            VK_ACCESS_2_TRANSFER_WRITE_BIT | VK_ACCESS_2_HOST_WRITE_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT |
+            VK_ACCESS_2_TRANSFORM_FEEDBACK_WRITE_BIT_EXT | VK_ACCESS_2_TRANSFORM_FEEDBACK_COUNTER_WRITE_BIT_EXT |
+            VK_ACCESS_2_ACCELERATION_STRUCTURE_WRITE_BIT_KHR;
+    bool ignore_layouts = list->device->device_info.vulkan_1_2_properties.driverID == VK_DRIVER_ID_MOLTENVK;
+    VkAccessFlags2 before_access, after_access;
+    VkPipelineStageFlags2 stages;
+    UINT i;
+
+    if (!barrier_count || list->type == D3D12_COMMAND_LIST_TYPE_COPY)
+        return false;
+
+    for (i = 0; i < barrier_count; i++)
+    {
+        const D3D12_RESOURCE_BARRIER *barrier = &barriers[i];
+        const D3D12_RESOURCE_TRANSITION_BARRIER *transition = &barrier->Transition;
+        struct d3d12_resource *resource;
+
+        if (barrier->Type != D3D12_RESOURCE_BARRIER_TYPE_TRANSITION || barrier->Flags)
+            return false;
+        if (!(resource = impl_from_ID3D12Resource(transition->pResource)) || !d3d12_resource_is_texture(resource))
+            return false;
+        if (!is_valid_resource_state(transition->StateBefore) || !is_valid_resource_state(transition->StateAfter))
+            return false;
+        if (transition->StateBefore == D3D12_RESOURCE_STATE_COMMON || transition->StateAfter == D3D12_RESOURCE_STATE_COMMON ||
+                (transition->StateAfter & D3D12_RESOURCE_STATE_INDIRECT_ARGUMENT))
+            return false;
+        if ((resource->desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL) ||
+                (resource->flags & VKD3D_RESOURCE_LINEAR_STAGING_COPY))
+            return false;
+
+        before_access = after_access = 0;
+        stages = 0;
+        vk_access_and_stage_flags_from_d3d12_resource_state(list, resource, transition->StateBefore,
+                list->vk_queue_flags, &stages, &before_access);
+        vk_access_and_stage_flags_from_d3d12_resource_state(list, resource, transition->StateAfter,
+                list->vk_queue_flags, &stages, &after_access);
+        if ((before_access | after_access) & write_access)
+            return false;
+        if (!ignore_layouts && vk_image_layout_from_d3d12_resource_state(list, resource, transition->StateBefore) !=
+                vk_image_layout_from_d3d12_resource_state(list, resource, transition->StateAfter))
+            return false;
+    }
+
+    for (i = 0; i < barrier_count; i++)
+        d3d12_command_list_track_resource_usage(list, impl_from_ID3D12Resource(barriers[i].Transition.pResource), true);
+    return true;
+}
+
