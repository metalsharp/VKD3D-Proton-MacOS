+                    !device->device_info.vulkan_1_3_properties.uniformTexelBufferOffsetSingleTexelAlignment)
+            {
+                VkDeviceSize byte_count = format ? vkd3d_get_format(device, format, false)->byte_count : sizeof(uint32_t);
+                VkDeviceSize align = max(device->device_info.vulkan_1_3_properties.storageTexelBufferOffsetAlignmentBytes,
