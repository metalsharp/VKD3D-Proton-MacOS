new file mode 100755
index 00000000..fb61358c
--- /dev/null
+++ b/scripts/cache-key.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Prints the key VKD3D-Proton's pipeline caches are kept under (15 hex digits, like the build tag it replaces
+# there): a hash of the sources that decide what a cached pipeline holds, so a rebuild that changes none of them
+# keeps the caches games built. Keyed on the git build instead, every commit (a swap chain or trace change too)
+# threw each game's cache away, and the next launch compiled every pipeline again.
+# The sources: the shader compiler (libs/vkd3d-shader and dxil-spirv with its SPIRV-Cross-free submodules), the
+# pipeline state, root signature, state object and cache code, the per-game workarounds, and the headers.
+# The cache's own checks still key on the device's shader interface (config flags and features) and the
+# Vulkan driver's pipelineCacheUUID.
+cd "$(dirname "$0")/.." || exit 1
+{
+    find libs/vkd3d-shader include -type f \( -name '*.c' -o -name '*.h' -o -name '*.idl' -o -name '*.in' \) | LC_ALL=C sort | xargs shasum
+    shasum libs/vkd3d/cache.c libs/vkd3d/state.c libs/vkd3d/state_object_common.c libs/vkd3d/raytracing_pipeline.c \
+        libs/vkd3d/workgraphs.c libs/vkd3d/device_workarounds.c libs/vkd3d/vkd3d_private.h
+    git -C subprojects/dxil-spirv rev-parse HEAD 2>/dev/null
+    git -C subprojects/dxil-spirv diff --no-ext-diff 2>/dev/null | shasum
+    git -C subprojects/dxil-spirv submodule status --recursive 2>/dev/null
+} | sed 's#  .*/#  #' | shasum | cut -c1-15
diff --git a/vkd3d_cache_key.h.in b/vkd3d_cache_key.h.in
new file mode 100644
index 00000000..a82672bf
--- /dev/null
+++ b/vkd3d_cache_key.h.in
@@ -0,0 +1,4 @@
+#include <stdint.h>
+
+/* Hash of the sources that decide what a cached pipeline holds (scripts/cache-key.sh). */
+static const uint64_t vkd3d_cache_build = 0x@VCS_TAG@;
