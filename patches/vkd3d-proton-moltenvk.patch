+     * that cannot fetch that format (Metal). The shader unpacks the word. */
+    uint32_t vertex_input_packed_rgb10a2_uint_mask;
+
     /* Used for either VKD3D_SHADER_INTERFACE_RAW_VA_ALIAS_DESCRIPTOR_BUFFER or local root signatures. */
