+/* METALSHARP_TRACE=shader: each pipeline state with its shader hashes and how long it took to create. */
 HRESULT d3d12_pipeline_state_create(struct d3d12_device *device, VkPipelineBindPoint bind_point,
         const struct d3d12_pipeline_state_desc *desc, struct d3d12_pipeline_state **state)
+{
+    uint64_t start_ns = VKD3D_MS_TRACE_ON(SHADER) ? vkd3d_get_current_time_ns() : 0;
+    char hashes[256] = "";
+    size_t len = 0;
+    unsigned int i;
+    HRESULT hr;
+
+    hr = d3d12_pipeline_state_create_internal(device, bind_point, desc, state);
+    if (!start_ns)
+        return hr;
+
+    if (SUCCEEDED(hr) && bind_point == VK_PIPELINE_BIND_POINT_GRAPHICS)
+    {
+        const struct d3d12_graphics_pipeline_state *graphics = &(*state)->graphics;
+
+        for (i = 0; i < graphics->stage_count && len < sizeof(hashes) - 32; i++)
+            len += snprintf(hashes + len, sizeof(hashes) - len, " %#x:%016"PRIx64, graphics->stages[i].stage,
+                    graphics->code[i].meta.hash);
+    }
+    else if (SUCCEEDED(hr) && bind_point == VK_PIPELINE_BIND_POINT_COMPUTE)
+        snprintf(hashes, sizeof(hashes), " cs:%016"PRIx64, (*state)->compute.code.meta.hash);
+
+    VKD3D_MS_TRACE(SHADER, "%s pipeline state %p%s: %.2f ms%s -> %#x.",
+            bind_point == VK_PIPELINE_BIND_POINT_COMPUTE ? "Compute" : "Graphics",
+            SUCCEEDED(hr) ? (void *)*state : NULL, hashes, (double)(vkd3d_get_current_time_ns() - start_ns) / 1.0e6,
+            SUCCEEDED(hr) && (*state)->pso_is_loaded_from_cached_blob ? " (from cached blob)" : "", hr);
+    return hr;
+}
