+/* MetalSharp: a MetalFX scale (metalfx.c), chained to a barrier after everything recorded before it, and followed
+ * by one before everything after it. */
+void d3d12_command_list_metalfx_scale(struct d3d12_command_list *list, const VkMetalFXScaleInfoMVK *info,
+        struct d3d12_resource **resources, unsigned int resource_count)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkDependencyInfo dependency_info;
+    VkMemoryBarrier2 barrier;
+    unsigned int i;
+
+    d3d12_command_list_flush_dgc_batch(list);
+    d3d12_command_list_end_current_render_pass(list, false);
+    d3d12_command_list_end_transfer_batch(list, false);
+    for (i = 0; i < resource_count; i++)
+    {
+        if (resources[i])
+            d3d12_command_list_track_resource_usage(list, resources[i], true);
+    }
+
+    memset(&barrier, 0, sizeof(barrier));
+    barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2;
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+    memset(&dependency_info, 0, sizeof(dependency_info));
+    dependency_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dependency_info.pNext = info;
+    dependency_info.memoryBarrierCount = 1;
+    dependency_info.pMemoryBarriers = &barrier;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dependency_info));
+    dependency_info.pNext = NULL;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dependency_info));
+
+    list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;
+}
