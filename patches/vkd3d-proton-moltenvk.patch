@@ -6172,6 +6172,7 @@ struct d3d12_device
         bool dxbc; /* DXBC shaders too, converted to DXIL by MoltenVK (METALSHARP_MSC_DXBC=0: DXIL only) */
         uint32_t minmax_heap_samplers; /* The application made a sampler with min/max reduction. */
