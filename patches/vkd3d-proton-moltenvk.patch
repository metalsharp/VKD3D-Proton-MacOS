index a456313c..0704898d 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -14727,11 +14727,14 @@ static bool d3d12_command_list_defer_uav_barrier_in_render_pass(
     {
         if (barriers[i].Type != D3D12_RESOURCE_BARRIER_TYPE_UAV || barriers[i].Flags)
             return false;
-        /* Acceleration structures and their scratch buffers go through the RTAS batch. */
+        /* Acceleration structures and their scratch buffers go through the RTAS batch. A global UAV barrier (no
+         * resource) covers them too, but they are built outside render passes: with no build pending, it only
+         * orders UAVs like the others (as Mullion keeps a pass open across any UAV barrier while it draws without
+         * UAVs). */
         resource = impl_from_ID3D12Resource(barriers[i].UAV.pResource);
-        if (!resource || d3d12_resource_is_acceleration_structure(resource))
+        if (resource && d3d12_resource_is_acceleration_structure(resource))
             return false;
-        if (d3d12_resource_is_buffer(resource) && list->rtas_batch.pending_rtas_work)
+        if ((!resource || d3d12_resource_is_buffer(resource)) && list->rtas_batch.pending_rtas_work)
             return false;
     }
 
