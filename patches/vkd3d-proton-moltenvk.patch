     if (!single_storage_texel || !single_uniform_texel)
     {
-        ERR("Lacking support for single texel alignment.\n");
-        return E_INVALIDARG;
+        /* MoltenVK aligns texel buffer views to Metal's linear-texture alignment; the custom VKMT
