     d3d_destruction_notifier_init(&state->destruction_notifier, (IUnknown*)&state->ID3D12PipelineState_iface);
     d3d12_device_add_ref(state->device = device);
 
+    /* MetalSharp: compiled now when an ExecuteIndirect state template names the root signature, rather than on the
+     * first such ExecuteIndirect (a hitch during rendering). */
+    if (state->compute.msc_bridge && state->root_signature &&
