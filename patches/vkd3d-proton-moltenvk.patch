From 943a6f89851edfbdbe6ca35d8ab4962480c0ef38 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 6 Nov 2026 06:09:59 -0700
Subject: [PATCH 52/63] msc: keep shaders that write SV_CullDistance on SPIR-V

The Metal Shader Converter drops cull distances (it only warns
"Unsupported: culldistance"), so a primitive with every cull distance
negative was drawn. MoltenVK's SPIR-V path passes them on as clip
distances, which culls it. Vertex, pixel and mesh shaders whose output
signature (OSG1, OSG5 or OSGN) has an SV_CullDistance now stay on SPIR-V.
---
 libs/vkd3d/msc_bridge.c | 36 ++++++++++++++++++++++++++++++++++--
 libs/vkd3d/state.c      |  2 +-
 2 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/libs/vkd3d/msc_bridge.c b/libs/vkd3d/msc_bridge.c
index 8a8e0294..4e7b21af 100644
--- a/libs/vkd3d/msc_bridge.c
+++ b/libs/vkd3d/msc_bridge.c
@@ -745,11 +745,43 @@ bool vkd3d_msc_reads_minmax_samplers(struct d3d12_device *device, const struct d
 
 /* Whether the bridge can take the shader, and how: DXIL as it is, DXBC (SM 4.x/5.x) through MoltenVK's DXBC to DXIL
  * converter (VKD3D_MSC_BLOB_FLAG_DXBC; METALSHARP_MSC_DXBC=0 keeps it on SPIR-V). */
+/* A shader whose output signature has an SV_CullDistance: the Metal Shader Converter drops cull distances (it warns
+ * "Unsupported: culldistance") and draws primitives that should be culled, where SPIR-V passes them on as clip
+ * distances. OSG1 (DXIL) entries are 32 bytes, OSG5 28 and OSGN 24; the system value is D3D_NAME_CULL_DISTANCE (3). */
+static bool vkd3d_msc_writes_cull_distance(const D3D12_SHADER_BYTECODE *code)
+{
+    static const struct { const char *fourcc; uint32_t entry_size, sysval_offset; } signatures[] =
+    {
+        { "OSG1", 32, 12 }, { "OSG5", 28, 12 }, { "OSGN", 24, 8 },
+    };
+    const uint8_t *data = code->pShaderBytecode;
+    uint32_t offset, size, count, entries, sysval, i, j;
+
+    for (i = 0; i < ARRAY_SIZE(signatures); i++)
+    {
+        if (!(offset = vkd3d_msc_find_chunk(code, signatures[i].fourcc, &size)) || size < 8)
+            continue;
+        memcpy(&count, data + offset, sizeof(count));
+        memcpy(&entries, data + offset + 4, sizeof(entries));
+        if (entries > size || count > (size - entries) / signatures[i].entry_size)
+            return true;
+        for (j = 0; j < count; j++)
+        {
+            memcpy(&sysval, data + offset + entries + j * signatures[i].entry_size + signatures[i].sysval_offset, sizeof(sysval));
+            if (sysval == 3)
+                return true;
+        }
+    }
+    return false;
+}
+
 bool vkd3d_msc_shader_is_bridgeable(struct d3d12_device *device, const D3D12_SHADER_BYTECODE *code, uint32_t *blob_flags)
 {
     uint32_t size;
 
     *blob_flags = 0;
+    if (vkd3d_msc_writes_cull_distance(code))
+        return false;
     if (vkd3d_msc_shader_is_dxil(code))
         return true;
     if (!device->msc.dxbc || (!vkd3d_msc_find_chunk(code, "SHEX", &size) && !vkd3d_msc_find_chunk(code, "SHDR", &size)))
@@ -932,10 +964,10 @@ bool d3d12_pipeline_state_init_graphics_msc(struct d3d12_pipeline_state *state,
         reason = "pixel shader stage";
     /* Mesh and amplification shaders are DXIL; vertex and pixel shaders may be DXBC too. */
     else if ((pre_raster == VK_SHADER_STAGE_VERTEX_BIT && !vkd3d_msc_shader_is_bridgeable(device, &desc->vs, &vs_flags)) ||
-            (pre_raster & VK_SHADER_STAGE_MESH_BIT_EXT && !vkd3d_msc_shader_is_dxil(&desc->ms)) ||
+            (pre_raster & VK_SHADER_STAGE_MESH_BIT_EXT && (!vkd3d_msc_shader_is_dxil(&desc->ms) || vkd3d_msc_writes_cull_distance(&desc->ms))) ||
             (pre_raster & VK_SHADER_STAGE_TASK_BIT_EXT && !vkd3d_msc_shader_is_dxil(&desc->as)) ||
             (desc->ps.BytecodeLength && !vkd3d_msc_shader_is_bridgeable(device, &desc->ps, &ps_flags)))
-        reason = "not DXIL, or DXBC that may read a three-component typed buffer";
+        reason = "not DXIL, DXBC that may read a three-component typed buffer, or writes SV_CullDistance";
     else if (graphics->xfb_buffer_count || graphics->cached_desc.xfb_info)
         reason = "stream output";
     else if (graphics->multiview.view_mask)
