From 7d92072033b76aae2589cf15cda890c5c564f372 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Mon, 2 Nov 2026 22:12:55 -0700
Subject: [PATCH 35/63] MetalSharp: WriteBufferImmediate's MARKER_IN writes are
 batched without buffer markers

With no VK_AMD_buffer_marker (MoltenVK), a MARKER_IN write flushed the batch, which ended the render pass instance
at every marker. It is now batched as a DEFAULT write, written when the pass ends or the batch fills, and the
batch holds 1024 writes (128 filled within a pass and ended it). D3D12 perf probe draw_markers (2500 draws between
5000 markers, as Starfield writes them).
---
 libs/vkd3d/command.c       | 6 +++++-
 libs/vkd3d/vkd3d_private.h | 3 ++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 8ad8970b..bbd190f5 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -20820,7 +20820,11 @@ static void STDMETHODCALLTYPE d3d12_command_list_WriteBufferImmediate(d3d12_comm
             list->wbi_batch.stages[batch_entry] = stage;
             list->wbi_batch.values[batch_entry] = parameters[i].Value;
 
-            if (mode == D3D12_WRITEBUFFERIMMEDIATE_MODE_MARKER_IN)
+            /* MetalSharp: with no buffer markers (MoltenVK), a MARKER_IN write is batched as a DEFAULT one, and
+             * written when the render pass instance ends or the batch fills: flushing it here ended the render
+             * pass at every marker (D3D12 perf probe draw_markers, 2500 marked draws: 186 ms of GPU time a
+             * frame). It is a breadcrumb that lands at the pass's end, not at the draw's start. */
+            if (mode == D3D12_WRITEBUFFERIMMEDIATE_MODE_MARKER_IN && list->device->vk_info.AMD_buffer_marker)
                 do_flush = true;
         }
         else
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 6d99b440..413bce33 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -3308,7 +3308,8 @@ struct d3d12_transfer_batch_state
     VkPipelineStageFlags2 shader_resource_execution_stages_are_idle;
 };
 
-#define VKD3D_MAX_WBI_BATCH_SIZE 128
+/* MetalSharp: 1024, not 128: a full batch inside a render pass instance ends it (draw_markers) */
+#define VKD3D_MAX_WBI_BATCH_SIZE 1024
 
 struct d3d12_wbi_batch_state
 {
