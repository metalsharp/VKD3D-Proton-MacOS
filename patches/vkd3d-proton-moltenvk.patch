+        WARN("Lacking transform-feedback behavior; stream output is disabled (VKMT).\n");
+        vulkan_info->EXT_transform_feedback = false;
+        memset(&physical_device_info->xfb_features, 0, sizeof(physical_device_info->xfb_features));
+        memset(&physical_device_info->xfb_properties, 0, sizeof(physical_device_info->xfb_properties));
+        vulkan_info->rasterization_stream = false;
     }
 
     single_storage_texel =
@@ -2516,8 +2521,18 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
 
     if (!single_storage_texel || !single_uniform_texel)
     {
-        ERR("Lacking support for single texel alignment.\n");
-        return E_INVALIDARG;
+        /* MoltenVK aligns texel buffer views to Metal's linear-texture alignment; the custom VKMT
+         * MoltenVK emulates unaligned views, which VKMT_ALLOW_NON_SINGLE_TEXEL_ALIGNMENT vouches for. */
+        char allow[8];
+        if (vkd3d_get_env_var("VKMT_ALLOW_NON_SINGLE_TEXEL_ALIGNMENT", allow, sizeof(allow)) && strcmp(allow, "0"))
+        {
+            WARN("Allowing non-single texel alignment (VKMT).\n");
+        }
+        else
+        {
+            ERR("Lacking support for single texel alignment.\n");
+            return E_INVALIDARG;
+        }
