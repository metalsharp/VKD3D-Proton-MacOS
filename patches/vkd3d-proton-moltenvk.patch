+    for (i = 0; i < barrier_count; i++)
+    {
+        switch (barriers[i].Type)
+        {
+            case D3D12_RESOURCE_BARRIER_TYPE_TRANSITION:
+                d3d12_command_list_block_upload_copy_resource(list,
