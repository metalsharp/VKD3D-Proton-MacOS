+static bool d3d12_pipeline_state_init_compute_msc(struct d3d12_pipeline_state *state,
+        struct d3d12_device *device, const D3D12_SHADER_BYTECODE *code)
+{
+    const struct vkd3d_shader_code dxbc = {code->pShaderBytecode, code->BytecodeLength};
+    const struct d3d12_root_signature *root_signature = state->root_signature;
+    uint64_t start_ns = vkd3d_get_current_time_ns();
+    const char *reason = NULL;
+    vkd3d_shader_hash_t hash;
+    HRESULT hr = S_OK;
+
+    hash = vkd3d_shader_hash(&dxbc);
