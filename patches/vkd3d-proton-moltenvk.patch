+/* A graphics PSO of a DXIL vertex shader and a DXIL pixel shader, and nothing that only SPIR-V pipelines can do,
+ * gets the converter's modules for both. Returns false, with nothing left behind, when it stays on SPIR-V. */
+bool d3d12_pipeline_state_init_graphics_msc(struct d3d12_pipeline_state *state,
+        const struct d3d12_pipeline_state_desc *desc)
+{
+    const struct vkd3d_shader_code vs_dxbc = {desc->vs.pShaderBytecode, desc->vs.BytecodeLength};
+    const struct vkd3d_shader_code ps_dxbc = {desc->ps.pShaderBytecode, desc->ps.BytecodeLength};
