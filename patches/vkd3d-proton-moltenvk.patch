@@ -2275,12 +2275,12 @@ static void dxgi_vk_swap_chain_recreate_swapchain_in_present_task(struct dxgi_vk
     swapchain_create_info.imageExtent.height = min(swapchain_create_info.imageExtent.height, surface_caps.maxImageExtent.height);
 
     /* MetalSharp: MetalFX spatial upscaling (vkd3d.conf). The swapchain keeps the back buffers' size, which MoltenVK
-     * upscales to the display's at present, instead of the window's, which the blit would stretch to. */
+     * upscales to the display's at present, instead of the window's, which the blit would stretch to. Wine reports
+     * the window's size as the smallest and largest extent, as Windows does, and takes a smaller one, which it
+     * presents scaled. */
     if (vkd3d_metalfx_spatial_requested() && vkd3d_metalfx_driver_has(chain->queue->device, VK_MVK_METALFX_DRIVER_INFO) &&
             chain->desc.Width <= swapchain_create_info.imageExtent.width &&
-            chain->desc.Height <= swapchain_create_info.imageExtent.height &&
