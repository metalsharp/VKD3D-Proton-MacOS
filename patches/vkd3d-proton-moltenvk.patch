+};
+
+/* vkd3d.conf: the file VKD3D_CONFIG_FILE names, else vkd3d.conf in the working directory, in dxvk.conf's form:
+ * "key = value" lines, those after a "[program.exe]" line for that program only. MetalSharp writes the same MetalFX
+ * lines there as in mullion.conf. Returns the value of the first key found (program lines over global ones). */
+static bool vkd3d_metalfx_conf_value(const char * const *keys, unsigned int key_count, char *value, size_t value_size)
+{
+    char path[VKD3D_PATH_MAX], program[VKD3D_PATH_MAX], line[512], found[2][128];
+    unsigned int best[2] = {~0u, ~0u}, scope = 0, i;
+    bool in_section = true;
+    char *key, *val, *end;
+    FILE *file;
+
+    if (!vkd3d_get_env_var("VKD3D_CONFIG_FILE", path, sizeof(path)) || !*path)
+        strcpy(path, "vkd3d.conf");
+    if (!(file = fopen(path, "r")))
+        return false;
+    if (!vkd3d_get_program_name(program))
+        program[0] = '\0';
+
+    /* scope 0: lines before any section, 1: lines of this program's section */
+    while (fgets(line, sizeof(line), file))
+    {
+        for (key = line; *key == ' ' || *key == '\t'; key++);
+        for (end = key + strlen(key); end > key && strchr("\r\n \t", end[-1]); end--);
+        *end = '\0';
+        if (!*key || *key == '#')
+            continue;
+        if (*key == '[')
+        {
+            if (end > key + 1 && end[-1] == ']')
+                end[-1] = '\0';
+            in_section = program[0] && !strcasecmp(key + 1, program);
+            scope = 1;
+            continue;
+        }
+        if (!in_section || !(val = strchr(key, '=')))
+            continue;
+        for (end = val; end > key && (end[-1] == ' ' || end[-1] == '\t'); end--);
+        *end = '\0';
+        for (val++; *val == ' ' || *val == '\t'; val++);
+        if (*val == '"' && strlen(val) >= 2 && val[strlen(val) - 1] == '"')
+        {
+            val[strlen(val) - 1] = '\0';
+            val++;
+        }
+        for (i = 0; i < key_count && i < best[scope]; i++)
+        {
+            if (!strcmp(key, keys[i]))
+            {
+                best[scope] = i;
+                vkd3d_strlcpy(found[scope], sizeof(found[scope]), val);
+                break;
+            }
+        }
+    }
+    fclose(file);
+
+    for (scope = 2; scope-- > 0;)
+    {
+        if (best[scope] != ~0u)
+        {
+            vkd3d_strlcpy(value, value_size, found[scope]);
+            return true;
+        }
+    }
+    return false;
+}
+
+/* MetalFX spatial upscaling of the swapchain to the display (d3d12.metalSpatialUpscale, or d3d11's, in vkd3d.conf) */
+bool vkd3d_metalfx_spatial_requested(void)
+{
+    static const char * const keys[] = {"d3d12.metalSpatialUpscale", "d3d11.metalSpatialUpscale"};
+    static int requested = -1;
+    char value[32];
+
+    if (requested < 0)
+    {
+        requested = vkd3d_metalfx_conf_value(keys, ARRAY_SIZE(keys), value, sizeof(value)) &&
+                (!strcasecmp(value, "true") || !strcmp(value, "1") || !strcasecmp(value, "yes"));
+        if (requested)
+            INFO("MetalFX spatial upscaling requested by vkd3d.conf.\n");
+    }
+    return requested;
+}
