index ea779aa9..9c6839ea 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -2525,12 +2525,14 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
 
     if (!single_storage_texel || !single_uniform_texel)
