+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __VKD3D_METALFX_H
+#define __VKD3D_METALFX_H
+
+#include "mvk_metalfx.h"
+
+typedef struct MTL_TEMPORAL_UPSCALE_D3D12_DESC
+{
+    UINT InputContentWidth;  /* 0: the color's width */
+    UINT InputContentHeight; /* 0: the color's height */
+    BOOL AutoExposure;
+    BOOL InReset;
+    BOOL DepthReversed;
+    BOOL MotionVectorInDisplayRes;
+    ID3D12Resource *Color;
+    ID3D12Resource *Depth;
+    ID3D12Resource *MotionVector;
+    ID3D12Resource *Output;
+    ID3D12Resource *ExposureTexture; /* optional */
+    FLOAT MotionVectorScaleX;
+    FLOAT MotionVectorScaleY;
+    FLOAT PreExposure;
+    FLOAT JitterOffsetX;
+    FLOAT JitterOffsetY;
+} MTL_TEMPORAL_UPSCALE_D3D12_DESC;
+
+typedef struct MTL_DENOISED_UPSCALE_D3D12_DESC
+{
+    BOOL AutoExposure;
+    BOOL InReset;
+    BOOL DepthReversed;
+    BOOL RoughnessInNormalAlpha; /* roughness is the normals' alpha (DLSS.Roughness.Mode packed) */
+    ID3D12Resource *Color;
+    ID3D12Resource *Depth;
+    ID3D12Resource *MotionVector;
+    ID3D12Resource *DiffuseAlbedo;
+    ID3D12Resource *SpecularAlbedo;
+    ID3D12Resource *Normals;
+    ID3D12Resource *Roughness;           /* unused when RoughnessInNormalAlpha */
+    ID3D12Resource *SpecularHitDistance; /* optional */
+    ID3D12Resource *ExposureTexture;     /* optional */
+    ID3D12Resource *Output;
+    FLOAT MotionVectorScaleX;
+    FLOAT MotionVectorScaleY;
+    FLOAT PreExposure;
+    FLOAT JitterOffsetX;
+    FLOAT JitterOffsetY;
+    /* row-major, of row vectors (D3D's) */
+    FLOAT WorldToView[16];
+    FLOAT ViewToClip[16];
+} MTL_DENOISED_UPSCALE_D3D12_DESC;
+
+/* A feature's scaler (a C++ class with one virtual method in Mullion), which its owner destroys when done with it. */
+typedef struct IMTLD3D12Upscaler IMTLD3D12Upscaler;
+
+typedef struct IMTLD3D12UpscalerVtbl
+{
+    void (STDMETHODCALLTYPE *Destroy)(IMTLD3D12Upscaler *This);
+} IMTLD3D12UpscalerVtbl;
+
+struct IMTLD3D12Upscaler
+{
+    const IMTLD3D12UpscalerVtbl *lpVtbl;
+};
+
+typedef struct IMTLD3D12CommandListExt IMTLD3D12CommandListExt;
+
+typedef struct IMTLD3D12CommandListExtVtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)(IMTLD3D12CommandListExt *This, REFIID riid, void **object);
+    ULONG (STDMETHODCALLTYPE *AddRef)(IMTLD3D12CommandListExt *This);
+    ULONG (STDMETHODCALLTYPE *Release)(IMTLD3D12CommandListExt *This);
+    BOOL (STDMETHODCALLTYPE *SupportsTemporalUpscale)(IMTLD3D12CommandListExt *This);
+    BOOL (STDMETHODCALLTYPE *SupportsDenoisedUpscale)(IMTLD3D12CommandListExt *This);
+    /* *upscaler is a feature's scaler, made at its first upscale */
+    HRESULT (STDMETHODCALLTYPE *TemporalUpscale)(IMTLD3D12CommandListExt *This,
+            const MTL_TEMPORAL_UPSCALE_D3D12_DESC *desc, IMTLD3D12Upscaler **upscaler);
+    HRESULT (STDMETHODCALLTYPE *DenoisedUpscale)(IMTLD3D12CommandListExt *This,
+            const MTL_DENOISED_UPSCALE_D3D12_DESC *desc, IMTLD3D12Upscaler **upscaler);
+} IMTLD3D12CommandListExtVtbl;
+
+struct IMTLD3D12CommandListExt
+{
+    const IMTLD3D12CommandListExtVtbl *lpVtbl;
+};
