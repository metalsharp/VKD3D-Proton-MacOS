     else if (graphics->multiview.view_mask)
         reason = "view instancing";
-    /* MoltenVK emulates the depth bounds test in the fragment shader, which a converted one can't do. */
-    else if (graphics->ds_desc.depthBoundsTestEnable)
-        reason = "depth bounds test";
+    /* Metal has a depth bounds test on Apple10 GPUs with macOS 26, which MoltenVK uses; elsewhere it emulates the
+     * test in the fragment shader, which a converted one can't do, and fails the bridge pipeline. The first such
+     * failure keeps later depth bounds PSOs from trying (d3d12_pipeline_state_init_graphics). */
+    else if (graphics->ds_desc.depthBoundsTestEnable &&
+            vkd3d_atomic_uint32_load_explicit(&device->msc.depth_bounds_emulated, vkd3d_memory_order_relaxed))
+        reason = "depth bounds test (emulated by MoltenVK on this GPU)";
     /* As it does logic operations (reading the target in the fragment shader) and conservative rasterization. */
     else if (desc->blend_state.RenderTarget[0].LogicOpEnable)
