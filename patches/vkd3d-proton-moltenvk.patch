new file mode 100644
index 00000000..3ea66522
--- /dev/null
+++ b/libs/vkd3d/stall_report.c
@@ -0,0 +1,180 @@
+/*
+ * Copyright 2026 Avery Felts
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* MetalSharp: the stall report (METALSHARP_TRACE=sync). A game that stops before a frame, or between two, is usually
+ * waiting on a fence value nothing will signal: a thread waiting through SetEventOnCompletion, or a queue whose Wait
+ * comes before the Signal it waits for. When no Present has come for VKD3D_STALL_SECONDS, a watchdog thread writes
+ * each fence somebody waits on: the value it is at, the values the waits want and for how long, the signals queued
+ * for it on the GPU, and the queues blocked on it. It reports again every VKD3D_STALL_REPEAT_SECONDS of the same
+ * stall, so a wait that moves shows. */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#include "vkd3d_private.h"
+
+#define VKD3D_STALL_SECONDS 5
+#define VKD3D_STALL_REPEAT_SECONDS 15
+
+static double vkd3d_stall_seconds_since(uint64_t now, uint64_t then)
+{
+    return then && now > then ? (double)(now - then) / 1.0e9 : 0.0;
+}
+
+static void vkd3d_stall_report_write(struct vkd3d_stall_report *report, uint64_t now, uint64_t since)
+{
+    unsigned int waiting = 0;
+    size_t i, j;
+
+    VKD3D_MS_TRACE(SYNC, "stall: %s for %.1f s; the fences that are waited on follow.",
+            vkd3d_atomic_uint64_load_explicit(&report->last_present_ns, vkd3d_memory_order_relaxed) ?
+            "no Present" : "no first Present since the device was created", vkd3d_stall_seconds_since(now, since));
+
+    for (i = 0; i < report->fence_count; i++)
+    {
+        struct d3d12_fence *fence = report->fences[i];
+        unsigned int fence_waits = 0;
+
+        pthread_mutex_lock(&fence->mutex);
+        for (j = 0; j < fence->event_count; j++)
+        {
+            const struct vkd3d_waiting_event *event = &fence->events[j];
+
+            if (event->value <= fence->virtual_value)
+                continue;
+            if (!fence_waits++)
+                VKD3D_MS_TRACE(SYNC, "stall: fence %p is at %"PRIu64", with GPU signals queued up to %"PRIu64
+                        " (%zu in flight):", fence, fence->virtual_value, fence->max_pending_virtual_timeline_value,
+                        fence->pending_updates_count);
+            VKD3D_MS_TRACE(SYNC, "stall:   %s waits for %"PRIu64", for %.1f s%s.",
+                    vkd3d_native_sync_handle_is_valid(event->handle) ? "an event" : "a thread (SetEventOnCompletion "
+                    "with no event)", event->value, vkd3d_stall_seconds_since(now, event->trace_since_ns),
+                    event->value > fence->max_pending_virtual_timeline_value ? ", which no queued signal reaches" : "");
+        }
+        if (fence->trace_blocked_queues)
+        {
+            if (!fence_waits++)
+                VKD3D_MS_TRACE(SYNC, "stall: fence %p is at %"PRIu64", with GPU signals queued up to %"PRIu64
+                        " (%zu in flight):", fence, fence->virtual_value, fence->max_pending_virtual_timeline_value,
+                        fence->pending_updates_count);
+            VKD3D_MS_TRACE(SYNC, "stall:   %u queue(s) blocked on a Wait for %"PRIu64" (queue %p the last), for %.1f s: "
+                    "the Signal it waits for has not been submitted.", fence->trace_blocked_queues,
+                    fence->trace_blocked_value, fence->trace_blocked_queue,
+                    vkd3d_stall_seconds_since(now, fence->trace_blocked_since_ns));
+        }
+        pthread_mutex_unlock(&fence->mutex);
+        waiting += !!fence_waits;
+    }
+
+    VKD3D_MS_TRACE(SYNC, "stall: %u of %zu fences waited on.", waiting, report->fence_count);
+}
+
+static void *vkd3d_stall_report_main(void *userdata)
+{
+    struct vkd3d_stall_report *report = userdata;
+    uint64_t last_report_ns = 0;
+
+    vkd3d_set_thread_name("vkd3d-stall");
+    pthread_mutex_lock(&report->mutex);
+    while (!report->stop)
+    {
+        uint64_t now = vkd3d_get_current_time_ns(), since;
+
+        since = vkd3d_atomic_uint64_load_explicit(&report->last_present_ns, vkd3d_memory_order_relaxed);
+        if (!since)
+            since = report->created_ns;
+        if (vkd3d_stall_seconds_since(now, since) >= VKD3D_STALL_SECONDS &&
+                (last_report_ns < since || vkd3d_stall_seconds_since(now, last_report_ns) >= VKD3D_STALL_REPEAT_SECONDS))
+        {
+            vkd3d_stall_report_write(report, now, since);
+            last_report_ns = now;
+        }
+        condvar_reltime_wait_timeout_seconds(&report->cond, &report->mutex, 1);
+    }
+    pthread_mutex_unlock(&report->mutex);
+    return NULL;
+}
+
+void vkd3d_stall_report_init(struct vkd3d_stall_report *report)
+{
+    memset(report, 0, sizeof(*report));
+    if (!VKD3D_MS_TRACE_ON(SYNC))
+        return;
+    pthread_mutex_init(&report->mutex, NULL);
+    condvar_reltime_init(&report->cond);
+    report->created_ns = vkd3d_get_current_time_ns();
+    report->enabled = true;
+    if (pthread_create(&report->thread, NULL, vkd3d_stall_report_main, report))
+    {
+        ERR("Failed to start the stall report thread.\n");
+        report->enabled = false;
+        condvar_reltime_destroy(&report->cond);
+        pthread_mutex_destroy(&report->mutex);
+        return;
+    }
+    VKD3D_MS_TRACE(SYNC, "stall: a report follows when no Present comes for %u s.", VKD3D_STALL_SECONDS);
+}
+
+void vkd3d_stall_report_cleanup(struct vkd3d_stall_report *report)
+{
+    if (!report->enabled)
+        return;
+    pthread_mutex_lock(&report->mutex);
+    report->stop = true;
+    condvar_reltime_signal(&report->cond);
+    pthread_mutex_unlock(&report->mutex);
+    pthread_join(report->thread, NULL);
+    condvar_reltime_destroy(&report->cond);
+    pthread_mutex_destroy(&report->mutex);
+    vkd3d_free(report->fences);
+    report->enabled = false;
+}
+
+void vkd3d_stall_report_add_fence(struct vkd3d_stall_report *report, struct d3d12_fence *fence)
+{
+    if (!report->enabled)
+        return;
+    pthread_mutex_lock(&report->mutex);
+    if (vkd3d_array_reserve((void **)&report->fences, &report->fences_size, report->fence_count + 1,
+            sizeof(*report->fences)))
+        report->fences[report->fence_count++] = fence;
+    pthread_mutex_unlock(&report->mutex);
+}
+
+void vkd3d_stall_report_remove_fence(struct vkd3d_stall_report *report, struct d3d12_fence *fence)
+{
+    size_t i;
+
+    if (!report->enabled)
+        return;
+    pthread_mutex_lock(&report->mutex);
+    for (i = 0; i < report->fence_count; i++)
+    {
+        if (report->fences[i] == fence)
+        {
+            report->fences[i] = report->fences[--report->fence_count];
+            break;
+        }
+    }
+    pthread_mutex_unlock(&report->mutex);
+}
+
+void vkd3d_stall_report_present(struct vkd3d_stall_report *report)
+{
+    if (report->enabled)
+        vkd3d_atomic_uint64_store_explicit(&report->last_present_ns, vkd3d_get_current_time_ns(),
+                vkd3d_memory_order_relaxed);
+}
