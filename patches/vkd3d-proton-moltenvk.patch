D3D12 perf probe 'barriers' (1000 transitions between 500 draws): 31.4 -> 0.3 ms CPU, 37.9 -> 0.4 ms GPU.
---
 libs/vkd3d/command.c | 60 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 373cd989..b0aec561 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -13948,6 +13948,64 @@ static bool d3d12_command_list_check_resource_barrier_trivial_copy_resource(
     return true;
