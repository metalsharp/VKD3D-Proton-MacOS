+    {
+        memcpy(&chunk_offset, data + 32 + i * sizeof(uint32_t), sizeof(chunk_offset));
+        if (chunk_offset > size - 8 || memcmp(data + chunk_offset, fourcc, 4))
+            continue;
+        memcpy(&length, data + chunk_offset + 4, sizeof(length));
+        if (length > size - chunk_offset - 8)
+            return 0;
+        *chunk_size = length;
+        return chunk_offset + 8;
+    }
+    return 0;
