From 7bbaeba36be3209faa8d6d735a23d9edf38cde2d Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 23 Oct 2026 16:36:29 -0600
Subject: [PATCH 02/63] Keep the transform feedback structures linked when
 stream output is disabled

Zeroing them cleared their sType and pNext while they were in the feature and property chains
the device is created with, which dropped every structure after them (robustness2 included).
---
 libs/vkd3d/device.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 8334e3b1..836a7441 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -2505,8 +2505,12 @@ static HRESULT vkd3d_init_device_caps(struct d3d12_device *device,
          * stream output and its queries are turned off instead of failing device creation. */
         WARN("Lacking transform-feedback behavior; stream output is disabled (VKMT).\n");
         vulkan_info->EXT_transform_feedback = false;
-        memset(&physical_device_info->xfb_features, 0, sizeof(physical_device_info->xfb_features));
-        memset(&physical_device_info->xfb_properties, 0, sizeof(physical_device_info->xfb_properties));
+        /* The structures stay linked into the feature and property chains (which the device is
+         * created with), so only their values are cleared. */
+        physical_device_info->xfb_features.transformFeedback = VK_FALSE;
+        physical_device_info->xfb_features.geometryStreams = VK_FALSE;
+        memset((char *)&physical_device_info->xfb_properties + offsetof(VkPhysicalDeviceTransformFeedbackPropertiesEXT, maxTransformFeedbackStreams),
+                0, sizeof(physical_device_info->xfb_properties) - offsetof(VkPhysicalDeviceTransformFeedbackPropertiesEXT, maxTransformFeedbackStreams));
         vulkan_info->rasterization_stream = false;
     }
 
-- 
