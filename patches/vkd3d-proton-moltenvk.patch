index db86de8b..1b18ea3d 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -18495,6 +18495,16 @@ static void STDMETHODCALLTYPE d3d12_command_list_SetPredication(d3d12_command_li
                 sizeof(uint32_t), sizeof(uint32_t), ~0u, &scratch))
             return;
 
+        /* Without conditional rendering, every predicated draw and dispatch is patched by a compute shader.
+         * After an INDIRECT_ARGUMENT barrier (PREDICATION is the same state: the predicate was just written,
+         * typically by ResolveQueryData) that patching can't be hoisted, and each predicated draw ends the render
+         * pass around its patch: on MoltenVK, a Metal render and compute encoder per draw (about 30 us each).
+         * A new sequence hoists it again: its patch command buffer runs after everything recorded so far. */
