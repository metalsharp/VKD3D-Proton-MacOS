+static void d3d12_command_list_track_upload_copy_hoist_barriers(struct d3d12_command_list *list,
+        UINT barrier_count, const D3D12_RESOURCE_BARRIER *barriers)
+{
+    UINT i;
+
+    if (list->upload_copy_hoist.disabled)
+        return;
