+    if (packed_mask && d3d_input->start_row < 32 && (packed_mask & (1u << d3d_input->start_row)))
+    {
+        /* Input layout elements are one row each; a multi-row input (a matrix) spans one element per row. */
+        if (d3d_input->rows != 1)
+        {
+            FIXME("Packed R10G10B10A2_UINT vertex input %s%u spans %u rows.\n",
+                    d3d_input->semantic, d3d_input->semantic_index, d3d_input->rows);
