+        reason = "not DXIL";
+    else if (!(state->compute.msc_dxil = vkd3d_malloc(code->BytecodeLength)))
+        reason = "out of memory";
+    else if (FAILED(hr = vkd3d_msc_create_compute_pipeline(device, root_signature, code,
+            &state->compute.vk_pipeline)))
