From 306ffc8c42b05f348010deb3910aba55f9383650 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Wed, 28 Oct 2026 00:30:05 -0600
Subject: [PATCH 31/37] Metal Shader Converter bridge: a null descriptor's
 shadow heap entry is a zeroed 64 KiB buffer and a 1x1 zeroed texture made
 with the device, not address 0 and resource ID 0; heaps start out filled with
 it. A converted shader reading a null or never-written descriptor (D3D12
 gives zeros) read address 0 or texture 0 instead, which shows as black and
 flickering surfaces or a GPU fault (Dragon's Dogma 2)

---
 libs/vkd3d/device.c        |   1 +
 libs/vkd3d/msc_bridge.c    | 139 +++++++++++++++++++++++++++++++++++++
 libs/vkd3d/resource.c      |   4 +-
 libs/vkd3d/vkd3d_private.h |  12 ++++
 4 files changed, 154 insertions(+), 2 deletions(-)

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 718482b8..f6175393 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -3944,6 +3944,7 @@ static void d3d12_device_destroy(struct d3d12_device *device)
         VK_CALL(vkDestroyCommandPool(device->vk_device, device->cached_command_allocators[i].vk_command_pool, NULL));
 
     vkd3d_free(device->descriptor_heap_gpu_vas);
+    vkd3d_msc_bridge_cleanup(device);
 
     vkd3d_private_store_destroy(&device->private_store);
 
diff --git a/libs/vkd3d/msc_bridge.c b/libs/vkd3d/msc_bridge.c
index 948cd98f..81d02ab1 100644
--- a/libs/vkd3d/msc_bridge.c
+++ b/libs/vkd3d/msc_bridge.c
@@ -69,6 +69,130 @@ bool vkd3d_msc_requested(void)
     return !vkd3d_get_env_var("METALSHARP_MSC", value, sizeof(value)) || strcmp(value, "0");
 }
 
+/* A null descriptor's shadow entry. The converter has no null entry: a texture entry is the texture's Metal resource
+ * ID, and a buffer entry its address and length, so zeros make a shader that reads a null SRV or UAV use resource ID 0
+ * and address 0, which faults the GPU (Dragon's Dogma 2's bindless SpeedTree passes hung the GPU and drew black).
+ * D3D12 reads zeros from null descriptors, whatever type a game wrote them as: the entry holds both a 64 KiB buffer of
+ * zeros, with its length, and a 1x1 texture of zeros. */
+#define VKD3D_MSC_NULL_BUFFER_SIZE 65536u
+
+static void vkd3d_msc_create_null_entry(struct d3d12_device *device)
+{
+    const VkMemoryPropertyFlags host = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkImageViewCreateInfo view_info;
+    VkImageViewHandleInfoNVX handle;
+    VkMemoryRequirements requirements;
+    VkBindImageMemoryInfo bind;
+    VkImageCreateInfo image_info;
+    void *mapped;
+
+    if (FAILED(vkd3d_create_buffer_explicit_usage(device,
+            VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+            VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT, VKD3D_MSC_NULL_BUFFER_SIZE, "msc-null-buffer", &device->msc.null_buffer)) ||
+            FAILED(vkd3d_allocate_internal_buffer_memory(device, device->msc.null_buffer, host, 0,
+            &device->msc.null_buffer_allocation)) ||
+            VK_CALL(vkMapMemory(device->vk_device, device->msc.null_buffer_allocation.vk_memory, 0, VK_WHOLE_SIZE, 0,
+            &mapped)))
+    {
+        ERR("Metal Shader Converter bridge: failed to make the null buffer; null descriptors stay zero.\n");
+        return;
+    }
+    memset(mapped, 0, VKD3D_MSC_NULL_BUFFER_SIZE);
+    device->msc.null_entry.gpu_va = vkd3d_get_buffer_device_address(device, device->msc.null_buffer);
+    device->msc.null_entry.metadata = vkd3d_msc_buffer_metadata(VKD3D_MSC_NULL_BUFFER_SIZE, 0, false);
+
+    /* Linear and host visible, so it is cleared without a command buffer. */
+    memset(&image_info, 0, sizeof(image_info));
+    image_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+    image_info.imageType = VK_IMAGE_TYPE_2D;
+    image_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+    image_info.extent.width = 1;
+    image_info.extent.height = 1;
+    image_info.extent.depth = 1;
+    image_info.mipLevels = 1;
+    image_info.arrayLayers = 1;
+    image_info.samples = VK_SAMPLE_COUNT_1_BIT;
+    image_info.tiling = VK_IMAGE_TILING_LINEAR;
+    image_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+    image_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    image_info.initialLayout = VK_IMAGE_LAYOUT_PREINITIALIZED;
+    if (VK_CALL(vkCreateImage(device->vk_device, &image_info, NULL, &device->msc.null_image)))
+    {
+        ERR("Metal Shader Converter bridge: failed to make the null texture; null textures stay zero.\n");
+        return;
+    }
+    VK_CALL(vkGetImageMemoryRequirements(device->vk_device, device->msc.null_image, &requirements));
+    if (SUCCEEDED(vkd3d_allocate_device_memory(device, requirements.size, host, requirements.memoryTypeBits, NULL,
+            false, &device->msc.null_image_allocation)))
+    {
+        bind.sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO;
+        bind.pNext = NULL;
+        bind.image = device->msc.null_image;
+        bind.memory = device->msc.null_image_allocation.vk_memory;
+        bind.memoryOffset = 0;
+    }
+    if (!device->msc.null_image_allocation.vk_memory ||
+            VK_CALL(vkBindImageMemory2(device->vk_device, 1, &bind)) ||
+            VK_CALL(vkMapMemory(device->vk_device, device->msc.null_image_allocation.vk_memory, 0, VK_WHOLE_SIZE, 0,
+            &mapped)))
+    {
+        ERR("Metal Shader Converter bridge: failed to back the null texture; null textures stay zero.\n");
+        return;
+    }
+    memset(mapped, 0, requirements.size);
+
+    memset(&view_info, 0, sizeof(view_info));
+    view_info.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+    view_info.image = device->msc.null_image;
+    view_info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    view_info.format = VK_FORMAT_R8G8B8A8_UNORM;
+    view_info.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    view_info.subresourceRange.levelCount = 1;
+    view_info.subresourceRange.layerCount = 1;
+    if (VK_CALL(vkCreateImageView(device->vk_device, &view_info, NULL, &device->msc.null_image_view)))
+    {
+        ERR("Metal Shader Converter bridge: failed to view the null texture; null textures stay zero.\n");
+        return;
+    }
+
+    handle.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_HANDLE_INFO_NVX;
+    handle.pNext = NULL;
+    handle.imageView = device->msc.null_image_view;
+    handle.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    handle.sampler = VK_NULL_HANDLE;
+    device->msc.null_entry.texture_view_id = VK_CALL(vkGetImageViewHandle64NVX(device->vk_device, &handle));
+    INFO("Metal Shader Converter bridge: null descriptors read a zero buffer at %#"PRIx64" and texture %#"PRIx64".\n",
+            device->msc.null_entry.gpu_va, device->msc.null_entry.texture_view_id);
+}
+
+void vkd3d_msc_bridge_cleanup(struct d3d12_device *device)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+
+    if (device->msc.null_image_view)
+        VK_CALL(vkDestroyImageView(device->vk_device, device->msc.null_image_view, NULL));
+    if (device->msc.null_image)
+        VK_CALL(vkDestroyImage(device->vk_device, device->msc.null_image, NULL));
+    if (device->msc.null_image_allocation.vk_memory)
+        vkd3d_free_device_memory(device, &device->msc.null_image_allocation);
+    if (device->msc.null_buffer)
+        VK_CALL(vkDestroyBuffer(device->vk_device, device->msc.null_buffer, NULL));
+    if (device->msc.null_buffer_allocation.vk_memory)
+        vkd3d_free_device_memory(device, &device->msc.null_buffer_allocation);
+}
+
+void d3d12_desc_msc_write_null(const struct d3d12_desc_split *d)
+{
+    const struct vkd3d_msc_descriptor *null_entry;
+
+    if (VKD3D_EXPECT_TRUE(!d->heap->msc.entries))
+        return;
+
+    null_entry = &d->heap->device->msc.null_entry;
+    d3d12_desc_msc_write(d, null_entry->gpu_va, null_entry->texture_view_id, null_entry->metadata);
+}
+
 void vkd3d_msc_bridge_init(struct d3d12_device *device)
 {
     char value[16];
@@ -100,6 +224,7 @@ void vkd3d_msc_bridge_init(struct d3d12_device *device)
 
     device->msc.enabled = true;
     device->msc.graphics = !vkd3d_get_env_var("METALSHARP_MSC", value, sizeof(value)) || strcmp(value, "compute");
+    vkd3d_msc_create_null_entry(device);
