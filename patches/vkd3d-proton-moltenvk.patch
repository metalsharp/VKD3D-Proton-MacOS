+        VKD3D_MS_TRACE(SHADER, "MSC bridge: vs %016"PRIx64" ps %016"PRIx64" -> SPIR-V (%s, hr %#x).",
+                vkd3d_shader_hash(&vs_dxbc), vkd3d_shader_hash(&ps_dxbc), reason, (int)hr);
