+    INFO("Compute PSO cs %016"PRIx64": Metal Shader Converter (%.2f ms).\n",
+            hash, (double)(vkd3d_get_current_time_ns() - start_ns) / 1.0e6);
+    VKD3D_MS_TRACE(SHADER, "MSC bridge: cs %016"PRIx64" -> Metal Shader Converter, %.2f ms.",
