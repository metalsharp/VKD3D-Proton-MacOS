+/* The converter's modules have no binding for acceleration structures: an RTAS SRV gets no handle, and a shader
+ * that runs ray queries against it traverses nothing valid (the GPU stalls). Those keep VKD3D-Proton's SPIR-V, whose
+ * ray queries use the device's acceleration structures. The SPIR-V declares RayQueryKHR when the DXIL uses them. */
+bool vkd3d_msc_spirv_uses_ray_query(const struct vkd3d_shader_code *code)
+{
+    size_t spirv_words = code->size / sizeof(uint32_t);
+    const uint32_t *spirv = code->code;
+    size_t offset = 5;
+
+    if (!spirv)
+        return false;
+
+    /* OpCapability instructions come first in a module. */
+    while (offset < spirv_words)
+    {
