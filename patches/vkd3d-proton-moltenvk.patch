+                !vulkan_info->EXT_descriptor_buffer)
+        {
+            INFO("Typed buffer views are aligned through the typed offset buffer.\n");
         }
         else
         {
diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index a8fc26b1..bf474e86 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -6372,6 +6372,18 @@ static bool vkd3d_buffer_view_get_aligned_view(
             end_range = (first_element + num_elements + element_align - 1) & ~(element_align - 1);
             end_range = min(end_range, max_resource_elements);
 
+            /* Without single texel alignment (MoltenVK: 16 bytes), the view must also start at an
+             * aligned byte offset; if quantizing did not get there, start the view at 0 instead. */
+            if (!device->device_info.vulkan_1_3_properties.storageTexelBufferOffsetSingleTexelAlignment ||
+                    !device->device_info.vulkan_1_3_properties.uniformTexelBufferOffsetSingleTexelAlignment)
+            {
+                VkDeviceSize byte_count = format ? vkd3d_get_format(device, format, false)->byte_count : sizeof(uint32_t);
+                VkDeviceSize align = max(device->device_info.vulkan_1_3_properties.storageTexelBufferOffsetAlignmentBytes,
