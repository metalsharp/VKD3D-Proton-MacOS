+    root_signature->msc.minmax_static_samplers = false;
+    for (i = 0; i < desc->NumStaticSamplers; i++)
+    {
+        D3D12_FILTER_REDUCTION_TYPE reduction = D3D12_DECODE_FILTER_REDUCTION(desc->pStaticSamplers[i].Filter);
+        if (reduction == D3D12_FILTER_REDUCTION_TYPE_MINIMUM || reduction == D3D12_FILTER_REDUCTION_TYPE_MAXIMUM)
