From fd83df895d5162f615925c7a37feaeee5496a768 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Mon, 26 Oct 2026 20:17:21 -0600
Subject: [PATCH 15/37] swapchain: report the device's feature level in the
 Metal HUD, through winemetal.dll

---
 libs/vkd3d/swapchain.c | 56 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/libs/vkd3d/swapchain.c b/libs/vkd3d/swapchain.c
index 382c7b4d..8401a239 100644
--- a/libs/vkd3d/swapchain.c
+++ b/libs/vkd3d/swapchain.c
@@ -3905,6 +3905,58 @@ static HRESULT dxgi_vk_swap_chain_init_frame_rate_limiter(struct dxgi_vk_swap_ch
     return hr;
 }
 
+#if defined(_WIN32)
+static const char *dxgi_vk_feature_level_name(D3D_FEATURE_LEVEL level)
+{
+    switch (level)
+    {
+        case D3D_FEATURE_LEVEL_11_0: return "11_0";
+        case D3D_FEATURE_LEVEL_11_1: return "11_1";
+        case D3D_FEATURE_LEVEL_12_0: return "12_0";
+        case D3D_FEATURE_LEVEL_12_1: return "12_1";
+        case D3D_FEATURE_LEVEL_12_2: return "12_2";
+        default: return "UNKNOWN";
+    }
+}
+
+/* The Metal HUD heading Mullion shows, through Mullion's winemetal.dll (ARM64X, so x86_64 programs load it too):
+ * the device's highest feature level, which is 12_2 only with MoltenVK's ray tracing. */
+static void dxgi_vk_swap_chain_report_hud(struct d3d12_device *device)
+{
+    static LONG reported;
+    uint64_t (*string_alloc_init)(const char *data, unsigned int encoding);
+    void (*hud_update_label)(uint64_t hud, uint64_t label, uint64_t value);
+    bool (*hud_add_label)(uint64_t hud, uint64_t label, uint64_t after);
+    void (*object_release)(uint64_t object);
+    uint64_t (*hud_instance)(void);
+    uint64_t hud, label, after, value;
+    HMODULE winemetal;
+    char text[96];
+
+    if (InterlockedCompareExchange(&reported, 1, 0) || !(winemetal = LoadLibraryA("winemetal.dll")))
+        return;
+    string_alloc_init = (void *)GetProcAddress(winemetal, "NSString_alloc_init");
+    hud_update_label = (void *)GetProcAddress(winemetal, "DeveloperHUDProperties_updateLabel");
+    hud_add_label = (void *)GetProcAddress(winemetal, "DeveloperHUDProperties_addLabel");
+    object_release = (void *)GetProcAddress(winemetal, "NSObject_release");
+    hud_instance = (void *)GetProcAddress(winemetal, "DeveloperHUDProperties_instance");
+    if (!string_alloc_init || !hud_update_label || !hud_add_label || !object_release || !hud_instance ||
+            !(hud = hud_instance()))
+        return;
+
+    /* 4 is NSUTF8StringEncoding; the HUD keeps the label for the life of the process. */
+    snprintf(text, sizeof(text), "VKD3D-Proton D3D12 FL_%s %s",
+            dxgi_vk_feature_level_name(device->d3d12_caps.max_feature_level), vkd3d_version);
+    label = string_alloc_init("com.github.metalsharp.vkd3d-proton-version", 4);
+    after = string_alloc_init("com.apple.hud-graph.default", 4);
+    value = string_alloc_init(text, 4);
+    hud_add_label(hud, label, after);
+    hud_update_label(hud, label, value);
+    object_release(after);
+    object_release(value);
+}
+#endif
+
