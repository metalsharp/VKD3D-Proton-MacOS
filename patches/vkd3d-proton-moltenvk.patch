+         * ExecuteIndirect with a state template uses up front, instead of on its first such call. */
+        if (root_signature)
+            vkd3d_atomic_uint32_store_explicit(&root_signature->msc.state_templates, 1, vkd3d_memory_order_relaxed);
     }
