+#define VKD3D_UPLOAD_COPY_HOIST_MAX_RANGES 256
+
+static bool d3d12_device_hoists_upload_copies(const struct d3d12_device *device)
+{
+    if (VKD3D_CONFIG_FLAG_IS_SET(NO_HOIST_UPLOAD_COPIES))
+        return false;
+    return VKD3D_CONFIG_FLAG_IS_SET(HOIST_UPLOAD_COPIES) ||
+            device->device_info.vulkan_1_2_properties.driverID == VK_DRIVER_ID_MOLTENVK;
+}
+
+static bool d3d12_buffer_ranges_overlap(const struct d3d12_buffer_range *ranges, size_t count,
+        VkBuffer vk_buffer, VkDeviceSize begin, VkDeviceSize end)
+{
+    size_t i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (ranges[i].vk_buffer == vk_buffer && begin < ranges[i].end && end > ranges[i].begin)
+            return true;
+    }
+    return false;
+}
+
+static void d3d12_command_list_add_upload_copy_hoist_range(struct d3d12_command_list *list,
+        struct d3d12_buffer_range **ranges, size_t *ranges_size, size_t *count,
+        VkBuffer vk_buffer, VkDeviceSize begin, VkDeviceSize end)
+{
+    struct d3d12_upload_copy_hoist *hoist = &list->upload_copy_hoist;
+    struct d3d12_buffer_range *last;
+
+    if (hoist->disabled)
+        return;
+
+    /* Grow the last range for sequential patterns, e.g. one copy per object into one buffer. */
+    if (*count)
+    {
+        last = &(*ranges)[*count - 1];
+        if (last->vk_buffer == vk_buffer && begin <= last->end && end >= last->begin)
+        {
+            last->begin = min(last->begin, begin);
+            last->end = max(last->end, end);
+            return;
+        }
+    }
+
+    if (*count == VKD3D_UPLOAD_COPY_HOIST_MAX_RANGES ||
+            !vkd3d_array_reserve((void **)ranges, ranges_size, *count + 1, sizeof(**ranges)))
+    {
+        hoist->disabled = true;
+        return;
+    }
+
+    last = &(*ranges)[(*count)++];
+    last->vk_buffer = vk_buffer;
+    last->begin = begin;
+    last->end = end;
+}
+
+static void d3d12_command_list_block_upload_copy_range(struct d3d12_command_list *list,
+        VkBuffer vk_buffer, VkDeviceSize begin, VkDeviceSize end)
+{
+    struct d3d12_upload_copy_hoist *hoist = &list->upload_copy_hoist;
+
+    d3d12_command_list_add_upload_copy_hoist_range(list, &hoist->blocked, &hoist->blocked_size,
+            &hoist->blocked_count, vk_buffer, begin, end);
+}
+
+static void d3d12_command_list_block_upload_copy_resource(struct d3d12_command_list *list,
+        const struct d3d12_resource *resource)
+{
+    /* A barrier on all resources orders everything. */
+    if (!resource)
+    {
+        list->upload_copy_hoist.disabled = true;
+        return;
+    }
+
+    if (d3d12_resource_is_buffer(resource))
+    {
+        d3d12_command_list_block_upload_copy_range(list, resource->res.vk_buffer,
+                resource->mem.offset, resource->mem.offset + resource->desc.Width);
+    }
+}
