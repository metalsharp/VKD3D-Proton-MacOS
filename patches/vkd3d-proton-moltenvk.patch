diff --git a/libs/vkd3d-common/metalsharp_trace.c b/libs/vkd3d-common/metalsharp_trace.c
new file mode 100644
index 00000000..97a8c9e3
--- /dev/null
+++ b/libs/vkd3d-common/metalsharp_trace.c
@@ -0,0 +1,332 @@
+/*
+ * MetalSharp trace flag (see vkd3d_metalsharp_trace.h).
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#include "vkd3d_debug.h"
+#include "vkd3d_threads.h"
+#include "vkd3d_common.h"
+#include "vkd3d_platform.h"
+#include "vkd3d_metalsharp_trace.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+static pthread_once_t ms_trace_once = PTHREAD_ONCE_INIT;
+static uint32_t ms_trace_mask;
+static uint32_t ms_trace_heavy;
+static char ms_trace_dir[VKD3D_PATH_MAX];
+static uint64_t ms_trace_start_ns;
+
+static const struct
+{
+    const char *name;
+    uint32_t mask;
+}
+ms_trace_categories[] =
+{
+    {"shader",   VKD3D_MS_TRACE_SHADER},
+    {"present",  VKD3D_MS_TRACE_PRESENT},
+    {"memory",   VKD3D_MS_TRACE_MEMORY},
+    {"resource", VKD3D_MS_TRACE_RESOURCE},
+    {"sync",     VKD3D_MS_TRACE_SYNC},
+    {"gpu",      VKD3D_MS_TRACE_GPU},
+    {"cpu",      VKD3D_MS_TRACE_CPU},
+    {"api",      VKD3D_MS_TRACE_API},
+    {"pass",     VKD3D_MS_TRACE_PASS},
+    {"all",      ~0u},
+};
+
+/* Raw environment access: vkd3d_get_env_var() itself waits for this initialization. */
+static bool ms_getenv(const char *name, char *value, size_t size)
+{
+#ifdef _WIN32
+    DWORD len = GetEnvironmentVariableA(name, value, size);
+    if (len > 0 && len < size)
+        return true;
+#else
+    const char *env = getenv(name);
+    if (env && strlen(env) < size)
+    {
+        strcpy(value, env);
+        return true;
+    }
+#endif
+    value[0] = '\0';
+    return false;
+}
+
+static void ms_setenv(const char *name, const char *value)
+{
+#ifdef _WIN32
+    SetEnvironmentVariableA(name, value);
+#else
+    setenv(name, value, 1);
+#endif
+}
+
+/* Sets name to value unless the environment already has it. */
+static void ms_default_env(const char *name, const char *value)
+{
+    char current[16];
+
+    if (!ms_getenv(name, current, sizeof(current)) && !current[0])
+        ms_setenv(name, value);
+}
+
+/* Appends a flag to VKD3D_CONFIG. */
+static void ms_add_config_flag(const char *flag)
+{
+    char config[1024];
+    size_t len;
+
+    ms_getenv("VKD3D_CONFIG", config, sizeof(config));
+    if (strstr(config, flag))
+        return;
+    len = strlen(config);
+    if (len + strlen(flag) + 2 >= sizeof(config))
+        return;
+    if (len)
+        config[len++] = ',';
+    strcpy(config + len, flag);
+    ms_setenv("VKD3D_CONFIG", config);
+}
+
+static void ms_parse_categories(const char *spec)
+{
+    const char *p = spec;
+
+    while (*p)
+    {
+        char token[32];
+        size_t len = strcspn(p, ",; ");
+        bool heavy = false;
+        char *plus;
+        size_t i;
+
+        if (len && len < sizeof(token))
+        {
+            memcpy(token, p, len);
+            token[len] = '\0';
+            if ((plus = strchr(token, '+')))
+            {
+                heavy = !strcmp(plus + 1, "heavy");
+                *plus = '\0';
+            }
+            for (i = 0; i < ARRAY_SIZE(ms_trace_categories); i++)
+            {
+                if (!strcmp(token, ms_trace_categories[i].name))
+                {
+                    ms_trace_mask |= ms_trace_categories[i].mask;
+                    if (heavy)
+                        ms_trace_heavy |= ms_trace_categories[i].mask;
+                }
+            }
+            /* "heavy" alone makes every requested category heavy. */
+            if (!strcmp(token, "heavy"))
+                ms_trace_heavy = ~0u;
+        }
+        p += len;
+        p += strspn(p, ",; ");
+    }
+    ms_trace_heavy &= ms_trace_mask;
+}
+
+/* A Unix path (/Users/...) as the DOS path Wine maps it to (Z:\Users\...); others are kept. */
+static void ms_to_dos_path(const char *path, char *out, size_t size)
+{
+    size_t i, j = 0;
+
+    if (path[0] == '/' && size > 3)
+    {
+        out[j++] = 'Z';
+        out[j++] = ':';
+    }
+    for (i = 0; path[i] && j + 1 < size; i++)
+        out[j++] = path[i] == '/' ? '\\' : path[i];
+    out[j] = '\0';
+}
+
+static void ms_exe_name(char *out, size_t size)
+{
+    char path[VKD3D_PATH_MAX];
+    const char *name;
+
+#ifdef _WIN32
+    if (!GetModuleFileNameA(NULL, path, sizeof(path)))
+        strcpy(path, "unknown");
+#else
+    ssize_t len = readlink("/proc/self/exe", path, sizeof(path) - 1);
+    path[len > 0 ? len : 0] = '\0';
+    if (!path[0])
+        strcpy(path, "unknown");
+#endif
+    name = strrchr(path, '\\');
+    if (!name)
+        name = strrchr(path, '/');
+    snprintf(out, size, "%s", name ? name + 1 : path);
+}
+
+static void ms_mkdirs(const char *dir)
+{
+    char path[VKD3D_PATH_MAX];
+    size_t i;
+
+    snprintf(path, sizeof(path), "%s", dir);
+    for (i = 1; path[i]; i++)
+    {
+        if (path[i] != '\\' && path[i] != '/')
+            continue;
+        if (i == 2 && path[1] == ':')
+            continue;
+        path[i] = '\0';
+#ifdef _WIN32
+        CreateDirectoryA(path, NULL);
+#else
+        mkdir(path, 0755);
+#endif
+        path[i] = dir[i];
+    }
+#ifdef _WIN32
+    CreateDirectoryA(path, NULL);
+#else
+    mkdir(path, 0755);
+#endif
+}
+
+/* Keeps the previous launch's log as <name>.prev.log. */
+static void ms_rotate(const char *path)
+{
+    char prev[VKD3D_PATH_MAX];
+    size_t len = strlen(path);
+
+    if (len < 4 || len + 6 >= sizeof(prev))
+        return;
+    snprintf(prev, sizeof(prev), "%.*s.prev.log", (int)(len - 4), path);
+#ifdef _WIN32
+    MoveFileExA(path, prev, MOVEFILE_REPLACE_EXISTING);
+#else
+    rename(path, prev);
+#endif
+}
+
+static void ms_trace_init_once(void)
+{
+    char spec[256], home[VKD3D_PATH_MAX], exe[256], path[VKD3D_PATH_MAX];
+
+    if (!ms_getenv("METALSHARP_TRACE", spec, sizeof(spec)) || !spec[0])
+        return;
+    ms_parse_categories(spec);
+    if (!ms_trace_mask)
+        return;
+
+    ms_trace_start_ns = vkd3d_get_current_time_ns();
+
+    if (ms_getenv("METALSHARP_TRACE_DIR", path, sizeof(path)) && path[0])
+    {
+        ms_to_dos_path(path, ms_trace_dir, sizeof(ms_trace_dir));
+    }
+    else
+    {
+        ms_exe_name(exe, sizeof(exe));
+        if (ms_getenv("METALSHARP_HOME", home, sizeof(home)) && home[0])
+            snprintf(path, sizeof(path), "%s/logs/trace/%s", home, exe);
+        else if (ms_getenv("HOME", home, sizeof(home)) && home[0])
+            snprintf(path, sizeof(path), "%s/.metalsharp/logs/trace/%s", home, exe);
+        else
+            snprintf(path, sizeof(path), "metalsharp-trace/%s", exe);
+        ms_to_dos_path(path, ms_trace_dir, sizeof(ms_trace_dir));
+    }
+    ms_mkdirs(ms_trace_dir);
+
+    snprintf(path, sizeof(path), "%s\\vkd3d.log", ms_trace_dir);
+    ms_rotate(path);
+    ms_default_env("VKD3D_LOG_FILE", path);
+
+    if (ms_trace_mask & VKD3D_MS_TRACE_SHADER)
+    {
+        snprintf(path, sizeof(path), "%s\\shaders", ms_trace_dir);
+        ms_mkdirs(path);
+        ms_default_env("VKD3D_SHADER_DUMP_PATH", path);
+        ms_add_config_flag("pipeline_library_log");
+    }
+    if (ms_trace_mask & VKD3D_MS_TRACE_PRESENT)
+        ms_default_env("VKD3D_SWAPCHAIN_DEBUG_LATENCY", "1");
+    if (ms_trace_mask & VKD3D_MS_TRACE_MEMORY)
+        ms_add_config_flag("log_memory_budget");
+    if (ms_trace_heavy & VKD3D_MS_TRACE_RESOURCE)
+        ms_add_config_flag("descriptor_qa_checks");
+    if (ms_trace_mask & VKD3D_MS_TRACE_GPU)
+    {
+        ms_add_config_flag("fault");
+        ms_add_config_flag("breadcrumbs");
+        if (ms_trace_heavy & VKD3D_MS_TRACE_GPU)
+            ms_add_config_flag("breadcrumbs_sync");
+    }
+    if (ms_trace_mask & VKD3D_MS_TRACE_CPU)
+    {
+        snprintf(path, sizeof(path), "%s\\queue-profile.json", ms_trace_dir);
+        ms_default_env("VKD3D_QUEUE_PROFILE", path);
+        if (ms_trace_heavy & VKD3D_MS_TRACE_CPU)
+            ms_add_config_flag("queue_profile_extra");
+    }
+}
+
+void vkd3d_metalsharp_trace_init(void)
+{
+    pthread_once(&ms_trace_once, ms_trace_init_once);
+}
+
+uint32_t vkd3d_metalsharp_trace_mask(void)
+{
+    vkd3d_metalsharp_trace_init();
+    return ms_trace_mask;
+}
+
+uint32_t vkd3d_metalsharp_trace_heavy_mask(void)
+{
+    vkd3d_metalsharp_trace_init();
+    return ms_trace_heavy;
+}
+
+const char *vkd3d_metalsharp_trace_dir(void)
+{
+    vkd3d_metalsharp_trace_init();
+    return ms_trace_dir;
+}
+
+double vkd3d_metalsharp_trace_time_ms(void)
+{
+    return (double)(vkd3d_get_current_time_ns() - ms_trace_start_ns) / 1.0e6;
+}
+
+void vkd3d_metalsharp_trace_printf(uint32_t category, const char *fmt, ...)
+{
+    char message[1024], function[32];
+    const char *name = "trace";
+    va_list args;
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(ms_trace_categories); i++)
+    {
+        if (ms_trace_categories[i].mask == category)
+            name = ms_trace_categories[i].name;
+    }
+    snprintf(function, sizeof(function), "trace.%s", name);
+
+    va_start(args, fmt);
+    vsnprintf(message, sizeof(message), fmt, args);
+    va_end(args);
+
+    vkd3d_dbg_printf(VKD3D_DBG_CHANNEL_API, VKD3D_DBG_LEVEL_INFO, function, "%.3f ms %s\n",
+            vkd3d_metalsharp_trace_time_ms(), message);
+}
