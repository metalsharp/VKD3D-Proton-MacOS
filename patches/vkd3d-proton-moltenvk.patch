+/* Metal Shader Converter bridge: an R32_UINT storage texel view over a UAV counter, starting at the counter
+ * offset aligned down to the texel buffer alignment. The view lives in the counter resource's view map,
+ * so it is shared and released with the resource, and caches its Metal resource ID. */
+static bool vkd3d_msc_create_counter_view(struct d3d12_device *device, struct d3d12_resource *counter_resource,
+        uint32_t counter_offset, struct vkd3d_view **view, uint32_t *element_offset)
+{
+    VkDeviceSize alignment, aligned_offset, size;
+
+    alignment = max(16, device->device_info.properties2.properties.limits.minTexelBufferOffsetAlignment);
+    aligned_offset = counter_offset & ~(alignment - 1);
+    size = align(counter_offset - aligned_offset + sizeof(uint32_t), 16);
+    size = min(size, counter_resource->desc.Width - aligned_offset);
+
+    if (!d3d12_resource_is_buffer(counter_resource) ||
+            (uint64_t)counter_offset + sizeof(uint32_t) > counter_resource->desc.Width ||
+            ((counter_resource->mem.offset + aligned_offset) & (alignment - 1)) ||
+            !vkd3d_create_buffer_view_for_resource(device, counter_resource, DXGI_FORMAT_R32_UINT,
+                    aligned_offset / sizeof(uint32_t), size / sizeof(uint32_t), 0, 0, view) || !*view)
+    {
+        FIXME_ONCE("Failed to create counter view for the bridge, offset %u; writing UAVs without counters.\n",
+                counter_offset);
+        return false;
+    }
+
+    *element_offset = (counter_offset - aligned_offset) / sizeof(uint32_t);
+    return true;
+}
