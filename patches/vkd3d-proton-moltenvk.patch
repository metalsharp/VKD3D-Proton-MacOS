From cc53133248542b55e055b634c1238102c28f7768 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 6 Nov 2026 10:12:23 -0700
Subject: [PATCH 62/63] MetalSharp: D24 depth bias in D24 units on emulated D24

Where D24 is emulated with 32-bit float depth (Apple GPUs), depth bias scales with
each primitive's depth exponent: a D24 shadow map at depth 0.1 got an eighth of its
bias (shadow acne). Without VK_EXT_depth_bias_control's forced UNORM representation,
the constant part (DepthBias / (2^24 - 1), clamped by DepthBiasClamp) is now a
viewport depth offset and the Vulkan bias keeps the slope part; such PSOs take
depth bias as dynamic state. With VK_EXT_depth_range_unrestricted the viewport may
pass 1 (depth itself stays clamped).
---
 libs/vkd3d/command.c       | 51 +++++++++++++++++++++++++++++++++++---
 libs/vkd3d/device.c        |  1 +
 libs/vkd3d/state.c         |  6 +++++
 libs/vkd3d/vkd3d_private.h | 14 +++++++++++
 4 files changed, 68 insertions(+), 4 deletions(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 0704898d..c323da55 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -8995,12 +8995,54 @@ static void d3d12_command_list_update_dynamic_state(struct d3d12_command_list *l
     /* Make sure we only update states that are dynamic in the pipeline */
     dyn_state->dirty_flags &= list->dynamic_state.active_flags;
 
+    /* MetalSharp: an emulated D24 target's constant depth bias is in D24 steps, which float depth bias can't give:
+     * it is a viewport depth offset, and the Vulkan bias keeps the slope part. */
+    {
+        float depth_offset = 0.0f;
+
+        if ((list->dynamic_state.active_flags & VKD3D_DYNAMIC_STATE_DEPTH_BIAS) &&
+                vkd3d_emulated_unorm_depth_bias(list->device, list->dsv.format))
+        {
+            depth_offset = dyn_state->depth_bias.constant_factor / 16777215.0f;
+            if (dyn_state->depth_bias.clamp > 0.0f)
+                depth_offset = min(depth_offset, dyn_state->depth_bias.clamp);
+            else if (dyn_state->depth_bias.clamp < 0.0f)
+                depth_offset = max(depth_offset, dyn_state->depth_bias.clamp);
+        }
+        if (depth_offset != dyn_state->viewport_depth_offset)
+        {
+            dyn_state->viewport_depth_offset = depth_offset;
+            dyn_state->dirty_flags |= VKD3D_DYNAMIC_STATE_VIEWPORT | VKD3D_DYNAMIC_STATE_DEPTH_BIAS;
+        }
+    }
+
     if (dyn_state->viewport_count)
     {
         if (dyn_state->dirty_flags & VKD3D_DYNAMIC_STATE_VIEWPORT)
         {
-            VK_CALL(vkCmdSetViewportWithCount(list->cmd.vk_command_buffer,
-                    dyn_state->viewport_count, dyn_state->viewports));
+            if (dyn_state->viewport_depth_offset != 0.0f)
+            {
+                VkViewport viewports[D3D12_VIEWPORT_AND_SCISSORRECT_OBJECT_COUNT_PER_PIPELINE];
+
+                for (i = 0; i < dyn_state->viewport_count; i++)
+                {
+                    viewports[i] = dyn_state->viewports[i];
+                    viewports[i].minDepth += dyn_state->viewport_depth_offset;
+                    viewports[i].maxDepth += dyn_state->viewport_depth_offset;
+                    /* A viewport at the far plane moves past 1 (the depth itself is still clamped to [0, 1]). */
+                    if (!list->device->vk_info.EXT_depth_range_unrestricted)
+                    {
+                        viewports[i].minDepth = min(max(viewports[i].minDepth, 0.0f), 1.0f);
+                        viewports[i].maxDepth = min(max(viewports[i].maxDepth, 0.0f), 1.0f);
+                    }
+                }
+                VK_CALL(vkCmdSetViewportWithCount(list->cmd.vk_command_buffer, dyn_state->viewport_count, viewports));
+            }
+            else
+            {
+                VK_CALL(vkCmdSetViewportWithCount(list->cmd.vk_command_buffer,
+                        dyn_state->viewport_count, dyn_state->viewports));
+            }
         }
 
         if (dyn_state->dirty_flags & VKD3D_DYNAMIC_STATE_SCISSOR)
@@ -9112,9 +9154,10 @@ static void d3d12_command_list_update_dynamic_state(struct d3d12_command_list *l
         }
         else
         {
+            /* The constant part of an emulated D24 target's bias is in the viewport (above). */
             VK_CALL(vkCmdSetDepthBias(list->cmd.vk_command_buffer,
-                    dyn_state->depth_bias.constant_factor, dyn_state->depth_bias.clamp,
-                    dyn_state->depth_bias.slope_factor));
+                    vkd3d_emulated_unorm_depth_bias(list->device, list->dsv.format) ? 0.0f : dyn_state->depth_bias.constant_factor,
+                    dyn_state->depth_bias.clamp, dyn_state->depth_bias.slope_factor));
         }
     }
 
diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 7b8d4487..f5c4b0d6 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -139,6 +139,7 @@ static const struct vkd3d_optional_extension_info optional_device_extensions[] =
     VK_EXTENSION(EXT_MEMORY_BUDGET, EXT_memory_budget),
     VK_EXTENSION_COND(EXT_DEVICE_ADDRESS_BINDING_REPORT, EXT_device_address_binding_report, VKD3D_CONFIG_FLAG_STATIC(FAULT)),
     VK_EXTENSION(EXT_DEPTH_BIAS_CONTROL, EXT_depth_bias_control),
+    VK_EXTENSION(EXT_DEPTH_RANGE_UNRESTRICTED, EXT_depth_range_unrestricted),
     VK_EXTENSION(EXT_ZERO_INITIALIZE_DEVICE_MEMORY, EXT_zero_initialize_device_memory),
     VK_EXTENSION(EXT_SHADER_FLOAT8, EXT_shader_float8),
     VK_EXTENSION_COND(EXT_DESCRIPTOR_HEAP, EXT_descriptor_heap, VKD3D_CONFIG_FLAG_STATIC(DESCRIPTOR_HEAP)),
diff --git a/libs/vkd3d/state.c b/libs/vkd3d/state.c
index 35d8c9d2..d29557df 100644
--- a/libs/vkd3d/state.c
+++ b/libs/vkd3d/state.c
@@ -6255,6 +6255,12 @@ static HRESULT d3d12_pipeline_state_init_graphics_create_info(struct d3d12_pipel
     {
         graphics->explicit_dynamic_states |= VKD3D_DYNAMIC_STATE_DEPTH_BIAS;
     }
+    /* MetalSharp: D24 emulated with float depth takes its constant bias from the viewport at draw time
+     * (vkd3d_emulated_unorm_depth_bias), so the bias is set there. */
+    else if (vkd3d_emulated_unorm_depth_bias(device, vkd3d_get_format(device, desc->dsv_format, true)))
+    {
+        graphics->explicit_dynamic_states |= VKD3D_DYNAMIC_STATE_DEPTH_BIAS;
+    }
     else if (device->device_info.depth_bias_control_features.depthBiasControl &&
             desc->rasterizer_state.DepthBias != 0.0f)
     {
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index aa877732..f4d64db1 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -199,6 +199,7 @@ struct vkd3d_vulkan_info
     bool EXT_memory_budget;
     bool EXT_device_address_binding_report;
     bool EXT_depth_bias_control;
+    bool EXT_depth_range_unrestricted;
     bool EXT_zero_initialize_device_memory;
     bool EXT_shader_float8;
     bool EXT_present_timing;
@@ -3139,6 +3140,9 @@ struct vkd3d_dynamic_state
         float clamp;
         float slope_factor;
     } depth_bias;
+    /* MetalSharp: the constant depth bias of an emulated D24 target, applied as a viewport depth offset
+     * (vkd3d_emulated_unorm_depth_bias). */
+    float viewport_depth_offset;
 
     D3D12_INDEX_BUFFER_STRIP_CUT_VALUE index_buffer_strip_cut_value;
 
@@ -7208,6 +7212,16 @@ static inline uint32_t d3d12_resource_desc_default_alignment(const D3D12_RESOURC
            D3D12_DEFAULT_MSAA_RESOURCE_PLACEMENT_ALIGNMENT : D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
 }
 
+/* MetalSharp: whether depth bias for a target of this format needs D24 UNORM units that the device can't give: D24 is
+ * emulated with 32-bit float depth, whose bias scales with each primitive's depth, and the device lacks
+ * VK_EXT_depth_bias_control's forced UNORM representation. The constant part is then applied as a viewport offset. */
+static inline bool vkd3d_emulated_unorm_depth_bias(const struct d3d12_device *device, const struct vkd3d_format *format)
+{
+    return format && format->is_emulated && format->dxgi_format == DXGI_FORMAT_D24_UNORM_S8_UINT &&
+            !(device->device_info.depth_bias_control_features.depthBiasControl &&
+              device->device_info.depth_bias_control_features.leastRepresentableValueForceUnormRepresentation);
+}
+
 static inline void vkd3d_get_depth_bias_representation(VkDepthBiasRepresentationInfoEXT *info,
         const struct d3d12_device *device, DXGI_FORMAT dsv_format)
 {
