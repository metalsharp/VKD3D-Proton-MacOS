From 115f42c07a51ef0e8a1c2d7c4e3b93743c3bbf88 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Sun, 1 Nov 2026 16:45:33 -0700
Subject: [PATCH 2/3] MetalSharp: Mullion's NVIDIA extension (NVEXT) in DXGI,
 for Mullion's NGX core and NVAPI on VKD3D-Proton's lane

DXGIGetDebugInterface1 answers Mullion's NVEXT GUID where the program is shown an NVIDIA GPU
(dxgi.customVendorId = 10de, or MULLION_ENABLE_NVEXT=1), and DXGI then sets the NVIDIA driver's NGXCore registry
values to System32 and trusts the certificate Mullion's nvngx.dll is signed with, as Mullion's DXGI does.
---
 src/dxgi/dxgi_main.cpp          |   7 ++
 src/dxgi/dxgi_ngx.cpp           | 127 ++++++++++++++++++++++++++++++++
 src/dxgi/dxgi_ngx.h             |  26 +++++++
 src/dxgi/dxgi_ngx_certificate.h |  74 +++++++++++++++++++
 src/dxgi/meson.build            |   1 +
 5 files changed, 235 insertions(+)
 create mode 100644 src/dxgi/dxgi_ngx.cpp
 create mode 100644 src/dxgi/dxgi_ngx.h
 create mode 100644 src/dxgi/dxgi_ngx_certificate.h

diff --git a/src/dxgi/dxgi_main.cpp b/src/dxgi/dxgi_main.cpp
index 17530f5..bcdac5f 100644
--- a/src/dxgi/dxgi_main.cpp
+++ b/src/dxgi/dxgi_main.cpp
@@ -1,11 +1,14 @@
 #include "dxgi_factory.h"
 #include "dxgi_include.h"
+#include "dxgi_ngx.h"
 
 namespace dxvk {
   
   Logger Logger::s_instance("dxgi.log");
   
   HRESULT createDxgiFactory(UINT Flags, REFIID riid, void **ppFactory) {
+    InitNvidiaExtension();
+
     try {
       Com<DxgiFactory> factory = new DxgiFactory(Flags);
       HRESULT hr = factory->QueryInterface(riid, ppFactory);
@@ -48,6 +51,10 @@ extern "C" {
   DLLEXPORT HRESULT __stdcall DXGIGetDebugInterface1(UINT Flags, REFIID riid, void **ppDebug) {
     static bool errorShown = false;
 
+    // MetalSharp: Mullion's NGX core and NVAPI ask whether the program is shown an NVIDIA GPU
+    if (dxvk::IsNvidiaExtensionQuery(riid))
+      return dxvk::NvidiaExtensionEnabled() ? S_OK : E_NOINTERFACE;
+
     if (!std::exchange(errorShown, true))
       dxvk::Logger::warn("DXGIGetDebugInterface1: Stub");
 
diff --git a/src/dxgi/dxgi_ngx.cpp b/src/dxgi/dxgi_ngx.cpp
new file mode 100644
index 0000000..a0be706
--- /dev/null
+++ b/src/dxgi/dxgi_ngx.cpp
@@ -0,0 +1,127 @@
+#include <algorithm>
+#include <cctype>
+#include <mutex>
+
+#include "dxgi_ngx.h"
+#include "dxgi_ngx_certificate.h"
+
+#include "../util/config/config.h"
+#include "../util/log/log.h"
+#include "../util/util_env.h"
+
+namespace dxvk {
+
+  /* ba0af616-4a43-4259-815c-db3b89829905 (Mullion's src/dxgi/dxgi_interfaces.h) */
+  static const GUID MullionNvextGuid = {0xba0af616, 0x4a43, 0x4259, {0x81, 0x5c, 0xdb, 0x3b, 0x89, 0x82, 0x99, 0x05}};
+
+  static std::once_flag s_nvextInit;
+  static bool s_nvextEnabled = false;
+
+
+  static bool NvidiaExtensionRequested() {
+    std::string env = env::getEnvVar("MULLION_ENABLE_NVEXT");
+
+    if (env == "1" || env == "0")
+      return env == "1";
+
+    std::string vendor = Config::getUserConfig().getOption<std::string>("dxgi.customVendorId", "");
+    std::transform(vendor.begin(), vendor.end(), vendor.begin(), [] (unsigned char c) { return std::tolower(c); });
+    return vendor == "10de" || vendor == "0x10de";
+  }
+
+
+  // NGX loads only a core whose signature chains to a trusted root
+  static void TrustNgxCertificate() {
+    typedef void* (WINAPI *PFN_CertOpenStore)(LPCSTR, DWORD, ULONG_PTR, DWORD, const void*);
+    typedef BOOL (WINAPI *PFN_CertAddEncodedCertificateToStore)(void*, DWORD, const BYTE*, DWORD, DWORD, void*);
+    typedef BOOL (WINAPI *PFN_CertCloseStore)(void*, DWORD);
+
+    HMODULE crypt32 = LoadLibraryW(L"crypt32.dll");
+
+    if (!crypt32)
+      return;
+
+    auto open = reinterpret_cast<PFN_CertOpenStore>(GetProcAddress(crypt32, "CertOpenStore"));
+    auto add = reinterpret_cast<PFN_CertAddEncodedCertificateToStore>(GetProcAddress(crypt32, "CertAddEncodedCertificateToStore"));
+    auto close = reinterpret_cast<PFN_CertCloseStore>(GetProcAddress(crypt32, "CertCloseStore"));
+
+    // CERT_STORE_PROV_SYSTEM_W, CERT_SYSTEM_STORE_LOCAL_MACHINE; X509_ASN_ENCODING, CERT_STORE_ADD_USE_EXISTING
+    if (open && add && close) {
+      if (void* store = open(reinterpret_cast<LPCSTR>(10), 0, 0, 2 << 16, L"Root")) {
+        if (!add(store, 1, mullion_ngx_certificate, sizeof(mullion_ngx_certificate), 2, nullptr))
+          Logger::warn("NVEXT: Failed to trust the NGX core's certificate");
+        close(store, 0);
+      }
+    }
+
+    FreeLibrary(crypt32);
+  }
+
+
+  // The NVIDIA driver's registry values NGX looks for its core with: NVIDIA Corporation\Global\NGXCore FullPath
+  // and nvlddmkm\NGXCore NGXPath, System32, where Mullion's signed nvngx.dll is. A process without NVEXT leaves
+  // them as they are: they are the prefix's.
+  static void InitNvidiaExtensionOnce() {
+#ifndef _WIN64
+    return;
+#else
+    if (!NvidiaExtensionRequested())
+      return;
+
+    WCHAR folder[MAX_PATH] = L"C:\\windows\\system32";
+    UINT length = GetSystemDirectoryW(folder, MAX_PATH);
+
+    if (!length || length >= MAX_PATH)
+      wcscpy(folder, L"C:\\windows\\system32");
+
+    static const WCHAR* const keyNames[] = {
+      L"SOFTWARE\\NVIDIA Corporation\\Global",
+      L"SYSTEM\\ControlSet001\\Services\\nvlddmkm",
+      L"SOFTWARE\\NVIDIA Corporation\\Global\\NGXCore",
+      L"SYSTEM\\ControlSet001\\Services\\nvlddmkm\\NGXCore",
+    };
+
+    HKEY keys[4] = { };
+    bool created = true;
+
+    for (uint32_t i = 0; i < 4 && created; i++)
+      created = !RegCreateKeyExW(HKEY_LOCAL_MACHINE, keyNames[i], 0, nullptr, 0, KEY_ALL_ACCESS, nullptr, &keys[i], nullptr);
+
+    if (created) {
+      static const WCHAR* name = L"{41FCC608-8496-4DEF-B43E-7D9BD675A6FF}";
+      DWORD one = 1, size = DWORD((wcslen(folder) + 1) * sizeof(WCHAR));
+
+      RegSetValueExW(keys[0], name, 0, REG_DWORD, reinterpret_cast<const BYTE*>(&one), sizeof(one));
+      RegSetValueExW(keys[1], name, 0, REG_DWORD, reinterpret_cast<const BYTE*>(&one), sizeof(one));
+      RegSetValueExW(keys[2], L"FullPath", 0, REG_SZ, reinterpret_cast<const BYTE*>(folder), size);
+      RegSetValueExW(keys[3], L"NGXPath", 0, REG_SZ, reinterpret_cast<const BYTE*>(folder), size);
+      TrustNgxCertificate();
+
+      Logger::info("Vendor extension enabled: NVEXT");
+      s_nvextEnabled = true;
+    }
+
+    for (uint32_t i = 0; i < 4; i++) {
+      if (keys[i])
+        RegCloseKey(keys[i]);
+    }
+#endif
+  }
+
+
+  void InitNvidiaExtension() {
+    std::call_once(s_nvextInit, InitNvidiaExtensionOnce);
+  }
+
+
+  bool IsNvidiaExtensionQuery(REFIID riid) {
+    return riid == MullionNvextGuid;
+  }
+
+
+  bool NvidiaExtensionEnabled() {
+    InitNvidiaExtension();
+    return s_nvextEnabled;
+  }
+
+}
diff --git a/src/dxgi/dxgi_ngx.h b/src/dxgi/dxgi_ngx.h
new file mode 100644
index 0000000..5711635
--- /dev/null
+++ b/src/dxgi/dxgi_ngx.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include "dxgi_include.h"
+
+namespace dxvk {
+
+  /**
+   * \brief MetalSharp: Mullion's NVIDIA extension (NVEXT) on VKD3D-Proton's lane
+   *
+   * Mullion's NGX core (nvngx.dll) and NVAPI (nvapi64.dll) run DLSS on MetalFX
+   * with VKD3D-Proton's command lists as with Mullion's. They ask DXGI whether
+   * the program is shown an NVIDIA GPU with DXGIGetDebugInterface1 and Mullion's
+   * NVEXT GUID; where it is, this DXGI also sets up the NVIDIA driver's registry
+   * values NGX finds its core by, and trusts the certificate the core is signed
+   * with in the prefix's Root store, as Mullion's DXGI does.
+   *
+   * It is on with MULLION_ENABLE_NVEXT=1, or where the configuration shows the
+   * program an NVIDIA GPU (dxgi.customVendorId = 10de), unless MULLION_ENABLE_NVEXT=0.
+   */
+  void InitNvidiaExtension();
+
+  bool IsNvidiaExtensionQuery(REFIID riid);
+
+  bool NvidiaExtensionEnabled();
+
+}
