From 8a8264529ded3178a33d25791a94a5668ba87e50 Mon Sep 17 00:00:00 2001
From: MetalSharp <metalsharp@users.noreply.github.com>
Date: Fri, 23 Oct 2026 21:55:10 -0600
Subject: [PATCH] MetalSharp: build with current libc++, flip-model buffer
 count validation, D3D11On12 error detail

- config.cpp: include <algorithm> (std::transform).
- DxvkPipelineManager::createNullFsPipelineLibrary(): key the map entry with the empty key, not an empty
  tuple (libc++ can't extract a key from an empty tuple).
- CreateSwapChainBase(): flip-model swap chains take 2 to 16 buffers (E_INVALIDARG otherwise), as on Windows.
- D3D11On12CreateDevice(): log the error's message.
---
 src/d3d11/d3d11_main.cpp      | 1 +
 src/dxgi/dxgi_factory.cpp     | 5 +++++
 src/dxvk/dxvk_pipemanager.cpp | 3 ++-
 src/util/config/config.cpp    | 1 +
 4 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/d3d11/d3d11_main.cpp b/src/d3d11/d3d11_main.cpp
index b3b66b0..2af3ea2 100644
--- a/src/d3d11/d3d11_main.cpp
+++ b/src/d3d11/d3d11_main.cpp
@@ -442,6 +442,7 @@ extern "C" {
       return S_OK;
     } catch (const DxvkError& e) {
       Logger::err("D3D11On12CreateDevice: Failed to create D3D11 device");
+      Logger::err(e.message());
       return E_FAIL;
     }
   }
diff --git a/src/dxgi/dxgi_factory.cpp b/src/dxgi/dxgi_factory.cpp
index d29ce4a..2464bc1 100644
--- a/src/dxgi/dxgi_factory.cpp
+++ b/src/dxgi/dxgi_factory.cpp
@@ -524,6 +524,11 @@ namespace dxvk {
     const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* pFullscreenDesc,
           IDXGIOutput*          pRestrictToOutput,
           IDXGISwapChain1**     ppSwapChain) {
+    // Flip-model swap chains take 2 to 16 buffers, as on Windows
+    if ((pDesc->SwapEffect == DXGI_SWAP_EFFECT_FLIP_DISCARD || pDesc->SwapEffect == DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL)
+     && (pDesc->BufferCount < 2 || pDesc->BufferCount > DXGI_MAX_SWAP_CHAIN_BUFFERS))
+      return E_INVALIDARG;
+
     // Make sure the back buffer size is not zero
     DXGI_SWAP_CHAIN_DESC1 desc = *pDesc;
 
diff --git a/src/dxvk/dxvk_pipemanager.cpp b/src/dxvk/dxvk_pipemanager.cpp
index b0b03f9..05eff4c 100644
--- a/src/dxvk/dxvk_pipemanager.cpp
+++ b/src/dxvk/dxvk_pipemanager.cpp
@@ -392,9 +392,10 @@ namespace dxvk {
     std::lock_guard<dxvk::mutex> lock(m_mutex);
     DxvkShaderPipelineLibraryKey key;
 
+    // The empty key, as a key: libc++ can't extract the key from an empty tuple.
     auto iter = m_shaderLibraries.emplace(
       std::piecewise_construct,
-      std::tuple(),
+      std::tuple(key),
       std::tuple(m_device, this, key));
     return &iter.first->second;
   }
diff --git a/src/util/config/config.cpp b/src/util/config/config.cpp
index f6f9d6d..81e93f8 100644
--- a/src/util/config/config.cpp
+++ b/src/util/config/config.cpp
@@ -1,3 +1,4 @@
+#include <algorithm>
 #include <array>
 #include <fstream>
 #include <sstream>
-- 
