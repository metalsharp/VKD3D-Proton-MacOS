+uint32_t MVKCommandEncoder::getMultiviewDrawLoopCount() {
+	MVKGraphicsPipeline* pipeline = getGraphicsPipeline();
+	if (_multiviewDrawView != ~0u || !pipeline || !getSubpass()->isMultiview() ||
+		!getPhysicalDevice()->canUseInstancingForMultiview()) { return 0; }
+	if ( !pipeline->isTessellationPipeline() && !pipeline->isGeometryPipeline() && !pipeline->isMeshPipeline() ) { return 0; }
+	uint32_t viewCount = getSubpass()->getViewCountInMetalPass(getMultiviewPassIndex());
+	return viewCount > 1 ? viewCount : 0;
+}
+
+void MVKCommandEncoder::setMultiviewDrawView(uint32_t view) {
+	_multiviewDrawView = view;
+	getState().invalidateViewRange();
+}
+
 void MVKCommandEncoder::finalizeDrawState(MVKGraphicsStage stage) {
     if (stage == kMVKGraphicsStageVertex) {
         // Must happen before switching encoders.
         encodeStoreActions(true);
     }
 	if (stage == kMVKGraphicsStageRasterization) {
+		_passDrawCount++;
+		auto* pipeline = getGraphicsPipeline();
+		static bool logPasses = (getenv("MVK_DEBUG_PASSES") != nullptr || MVK_MS_TRACE_ON(Pass));
+		if (logPasses && _passDrawCount <= 2 && pipeline) { fprintf(mvkMSTraceStream(), "DRAW fs=%016zx\n", pipeline->getFragmentShaderHash()); }
+		if (pipeline && pipeline->usesEmulatedDepthBounds()) { ensureDepthBoundsSnapshot(); }
 		prepareDraw();
 		_occlusionQueryState.encode(_mtlRenderEncoder, this);
+		if (getMtlGraphics()._depthStencil.depthWriteEnabled) { _depthBoundsSnapshotValid = false; }
 	} else {
 		getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+		if (stage == kMVKGraphicsStageVertex) { encodeTransformFeedbackLoad(); }
 		prepareRenderDispatch(stage);
 	}
 }
 
+void MVKCommandEncoder::beginTransformFeedback() {
+	// TransformFeedbackState: offset[4], size[4], written, needed, bytes[4].
+	_transformFeedbackState = getTempMTLBuffer(16 * sizeof(uint32_t));
+	auto* state = (uint32_t*)_transformFeedbackState->getContents();
+	mvkClear(state, 16);
+	_transformFeedbackNeedsLoad = false;
+	for (uint32_t i = 0; i < kMVKMaxTransformFeedbackBufferCount; i++) {
+		auto& b = _graphicsResourcesState._transformFeedbackBufferBindings[i];
+		state[4 + i] = b.mtlBuffer ? (uint32_t)std::min<VkDeviceSize>(b.size, UINT32_MAX) : 0;
+		if (_graphicsResourcesState._transformFeedbackCounterAddresses[i]) { _transformFeedbackNeedsLoad = true; }
+	}
+	_transformFeedbackRunning = true;
+}
+
+void MVKCommandEncoder::encodeTransformFeedbackLoad() {
+	auto* pipeline = getGraphicsPipeline();
+	if ( !_transformFeedbackRunning || !_transformFeedbackNeedsLoad || !pipeline || !pipeline->isTransformFeedbackPipeline() ) { return; }
+	encodeTransformFeedbackLoad(getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl));
+}
+
+void MVKCommandEncoder::beginTransformFeedbackQuery(id<MTLBuffer> resultBuffer, uint64_t resultAddress) {
+	_transformFeedbackQueries.push_back(resultAddress);
+	_transformFeedbackQueryBuffers.push_back(resultBuffer);
+}
+
+void MVKCommandEncoder::endTransformFeedbackQuery(uint64_t resultAddress) {
+	for (size_t i = 0; i < _transformFeedbackQueries.size(); i++) {
+		if (_transformFeedbackQueries[i] == resultAddress) {
+			_transformFeedbackQueries.erase(_transformFeedbackQueries.begin() + i);
+			_transformFeedbackQueryBuffers.erase(_transformFeedbackQueryBuffers.begin() + i);
+			break;
+		}
+	}
+}
+
+// The kernels reach the counter and query buffers through their GPU addresses; tell Metal about the accesses,
+// so they are ordered with the other commands that use these buffers (such as query pool resets and copies).
+static void mvkUseTransformFeedbackBuffers(id<MTLComputeCommandEncoder> mtlEncoder, const id<MTLBuffer>* buffers, size_t count) {
+	for (size_t i = 0; i < count; i++) {
+		if (buffers[i]) { [mtlEncoder useResource: buffers[i] usage: MTLResourceUsageRead | MTLResourceUsageWrite]; }
+	}
+}
+
+void MVKCommandEncoder::encodeTransformFeedbackLoad(id<MTLComputeCommandEncoder> mtlEncoder) {
+	auto& mtlCompute = getMtlCompute();
+	mvkUseTransformFeedbackBuffers(mtlEncoder, _graphicsResourcesState._transformFeedbackCounterBuffers, kMVKMaxTransformFeedbackBufferCount);
+	mtlCompute.bindPipeline(mtlEncoder, getCommandEncodingPool()->getCmdTransformFeedbackLoadMTLComputePipelineState());
+	mtlCompute.bindBuffer(mtlEncoder, _transformFeedbackState->_mtlBuffer, _transformFeedbackState->_offset, 0);
+	mtlCompute.bindBytes(mtlEncoder, _graphicsResourcesState._transformFeedbackCounterAddresses,
+						 sizeof(_graphicsResourcesState._transformFeedbackCounterAddresses), 1);
+	[mtlEncoder dispatchThreadgroups: MTLSizeMake(1, 1, 1) threadsPerThreadgroup: MTLSizeMake(1, 1, 1)];
+	_transformFeedbackNeedsLoad = false;
+}
+
+void MVKCommandEncoder::endTransformFeedback(const uint64_t* counterAddresses, const id<MTLBuffer>* counterBuffers) {
+	_transformFeedbackRunning = false;
+	if ( !_transformFeedbackState ) { return; }
+	auto& counters = _graphicsResourcesState._transformFeedbackCounterAddresses;
+	bool hasCounters = false;
+	for (uint32_t i = 0; i < kMVKMaxTransformFeedbackBufferCount; i++) { hasCounters |= counterAddresses[i] != 0; }
+	if (hasCounters) {
+		// Store the offsets to the counter buffers given to End (if nothing was drawn, from those given to Begin).
+		bool isRendering = _mtlRenderEncoder != nil;
+		if (isRendering) { encodeStoreActions(true); }	// Must happen before switching encoders.
+		id<MTLComputeCommandEncoder> mtlEncoder = getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+		if (_transformFeedbackNeedsLoad) { encodeTransformFeedbackLoad(mtlEncoder); }
+		mvkCopy(counters, counterAddresses, kMVKMaxTransformFeedbackBufferCount);
+		mvkCopy(_graphicsResourcesState._transformFeedbackCounterBuffers, counterBuffers, kMVKMaxTransformFeedbackBufferCount);
+		encodeTransformFeedbackCaptureEnd(mtlEncoder, false);
