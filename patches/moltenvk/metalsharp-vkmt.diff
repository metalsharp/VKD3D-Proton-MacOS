+// The blob's header (MetalSharp's docs/MSC-BRIDGE-CONTRACT.md, section 1). Version 1 ends at heapsOffset, which it
+// has as a reserved 0: it never binds heaps.
+typedef struct {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t stage;
+	uint32_t dxilOffset;
+	uint32_t dxilSize;
+	uint32_t rootSigOffset;
+	uint32_t rootSigSize;
+	uint32_t heapsOffset;
+	uint32_t vertexInputOffset;
+	uint32_t vertexInputCount;
+} MVKMSCBlobHeader;
+static constexpr size_t kMVKMSCBlobHeaderSizeV1 = 8 * sizeof(uint32_t);
+
+// A vertex blob's input table entry: the Vulkan attribute location, then the NUL-terminated semantic and index.
+static constexpr size_t kMVKMSCVertexInputSize = 64;
+
+// The flattened root signature's sizes: counts and flags, then 7-word parameters, 6-word ranges and 13-word static samplers.
+static constexpr uint32_t kMVKMSCRootSigHeaderSize = 4 * sizeof(uint32_t);
+static constexpr uint32_t kMVKMSCRootParamSize = 7 * sizeof(uint32_t);
+static constexpr uint32_t kMVKMSCRangeSize = 6 * sizeof(uint32_t);
+static constexpr uint32_t kMVKMSCStaticSamplerSize = 13 * sizeof(uint32_t);
+static_assert(sizeof(IRStaticSamplerDescriptor) == kMVKMSCStaticSamplerSize, "The blob's static samplers are D3D12_STATIC_SAMPLER_DESCs, as IRStaticSamplerDescriptor is.");
+
+void MVKShaderModule::initMSCBlob(const VkShaderModuleCreateInfo* pCreateInfo) {
+	// The app owns pCode: keep a copy, zero-padded to whole words.
+	size_t codeSize = pCreateInfo->codeSize;
+	_mscBlob.assign((codeSize + 3) / 4, 0);
+	memcpy(_mscBlob.data(), pCreateInfo->pCode, codeSize);
+	_isMSC = true;
+
+	MVKMSCBlobHeader hdr = {};
+	const char* err = nullptr;
+	if (codeSize < kMVKMSCBlobHeaderSizeV1) {
+		err = "is smaller than its header";
+	} else {
+		memcpy(&hdr, _mscBlob.data(), min(codeSize, sizeof(hdr)));
+		if (hdr.version == 1) { hdr.heapsOffset = kMVKMSCNoHeaps; hdr.vertexInputOffset = hdr.vertexInputCount = 0; }
+		if (hdr.version != 1 && hdr.version != 2) {
+			err = "has an unsupported version";
+		} else if (hdr.version == 2 && codeSize < sizeof(hdr)) {
+			err = "is smaller than its header";
+		} else if (hdr.heapsOffset != kMVKMSCNoHeaps && (hdr.heapsOffset & 7)) {
+			err = "has heap addresses at an unaligned offset";
+		} else if (hdr.stage > kMVKMSCStageFragment) {
+			err = "is for an unsupported shader stage";
+		} else if (hdr.vertexInputCount && (hdr.stage != kMVKMSCStageVertex || (hdr.vertexInputOffset & 3) ||
+											uint64_t(hdr.vertexInputOffset) + uint64_t(hdr.vertexInputCount) * kMVKMSCVertexInputSize > codeSize)) {
+			err = "has a vertex input table that isn't a vertex shader's, or is past its end";
+		} else if ( !hdr.dxilSize || uint64_t(hdr.dxilOffset) + hdr.dxilSize > codeSize ) {
+			err = "has no DXIL, or DXIL past its end";
+		} else if (hdr.rootSigSize < kMVKMSCRootSigHeaderSize || uint64_t(hdr.rootSigOffset) + hdr.rootSigSize > codeSize ||
+				   (hdr.rootSigOffset & 3)) {
+			err = "has no root signature, or one past its end";
+		}
+	}
+	if (err) {
+		setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCreateShaderModule(): The Metal Shader Converter blob %s (version %u, stage %u, %zu bytes).",
+										   err, hdr.version, hdr.stage, codeSize));
+	}
+	_mscHeapsOffset = hdr.heapsOffset;
+	_mscStage = hdr.stage;
+	if ( !err ) {
+		const uint8_t* dxil = (const uint8_t*)_mscBlob.data() + hdr.dxilOffset;
+		uint64_t h = 0xcbf29ce484222325ull;
+		for (uint32_t i = 0; i < hdr.dxilSize; i++) { h = (h * 0x100000001b3ull) ^ dxil[i]; }
+		_mscDXILHash = h;
+	}
+	if ( !err ) {
+		const char* entries = (const char*)_mscBlob.data() + hdr.vertexInputOffset;
+		for (uint32_t i = 0; i < hdr.vertexInputCount; i++) {
+			const char* entry = entries + i * kMVKMSCVertexInputSize;
+			uint32_t location;
+			memcpy(&location, entry, sizeof(location));
+			const char* name = entry + sizeof(location);
+			_mscVertexInputLocations.emplace_back(string(name, strnlen(name, kMVKMSCVertexInputSize - sizeof(location))), location);
+		}
+	}
+}
