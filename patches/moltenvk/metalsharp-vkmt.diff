+void MVKPhysicalDevice::getSparseImageFormatProperties(VkFormat format, VkImageType type, VkSampleCountFlagBits samples,
+													   VkImageUsageFlags usage, VkImageTiling tiling,
+													   uint32_t* pPropertyCount, VkSparseImageFormatProperties* pProperties) {
+	VkExtent3D granularity = getSparseImageGranularity(format, type);
+	if (samples != VK_SAMPLE_COUNT_1_BIT || tiling != VK_IMAGE_TILING_OPTIMAL || !granularity.width) {
+		*pPropertyCount = 0;
+		return;
+	}
+	if ( !pProperties ) {
+		*pPropertyCount = 1;
+		return;
+	}
+	if (*pPropertyCount == 0) { return; }
+	*pPropertyCount = 1;
+
+	MTLPixelFormat mtlFormat = _pixelFormats.getMTLPixelFormat(format);
+	VkExtent2D blockTexels = _pixelFormats.getBlockTexelSize(format);
+	VkExtent3D standard = mvkStandardSparseBlockShape2D(_pixelFormats.getBytesPerBlock(format));
+	// Metal's 3D tiles are one slice deep, unlike the Vulkan standard 3D block shapes.
+	bool isStandard = type == VK_IMAGE_TYPE_2D && granularity.width == standard.width * blockTexels.width &&
+					  granularity.height == standard.height * blockTexels.height && granularity.depth == 1;
+
+	pProperties->aspectMask = _pixelFormats.isDepthFormat(mtlFormat) ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+	pProperties->imageGranularity = granularity;
+	// Each array layer has its own mip tail.
+	pProperties->flags = isStandard ? 0 : VK_SPARSE_IMAGE_FORMAT_NONSTANDARD_BLOCK_SIZE_BIT;
+}
