+// Keeps a copy of the main state's descriptor and its attachment formats, for variants for other attachments.
+template <class D>
+void MVKGraphicsPipeline::keepPipelineDescriptor(D* plDesc) {
+	if ( !_mtlPipelineState ) { return; }
+	[_mtlPipelineDescriptor release];
+	_mtlPipelineDescriptor = [plDesc copy];		// retained
+	for (uint32_t i = 0; i < kMVKMaxColorAttachmentCount; i++) {
+		_attachmentFormats.color[i] = plDesc.colorAttachments[i].pixelFormat;
+	}
+	_attachmentFormats.depth = plDesc.depthAttachmentPixelFormat;
+	_attachmentFormats.stencil = plDesc.stencilAttachmentPixelFormat;
+}
+
+// Adjusts a pipeline descriptor to the render pass's attachment formats, not writing the ones the pipeline has no format for.
+template <class D>
+static void adjustForAttachments(D* desc, const MVKRenderPassAttachmentFormats& formats, MVKPixelFormats* pixFmts) {
+	for (uint32_t i = 0; i < kMVKMaxColorAttachmentCount; i++) {
+		MTLRenderPipelineColorAttachmentDescriptor* colorDesc = desc.colorAttachments[i];
+		MTLPixelFormat pipelineFmt = colorDesc.pixelFormat, passFmt = formats.color[i];
+		if (pipelineFmt == passFmt) { continue; }
+		colorDesc.pixelFormat = passFmt;
+		if (pipelineFmt == MTLPixelFormatInvalid) { colorDesc.writeMask = MTLColorWriteMaskNone; }
+		if (pipelineFmt == MTLPixelFormatInvalid || !(pixFmts->getCapabilities(passFmt) & kMVKMTLFmtCapsBlend)) {
+			colorDesc.blendingEnabled = NO;
+		}
+	}
+	desc.depthAttachmentPixelFormat = formats.depth;
+	desc.stencilAttachmentPixelFormat = formats.stencil;
+}
+
+id<MTLRenderPipelineState> MVKGraphicsPipeline::getIndirectPipelineStateForAttachments(const MVKRenderPassAttachmentFormats& formats) {
+	if ( ![_mtlPipelineDescriptor isKindOfClass: [MTLRenderPipelineDescriptor class]] ||
+		isTessellationPipeline() || isTransformFeedbackPipeline() ) { return nil; }
+	lock_guard<mutex> lock(_attachmentVariantsLock);
+	for (auto& variant : _indirectVariants) {
+		if (variant.first == formats) { return variant.second; }
+	}
+	MTLRenderPipelineDescriptor* desc = [[_mtlPipelineDescriptor copy] autorelease];
+	adjustForAttachments(desc, formats, getPixelFormats());
+	desc.supportIndirectCommandBuffers = YES;
+	NSError* error = nil;
+	id<MTLRenderPipelineState> state = [getMTLDevice() newRenderPipelineStateWithDescriptor: desc error: &error];	// retained
+	if ( !state ) {
+		reportWarning(VK_ERROR_FEATURE_NOT_PRESENT, "Pipeline can't be used with indirect command buffers: %s", error.localizedDescription.UTF8String);
+	}
+	_indirectVariants.push_back({formats, state});
+	return state;
+}
+
+id<MTLRenderPipelineState> MVKGraphicsPipeline::getPipelineStateForAttachments(const MVKRenderPassAttachmentFormats& formats) {
+	if ( !_mtlPipelineDescriptor || formats == _attachmentFormats ) { return _mtlPipelineState; }
+	lock_guard<mutex> lock(_attachmentVariantsLock);
+	for (auto& variant : _attachmentVariants) {
+		if (variant.first == formats) { return variant.second ? variant.second : _mtlPipelineState; }
+	}
+	auto adjust = [&](auto* desc) { adjustForAttachments(desc, formats, getPixelFormats()); };
+	id<MTLRenderPipelineState> state = nil;
+	MVKRenderPipelineCompiler* plc = new MVKRenderPipelineCompiler(this);
+	if ([_mtlPipelineDescriptor isKindOfClass: [MTLRenderPipelineDescriptor class]]) {
+		MTLRenderPipelineDescriptor* desc = [[_mtlPipelineDescriptor copy] autorelease];
+		adjust(desc);
+		state = plc->newMTLRenderPipelineState(desc);	// retained
+	} else {
+		MTLMeshRenderPipelineDescriptor* desc = [[_mtlPipelineDescriptor copy] autorelease];
+		adjust(desc);
+		state = plc->newMTLRenderPipelineState(desc);	// retained
+	}
+	plc->destroy();
+	_attachmentVariants.push_back({formats, state});
+	return state ? state : _mtlPipelineState;
+}
