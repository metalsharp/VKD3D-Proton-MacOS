+// Forwards everything to a render encoder, recording the vertex and fragment buffers bound
+// (with bytes copied to temporary buffers), for the indirect command buffer draws of generated commands.
+struct MVKDGCCapturedBuffer {
+	id<MTLBuffer> buffer;
+	NSUInteger offset;
+	NSUInteger stride;
+	bool hasStride;
+};
+
+@interface MVKDGCBindingCapture : NSProxy {
+@public
+	id<MTLRenderCommandEncoder> _target;
+	MVKCommandEncoder* _cmdEncoder;
+	MVKDGCCapturedBuffer _vertex[kMVKMaxBufferCount];
+	MVKDGCCapturedBuffer _fragment[kMVKMaxBufferCount];
+	uint32_t _vertexMask;
+	uint32_t _fragmentMask;
