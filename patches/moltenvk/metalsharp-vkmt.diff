+		return fail("The heap addresses are past the pipeline layout's push constants.");
+	}
+
+	const MVKMSCConversion& vtxConv = _vertexModule->getMSCConversion();
+	if ( !vtxConv.mtlLibrary ) { return fail(vtxConv.error); }
+	if (vtxConv.needsDrawParams) { return fail("The vertex shader reads draw parameters, which aren't bound."); }
