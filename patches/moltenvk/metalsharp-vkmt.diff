+VkResult MVKQueue::bindSparse(uint32_t bindInfoCount, const VkBindSparseInfo* pBindInfo, VkFence fence) {
+	if ( !getPhysicalDevice()->supportsSparseResources() || !ensureSparseMappingQueue() ) {
+		return reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkQueueBindSparse(): Sparse binding is not supported.");
