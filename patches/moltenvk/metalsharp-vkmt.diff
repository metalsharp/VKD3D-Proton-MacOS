+// Returns a retained MTLRenderPipelineDescriptor whose vertex and fragment functions Metal Shader Converter made from
+// DXIL (the MSC bridge, docs/MSC-BRIDGE-CONTRACT.md in MetalSharp), or nil if an error occurs. The stages read their
+// resources from the top-level argument buffer (the push constants) and the heaps, so they have no bind scripts. The
+// vertex descriptor gives each stage-in attribute the Vulkan vertex attribute of the same semantic.
+MTLRenderPipelineDescriptor* MVKGraphicsPipeline::newMSCRenderPipelineDescriptor(const VkGraphicsPipelineCreateInfo* pCreateInfo,
+																				 const VkPipelineShaderStageCreateInfo* pVertexSS,
+																				 const VkPipelineShaderStageCreateInfo* pFragmentSS) {
+	auto fail = [&](const string& msg) -> MTLRenderPipelineDescriptor* {
+		setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCreateGraphicsPipelines(): Metal Shader Converter: %s", msg.c_str()));
+		return nil;
+	};
