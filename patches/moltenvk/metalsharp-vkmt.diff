+	uint32_t stageInAttributes[kMVKMSCMaxVertexAttributes];
+	std::fill(std::begin(stageInAttributes), std::end(stageInAttributes), UINT32_MAX);
+	for (auto& si : shaderConfig.shaderInputs) {
+		uint32_t location = si.shaderVar.location;
+		if (location >= kMVKMSCMaxVertexAttributes) { continue; }
+		for (auto& locInput : _vertexModule->getMSCVertexInputLocations()) {
+			if (locInput.second != location) { continue; }
+			for (auto& convInput : vtxConv.vertexInputs) {
+				if (strcasecmp(convInput.first.c_str(), locInput.first.c_str()) == 0) {
