+MVKRayTracingPipeline::MVKRayTracingPipeline(MVKDevice* device,
+											 MVKPipelineCache* pipelineCache,
+											 MVKPipeline* parent,
+											 const VkRayTracingPipelineCreateInfoKHR* pCreateInfo) :
+	MVKComputePipeline(device,
+					   pipelineCache,
