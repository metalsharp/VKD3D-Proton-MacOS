+uint64_t MVKDevice::getImageViewHandle(const VkImageViewHandleInfoNVX* pInfo) {
+	if ( !pInfo ) { return 0; }
+	switch (pInfo->descriptorType) {
+		case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+		case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+		case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+		case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT: {
+			auto* imageView = (MVKImageView*)pInfo->imageView;
+			id<MTLTexture> mtlTex = imageView ? imageView->getMTLTexture(0) : nil;
+			return mtlTex ? mtlTex.gpuResourceID._impl : 0;
+		}
+		case VK_DESCRIPTOR_TYPE_SAMPLER: {
+			auto* sampler = (MVKSampler*)pInfo->sampler;
+			id<MTLSamplerState> mtlSamp = sampler ? sampler->getMTLSamplerState() : nil;
+			return mtlSamp ? mtlSamp.gpuResourceID._impl : 0;
+		}
+		case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+		case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER: {
+			// Not in the extension: the Metal Shader Converter bridge passes a VkBufferView in imageView.
+			auto* bufferView = (MVKBufferView*)(uintptr_t)pInfo->imageView;
+			id<MTLTexture> mtlTex = bufferView ? bufferView->getMTLTexture() : nil;
+			return mtlTex ? mtlTex.gpuResourceID._impl : 0;
+		}
+		default:
+			return 0;
+	}
+}
