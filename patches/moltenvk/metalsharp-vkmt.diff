+// Indirect draws with a mesh-run (geometry or conservative rasterization) pipeline: each draw's DrawInfo,
+// from the common one and the draw's arguments, and its object threadgroups (input primitives by instances).
+kernel void cmdDrawMeshPipelineIndirectConvert(const device char* srcBuff [[buffer(0)]],
+                                               device MVKMeshDrawInfo* drawInfos [[buffer(1)]],
+                                               device MTLDispatchThreadgroupsIndirectArguments* dispatches [[buffer(2)]],
+                                               constant MVKMeshDrawInfo& drawInfo [[buffer(3)]],
+                                               constant uint32_t& srcStride [[buffer(4)]],
+                                               constant uint32_t& drawCount [[buffer(5)]],
+                                               uint idx [[thread_position_in_grid]]) {
+	if (idx >= drawCount) { return; }
