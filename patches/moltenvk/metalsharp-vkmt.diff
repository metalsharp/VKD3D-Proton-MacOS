+
+#pragma mark -
+#pragma mark MetalSharp trace flag
+
+#include <crt_externs.h>
+#include <mutex>
+#include <pthread.h>
+#include <stdarg.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <dispatch/dispatch.h>
+#include <mach/mach.h>
+#include <sys/sysctl.h>
+
+static std::once_flag _mvkMSTraceOnce;
+static uint32_t _mvkMSTraceMask = 0;
+static uint32_t _mvkMSTraceHeavy = 0;
+static FILE* _mvkMSTraceFile = nullptr;
+static std::string _mvkMSTraceDir;
+static std::string _mvkMSTraceShaderDir;
+static uint64_t _mvkMSTraceStartNS = 0;
+
+static const struct { const char* name; uint32_t mask; } _mvkMSTraceCategories[] = {
+	{"shader", kMVKMSTraceShader}, {"present", kMVKMSTracePresent}, {"memory", kMVKMSTraceMemory},
+	{"resource", kMVKMSTraceResource}, {"sync", kMVKMSTraceSync}, {"gpu", kMVKMSTraceGPU}, {"cpu", kMVKMSTraceCPU},
+	{"api", kMVKMSTraceAPI}, {"pass", kMVKMSTracePass}, {"all", ~0u},
+};
+
+static uint64_t mvkMSTraceNowNS() {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+// The Windows program's name: Wine puts its path (Z:\...\game.exe) in argv[0].
+static std::string mvkMSTraceExeName() {
+	char** argv = *_NSGetArgv();
+	std::string path = (argv && argv[0]) ? argv[0] : "unknown";
+	size_t slash = path.find_last_of("\\/");
+	return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+// A DOS path Wine maps to the root (Z:\Users\...) as the Unix path (/Users/...).
+static std::string mvkMSTraceUnixPath(std::string path) {
+	if (path.size() >= 2 && path[1] == ':' && (path[0] == 'Z' || path[0] == 'z')) { path = path.substr(2); }
+	for (auto& c : path) { if (c == '\\') { c = '/'; } }
+	return path;
+}
+
+static void mvkMSTraceMkdirs(const std::string& dir) {
+	for (size_t i = 1; i <= dir.size(); i++) {
+		if (i == dir.size() || dir[i] == '/') { mkdir(dir.substr(0, i).c_str(), 0755); }
+	}
+}
+
+static void mvkMSTraceInit() {
+	const char* spec = getenv("METALSHARP_TRACE");
+	if ( !spec || !*spec ) { return; }
+
+	std::string s = spec;
+	size_t pos = 0;
+	while (pos <= s.size()) {
+		size_t end = s.find_first_of(",; ", pos);
+		if (end == std::string::npos) { end = s.size(); }
+		std::string token = s.substr(pos, end - pos);
+		bool heavy = false;
+		size_t plus = token.find('+');
+		if (plus != std::string::npos) { heavy = token.substr(plus + 1) == "heavy"; token = token.substr(0, plus); }
+		for (auto& cat : _mvkMSTraceCategories) {
+			if (token == cat.name) {
+				_mvkMSTraceMask |= cat.mask;
+				if (heavy) { _mvkMSTraceHeavy |= cat.mask; }
+			}
+		}
+		if (token == "heavy") { _mvkMSTraceHeavy = ~0u; }
+		pos = end + 1;
+	}
+	_mvkMSTraceHeavy &= _mvkMSTraceMask;
+	if ( !_mvkMSTraceMask ) { return; }
+
+	_mvkMSTraceStartNS = mvkMSTraceNowNS();
+	const char* dir = getenv("METALSHARP_TRACE_DIR");
+	const char* home = getenv("METALSHARP_HOME");
+	if (dir && *dir) {
+		_mvkMSTraceDir = mvkMSTraceUnixPath(dir);
+	} else if (home && *home) {
+		_mvkMSTraceDir = std::string(home) + "/logs/trace/" + mvkMSTraceExeName();
+	} else {
+		const char* h = getenv("HOME");
+		_mvkMSTraceDir = std::string(h ? h : "/tmp") + "/.metalsharp/logs/trace/" + mvkMSTraceExeName();
+	}
+	mvkMSTraceMkdirs(_mvkMSTraceDir);
+
+	std::string log = _mvkMSTraceDir + "/moltenvk.log";
+	rename(log.c_str(), (_mvkMSTraceDir + "/moltenvk.prev.log").c_str());
+	_mvkMSTraceFile = fopen(log.c_str(), "w");
+	if (_mvkMSTraceFile) {
+		time_t now = time(nullptr);
+		char when[64];
+		strftime(when, sizeof(when), "%Y-%m-%d %H:%M:%S", localtime(&now));
+		fprintf(_mvkMSTraceFile, "MoltenVK trace %s, pid %d, %s, METALSHARP_TRACE=%s (categories %#x, heavy %#x)\n",
+				when, (int)getpid(), mvkMSTraceExeName().c_str(), spec, _mvkMSTraceMask, _mvkMSTraceHeavy);
+		fflush(_mvkMSTraceFile);
+	}
+
+	// Existing switches that are read straight from the environment.
+	if (_mvkMSTraceMask & kMVKMSTracePass) { setenv("MVK_DEBUG_PASSES", "1", 0); }
+	if (_mvkMSTraceMask & kMVKMSTraceMemory) { setenv("MVK_DEBUG_TEXTURES", "1", 0); }
+	if (_mvkMSTraceMask & kMVKMSTraceShader) {
+		_mvkMSTraceShaderDir = _mvkMSTraceDir + "/shaders";
+		mvkMSTraceMkdirs(_mvkMSTraceShaderDir);
+	}
+}
+
+// METALSHARP_TRACE=memory: every 5 s, this process's memory footprint and the system's swap and paging, which
+// explain GPU work that slows to seconds once the Mac starts paging (the GPU shares the process's memory).
+static void mvkMSTraceSampleMemory(void*) {
+	task_vm_info_data_t vmInfo = {};
+	mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+	double footprintMB = 0, peakMB = 0;
+	if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vmInfo, &count) == KERN_SUCCESS) {
+		footprintMB = (double)vmInfo.phys_footprint / 1048576.0;
+		peakMB = (double)vmInfo.ledger_phys_footprint_peak / 1048576.0;
+	}
+	xsw_usage swap = {};
+	size_t swapSize = sizeof(swap);
+	sysctlbyname("vm.swapusage", &swap, &swapSize, nullptr, 0);
+	vm_statistics64_data_t vmStat = {};
+	mach_msg_type_number_t statCount = HOST_VM_INFO64_COUNT;
+	host_statistics64(mach_host_self(), HOST_VM_INFO64, (host_info64_t)&vmStat, &statCount);
+	static uint64_t lastPageouts, lastSwapouts;
+	uint64_t pageouts = vmStat.pageouts - lastPageouts, swapouts = vmStat.swapouts - lastSwapouts;
+	bool first = !lastPageouts && !lastSwapouts;
+	lastPageouts = vmStat.pageouts;
+	lastSwapouts = vmStat.swapouts;
+	double pageMB = (double)vm_page_size / 1048576.0;
+	mvkMSTracePrintf(kMVKMSTraceMemory, "process footprint %.0f MB (peak %.0f MB); system: swap used %.0f MB, compressed %.0f MB, "
+					 "free %.0f MB, %llu pageouts and %llu swapouts in the last 5 s",
+					 footprintMB, peakMB, (double)swap.xsu_used / 1048576.0, vmStat.compressor_page_count * pageMB,
+					 vmStat.free_count * pageMB, first ? 0ull : (unsigned long long)pageouts,
+					 first ? 0ull : (unsigned long long)swapouts);
+}
+
+static void mvkMSTraceStartMemorySampler() {
+	dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+	if ( !timer ) { return; }
+	dispatch_source_set_timer(timer, dispatch_time(DISPATCH_TIME_NOW, 0), 5 * NSEC_PER_SEC, NSEC_PER_SEC / 2);
+	dispatch_source_set_event_handler_f(timer, mvkMSTraceSampleMemory);
+	dispatch_resume(timer);	// Runs for the life of the process
+}
+
+static void mvkMSTraceEnsureInit() {
+	std::call_once(_mvkMSTraceOnce, [] {
+		mvkMSTraceInit();
+		if (_mvkMSTraceMask & kMVKMSTraceMemory) { mvkMSTraceStartMemorySampler(); }
+	});
+}
+
+uint32_t mvkMSTraceMask() { mvkMSTraceEnsureInit(); return _mvkMSTraceMask; }
+uint32_t mvkMSTraceHeavyMask() { mvkMSTraceEnsureInit(); return _mvkMSTraceHeavy; }
+FILE* mvkMSTraceStream() { mvkMSTraceEnsureInit(); return _mvkMSTraceFile ? _mvkMSTraceFile : stderr; }
+double mvkMSTraceTimeMS() { return (double)(mvkMSTraceNowNS() - _mvkMSTraceStartNS) / 1.0e6; }
+
+void mvkMSTracePrintf(uint32_t category, const char* format, ...) {
+	mvkMSTraceEnsureInit();
+	const char* name = "trace";
+	for (auto& cat : _mvkMSTraceCategories) { if (cat.mask == category) { name = cat.name; } }
+
+	char msg[2048];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(msg, sizeof(msg), format, args);
+	va_end(args);
+
+	uint64_t tid = 0;
+	pthread_threadid_np(nullptr, &tid);
+	FILE* out = mvkMSTraceStream();
+	fprintf(out, "%.3f ms [%s] %llx: %s\n", mvkMSTraceTimeMS(), name, (unsigned long long)tid, msg);
+	fflush(out);
+}
+
+// Settings the trace categories turn on, unless the environment already sets them.
+static void mvkMSTraceApplyConfig(MVKConfiguration& cfg) {
+	uint32_t mask = mvkMSTraceMask();
+	uint32_t heavy = mvkMSTraceHeavyMask();
+	if ( !mask ) { return; }
+
+	if ((mask & kMVKMSTraceShader) && !getenv("MVK_CONFIG_SHADER_DUMP_DIR")) {
+		cfg.shaderDumpDir = (char*)_mvkMSTraceShaderDir.c_str();
+	}
+	if (mask & kMVKMSTraceCPU) {
+		if ( !getenv("MVK_CONFIG_PERFORMANCE_TRACKING") ) { cfg.performanceTracking = true; }
+		if ( !getenv("MVK_CONFIG_ACTIVITY_PERFORMANCE_LOGGING_STYLE") ) {
+			cfg.activityPerformanceLoggingStyle = MVK_CONFIG_ACTIVITY_PERFORMANCE_LOGGING_STYLE_FRAME_COUNT;
+		}
+		if ( !getenv("MVK_CONFIG_PERFORMANCE_LOGGING_FRAME_COUNT") ) { cfg.performanceLoggingFrameCount = 600; }
+	}
+	if ((heavy & kMVKMSTraceGPU) && !getenv("MVK_CONFIG_DEBUG") && !getenv("MVK_DEBUG")) { cfg.debugMode = true; }
+	if ((mask & kMVKMSTraceAPI) && !getenv("MVK_CONFIG_TRACE_VULKAN_CALLS")) {
+		cfg.traceVulkanCalls = (heavy & kMVKMSTraceAPI) ? MVK_CONFIG_TRACE_VULKAN_CALLS_DURATION_THREAD_ID
+		                                                 : MVK_CONFIG_TRACE_VULKAN_CALLS_DURATION;
