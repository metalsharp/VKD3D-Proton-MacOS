+// The archive is per OS build and GPU as well: Metal refuses one another compiler or GPU made.
+void MVKDevice::initBinaryArchive(const std::string& basePath) {
+	if ( !mvkGetEnvVarNumber("MVK_CONFIG_BINARY_ARCHIVE", 1) ) { return; }
+	_binaryArchiveQueue = dispatch_queue_create("MoltenVK binary archive", DISPATCH_QUEUE_SERIAL);
+	char build[64] = {};
+	size_t size = sizeof(build) - 1;
+	sysctlbyname("kern.osversion", build, &size, nullptr, 0);
+	std::string gpu = _physicalDevice->getMTLDevice().name.UTF8String;
+	for (char& c : gpu) { if ( !isalnum((unsigned char)c) ) { c = '_'; } }
+	_binaryArchivePath = basePath + "-" + build + "-" + gpu + ".metalarchive";
+
+	@autoreleasepool {
+		NSError* err = nil;
+		MTLBinaryArchiveDescriptor* desc = [[MTLBinaryArchiveDescriptor new] autorelease];
+		bool exists = access(_binaryArchivePath.c_str(), R_OK) == 0;
+		if (exists) { desc.url = [NSURL fileURLWithPath: @(_binaryArchivePath.c_str())]; }
+		_binaryArchive = [_physicalDevice->getMTLDevice() newBinaryArchiveWithDescriptor: desc error: &err];	// retained
+		if ( !_binaryArchive && exists ) {
+			MVKLogWarn("Binary archive %s can't be loaded (%s), starting a new one.", _binaryArchivePath.c_str(), err.localizedDescription.UTF8String);
+			unlink(_binaryArchivePath.c_str());
+			desc.url = nil;
+			_binaryArchive = [_physicalDevice->getMTLDevice() newBinaryArchiveWithDescriptor: desc error: &err];	// retained
+		}
+		if (_binaryArchive) { MVKLogInfo("Binary archive %s: %s.", _binaryArchivePath.c_str(), exists ? "loaded" : "new"); }
+	}
+}
+
+// Stands in for the binary archive when a pipeline is added to it, and leaves out render pipelines without a
+// fragment stage (depth-only passes): Metal adds them, but then can't serialize the archive ("expecting
+// 'fragment' stage in pipeline no. N"), so one such pipeline kept every later save from being written (RDR2,
+// Ghostrunner, The Witcher 3), and each launch compiled the GPU code of every pipeline again.
+@interface MVKBinaryArchiveFilter : NSProxy {
+@public
+	id<MTLBinaryArchive> _archive;
+}
+@end
+
+@implementation MVKBinaryArchiveFilter
+- (BOOL) addRenderPipelineFunctionsWithDescriptor: (MTLRenderPipelineDescriptor*) descriptor error: (NSError**) error {
+	if ( !descriptor.fragmentFunction ) { return NO; }
+	return [_archive addRenderPipelineFunctionsWithDescriptor: descriptor error: error];
+}
+// Mesh pipelines (geometry shaders run as object and mesh stages) are left out too: Metal adds them, but can't
+// serialize them either ("missing 'vertex' stage in pipeline no. N"; The Witcher 3, Ghostrunner).
+- (BOOL) addMeshRenderPipelineFunctionsWithDescriptor: (MTLMeshRenderPipelineDescriptor*) descriptor error: (NSError**) error {
+	return NO;
+}
+- (NSMethodSignature*) methodSignatureForSelector: (SEL) sel { return [(NSObject*)_archive methodSignatureForSelector: sel]; }
+- (void) forwardInvocation: (NSInvocation*) invocation { [invocation invokeWithTarget: _archive]; }
+@end
+
+// Pipelines waiting to be added are kept to this many: each add compiles the pipeline's GPU code again on one
+// queue, and the save waits behind them, so while a game compiled steadily the archive was never written, and
+// every waiting pipeline's descriptor and functions stayed alive. Those dropped are added at a later launch.
+static constexpr int kMVKBinaryArchiveMaxPending = 256;
+
+// When the app last compiled a shader library or pipeline (MVKMetalCompiler). Each archive add compiles its
+// pipeline's GPU code again, in the same Metal compiler service as the app's own compiles, and while God of War
+// created pipelines on demand those adds made its frame-blocking compiles slower: adds wait until the app has
+// compiled nothing for kMVKBinaryArchiveQuietNS.
+static std::atomic<uint64_t> _mvkLastShaderCompileNS{0};
+static constexpr uint64_t kMVKBinaryArchiveQuietNS = 2ull * NSEC_PER_SEC;
+
+void mvkNoteShaderCompileActivity() { _mvkLastShaderCompileNS = mvkGetRuntimeNanoseconds(); }
+
+void MVKDevice::addToBinaryArchive(BOOL (^add)(id<MTLBinaryArchive> archive, NSError** error)) {
+	if ( !_binaryArchive ) { return; }
+	if (_binaryArchivePending.fetch_add(1) >= kMVKBinaryArchiveMaxPending) {
+		_binaryArchivePending--;
+		return;
+	}
+	id<MTLBinaryArchive> archive = [_binaryArchive retain];
+	BOOL (^work)(id<MTLBinaryArchive>, NSError**) = [add copy];
+	dispatch_async(_binaryArchiveQueue, ^{
+		// Let the app's own compiles go first.
+		while ( !_binaryArchiveClosing && mvkGetRuntimeNanoseconds() - _mvkLastShaderCompileNS < kMVKBinaryArchiveQuietNS ) {
+			usleep(100 * 1000);
+		}
+		// adds still waiting when the device goes are dropped: its pipelines are added at a later launch instead
+		if ( !_binaryArchiveClosing ) {
+			@autoreleasepool {
+				MVKBinaryArchiveFilter* filter = [MVKBinaryArchiveFilter alloc];
+				filter->_archive = archive;
+				NSError* err = nil;
+				if (work((id<MTLBinaryArchive>)filter, &err)) { _binaryArchiveDirty = true; }
+				[filter release];
+			}
+		}
+		[work release];
+		[archive release];
+		_binaryArchivePending--;
+	});
+}
+
+// Games exit without destroying their device, so its last cache and archive saves never ran (Elden Ring's
+// archive was never written past its first seconds). At exit, the devices still alive save both, on another
+// thread and for at most 5 seconds: when Wine ends a process its other threads may already be stopped, holding
+// a lock the save needs, and the game must still exit. Saves go to a temporary file renamed when complete.
+static std::mutex _mvkLiveDevicesLock;
+static std::vector<MVKDevice*> _mvkLiveDevices;
+
+static void mvkFlushPipelineCachesAtExit() {
+	dispatch_semaphore_t done = dispatch_semaphore_create(0);
+	dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+		std::vector<MVKDevice*> devices;
+		{
+			std::lock_guard<std::mutex> lock(_mvkLiveDevicesLock);
+			devices = _mvkLiveDevices;
+		}
+		for (auto* device : devices) { device->flushPipelineCachesAtExit(); }
+		dispatch_semaphore_signal(done);
+	});
+	dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC));
+}
+
+static void mvkRegisterLiveDevice(MVKDevice* device) {
+	static std::once_flag registered;
+	std::call_once(registered, [] { atexit(mvkFlushPipelineCachesAtExit); });
+	std::lock_guard<std::mutex> lock(_mvkLiveDevicesLock);
+	_mvkLiveDevices.push_back(device);
+}
+
+static void mvkUnregisterLiveDevice(MVKDevice* device) {
+	std::lock_guard<std::mutex> lock(_mvkLiveDevicesLock);
+	_mvkLiveDevices.erase(std::remove(_mvkLiveDevices.begin(), _mvkLiveDevices.end(), device), _mvkLiveDevices.end());
+}
+
+void MVKDevice::flushPipelineCachesAtExit() {
+	if ( !_implicitPipelineCache ) { return; }
+	dispatch_sync(_implicitPipelineCacheQueue, ^{
+		if (_implicitPipelineCacheDirty) { saveImplicitPipelineCache(); }
+	});
+	if (_binaryArchiveQueue && _binaryArchiveDirty) {
+		_binaryArchiveClosing = true;	// adds still waiting are dropped
+		dispatch_sync(_binaryArchiveQueue, ^{
+			if (_binaryArchiveDirty) { saveBinaryArchive(); }
+		});
+	}
+}
