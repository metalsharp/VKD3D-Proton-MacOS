+@end
+
+// Matches the structures of the cmdExecuteGeneratedCommandsICB kernel.
+struct MVKDGCBufferEntry {
+	uint64_t address;
+	uint32_t stride;
+	uint32_t flags;
+};
+
+struct MVKDGCBindings {
+	MVKDGCBufferEntry vertexBuffers[kMVKMaxBufferCount];
+	MVKDGCBufferEntry fragmentBuffers[kMVKMaxBufferCount];
+	uint64_t indexAddress;
+	uint32_t indexType;
+	uint32_t primitiveType;
+	uint32_t vertexMask;
+	uint32_t fragmentMask;
+	uint32_t pushConstantsStride;
+	uint32_t pad;
+};
+
+struct MVKDGCVertexBufferToken {
+	uint32_t streamOffset;
+	uint32_t index;
+	uint32_t hasStride;
+	uint32_t pad;
+};
+
+struct MVKDGCICBParams {
+	uint32_t sequenceCount;
+	uint32_t stride;
+	uint32_t actionOffset;
+	uint32_t isIndexed;
+	uint32_t hasCount;
+	uint32_t vertexBufferTokenCount;
+	uint32_t indexBufferStreamOffset;
+	uint32_t indexBufferDXGI;
+};
+
+// Matches MVKDGCParams of the cmdExecuteGeneratedCommandsExpand kernel.
+struct MVKDGCParams {
+	uint32_t sequenceCount;
+	uint32_t stride;
+	uint32_t pushConstantsStride;
+	uint32_t pushConstantsSize;
+	uint32_t argsSize;
+	uint32_t actionOffset;
+	uint32_t tokenCount;
+	uint32_t hasCount;
+};
+
+// MVK_CONFIG_DGC_STATS=1 logs, every 2000 calls, how many sequences the calls allowed and whether a count
+// buffer limited them, by action: what an application's GPU-driven work looks like.
+static void mvkLogGeneratedCommandsStats(VkIndirectCommandsTokenTypeEXT actionType, uint32_t maxSequenceCount, bool counted) {
+	static const bool enabled = mvkGetEnvVarNumber("MVK_CONFIG_DGC_STATS", 0) != 0;
+	if ( !enabled ) { return; }
+	static std::mutex lock;
+	static uint64_t calls, sequences, countedCalls, dispatchCalls, buckets[6];
+	std::lock_guard<std::mutex> guard(lock);
+	calls++;
+	sequences += maxSequenceCount;
+	countedCalls += counted;
+	dispatchCalls += actionType == VK_INDIRECT_COMMANDS_TOKEN_TYPE_DISPATCH_EXT;
+	buckets[maxSequenceCount <= 1 ? 0 : maxSequenceCount <= 16 ? 1 : maxSequenceCount <= 64 ? 2 : maxSequenceCount <= 256 ? 3 : maxSequenceCount <= 1024 ? 4 : 5]++;
+	if (calls % 2000) { return; }
+	fprintf(stderr, "[mvk-info] vkCmdExecuteGeneratedCommandsEXT(): %llu calls, %llu dispatches, %llu with a count buffer, %.1f sequences"
+			   " allowed a call; max sequences 1: %llu, 2-16: %llu, 17-64: %llu, 65-256: %llu, 257-1024: %llu, more: %llu\n",
+			   calls, dispatchCalls, countedCalls, double(sequences) / calls,
+			   buckets[0], buckets[1], buckets[2], buckets[3], buckets[4], buckets[5]);
+}
+
+void MVKCmdExecuteGeneratedCommands::encode(MVKCommandEncoder* cmdEncoder) {
+	if ( !_maxSequenceCount || !_layout || _layout->_actionType == VK_INDIRECT_COMMANDS_TOKEN_TYPE_MAX_ENUM_EXT ) { return; }
+	if (_layout->_actionType != VK_INDIRECT_COMMANDS_TOKEN_TYPE_DISPATCH_EXT && mvkSkipsUnsupportedDraw(cmdEncoder)) { return; }
+	// Generated push constants are in the app's own layout, not a Metal Shader Converter top-level argument buffer
+	// (VKD3D-Proton uses SPIR-V pipelines for these): skip the draws.
+	if (_layout->_actionType != VK_INDIRECT_COMMANDS_TOKEN_TYPE_DISPATCH_EXT &&
+		cmdEncoder->getGraphicsPipeline() && cmdEncoder->getGraphicsPipeline()->isMSC()) {
+		static bool reportedDraw = false;
+		if ( !reportedDraw ) {
+			reportedDraw = true;
+			cmdEncoder->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkCmdExecuteGeneratedCommandsEXT(): Draws with a Metal Shader Converter pipeline are not supported, and are skipped.");
+		}
+		return;
+	}
+	// Generated push constants are in the app's own layout, not a Metal Shader Converter top-level argument buffer
+	// (VKD3D-Proton uses a SPIR-V pipeline for these): skip the dispatches.
+	if (_layout->_actionType == VK_INDIRECT_COMMANDS_TOKEN_TYPE_DISPATCH_EXT &&
+		cmdEncoder->getComputePipeline() && cmdEncoder->getComputePipeline()->isMSC()) {
+		static bool reported = false;
+		if ( !reported ) {
+			reported = true;
+			cmdEncoder->reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkCmdExecuteGeneratedCommandsEXT(): Dispatches with a Metal Shader Converter pipeline are not supported, and are skipped.");
+		}
+		return;
+	}
+	mvkLogGeneratedCommandsStats(_layout->_actionType, _maxSequenceCount, _mtlCount != nil);
+
+	uint32_t argsSize;
+	switch (_layout->_actionType) {
+		case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_EXT:         argsSize = sizeof(VkDrawIndirectCommand); break;
+		case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_INDEXED_EXT: argsSize = sizeof(VkDrawIndexedIndirectCommand); break;
+		case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DISPATCH_EXT:     argsSize = sizeof(VkDispatchIndirectCommand); break;
+		default:                                               argsSize = sizeof(VkDrawMeshTasksIndirectCommandEXT); break;
+	}
+	// Each sequence's push constants are the current ones with the tokens' ranges set.
+	const auto& pushConstants = cmdEncoder->getState().vkShared()._pushConstants;
+	uint32_t pcSize = (std::max<uint32_t>((uint32_t)pushConstants.size(), _layout->_pushConstantsSize) + 3) & ~3u;
+	uint32_t pcStride = _layout->_pushConstantTokens.empty() ? 0 : (pcSize + 15) & ~15u;
+	auto* args = cmdEncoder->getTempMTLBuffer(_maxSequenceCount * argsSize, true);
+	auto* pcBuff = pcStride ? cmdEncoder->getTempMTLBuffer(_maxSequenceCount * pcStride, true) : nullptr;
+
+	bool isRendering = cmdEncoder->_mtlRenderEncoder != nil;
+
+	// Vertex and index buffer tokens: the draws run from an indirect command buffer that a kernel encodes,
+	// which needs a variant of the pipeline that supports them, and so a plain pipeline.
+	bool isDraw = _layout->_actionType == VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_EXT ||
+				  _layout->_actionType == VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_INDEXED_EXT;
+	id<MTLRenderPipelineState> icbPipelineState = nil;
+	id<MTLIndirectCommandBuffer> icb = nil;
+	const MVKMTLBufferAllocation* icbBindings = nullptr;
+	MVKGraphicsPipeline* pipeline = cmdEncoder->getGraphicsPipeline();
+	if (_layout->hasBufferTokens() && isRendering && isDraw && pipeline) {
+		if ( !pipeline->isGeometryPipeline() && !cmdEncoder->getSubpass()->isMultiview() && !cmdEncoder->_transformFeedbackRunning ) {
+			icbPipelineState = pipeline->getIndirectPipelineStateForAttachments(cmdEncoder->_mtlRenderPassFormats);
+		}
+		if (icbPipelineState) {
+			// Pooled: only the first _maxSequenceCount commands are encoded and run (the kernel resets those past the count).
+			icb = cmdEncoder->getDevice()->acquireDGCIndirectCommandBuffer(_maxSequenceCount);	// retained
+			icbBindings = cmdEncoder->getTempMTLBuffer(sizeof(MVKDGCBindings));
+		}
+		static bool warned = false;
+		if ( !icb && !warned ) {
+			warned = true;
+			MVKLogWarn("vkCmdExecuteGeneratedCommandsEXT(): Vertex and index buffer tokens can't be applied with this pipeline, and are ignored.");
+		}
+	}
+
+	if (isRendering) { cmdEncoder->encodeStoreActions(true); }
+	id<MTLComputeCommandEncoder> mtlEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDrawIndirectConvertBuffers);
+	auto& mtlCompute = cmdEncoder->getMtlCompute();
+	id<MTLComputePipelineState> expandState = cmdEncoder->getCommandEncodingPool()->getCmdExecuteGeneratedCommandsExpandMTLComputePipelineState();
+	mtlCompute.bindPipeline(mtlEncoder, expandState);
+	mtlCompute.bindBuffer(mtlEncoder, _mtlStream, _mtlStreamOffset, 0);
+	mtlCompute.bindBuffer(mtlEncoder, _mtlCount ? _mtlCount : args->_mtlBuffer, _mtlCount ? _mtlCountOffset : args->_offset, 1);
+	MVKDGCParams params = { _maxSequenceCount, _layout->_stride, pcStride, pcSize, argsSize, _layout->_actionOffset,
+							(uint32_t)_layout->_pushConstantTokens.size(), _mtlCount != nil };
+	mtlCompute.bindBytes(mtlEncoder, &params, sizeof(params), 2);
+	MVKIndirectCommandsLayout::PushConstantToken noToken = {};
+	mtlCompute.bindBytes(mtlEncoder, params.tokenCount ? (const void*)_layout->_pushConstantTokens.data() : &noToken,
+						 std::max<size_t>(params.tokenCount, 1) * sizeof(noToken), 3);
+	MVKSmallVector<uint8_t, 256> base(std::max<uint32_t>(pcSize, 4), 0);
+	if ( !pushConstants.empty() ) { memcpy(base.data(), pushConstants.data(), pushConstants.size()); }
+	mtlCompute.bindBytes(mtlEncoder, base.data(), base.size(), 4);
+	mtlCompute.bindBuffer(mtlEncoder, args->_mtlBuffer, args->_offset, 5);
+	mtlCompute.bindBuffer(mtlEncoder, pcBuff ? pcBuff->_mtlBuffer : args->_mtlBuffer, pcBuff ? pcBuff->_offset : args->_offset, 6);
+	[mtlEncoder dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(_maxSequenceCount, expandState.threadExecutionWidth), 1, 1)
+			   threadsPerThreadgroup: MTLSizeMake(expandState.threadExecutionWidth, 1, 1)];
+
+	// The kernel reads the bindings, which are filled in below, once the render pass binds them.
+	MVKSmallVector<MVKDGCVertexBufferToken, 4> vbTokens;
+	if (icb) {
+		id<MTLComputePipelineState> icbState = cmdEncoder->getCommandEncodingPool()->getCmdExecuteGeneratedCommandsICBMTLComputePipelineState();
+		bool dynamicStride = pipeline->getDynamicStateFlags().has(MVKRenderStateFlag::VertexStride);
+		for (auto& tok : _layout->_vertexBufferTokens) {
+			vbTokens.push_back({ tok.streamOffset, pipeline->getMetalBufferIndexForVertexAttributeBinding(tok.binding), dynamicStride, 0 });
+		}
+		MVKDGCVertexBufferToken noToken = {};
+		MVKDGCICBParams icbParams = { _maxSequenceCount, _layout->_stride, _layout->_actionOffset,
+									  _layout->_actionType == VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_INDEXED_EXT, _mtlCount != nil,
+									  (uint32_t)vbTokens.size(), _layout->_indexBufferStreamOffset, _layout->_indexBufferDXGI };
+		MTLResourceID icbID = icb.gpuResourceID;
+		mtlCompute.bindPipeline(mtlEncoder, icbState);
+		mtlCompute.bindBytes(mtlEncoder, &icbID, sizeof(icbID), 0);
+		mtlCompute.bindBuffer(mtlEncoder, _mtlStream, _mtlStreamOffset, 1);
+		mtlCompute.bindBuffer(mtlEncoder, _mtlCount ? _mtlCount : args->_mtlBuffer, _mtlCount ? _mtlCountOffset : args->_offset, 2);
+		mtlCompute.bindBytes(mtlEncoder, &icbParams, sizeof(icbParams), 3);
+		mtlCompute.bindBytes(mtlEncoder, vbTokens.empty() ? &noToken : vbTokens.data(), std::max<size_t>(vbTokens.size(), 1) * sizeof(noToken), 4);
+		mtlCompute.bindBuffer(mtlEncoder, icbBindings->_mtlBuffer, icbBindings->_offset, 5);
+		[mtlEncoder useResource: icb usage: MTLResourceUsageWrite];
+		[mtlEncoder dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(_maxSequenceCount, icbState.threadExecutionWidth), 1, 1)
+				   threadsPerThreadgroup: MTLSizeMake(icbState.threadExecutionWidth, 1, 1)];
+	}
+	if (isRendering) { cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass); }
+
+	if (icb) {
+		encodeIndirectCommandBuffer(cmdEncoder, icb, icbPipelineState, icbBindings, pcBuff, pcStride);
+		return;
+	}
+
+	for (uint32_t i = 0; i < _maxSequenceCount; i++) {
+		if (pcBuff) { cmdEncoder->getState().setPushConstantsBuffer(pcBuff->_mtlBuffer, pcBuff->_offset + i * pcStride); }
+		NSUInteger argsOffset = args->_offset + i * argsSize;
+		switch (_layout->_actionType) {
+			case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_EXT: {
+				MVKCmdDrawIndirect cmd;
+				cmd.setContent(args->_mtlBuffer, argsOffset, 1, argsSize);
+				cmd.encode(cmdEncoder);
+				break;
+			}
+			case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_INDEXED_EXT: {
+				MVKCmdDrawIndexedIndirect cmd;
+				cmd.setContent(cmdEncoder->_cmdBuffer, args->_mtlBuffer, argsOffset, 1, argsSize);
+				cmd.encode(cmdEncoder);
+				break;
+			}
+			case VK_INDIRECT_COMMANDS_TOKEN_TYPE_DRAW_MESH_TASKS_EXT: {
+				MVKCmdDrawMeshTasksIndirect cmd;
+				cmd.setContent(args->_mtlBuffer, argsOffset, 1, argsSize);
+				cmd.encode(cmdEncoder);
+				break;
+			}
+			default:
+				cmdEncoder->finalizeDispatchState();
+				[cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDispatch) dispatchThreadgroupsWithIndirectBuffer: args->_mtlBuffer
+																							indirectBufferOffset: argsOffset
+																						   threadsPerThreadgroup: cmdEncoder->getComputePipeline()->getThreadgroupSize()];
+				break;
+		}
+	}
+	if (pcBuff) { cmdEncoder->getState().setPushConstantsBuffer(nil, 0); }
+}
+
+void MVKCmdExecuteGeneratedCommands::encodeIndirectCommandBuffer(MVKCommandEncoder* cmdEncoder,
+																 id<MTLIndirectCommandBuffer> icb,
+																 id<MTLRenderPipelineState> icbPipelineState,
+																 const MVKMTLBufferAllocation* icbBindings,
+																 const MVKMTLBufferAllocation* pcBuff,
+																 uint32_t pcStride) {
+	// The render pass just began, so preparing the draw binds everything the pipeline uses: capture it.
+	if (pcBuff) { cmdEncoder->getState().setPushConstantsBuffer(pcBuff->_mtlBuffer, pcBuff->_offset); }
+	id<MTLRenderCommandEncoder> mtlRender = cmdEncoder->_mtlRenderEncoder;
+	MVKDGCBindingCapture* capture = [MVKDGCBindingCapture alloc];	// retained
+	capture->_target = mtlRender;
+	capture->_cmdEncoder = cmdEncoder;
+	capture->_vertexMask = capture->_fragmentMask = 0;
+	cmdEncoder->_mtlRenderEncoder = (id<MTLRenderCommandEncoder>)capture;
+	cmdEncoder->finalizeDrawState(kMVKGraphicsStageRasterization);
+	cmdEncoder->_mtlRenderEncoder = mtlRender;
+
+	auto* bindings = (MVKDGCBindings*)icbBindings->getContents();
+	mvkClear(bindings);
+	auto fill = [&](MVKDGCBufferEntry* entries, const MVKDGCCapturedBuffer* captured, uint32_t mask) {
+		for (uint32_t i = 0; i < kMVKMaxBufferCount; i++) {
+			if ( !(mask & (1u << i)) ) { continue; }
+			const auto& c = captured[i];
+			bool isPushConstants = pcBuff && c.buffer == pcBuff->_mtlBuffer && c.offset == pcBuff->_offset;
+			entries[i] = { c.buffer.gpuAddress + c.offset, (uint32_t)c.stride, (isPushConstants ? 1u : 0u) | (c.hasStride ? 2u : 0u) };
+			[mtlRender useResource: c.buffer usage: MTLResourceUsageRead stages: MTLRenderStageVertex | MTLRenderStageFragment];
+		}
+	};
+	fill(bindings->vertexBuffers, capture->_vertex, capture->_vertexMask);
+	fill(bindings->fragmentBuffers, capture->_fragment, capture->_fragmentMask);
+	bindings->vertexMask = capture->_vertexMask;
+	bindings->fragmentMask = capture->_fragmentMask;
+	bindings->pushConstantsStride = pcStride;
+	bindings->primitiveType = (uint32_t)cmdEncoder->getMtlGraphics().getPrimitiveType();
+	const auto& indexBuffer = cmdEncoder->getVkGraphics()._indexBuffer;
+	if (indexBuffer.mtlBuffer) {
+		bindings->indexAddress = indexBuffer.mtlBuffer.gpuAddress + indexBuffer.offset;
+		bindings->indexType = indexBuffer.mtlIndexType;
+		[mtlRender useResource: indexBuffer.mtlBuffer usage: MTLResourceUsageRead stages: MTLRenderStageVertex];
+	}
+	[capture release];
+
+	// The tokens' buffers are found by address, so every GPU addressable buffer must be resident.
+	auto& mtlShared = cmdEncoder->getState().mtlShared();
+	if (mtlShared._gpuAddressableResourceStages != MVKResourceUsageStages::Vertex &&
+		mtlShared._gpuAddressableResourceStages != MVKResourceUsageStages::All) {
+		mtlShared._gpuAddressableResourceStages = mtlShared._gpuAddressableResourceStages == MVKResourceUsageStages::None
+			? MVKResourceUsageStages::Vertex : MVKResourceUsageStages::All;
+		cmdEncoder->getDevice()->encodeGPUAddressableBuffers(mtlShared._useResource, MVKResourceUsageStages::Vertex);
+		mtlShared._useResource.bindAndResetGraphics(mtlRender);
+	}
+
+	[mtlRender setRenderPipelineState: icbPipelineState];
+	[mtlRender useResource: icb usage: MTLResourceUsageRead stages: MTLRenderStageVertex | MTLRenderStageFragment];
+	[mtlRender executeCommandsInBuffer: icb withRange: NSMakeRange(0, _maxSequenceCount)];
+	[mtlRender setRenderPipelineState: cmdEncoder->getMtlGraphics()._pipeline];
+
+	// The commands set their own buffers: bind them all again for the next draw.
+	auto& mtlGraphics = cmdEncoder->getMtlGraphics();
+	for (auto stage : { MVKMetalGraphicsStage::Vertex, MVKMetalGraphicsStage::Fragment }) {
+		mtlGraphics._exists[stage].buffers.reset();
+		mtlGraphics._exists[stage].descriptorSetData.reset();
+	}
+	if (pcBuff) { cmdEncoder->getState().setPushConstantsBuffer(nil, 0); }
+	MVKDevice* device = cmdEncoder->getDevice();
+	[cmdEncoder->_mtlCmdBuffer addCompletedHandler: ^(id<MTLCommandBuffer>) { device->releaseDGCIndirectCommandBuffer(icb); }];
+}
