+// The input primitives of a draw of so many vertexes (or indexes) with the VkPrimitiveTopology.
+static uint32_t mvkMeshDrawPrimitiveCount(uint32_t topology, uint32_t v) {
+	switch (topology) {
+		case 0: return v;
+		case 1: return v / 2;
+		case 2: return v > 1 ? v - 1 : 0;
+		case 3: return v / 3;
+		case 4:
+		case 5: return v > 2 ? v - 2 : 0;
+		case 6: return v / 4;
+		case 7: return v > 3 ? v - 3 : 0;
+		case 8: return v / 6;
+		case 9: return v >= 6 ? (v - 4) / 2 : 0;
+		default: return 0;
+	}
