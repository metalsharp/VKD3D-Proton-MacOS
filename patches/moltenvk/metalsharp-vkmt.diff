+
+kernel void cmdExecuteGeneratedCommandsExpand(const device uchar* stream [[buffer(0)]],
+                                              const device uint32_t* countBuff [[buffer(1)]],
+                                              constant MVKDGCParams& params [[buffer(2)]],
+                                              constant MVKDGCPushConstantToken* tokens [[buffer(3)]],
+                                              constant uint32_t* basePushConstants [[buffer(4)]],
+                                              device uint32_t* args [[buffer(5)]],
+                                              device uint32_t* pushConstants [[buffer(6)]],
+                                              uint idx [[thread_position_in_grid]]) {
+	if (idx >= params.sequenceCount) { return; }
+	uint32_t count = params.hasCount ? min(countBuff[0], params.sequenceCount) : params.sequenceCount;
