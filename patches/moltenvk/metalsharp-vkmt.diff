+	if (drawInfo.indexed) {
+		const device auto& src = *reinterpret_cast<const device MTLDrawIndexedPrimitivesIndirectArguments*>(srcBuff + idx * srcStride);
+		count = src.indexCount;
+		instanceCount = src.instanceCount;
+		info.indexBuffer += uint64_t(src.indexStart) * uint64_t(drawInfo.indexSize);
+		info.baseVertex = src.baseVertex;
+		info.baseInstance = src.baseInstance;
+	} else {
+		const device auto& src = *reinterpret_cast<const device MTLDrawPrimitivesIndirectArguments*>(srcBuff + idx * srcStride);
+		count = src.vertexCount;
+		instanceCount = src.instanceCount;
+		info.baseVertex = int32_t(src.vertexStart);
+		info.baseInstance = src.baseInstance;
+	}
+	info.primitiveCount = mvkMeshDrawPrimitiveCount(info.topology, count);
+	drawInfos[idx] = info;
+	bool any = info.primitiveCount && instanceCount;
+	dispatches[idx].threadgroupsPerGrid[0] = any ? info.primitiveCount : 0;
+	dispatches[idx].threadgroupsPerGrid[1] = any ? instanceCount : 0;
+	dispatches[idx].threadgroupsPerGrid[2] = any ? 1 : 0;
