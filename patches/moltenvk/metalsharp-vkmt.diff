+	MVKMSCBlobHeader hdr;
+	memcpy(&hdr, _mscBlob.data(), sizeof(hdr));
+	const uint8_t* blob = (const uint8_t*)_mscBlob.data();
+
+	// The flattened root signature, as the converter's 1.1 descriptor. Its enums have D3D12's values.
+	const uint8_t* pRootSig = blob + hdr.rootSigOffset;
+	uint32_t rsHdr[4];		// numParameters, numRanges, numStaticSamplers, flags
+	memcpy(rsHdr, pRootSig, sizeof(rsHdr));
