+// Runs the transform feedback capture stage of a draw on the vertex stage compute encoder,
+// then restarts the render pass that running it ended.
+static void mvkEncodeTransformFeedbackCapture(MVKCommandEncoder* cmdEncoder,
+											  id<MTLComputeCommandEncoder> mtlEncoder,
+											  MVKGraphicsPipeline* pipeline,
+											  const MVKMTLBufferAllocation* drawIDBuff,
+											  const MVKIndexMTLBufferBinding* ibb,
+											  VkDeviceSize idxBuffOffset,
+											  uint32_t firstVertex, uint32_t vertexCount,
+											  uint32_t firstInstance, uint32_t instanceCount) {
+	const auto& implicit = pipeline->getImplicitBuffers(kMVKShaderStageVertex).ids;
+	cmdEncoder->encodeTransformFeedbackCaptureBindings(mtlEncoder, pipeline);
+	if (pipeline->needsVertexOutputBuffer()) {
+		auto* vtxOutBuff = cmdEncoder->getTempMTLBuffer(vertexCount * instanceCount * 4 * cmdEncoder->getDeviceProperties().limits.maxVertexOutputComponents, true);
+		[mtlEncoder setBuffer: vtxOutBuff->_mtlBuffer offset: vtxOutBuff->_offset atIndex: implicit[MVKImplicitBuffer::Output]];
+	}
+	if (drawIDBuff) {
+		[mtlEncoder setBuffer: drawIDBuff->_mtlBuffer offset: drawIDBuff->_offset atIndex: implicit[MVKImplicitBuffer::DrawId]];
+	}
+	if (ibb) {
+		[mtlEncoder setBuffer: ibb->mtlBuffer offset: idxBuffOffset atIndex: implicit[MVKImplicitBuffer::Index]];
+	}
+	[mtlEncoder setStageInRegion: MTLRegionMake2D(firstVertex, firstInstance, vertexCount, instanceCount)];
+	cmdEncoder->getState().offsetZeroDivisorVertexBuffers(*cmdEncoder, kMVKGraphicsStageVertex, pipeline, firstInstance);
+	id<MTLComputePipelineState> vtxState = (!ibb ? pipeline->getVertexStageState()
+											: ibb->mtlIndexType == MTLIndexTypeUInt16 ? pipeline->getVertexStageIndex16State()
+											: pipeline->getVertexStageIndex32State());
+	if (cmdEncoder->getMetalFeatures().nonUniformThreadgroups) {
+		[mtlEncoder dispatchThreads: MTLSizeMake(vertexCount, instanceCount, 1)
+			  threadsPerThreadgroup: MTLSizeMake(vtxState.threadExecutionWidth, 1, 1)];
+	} else {
+		[mtlEncoder dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(vertexCount, vtxState.threadExecutionWidth), instanceCount, 1)
+				   threadsPerThreadgroup: MTLSizeMake(vtxState.threadExecutionWidth, 1, 1)];
+	}
+	cmdEncoder->encodeTransformFeedbackCaptureEnd(mtlEncoder);
+	cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+}
