+	vector<IRDescriptorRange1> ranges(rangeCount);
+	for (uint32_t i = 0; i < rangeCount; i++) {
+		uint32_t r[6];
+		memcpy(r, pRanges + i * kMVKMSCRangeSize, sizeof(r));
+		ranges[i] = { (IRDescriptorRangeType)r[0], r[1], r[2], r[3], (IRDescriptorRangeFlags)r[4], r[5] };
+	}
