+#pragma mark -
+#pragma mark Metal Shader Converter bridge
+
+// The functions of Metal Shader Converter (libmetalirconverter.dylib) the bridge calls.
+#define MVK_MSC_FUNCTIONS(F) \
+	F(IRRootSignatureCreateFromDescriptor) F(IRRootSignatureDestroy) \
+	F(IRCompilerCreate) F(IRCompilerDestroy) F(IRCompilerSetGlobalRootSignature) F(IRCompilerSetCompatibilityFlags) \
+	F(IRCompilerAllocCompileAndLink) \
+	F(IRObjectCreateFromDXIL) F(IRObjectDestroy) F(IRObjectGetMetalIRShaderStage) F(IRObjectGetMetalLibBinary) \
+	F(IRObjectGetReflection) \
+	F(IRMetalLibBinaryCreate) F(IRMetalLibBinaryDestroy) F(IRMetalLibGetBytecodeSize) F(IRMetalLibGetBytecode) \
+	F(IRShaderReflectionCreate) F(IRShaderReflectionDestroy) F(IRShaderReflectionGetEntryPointFunctionName) \
+	F(IRShaderReflectionCopyComputeInfo) F(IRShaderReflectionReleaseComputeInfo) \
+	F(IRShaderReflectionCopyVertexInfo) F(IRShaderReflectionReleaseVertexInfo) \
+	F(IRErrorGetCode) F(IRErrorGetPayload) F(IRErrorDestroy)
+
+// Metal Shader Converter, loaded on first use. Apple ships it apart from macOS and MoltenVK doesn't link it, so
+// it's looked for next to libMoltenVK.dylib, then in /usr/local/lib, where Apple's installer puts it.
+struct MVKMetalShaderConverter {
+#define MVK_MSC_DECLARE(func) decltype(&::func) func = nullptr;
+	MVK_MSC_FUNCTIONS(MVK_MSC_DECLARE)
+#undef MVK_MSC_DECLARE
+	decltype(&::IRCompilerIgnoreRootSignature) IRCompilerIgnoreRootSignature = nullptr;	// Optional
+	string error;		// Why it couldn't be loaded, if it couldn't
+
+	MVKMetalShaderConverter() {
+		static const char* libName = "libmetalirconverter.dylib";
+		vector<string> paths;
+		Dl_info info;
+		if (dladdr((const void*)&MVKMetalShaderConverter::get, &info) && info.dli_fname) {	// libMoltenVK.dylib
+			string mvkPath = info.dli_fname;
+			size_t slash = mvkPath.rfind('/');
+			if (slash != string::npos) { paths.push_back(mvkPath.substr(0, slash + 1) + libName); }
+		}
+		paths.push_back(string("/usr/local/lib/") + libName);
+
+		uint64_t startTime = mvkGetTimestamp();
+		void* lib = nullptr;
+		for (auto& path : paths) {
+			lib = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+			if (lib) {
+				MVK_MS_TRACE(Shader, "Metal Shader Converter: loaded %s in %.3f ms", path.c_str(), mvkGetElapsedMilliseconds(startTime));
+				break;
+			}
+			const char* dlErr = dlerror();
+			error += (error.empty() ? "" : "; ") + string(dlErr ? dlErr : path.c_str());
+		}
+		if ( !lib ) {
+			error = "Could not load " + string(libName) + ": " + error;
+			return;
+		}
+		error.clear();
+#define MVK_MSC_LOAD(func) \
+		func = (decltype(func))dlsym(lib, #func); \
+		if ( !func && error.empty() ) { error = string(libName) + " has no function " #func "."; }
+		MVK_MSC_FUNCTIONS(MVK_MSC_LOAD)
+#undef MVK_MSC_LOAD
+		IRCompilerIgnoreRootSignature = (decltype(IRCompilerIgnoreRootSignature))dlsym(lib, "IRCompilerIgnoreRootSignature");
+	}
+
+	// Returns the message of the converter's error, and destroys it.
+	string takeErrorMessage(IRError*& irErr, const char* step) const {
+		string msg = step;
+		if (irErr) {
+			// The payload of the errors the converter reports is its message.
+			const char* payload = (const char*)IRErrorGetPayload(irErr);
+			msg += " failed (error " + to_string(IRErrorGetCode(irErr)) + ")" + (payload ? string(": ") + payload : string("."));
+			IRErrorDestroy(irErr);
+			irErr = nullptr;
+		} else {
+			msg += " failed.";
+		}
+		return msg;
+	}
+
+	static const MVKMetalShaderConverter& get() {
+		static const MVKMetalShaderConverter msc;
+		return msc;
+	}
