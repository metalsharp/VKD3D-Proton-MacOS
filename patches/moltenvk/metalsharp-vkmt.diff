+#pragma mark -
+#pragma mark METALSHARP_TRACE=gpu watchdog
+
+// Every MTLCommandBuffer is watched from creation to completion. A buffer committed for longer than
+// METALSHARP_TRACE_GPU_HANG_MS (default 2000) is reported once, with whether it is still waiting to be
+// scheduled (blocked on an event or semaphore wait) or running on the GPU, and again when it completes.
+// gpu+heavy also logs the GPU time of every buffer.
+namespace {
+struct MVKMSWatchedCmdBuff {
+	uint64_t committedNS = 0;	// When the watchdog first saw it committed
+	bool reported = false;
+};
+
+mutex _msWatchLock;
+unordered_map<id<MTLCommandBuffer>, MVKMSWatchedCmdBuff> _msWatched;	// retained keys
+dispatch_source_t _msWatchTimer;
+
+uint64_t mvkMSHangNS() {
+	static uint64_t hangNS = [] {
+		const char* ms = getenv("METALSHARP_TRACE_GPU_HANG_MS");
+		uint64_t v = ms ? strtoull(ms, nullptr, 10) : 0;
+		return (v ? v : 2000) * 1000000ull;
+	}();
+	return hangNS;
+}
+
+void mvkMSWatchCheck() {
+	lock_guard<mutex> lock(_msWatchLock);
+	uint64_t now = mvkGetRuntimeNanoseconds();
+	for (auto& [mtlCB, w] : _msWatched) {
+		MTLCommandBufferStatus status = mtlCB.status;
+		if (status < MTLCommandBufferStatusCommitted || status > MTLCommandBufferStatusScheduled) { continue; }
+		if ( !w.committedNS ) { w.committedNS = now; continue; }
+		if ( !w.reported && now - w.committedNS >= mvkMSHangNS()) {
+			w.reported = true;
+			mvkMSTracePrintf(kMVKMSTraceGPU, "GPU HANG? %s %p committed for %.0f ms and still %s",
+							 mtlCB.label.UTF8String ?: "MTLCommandBuffer", mtlCB, (double)(now - w.committedNS) / 1.0e6,
+							 status == MTLCommandBufferStatusScheduled ? "running on the GPU"
+							 : "waiting to be scheduled (blocked on an event or semaphore wait)");
+		}
+	}
+}
+
+void mvkMSWatch(id<MTLCommandBuffer> mtlCmdBuff) {
+	{
+		lock_guard<mutex> lock(_msWatchLock);
+		if ( !_msWatchTimer ) {
+			_msWatchTimer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_global_queue(QOS_CLASS_UTILITY, 0));
+			dispatch_source_set_timer(_msWatchTimer, dispatch_time(DISPATCH_TIME_NOW, 250 * NSEC_PER_MSEC), 250 * NSEC_PER_MSEC, 50 * NSEC_PER_MSEC);
+			dispatch_source_set_event_handler(_msWatchTimer, ^{ mvkMSWatchCheck(); });
+			dispatch_resume(_msWatchTimer);
+		}
+		_msWatched[[mtlCmdBuff retain]] = {};
+	}
+	[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer> mtlCB) {
+		MVKMSWatchedCmdBuff w;
+		{
+			lock_guard<mutex> lock(_msWatchLock);
+			auto it = _msWatched.find(mtlCB);
+			if (it == _msWatched.end()) { return; }
+			w = it->second;
+			_msWatched.erase(it);
+		}
+		double gpuMS = (mtlCB.GPUEndTime - mtlCB.GPUStartTime) * 1000.0;
+		if (w.reported) {
+			bool failed = mtlCB.status == MTLCommandBufferStatusError;
+			mvkMSTracePrintf(kMVKMSTraceGPU, "%s %p %s after %.0f ms (GPU time %.3f ms)%s%s",
+							 mtlCB.label.UTF8String ?: "MTLCommandBuffer", mtlCB, failed ? "FAILED" : "completed",
+							 (double)(mvkGetRuntimeNanoseconds() - w.committedNS) / 1.0e6, gpuMS,
+							 failed ? ": " : "", failed ? [NSString stringWithFormat: @"error %ld, %@", (long)mtlCB.error.code,
+																	mtlCB.error.localizedDescription].UTF8String : "");
+		} else if (mtlCB.status == MTLCommandBufferStatusError || (mvkMSTraceHeavyMask() & kMVKMSTraceGPU)) {
+			mvkMSTracePrintf(kMVKMSTraceGPU, "%s %p GPU time %.3f ms%s%s", mtlCB.label.UTF8String ?: "MTLCommandBuffer", mtlCB, gpuMS,
+							 mtlCB.status == MTLCommandBufferStatusError ? ", FAILED: " : "",
+							 mtlCB.status == MTLCommandBufferStatusError ? [NSString stringWithFormat: @"error %ld, %@", (long)mtlCB.error.code,
+																			mtlCB.error.localizedDescription].UTF8String : "");
+		}
+		[mtlCB release];
+	}];
+}
+}
