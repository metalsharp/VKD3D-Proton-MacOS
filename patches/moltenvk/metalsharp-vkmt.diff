+		_samples != VK_SAMPLE_COUNT_1_BIT || _isLinear || _isLinearForAtomics ) {
+		setConfigurationResult(reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkCreateImage(): Sparse images of format %s and this configuration are not supported.", getPixelFormats()->getName(pCreateInfo->format)));
+		return;
+	}
+	_isSparse = true;
+
+	id<MTLTexture> tex = getMTLTexture(0);
+	if ( !tex ) {
+		setConfigurationResult(reportError(VK_ERROR_OUT_OF_DEVICE_MEMORY, "vkCreateImage(): Could not create a sparse texture."));
+		return;
+	}
+	_sparseMipTailFirstLod = std::min((uint32_t)tex.firstMipmapInTail, _mipLevels);
+	_sparseMipTailBlocks = _sparseMipTailFirstLod < _mipLevels
+		? (uint32_t)mvkCeilingDivide(std::max(tex.tailSizeInBytes, (NSUInteger)1), (NSUInteger)MVKPhysicalDevice::kSparseBlockSize) : 0;
+	_sparseMipFirstBlock.clear();
+	uint32_t blocks = 0;
+	for (uint32_t mipLvl = 0; mipLvl < _sparseMipTailFirstLod; mipLvl++) {
+		_sparseMipFirstBlock.push_back(blocks);
+		VkExtent3D count = getSparseMipBlockCounts(mipLvl);
+		blocks += count.width * count.height * count.depth;
+	}
+	_sparseMipFirstBlock.push_back(blocks);	// The tail
+	_sparseLayerBlocks = blocks + _sparseMipTailBlocks;
+
+	MVKImageMemoryBinding* memoryBinding = _planes[0]->getMemoryBinding();
+	memoryBinding->_byteCount = (VkDeviceSize)_sparseLayerBlocks * _arrayLayers * MVKPhysicalDevice::kSparseBlockSize;
+	memoryBinding->_byteAlignment = MVKPhysicalDevice::kSparseBlockSize;
+}
+
+VkExtent3D MVKImage::getSparseMipBlockCounts(uint32_t mipLevel) {
+	VkExtent3D extent = getExtent3D(0, mipLevel);
+	return { mvkCeilingDivide(extent.width, _sparseGranularity.width),
+			 mvkCeilingDivide(extent.height, _sparseGranularity.height),
+			 mvkCeilingDivide(extent.depth, _sparseGranularity.depth) };
+}
+
+void MVKImage::getSparseMemoryRequirements(uint32_t* pCount, VkSparseImageMemoryRequirements* pRequirements) {
+	if ( !_isSparse ) {
+		*pCount = 0;
+		return;
+	}
+	if ( !pRequirements ) {
+		*pCount = 1;
+		return;
+	}
+	if (*pCount == 0) { return; }
+	*pCount = 1;
+
+	uint32_t propCount = 1;
+	getPhysicalDevice()->getSparseImageFormatProperties(_vkFormat, getImageType(), _samples, _usage, VK_IMAGE_TILING_OPTIMAL,
+														&propCount, &pRequirements->formatProperties);
+	VkDeviceSize block = MVKPhysicalDevice::kSparseBlockSize;
+	pRequirements->imageMipTailFirstLod = _sparseMipTailFirstLod;
+	pRequirements->imageMipTailSize = (VkDeviceSize)_sparseMipTailBlocks * block;
+	pRequirements->imageMipTailOffset = (VkDeviceSize)_sparseMipFirstBlock.back() * block;
+	pRequirements->imageMipTailStride = (VkDeviceSize)_sparseLayerBlocks * block;
+}
+
+// Returns the heap a sparse bind maps onto, or nil to unmap; false if the memory cannot back sparse blocks.
+static bool mvkGetSparseBindHeap(VkDeviceMemory memory, id<MTLHeap>* pHeap) {
+	*pHeap = nil;
+	if ( !memory ) { return true; }
+	*pHeap = ((MVKDeviceMemory*)memory)->getSparseBindingMTLHeap();
+	return *pHeap != nil;
+}
+
+VkResult MVKImage::getSparseMappings(const VkSparseImageMemoryBind& bind, MVKSmallVector<MVKSparseTextureMapping, 8>& mappings) {
+	MVKSparseTextureMapping mapping = {};
+	if ( !mvkGetSparseBindHeap(bind.memory, &mapping.heap) ) {
+		return reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkQueueBindSparse(): The memory cannot back sparse blocks.");
+	}
+	if (bind.subresource.mipLevel >= _sparseMipTailFirstLod) {
+		return reportError(VK_ERROR_VALIDATION_FAILED_EXT, "vkQueueBindSparse(): Mip level %u is in the mip tail, which is bound with opaque binds.", bind.subresource.mipLevel);
+	}
+	const VkExtent3D& g = _sparseGranularity;
+	VkExtent3D mipExtent = getExtent3D(0, bind.subresource.mipLevel);
+	uint32_t x = (uint32_t)bind.offset.x / g.width, y = (uint32_t)bind.offset.y / g.height, z = (uint32_t)bind.offset.z / g.depth;
+	// The extent may end at the mip's edge, short of a whole block.
+	uint32_t w = mvkCeilingDivide(std::min(bind.extent.width, mipExtent.width - bind.offset.x), g.width);
+	uint32_t h = mvkCeilingDivide(std::min(bind.extent.height, mipExtent.height - bind.offset.y), g.height);
+	uint32_t d = mvkCeilingDivide(std::min(bind.extent.depth, mipExtent.depth - bind.offset.z), g.depth);
+	mapping.region = MTLRegionMake3D(x, y, z, w, h, d);
+	mapping.level = bind.subresource.mipLevel;
+	mapping.slice = bind.subresource.arrayLayer;
+	mapping.heapOffset = bind.memoryOffset / MVKPhysicalDevice::kSparseBlockSize;
+	mappings.push_back(mapping);
+	return VK_SUCCESS;
+}
+
+VkResult MVKImage::getSparseMappings(const VkSparseMemoryBind& bind, MVKSmallVector<MVKSparseTextureMapping, 8>& mappings) {
+	id<MTLHeap> heap = nil;
+	if ( !mvkGetSparseBindHeap(bind.memory, &heap) ) {
+		return reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkQueueBindSparse(): The memory cannot back sparse blocks.");
+	}
+	VkDeviceSize block = MVKPhysicalDevice::kSparseBlockSize;
+	uint32_t first = (uint32_t)(bind.resourceOffset / block);
+	uint32_t count = (uint32_t)mvkCeilingDivide(bind.size, block);
+	NSUInteger heapBlock = bind.memoryOffset / block;
+	uint32_t regularBlocks = _sparseMipFirstBlock.back();
+
+	for (uint32_t b = first; b < first + count; b++, heapBlock++) {
+		uint32_t layer = b / _sparseLayerBlocks;
+		uint32_t r = b % _sparseLayerBlocks;
+		if (layer >= _arrayLayers) { break; }
+
+		MVKSparseTextureMapping mapping = {};
+		mapping.heap = heap;
+		mapping.slice = layer;
+		mapping.heapOffset = heapBlock;
+		if (r >= regularBlocks) {
+			// A mip tail block.
+			mapping.level = _sparseMipTailFirstLod;
+			mapping.region = MTLRegionMake2D(r - regularBlocks, 0, 1, 1);
+		} else {
+			uint32_t mip = 0;
+			while (mip + 1 < _sparseMipTailFirstLod && _sparseMipFirstBlock[mip + 1] <= r) { mip++; }
+			VkExtent3D counts = getSparseMipBlockCounts(mip);
+			uint32_t local = r - _sparseMipFirstBlock[mip];
+			mapping.level = mip;
+			mapping.region = MTLRegionMake3D(local % counts.width, (local / counts.width) % counts.height,
+											 local / (counts.width * counts.height), 1, 1, 1);
+		}
+
+		// Extend the previous mapping along its row when this block follows it.
+		if ( !mappings.empty() ) {
+			auto& prev = mappings.back();
+			if (prev.heap == mapping.heap && prev.level == mapping.level && prev.slice == mapping.slice &&
+				r < regularBlocks && prev.region.origin.y == mapping.region.origin.y && prev.region.origin.z == mapping.region.origin.z &&
+				prev.region.size.height == 1 && prev.region.size.depth == 1 &&
+				prev.region.origin.x + prev.region.size.width == mapping.region.origin.x &&
+				(!heap || prev.heapOffset + prev.region.size.width == mapping.heapOffset)) {
+				prev.region.size.width++;
+				continue;
+			}
+		}
+		mappings.push_back(mapping);
+	}
+	return VK_SUCCESS;
+}
