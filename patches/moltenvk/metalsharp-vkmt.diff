+/** The bits of the Vulkan stages (1 << MVKShaderStage) whose resources are bound to the given stage of a Metal render encoder. */
+static uint32_t getVkStagesBoundTo(MVKMetalGraphicsStage stage) {
+	switch (stage) {
+		case MVKMetalGraphicsStage::Vertex:   return (1u << kMVKShaderStageVertex) | (1u << kMVKShaderStageTessEval);
+		case MVKMetalGraphicsStage::Fragment: return 1u << kMVKShaderStageFragment;
+		case MVKMetalGraphicsStage::Object:   return (1u << kMVKShaderStageVertex) | (1u << kMVKShaderStageTessCtl);
+		case MVKMetalGraphicsStage::Mesh:     return (1u << kMVKShaderStageVertex) | (1u << kMVKShaderStageGeometry);
+		case MVKMetalGraphicsStage::Count:    break;
+	}
+	return 0;
+}
