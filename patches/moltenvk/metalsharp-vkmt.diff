-uint32_t MVKComputePipeline::getImplicitBufferIndex(uint32_t bufferIndexOffset) {
+// Returns the function of a Metal Shader Converter module (the MSC bridge, docs/MSC-BRIDGE-CONTRACT.md in MetalSharp):
+// converted from DXIL by the converter instead of SPIRV-Cross, and kept out of pipeline caches. It reads everything
+// from its top-level argument buffer, the push constants, so the stage binds nothing else and has no bind script.
+MVKMTLFunction MVKComputePipeline::getMSCFunction(spv::ExecutionModel executionModel) {
+	const char* err = nullptr;
+	if (executionModel != spv::ExecutionModelGLCompute) {
+		err = "Only compute pipelines can use a Metal Shader Converter shader module.";
+	} else if ( !_device->hasResidencySet() ) {
+		// Nothing makes the resources the argument buffers reference resident but the device's residency set.
+		err = "Metal Shader Converter shaders need a device with a residency set.";
+	} else if (_module->getMSCHeapsOffset() != kMVKMSCNoHeaps &&
+			   uint64_t(_module->getMSCHeapsOffset()) + 2 * sizeof(uint64_t) > _layout->getPushConstantsLength()) {
+		err = "The Metal Shader Converter blob's heap addresses are past the pipeline layout's push constants.";
+	}
+	if (err) {
+		setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCreateComputePipelines(): %s", err));
+		return MVKMTLFunctionNull;
+	}
+
+	const MVKMSCConversion& conv = _module->getMSCConversion();
+	if ( !conv.mtlLibrary ) {
+		setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCreateComputePipelines(): Metal Shader Converter: %s", conv.error.c_str()));
+		return MVKMTLFunctionNull;
+	}
+	id<MTLFunction> mtlFunc = [conv.mtlLibrary newFunctionWithName: @(conv.entryPointName.c_str())];	// temp retained
+	if ( !mtlFunc ) {
+		setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCreateComputePipelines(): The converted Metal library has no function %s.", conv.entryPointName.c_str()));
+		return MVKMTLFunctionNull;
+	}
+	setMetalObjectLabel(mtlFunc, _module->getDebugName());
+
+	_isMSC = true;
+	_mscHeapsOffset = _module->getMSCHeapsOffset();
+	_traceSignpost = [[NSString alloc] initWithFormat: @"MSC cs %016llx", (unsigned long long)_module->getMSCDXILHash()];	// retained
+	_allowsDispatchBase = false;		// Its kernel has no stage-input region to pass the base in.
+	MVKMTLFunction func(mtlFunc, SPIRVToMSLConversionResultInfo(), conv.threadgroupSize);
+	[mtlFunc release];																			// temp release
+	return func;
+}
