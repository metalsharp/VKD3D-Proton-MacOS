+void MVKCommandEncoder::ensureDepthBoundsSnapshot() {
+	MVKRenderSubpass* subpass = getSubpass();
+	uint32_t depthIdx = subpass ? subpass->getDepthAttachmentIndex() : VK_ATTACHMENT_UNUSED;
+	MVKImageView* depthView = depthIdx < _attachments.size() ? _attachments[depthIdx] : nullptr;
+	id<MTLTexture> depthTex = depthView ? depthView->getMTLTexture() : nil;
+	if ( !depthTex || depthTex.storageMode == MTLStorageModeMemoryless ||
+		(depthTex.textureType != MTLTextureType2D && depthTex.textureType != MTLTextureType2DMultisample) ) {
+		_depthBoundsSnapshot = nil;
+		return;
+	}
+
+	id<MTLTexture> snap = _depthBoundsSnapshot;
+	if ( !snap || snap.width != depthTex.width || snap.height != depthTex.height || snap.pixelFormat != depthTex.pixelFormat ||
+		snap.sampleCount != depthTex.sampleCount || snap.textureType != depthTex.textureType ) {
+		// The device keeps one per queue and kind of attachment: making a texture at every command buffer, and at
+		// every change of depth target, took a third of the queue's encoding time (Metal's resource list lock)
+		snap = [getDevice()->getDepthBoundsSnapshot(_mtlCmdBuffer.commandQueue, depthTex) retain];	// until the command buffer completes
+		[_mtlCmdBuffer addCompletedHandler: ^(id<MTLCommandBuffer>) { [snap release]; }];
+		_depthBoundsSnapshot = snap;
+		_depthBoundsSnapshotValid = false;
+	}
+
+	bool enabled = getVkGraphics().pickRenderState(MVKRenderStateFlag::DepthBoundsTestEnable).enable.has(MVKRenderStateEnableFlag::DepthBoundsTest);
+	if (enabled && !_depthBoundsSnapshotValid) {
+		// Suspend the Metal render pass (storing its attachments), copy the depth, and resume it.
+		encodeStoreActions(true);
+		endCurrentMetalEncoding();
+		[getMTLBlitEncoder(kMVKCommandUseCopyImage) copyFromTexture: depthTex toTexture: snap];
+		beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+		_depthBoundsSnapshotValid = true;
+	}
+}
