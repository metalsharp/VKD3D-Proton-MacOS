+// Transform feedback: the capture buffers' byte offsets and sizes, and a capture's results
+// (written and needed primitives, bytes per buffer), which the capture shader records.
+typedef struct {
+	uint offset[4];
+	uint size[4];
+	uint written;
+	uint needed;
+	uint bytes[4];
+} TransformFeedbackState;
+
+// Loads the capture offsets from the counter buffers (GPU addresses; 0 for none).
+kernel void cmdTransformFeedbackLoad(device TransformFeedbackState& state [[buffer(0)]],
+                                     constant ulong4& counters [[buffer(1)]],
+                                     uint pos [[thread_position_in_grid]]) {
+	if (pos != 0) { return; }
+	for (uint i = 0; i < 4; i++) {
+		state.offset[i] = counters[i] ? *reinterpret_cast<device uint*>(counters[i]) : 0u;
+	}
+}
+
+// After a capture: advances the offsets, stores them to the counter buffers, and adds the
+// written and needed primitives to the active transform feedback queries.
+kernel void cmdTransformFeedbackAdvance(device TransformFeedbackState& state [[buffer(0)]],
+                                        constant ulong4& counters [[buffer(1)]],
+                                        constant ulong* queries [[buffer(2)]],
+                                        constant uint& queryCount [[buffer(3)]],
+                                        uint pos [[thread_position_in_grid]]) {
+	if (pos != 0) { return; }
+	for (uint i = 0; i < 4; i++) {
+		state.offset[i] += state.bytes[i];
+		state.bytes[i] = 0;
+		if (counters[i]) { *reinterpret_cast<device uint*>(counters[i]) = state.offset[i]; }
+	}
+	for (uint q = 0; q < queryCount; q++) {
+		device ulong* result = reinterpret_cast<device ulong*>(queries[q]);
+		result[0] += state.written;
+		result[1] += state.needed;
+	}
+	state.written = 0;
+	state.needed = 0;
+}
