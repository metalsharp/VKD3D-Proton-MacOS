+// Transform feedback from a geometry shader: the exclusive prefix sums of the primitives counted per input
+// primitive and invocation, in place, and their total at counts[n]. One threadgroup.
+kernel void cmdTransformFeedbackScan(device uint32_t* counts [[buffer(0)]],
+                                     constant uint32_t& n [[buffer(1)]],
+                                     uint lid [[thread_position_in_threadgroup]],
+                                     uint tgSize [[threads_per_threadgroup]]) {
+	threadgroup uint32_t sums[1024];
+	uint32_t chunk = (n + tgSize - 1) / tgSize;
+	uint32_t begin = min(lid * chunk, n), end = min(begin + chunk, n);
+	uint32_t s = 0;
+	for (uint32_t i = begin; i < end; i++) { s += counts[i]; }
+	sums[lid] = s;
+	threadgroup_barrier(mem_flags::mem_threadgroup);
+	if (lid == 0) {
+		uint32_t acc = 0;
+		for (uint32_t t = 0; t < tgSize; t++) { uint32_t v = sums[t]; sums[t] = acc; acc += v; }
+		counts[n] = acc;
+	}
+	threadgroup_barrier(mem_flags::mem_threadgroup);
+	uint32_t acc = sums[lid];
+	for (uint32_t i = begin; i < end; i++) { uint32_t v = counts[i]; counts[i] = acc; acc += v; }
+}
