+// VK_EXT_device_generated_commands: each sequence's action arguments (zeroed past the sequence count) and push
+// constants (the current ones with the tokens' ranges set from the stream, or to the sequence index).
+typedef struct {
+	uint32_t sequenceCount;
+	uint32_t stride;
+	uint32_t pushConstantsStride;
+	uint32_t pushConstantsSize;
+	uint32_t argsSize;
+	uint32_t actionOffset;
+	uint32_t tokenCount;
+	uint32_t hasCount;
