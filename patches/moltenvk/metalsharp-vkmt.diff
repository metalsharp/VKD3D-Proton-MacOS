+- (void) setFragmentBytes: (const void*) bytes length: (NSUInteger) length atIndex: (NSUInteger) index {
+	const MVKMTLBufferAllocation* alloc = _cmdEncoder->copyToTempMTLBufferAllocation(bytes, length);
+	mvkDGCCapture(_fragment, _fragmentMask, index, alloc->_mtlBuffer, alloc->_offset, 0, false);
+	[_target setFragmentBytes: bytes length: length atIndex: index];
+}
