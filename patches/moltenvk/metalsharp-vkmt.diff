+		desc.pixelFormat = depthTex.pixelFormat;
+		desc.width = depthTex.width;
+		desc.height = depthTex.height;
+		desc.sampleCount = depthTex.sampleCount;
+		desc.usage = MTLTextureUsageShaderRead;
+		desc.storageMode = MTLStorageModePrivate;
+		snap = [_physicalDevice->_mtlDevice newTextureWithDescriptor: desc];	// retained by the device
+		[desc release];
+	}
+	// Depth targets come and go with resolutions: the oldest snapshots go first, alive while command buffers hold them.
+	if (_depthBoundsSnapshots.size() >= 16) {
+		[_depthBoundsSnapshots.front().second release];
+		_depthBoundsSnapshots.erase(_depthBoundsSnapshots.begin());
+	}
+	_depthBoundsSnapshots.emplace_back(queue, snap);
+	return snap;
