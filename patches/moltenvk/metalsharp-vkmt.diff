+// Pipelines created without a VkPipelineCache (VKD3D-Proton passes none) share a device-wide
+// cache, persisted per application, so a relaunch reuses the converted MSL instead of running
+// SPIRV-Cross on every shader again, and the compiled libraries instead of Metal's front end.
+// MVK_CONFIG_PIPELINE_CACHE_PATH names the directory; set it to 0 to disable.
+static std::string mvkPipelineCacheBuildID() {
+#ifdef MVK_PIPELINE_CACHE_SOURCES_HASH
+	char hash[17];
+	snprintf(hash, sizeof(hash), "%016llx", (unsigned long long)uint64_t(MVK_PIPELINE_CACHE_SOURCES_HASH));
+	return hash;
+#endif
+	const uint8_t* uuid = mvkBuildUUID();
+	if ( !uuid ) { return "0"; }
+	char str[33];
+	for (int j = 0; j < 16; j++) { snprintf(str + j * 2, 3, "%02x", uuid[j]); }
+	return std::string(str, 16);
+}
