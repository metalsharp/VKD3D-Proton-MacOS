+		uint64_t values[] = {
+			(uint64_t)opts.languageVersion,
+			(uint64_t)opts.preserveInvariance,
+			[opts respondsToSelector: @selector(optimizationLevel)] ? (uint64_t)opts.optimizationLevel : ~0ull,
+			[opts respondsToSelector: @selector(mathMode)] ? (uint64_t)opts.mathMode : (uint64_t)opts.fastMathEnabled,
+			[opts respondsToSelector: @selector(mathFloatingPointFunctions)] ? (uint64_t)opts.mathFloatingPointFunctions : ~0ull,
+		};
+		hash = mvkHash(values, sizeof(values) / sizeof(values[0]), hash);
