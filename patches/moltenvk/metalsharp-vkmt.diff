+#pragma mark -
+#pragma mark MVKCmdBeginTransformFeedback
+
+template <size_t N>
+VkResult MVKCmdBeginTransformFeedback<N>::setContent(MVKCommandBuffer* cmdBuff,
+                                                     uint32_t firstCounterBuffer,
+                                                     uint32_t counterBufferCount,
+                                                     const VkBuffer* pCounterBuffers,
+                                                     const VkDeviceSize* pCounterBufferOffsets) {
+    _firstCounterBuffer = firstCounterBuffer;
+    _counterBuffers.clear();    // Clear for reuse
+    _counterBuffers.reserve(counterBufferCount);
+    _counterMTLBuffers.clear();
+    _counterMTLBuffers.reserve(counterBufferCount);
+    for (uint32_t bindIdx = 0; bindIdx < counterBufferCount; bindIdx++) {
+        // A null counter buffer starts capturing at offset zero.
+        auto* mvkBuffer = pCounterBuffers ? (MVKBuffer*)pCounterBuffers[bindIdx] : nullptr;
+        _counterBuffers.push_back(mvkBuffer ? mvkBuffer->getMTLBufferGPUAddress() + pCounterBufferOffsets[bindIdx] : 0);
+        _counterMTLBuffers.push_back(mvkBuffer ? mvkBuffer->getMTLBuffer() : nil);
+    }
+
+    return VK_SUCCESS;
+}
+
+template <size_t N>
+void MVKCmdBeginTransformFeedback<N>::encode(MVKCommandEncoder* cmdEncoder) {
+    if (cmdEncoder->_transformFeedbackRunning) {
+        return;
+    }
+
+    auto& counters = cmdEncoder->_graphicsResourcesState._transformFeedbackCounterAddresses;
+    auto& counterMTLBuffers = cmdEncoder->_graphicsResourcesState._transformFeedbackCounterBuffers;
+    mvkClear(counters, kMVKMaxTransformFeedbackBufferCount);
+    mvkClear(counterMTLBuffers, kMVKMaxTransformFeedbackBufferCount);
+    for (uint32_t i = 0; i < _counterBuffers.size() && _firstCounterBuffer + i < kMVKMaxTransformFeedbackBufferCount; i++) {
+        counters[_firstCounterBuffer + i] = _counterBuffers[i];
+        counterMTLBuffers[_firstCounterBuffer + i] = _counterMTLBuffers[i];
+    }
+    cmdEncoder->beginTransformFeedback();
+}
+
+template class MVKCmdBeginTransformFeedback<1>;
+template class MVKCmdBeginTransformFeedback<2>;
+template class MVKCmdBeginTransformFeedback<4>;
+
+
+#pragma mark -
+#pragma mark MVKCmdBindTransformFeedbackBuffers
+
+template <size_t N>
+VkResult MVKCmdBindTransformFeedbackBuffers<N>::setContent(MVKCommandBuffer *cmdBuffer,
+                                                        uint32_t firstBinding, uint32_t bindingCount,
+                                                        const VkBuffer *pBuffers,
+                                                        const VkDeviceSize *pOffsets,
+                                                       const VkDeviceSize *pSizes) {
+    _firstBinding = firstBinding;
+    _bindings.clear();	// Clear for reuse
+    _bindings.reserve(bindingCount);
+    MVKMTLBufferBinding b;
+    for (uint32_t bindIdx = 0; bindIdx < bindingCount; bindIdx++) {
+        auto* mvkBuffer = (MVKBuffer*)pBuffers[bindIdx];
+        b.index = firstBinding + bindIdx;
+        b.mtlBuffer = mvkBuffer->getMTLBuffer();
+        b.offset = mvkBuffer->getMTLBufferOffset() + pOffsets[bindIdx];
+        VkDeviceSize remaining = mvkBuffer->getByteCount() - pOffsets[bindIdx];
+        VkDeviceSize size = (pSizes && pSizes[bindIdx] != VK_WHOLE_SIZE) ? std::min(pSizes[bindIdx], remaining) : remaining;
+        b.size = (uint32_t)std::min<VkDeviceSize>(size, UINT32_MAX);
+        _bindings.push_back(b);
+    }
+
+    return VK_SUCCESS;
+}
+
+template <size_t N>
+void MVKCmdBindTransformFeedbackBuffers<N>::encode(MVKCommandEncoder *cmdEncoder) {
+    for (auto& b : _bindings) {
+        if (b.index < kMVKMaxTransformFeedbackBufferCount) { cmdEncoder->_graphicsResourcesState._transformFeedbackBufferBindings[b.index] = b; }
+    }
+}
+
+template class MVKCmdBindTransformFeedbackBuffers<1>;
+template class MVKCmdBindTransformFeedbackBuffers<2>;
+template class MVKCmdBindTransformFeedbackBuffers<4>;
+
+
+#pragma mark -
+#pragma mark MVKCmdDrawIndirectByteCount
+
+VkResult MVKCmdDrawIndirectByteCount::setContent(MVKCommandBuffer* cmdBuffer,
+                                                 uint32_t instanceCount,
+                                                 uint32_t firstInstance,
+                                                 VkBuffer counterBuffer,
+                                                 VkDeviceSize counterBufferOffset,
+                                                 uint32_t counterOffset,
+                                                 uint32_t vertexStride) {
+    auto* mvkBuffer = (MVKBuffer*)counterBuffer;
+    _mtlCounterBuffer = mvkBuffer->getMTLBuffer();
+    _mtlCounterBufferOffset = mvkBuffer->getMTLBufferOffset() + counterBufferOffset;
+    _params[0] = counterOffset;
+    _params[1] = vertexStride;
+    _params[2] = instanceCount;
+    _params[3] = firstInstance;
+    return VK_SUCCESS;
+}
+
+// Converts the counter to indirect draw arguments on the GPU, and draws with them.
+void MVKCmdDrawIndirectByteCount::encode(MVKCommandEncoder* cmdEncoder) {
+    if (mvkSkipsUnsupportedDraw(cmdEncoder)) { return; }
+    cmdEncoder->restartMetalRenderPassIfNeeded();
+    auto* args = cmdEncoder->getTempMTLBuffer(sizeof(MTLDrawPrimitivesIndirectArguments), true);
+
+    cmdEncoder->encodeStoreActions(true);
+    id<MTLComputeCommandEncoder> mtlEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDrawIndirectConvertBuffers);
+    auto& mtlCompute = cmdEncoder->getMtlCompute();
+    mtlCompute.bindPipeline(mtlEncoder, cmdEncoder->getCommandEncodingPool()->getCmdDrawIndirectByteCountMTLComputePipelineState());
+    mtlCompute.bindBuffer(mtlEncoder, _mtlCounterBuffer, _mtlCounterBufferOffset, 0);
+    mtlCompute.bindBuffer(mtlEncoder, args->_mtlBuffer, args->_offset, 1);
+    mtlCompute.bindBytes(mtlEncoder, _params, sizeof(_params), 2);
+    [mtlEncoder dispatchThreadgroups: MTLSizeMake(1, 1, 1) threadsPerThreadgroup: MTLSizeMake(1, 1, 1)];
+    cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+
+    MVKCmdDrawIndirect drawCmd;
+    drawCmd.setContent(args->_mtlBuffer, args->_offset, 1, sizeof(MTLDrawPrimitivesIndirectArguments));
+    drawCmd.encode(cmdEncoder);
+}
+
+#pragma mark -
+#pragma mark MVKCmdEndTransformFeedback
+
+VkResult MVKCmdEndTransformFeedback::setContent(MVKCommandBuffer *,
+                                                uint32_t firstCounterBuffer,
+                                                uint32_t counterBufferCount,
+                                                const VkBuffer* pCounterBuffers,
+                                                const VkDeviceSize* pCounterBufferOffsets) {
+    mvkClear(_counterBuffers, kMVKMaxTransformFeedbackBufferCount);
+    mvkClear(_counterMTLBuffers, kMVKMaxTransformFeedbackBufferCount);
+    for (uint32_t i = 0; i < counterBufferCount && firstCounterBuffer + i < kMVKMaxTransformFeedbackBufferCount; i++) {
+        auto* mvkBuffer = pCounterBuffers ? (MVKBuffer*)pCounterBuffers[i] : nullptr;
+        _counterBuffers[firstCounterBuffer + i] = mvkBuffer ? mvkBuffer->getMTLBufferGPUAddress() + pCounterBufferOffsets[i] : 0;
+        _counterMTLBuffers[firstCounterBuffer + i] = mvkBuffer ? mvkBuffer->getMTLBuffer() : nil;
+    }
+    return VK_SUCCESS;
+}
+
+void MVKCmdEndTransformFeedback::encode(MVKCommandEncoder *cmdEncoder) {
+    if (cmdEncoder->_transformFeedbackRunning) { cmdEncoder->endTransformFeedback(_counterBuffers, _counterMTLBuffers); }
+}
