+
+// Bytes of large temporary buffers alive in the process, for METALSHARP_TRACE=memory.
+static std::atomic<uint64_t> _mvkUnpooledTempBytes{0};
+
+// Large temporary buffers given back are kept for reuse, up to kMVKTempBufferReserveMax bytes for the process:
+// releasing each one when its command buffer completed made God of War allocate and free about 74 buffers of
+// 16 to 32 MB a second, each also added to and removed from the residency set. Kept per device (a buffer is
+// resident in its device's residency set), and by length and storage mode.
+static constexpr uint64_t kMVKTempBufferReserveMax = 512ull * 1024 * 1024;
+static std::mutex _mvkTempBufferReserveLock;
+static std::unordered_map<MVKDevice*, std::unordered_map<uint64_t, std::vector<id<MTLBuffer>>>> _mvkTempBufferReserve;
+static uint64_t _mvkTempBufferReserveBytes = 0;
+
+static uint64_t mvkTempBufferReserveKey(NSUInteger length, MTLStorageMode storageMode) {
+	return (uint64_t)length | ((uint64_t)storageMode << 56);
+}
+
+void mvkPurgeTempBufferReserve(MVKDevice* device) {
+	std::lock_guard<std::mutex> lock(_mvkTempBufferReserveLock);
+	auto it = _mvkTempBufferReserve.find(device);
+	if (it == _mvkTempBufferReserve.end()) { return; }
+	for (auto& [key, buffs] : it->second) {
+		for (auto buff : buffs) {
+			_mvkTempBufferReserveBytes -= buff.length;
+			_mvkUnpooledTempBytes -= buff.length;
+			device->removeResidency(buff);
+			[buff release];
+		}
+	}
+	_mvkTempBufferReserve.erase(it);
+}
 
 
