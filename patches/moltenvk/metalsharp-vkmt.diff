+	uint64_t rootSigSize = kMVKMSCRootSigHeaderSize + uint64_t(paramCount) * kMVKMSCRootParamSize +
+						   uint64_t(rangeCount) * kMVKMSCRangeSize + uint64_t(samplerCount) * kMVKMSCStaticSamplerSize;
+	if (rootSigSize > hdr.rootSigSize) {
+		rslt.error = "The root signature is larger than its section of the blob.";
+		return;
+	}
