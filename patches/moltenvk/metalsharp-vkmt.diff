+static void mvkDGCCapture(MVKDGCCapturedBuffer* buffers, uint32_t& mask, NSUInteger index,
+						  id<MTLBuffer> buffer, NSUInteger offset, NSUInteger stride, bool hasStride) {
+	if (index >= kMVKMaxBufferCount) { return; }
+	if (buffer) {
+		buffers[index] = { buffer, offset, stride, hasStride };
+		mask |= 1u << index;
+	} else {
+		mask &= ~(1u << index);
+	}
+}
