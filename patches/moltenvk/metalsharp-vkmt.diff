+		id<MTLFunction> mtlFunc = [conv.mtlLibrary newFunctionWithName: @(conv.entryPointName.c_str())];	// retained
+		if (mtlFunc) { setMetalObjectLabel(mtlFunc, module->getDebugName()); }
