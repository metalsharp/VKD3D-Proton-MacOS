+// is an allocation, and encoding on more threads contends with the threads recording the next frame, on
+// the allocator and on shared state; one MTLCommandBuffer per command buffer also costs a commit and a
+// fence synchronization each.
+bool MVKQueueCommandBufferSubmission::encodeCommandBuffersInParallel(MVKCommandBuffer* const* cmdBuffs, uint32_t count) {
