+// Metal does not bounds-check buffers reached through argument buffers or bound at an offset,
+// so robustBufferAccess2 and null buffer descriptors are bounds checks against the descriptor
+// range (0 for a null descriptor) in the shader. Inline uniform blocks have no range, so uniform
+// buffer checks need a layout without them.
+void MVKPipeline::initRobustBufferAccess(SPIRVToMSLConversionConfiguration& shaderConfig, MVKPipelineLayout* layout) {
+	auto& robustness2 = getEnabledRobustness2Features();
+	bool robust = robustness2.robustBufferAccess2 || robustness2.nullDescriptor;
+	bool hasInlineUniformBlocks = false;
+	for (auto* dsl : layout->getDescriptorSetLayouts())
+		for (const auto& binding : dsl->bindings())
+			hasInlineUniformBlocks |= binding.descriptorType == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK;
+	shaderConfig.options.mslOptions.robust_storage_buffer_access = robust;
+	shaderConfig.options.mslOptions.robust_uniform_buffer_access = robust && !hasInlineUniformBlocks;
+
+	// Min/max sampler reduction, emulated from the sampler modes the descriptor sets hold.
+	// It costs an extra load and a branch on every 2D sample, so shaders only carry it once the app has
+	// created a min/max sampler (most never do); MVK_CONFIG_EMULATE_SAMPLER_REDUCTION=1 always enables it.
+	static const bool forceReduction = mvkGetEnvVarNumber("MVK_CONFIG_EMULATE_SAMPLER_REDUCTION") != 0;
+	shaderConfig.options.mslOptions.emulate_sampler_reduction = getPhysicalDevice()->emulatesSamplerReduction() &&
+		getEnabledVulkan12NoExtFeatures().samplerFilterMinmax && (forceReduction || getDevice()->hasReductionSampler());
+
+	// Shaders compile with fast floating-point functions unless fast math is off (see MVKDevice::getMTLCompileOptions()),
+	// so NaN-preserving shaders (every DXBC shader from VKD3D-Proton) don't need the much slower precise:: functions either.
+	shaderConfig.options.mslOptions.precise_functions_preserve_nan = getMVKConfig().fastMathEnabled == MVK_CONFIG_FAST_MATH_NEVER;
+}
