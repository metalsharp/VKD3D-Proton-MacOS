+// The mesh (object-stage) path fetches vertices by hand, so SPIRV-Cross needs the
+// concrete component format of each attribute (get_variable_format_string reads it).
+// The classic path only ever sets shaderVar.format for the signedness fixup, leaving
+// float/int formats as OTHER(0) — which throws "Format not handled: 0" in the mesh
+// path. Map every MVKFormatType to a concrete MSLShaderVariableFormat here.
+// The object stage's manual vertex fetch: how an attribute of this format is stored (its element type, component
+// count, and whether it is normalized). False for a format it can't fetch.
+static bool mvkVertexFetchLayout(VkFormat format, MVK_spirv_cross::MSLShaderVariableFormat& fetchFormat,
+								 uint32_t& componentCount, bool& normalized) {
+	using namespace MVK_spirv_cross;
+	// Each 8- and 16-bit group runs UNORM, SNORM, USCALED, SSCALED, UINT, SINT (then SRGB or SFLOAT).
+	auto group = [&](VkFormat first, uint32_t count, MSLShaderVariableFormat u, MSLShaderVariableFormat i,
+					 MSLShaderVariableFormat f) {
+		uint32_t k = uint32_t(format) - uint32_t(first);
+		componentCount = count;
+		normalized = k < 2;
+		fetchFormat = k == 6 ? f : (k & 1) ? i : u;
+		return true;
+	};
+	auto group32 = [&](VkFormat first, uint32_t count) {
+		uint32_t k = uint32_t(format) - uint32_t(first);
+		componentCount = count;
+		normalized = false;
+		fetchFormat = k == 0 ? MSL_SHADER_VARIABLE_FORMAT_UINT32 : k == 1 ? MSL_SHADER_VARIABLE_FORMAT_INT32 : MSL_SHADER_VARIABLE_FORMAT_FLOAT;
+		return true;
+	};
+	auto rgb10a2 = [&](VkFormat first, MSLShaderVariableFormat u, MSLShaderVariableFormat i) {
+		uint32_t k = uint32_t(format) - uint32_t(first);
+		componentCount = 4;
+		normalized = k < 2;
+		fetchFormat = (k & 1) ? i : u;
+		return true;
+	};
+	if (format >= VK_FORMAT_R8_UNORM && format <= VK_FORMAT_R8_SINT)
+		return group(VK_FORMAT_R8_UNORM, 1, MSL_SHADER_VARIABLE_FORMAT_UINT8, MSL_SHADER_VARIABLE_FORMAT_INT8, MSL_SHADER_VARIABLE_FORMAT_UINT8);
+	if (format >= VK_FORMAT_R8G8_UNORM && format <= VK_FORMAT_R8G8_SINT)
+		return group(VK_FORMAT_R8G8_UNORM, 2, MSL_SHADER_VARIABLE_FORMAT_UINT8, MSL_SHADER_VARIABLE_FORMAT_INT8, MSL_SHADER_VARIABLE_FORMAT_UINT8);
+	if (format >= VK_FORMAT_R8G8B8_UNORM && format <= VK_FORMAT_R8G8B8_SINT)
+		return group(VK_FORMAT_R8G8B8_UNORM, 3, MSL_SHADER_VARIABLE_FORMAT_UINT8, MSL_SHADER_VARIABLE_FORMAT_INT8, MSL_SHADER_VARIABLE_FORMAT_UINT8);
+	if (format >= VK_FORMAT_R8G8B8A8_UNORM && format <= VK_FORMAT_R8G8B8A8_SINT)
+		return group(VK_FORMAT_R8G8B8A8_UNORM, 4, MSL_SHADER_VARIABLE_FORMAT_UINT8, MSL_SHADER_VARIABLE_FORMAT_INT8, MSL_SHADER_VARIABLE_FORMAT_UINT8);
+	if (format >= VK_FORMAT_B8G8R8A8_UNORM && format <= VK_FORMAT_B8G8R8A8_SINT)
+		return group(VK_FORMAT_B8G8R8A8_UNORM, 4, MSL_SHADER_VARIABLE_FORMAT_UINT8_BGRA, MSL_SHADER_VARIABLE_FORMAT_INT8_BGRA, MSL_SHADER_VARIABLE_FORMAT_UINT8_BGRA);
+	// A8B8G8R8 packed in a little-endian word is R8G8B8A8 in memory.
+	if (format >= VK_FORMAT_A8B8G8R8_UNORM_PACK32 && format <= VK_FORMAT_A8B8G8R8_SINT_PACK32)
+		return group(VK_FORMAT_A8B8G8R8_UNORM_PACK32, 4, MSL_SHADER_VARIABLE_FORMAT_UINT8, MSL_SHADER_VARIABLE_FORMAT_INT8, MSL_SHADER_VARIABLE_FORMAT_UINT8);
+	if (format >= VK_FORMAT_A2R10G10B10_UNORM_PACK32 && format <= VK_FORMAT_A2R10G10B10_SINT_PACK32)
+		return rgb10a2(VK_FORMAT_A2R10G10B10_UNORM_PACK32, MSL_SHADER_VARIABLE_FORMAT_UINT_A2R10G10B10, MSL_SHADER_VARIABLE_FORMAT_INT_A2R10G10B10);
+	if (format >= VK_FORMAT_A2B10G10R10_UNORM_PACK32 && format <= VK_FORMAT_A2B10G10R10_SINT_PACK32)
+		return rgb10a2(VK_FORMAT_A2B10G10R10_UNORM_PACK32, MSL_SHADER_VARIABLE_FORMAT_UINT_A2B10G10R10, MSL_SHADER_VARIABLE_FORMAT_INT_A2B10G10R10);
+	if (format >= VK_FORMAT_R16_UNORM && format <= VK_FORMAT_R16_SFLOAT)
+		return group(VK_FORMAT_R16_UNORM, 1, MSL_SHADER_VARIABLE_FORMAT_UINT16, MSL_SHADER_VARIABLE_FORMAT_INT16, MSL_SHADER_VARIABLE_FORMAT_HALF);
+	if (format >= VK_FORMAT_R16G16_UNORM && format <= VK_FORMAT_R16G16_SFLOAT)
+		return group(VK_FORMAT_R16G16_UNORM, 2, MSL_SHADER_VARIABLE_FORMAT_UINT16, MSL_SHADER_VARIABLE_FORMAT_INT16, MSL_SHADER_VARIABLE_FORMAT_HALF);
+	if (format >= VK_FORMAT_R16G16B16_UNORM && format <= VK_FORMAT_R16G16B16_SFLOAT)
+		return group(VK_FORMAT_R16G16B16_UNORM, 3, MSL_SHADER_VARIABLE_FORMAT_UINT16, MSL_SHADER_VARIABLE_FORMAT_INT16, MSL_SHADER_VARIABLE_FORMAT_HALF);
+	if (format >= VK_FORMAT_R16G16B16A16_UNORM && format <= VK_FORMAT_R16G16B16A16_SFLOAT)
+		return group(VK_FORMAT_R16G16B16A16_UNORM, 4, MSL_SHADER_VARIABLE_FORMAT_UINT16, MSL_SHADER_VARIABLE_FORMAT_INT16, MSL_SHADER_VARIABLE_FORMAT_HALF);
+	if (format >= VK_FORMAT_R32_UINT && format <= VK_FORMAT_R32_SFLOAT) return group32(VK_FORMAT_R32_UINT, 1);
+	if (format >= VK_FORMAT_R32G32_UINT && format <= VK_FORMAT_R32G32_SFLOAT) return group32(VK_FORMAT_R32G32_UINT, 2);
+	if (format >= VK_FORMAT_R32G32B32_UINT && format <= VK_FORMAT_R32G32B32_SFLOAT) return group32(VK_FORMAT_R32G32B32_UINT, 3);
+	if (format >= VK_FORMAT_R32G32B32A32_UINT && format <= VK_FORMAT_R32G32B32A32_SFLOAT) return group32(VK_FORMAT_R32G32B32A32_UINT, 4);
+	return false;
+}
+
+static MVK_spirv_cross::MSLShaderVariableFormat mvkMSLFormatForFormatType(MVKFormatType type) {
+    switch (type) {
+        case kMVKFormatColorInt8:   return MSL_SHADER_VARIABLE_FORMAT_INT8;
+        case kMVKFormatColorUInt8:  return MSL_SHADER_VARIABLE_FORMAT_UINT8;
+        case kMVKFormatColorInt16:  return MSL_SHADER_VARIABLE_FORMAT_INT16;
+        case kMVKFormatColorUInt16: return MSL_SHADER_VARIABLE_FORMAT_UINT16;
+        case kMVKFormatColorInt32:  return MSL_SHADER_VARIABLE_FORMAT_INT32;
+        case kMVKFormatColorUInt32: return MSL_SHADER_VARIABLE_FORMAT_UINT32;
+        case kMVKFormatColorHalf:   return MSL_SHADER_VARIABLE_FORMAT_HALF;
+        case kMVKFormatColorFloat:  return MSL_SHADER_VARIABLE_FORMAT_FLOAT;
+        default:                    return MSL_SHADER_VARIABLE_FORMAT_FLOAT;  // normalized/UNORM etc. load as float
+    }
+}
