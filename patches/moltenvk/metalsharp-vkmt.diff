+		// Depth formats are 2D-only in Metal.
+		if (type == VK_IMAGE_TYPE_3D && _pixelFormats.isDepthFormat(mtlFormat)) { return { 0, 0, 0 }; }
+		MTLSize tile = [_mtlDevice sparseTileSizeWithTextureType: type == VK_IMAGE_TYPE_3D ? MTLTextureType3D : MTLTextureType2D
