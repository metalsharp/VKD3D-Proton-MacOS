+	if (params.pushConstantsStride) {
+		device uint32_t* pc = pushConstants + idx * (params.pushConstantsStride / 4);
+		for (uint32_t w = 0; w < params.pushConstantsSize / 4; w++) { pc[w] = basePushConstants[w]; }
+		for (uint32_t t = 0; t < params.tokenCount; t++) {
+			MVKDGCPushConstantToken tok = tokens[t];
+			for (uint32_t w = 0; w < tok.size / 4; w++) {
+				pc[tok.offset / 4 + w] = tok.streamOffset == 0xffffffffu ? idx
+					: *reinterpret_cast<const device uint32_t*>(seq + tok.streamOffset + 4 * w);
+			}
+		}
+	}
