+id<MTLTexture> MVKDevice::getDepthBoundsSnapshot(id<MTLCommandQueue> queue, id<MTLTexture> depthTex) {
+	std::lock_guard<std::mutex> lock(_depthBoundsSnapshotsLock);
+	for (auto& [q, snap] : _depthBoundsSnapshots) {
