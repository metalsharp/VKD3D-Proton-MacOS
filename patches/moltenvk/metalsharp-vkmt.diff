+const MVKMSCConversion& MVKShaderModule::getMSCConversion() {
+	// Converted once, by the first pipeline that needs it; the result doesn't change after.
+	lock_guard<mutex> lock(_accessLock);
+	if ( !_isMSCConverted ) {
+		_isMSCConverted = true;
+		MVKMetalShaderConverter::get();		// Loading it isn't part of the conversion's time.
+		uint64_t startTime = mvkGetTimestamp();
+		convertMSC();
+		MVK_MS_TRACE(Shader, "Metal Shader Converter: module %p (%016zx, %zu bytes) %s in %.3f ms%s%s",
+					 this, _key.codeHash, _key.codeSize, _mscConversion.mtlLibrary ? "converted" : "FAILED to convert",
+					 mvkGetElapsedMilliseconds(startTime), _mscConversion.error.empty() ? "" : ": ", _mscConversion.error.c_str());
+	}
+	return _mscConversion;
+}
