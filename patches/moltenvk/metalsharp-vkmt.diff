+		if ( !(b.fragmentMask & (1u << i)) ) { continue; }
+		MVKDGCBufferEntry e = b.fragmentBuffers[i];
+		ulong a = e.address + ((e.flags & 1) ? ulong(idx) * b.pushConstantsStride : 0);
