+MVKQueueSparseBindSubmission::MVKQueueSparseBindSubmission(MVKQueue* queue, const VkBindSparseInfo* pBindInfo, VkFence fence) :
+	MVKQueueCommandBufferSubmission(queue, mvkSubmitInfoFromBindSparseInfo(pBindInfo), fence, kMVKCommandUseQueueSubmit) {
+
+	VkDeviceSize block = MVKPhysicalDevice::kSparseBlockSize;
+
+	for (uint32_t i = 0; i < pBindInfo->bufferBindCount; i++) {
+		const auto& bufferBind = pBindInfo->pBufferBinds[i];
+		auto* mvkBuff = (MVKBuffer*)bufferBind.buffer;
+		for (uint32_t j = 0; j < bufferBind.bindCount; j++) {
+			const auto& bind = bufferBind.pBinds[j];
+			id<MTLHeap> heap = nil;
+			if (bind.memory) {
+				heap = ((MVKDeviceMemory*)bind.memory)->getSparseBindingMTLHeap();
+				if ( !heap ) {
+					setConfigurationResult(reportError(VK_ERROR_FEATURE_NOT_PRESENT, "vkQueueBindSparse(): The memory cannot back sparse blocks."));
+					continue;
+				}
+			}
+			BufferMapping mapping;
+			mapping.buffer = [mvkBuff->getMTLBuffer() retain];
+			mapping.heap = [heap retain];
+			mapping.blocks = NSMakeRange(bind.resourceOffset / block, mvkCeilingDivide(bind.size, block));
+			mapping.heapOffset = bind.memoryOffset / block;
+			_bufferMappings.push_back(mapping);
+		}
+	}
+
+	MVKSmallVector<MVKSparseTextureMapping, 8> mappings;
+	auto addTextureMappings = [&](MVKImage* mvkImg) {
+		id<MTLTexture> texture = mvkImg->getMTLTexture(0);
+		for (auto& mapping : mappings) {
+			[mapping.heap retain];
+			_textureMappings.push_back({ [texture retain], mapping });
+		}
+		mappings.clear();
+	};
+	for (uint32_t i = 0; i < pBindInfo->imageOpaqueBindCount; i++) {
+		const auto& opaqueBind = pBindInfo->pImageOpaqueBinds[i];
+		auto* mvkImg = (MVKImage*)opaqueBind.image;
+		for (uint32_t j = 0; j < opaqueBind.bindCount; j++) {
+			VkResult rslt = mvkImg->getSparseMappings(opaqueBind.pBinds[j], mappings);
+			if (rslt != VK_SUCCESS) { setConfigurationResult(rslt); }
+		}
+		addTextureMappings(mvkImg);
+	}
+	for (uint32_t i = 0; i < pBindInfo->imageBindCount; i++) {
+		const auto& imageBind = pBindInfo->pImageBinds[i];
+		auto* mvkImg = (MVKImage*)imageBind.image;
+		for (uint32_t j = 0; j < imageBind.bindCount; j++) {
+			VkResult rslt = mvkImg->getSparseMappings(imageBind.pBinds[j], mappings);
+			if (rslt != VK_SUCCESS) { setConfigurationResult(rslt); }
+		}
+		addTextureMappings(mvkImg);
+	}
