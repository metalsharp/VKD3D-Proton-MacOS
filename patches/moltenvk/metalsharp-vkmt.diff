+void MVKDevice::saveBinaryArchive() {
+	_binaryArchiveDirty = false;
+	@autoreleasepool {
+		std::string tmp = _binaryArchivePath + ".tmp";
+		NSError* err = nil;
+		if ([_binaryArchive serializeToURL: [NSURL fileURLWithPath: @(tmp.c_str())] error: &err]) {
+			rename(tmp.c_str(), _binaryArchivePath.c_str());
+		} else {
+			unlink(tmp.c_str());
+			MVKLogWarn("Binary archive %s can't be written: %s", _binaryArchivePath.c_str(), err.localizedDescription.UTF8String);
+		}
+	}
+}
