+			proceduralIFBStageHandles[i] = [_mtlPipelineState functionHandleWithFunction:proceduralIFBStageFunctions[i]];
+			valid = valid && proceduralIFBStageHandles[i];
+		}
+	}
+	id<MTLFunctionHandle> ifbPassthroughHandle = _usesIFB
