+/* Describes the draw parameters for mesh pipelines. */
+// Matches the DrawInfo struct of the SPIRV-Cross object stage wrapper for mesh-run pipelines.
+struct DrawInfo {
+	int32_t indexed;
+	int32_t indexSize;
+	uint64_t indexBuffer;
+	int32_t baseVertex;
+	uint32_t baseInstance;
+	float conservativeExtent[2];
+	uint32_t conservativeFlags;	// Bit 0: a counter-clockwise hull (in Vulkan NDC) is front-facing.
+	uint32_t vertexStrides[31];	// By Metal buffer index; used for dynamic vertex strides.
+	uint32_t topology;			// The VkPrimitiveTopology the object stage groups vertexes by.
+	uint32_t primitiveCount;
+};
+static_assert(sizeof(DrawInfo) == 168, "DrawInfo must match MVKMeshDrawInfo and the object stage's DrawInfo.");
+
+#if MVK_XCODE_14
+// The input primitives of a draw of so many vertexes (or indexes) with the topology.
+static uint32_t mvkMeshDrawPrimitiveCount(VkPrimitiveTopology topology, uint32_t v) {
+	switch (topology) {
+		case VK_PRIMITIVE_TOPOLOGY_POINT_LIST:                    return v;
+		case VK_PRIMITIVE_TOPOLOGY_LINE_LIST:                     return v / 2;
+		case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP:                    return v > 1 ? v - 1 : 0;
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST:                 return v / 3;
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN:                  return v > 2 ? v - 2 : 0;
+		case VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY:      return v / 4;
+		case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY:     return v > 3 ? v - 3 : 0;
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST_WITH_ADJACENCY:  return v / 6;
+		case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY: return v >= 6 ? (v - 4) / 2 : 0;
+		default:                                                  return 0;
+	}
+}
+
+// Sets up a draw with a geometry or conservative rasterization pipeline, except the primitive count: the
+// conservative rasterization state, the vertex buffers of the object stage, and the topology the object
+// stage groups vertexes by.
+static void mvkPrepareMeshPipelineDraw(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline, DrawInfo& drawInfo) {
+	id<MTLRenderCommandEncoder> mtlEncoder = cmdEncoder->_mtlRenderEncoder;
+	if (pipeline->isConservativeRasterPipeline()) {
+		// The pixel box (half a pixel plus the extra overestimation each way) in NDC units. A further
+		// 1/256 pixel (the reported primitiveOverestimationSize) covers pixels the triangle only
+		// touches, which vertex snapping and fill-rule ties would otherwise decide.
+		const VkViewport& vp = cmdEncoder->getMtlGraphics()._viewports[0];
+		float grow = 1.0f + 2.0f * (pipeline->getConservativeExtraSize() + 1.0f / 256.0f);
+		drawInfo.conservativeExtent[0] = vp.width ? grow / fabsf(vp.width) : 0.0f;
+		drawInfo.conservativeExtent[1] = vp.height ? grow / fabsf(vp.height) : 0.0f;
+		// Degenerate primitives have no winding; the mesh stage emits them front-facing. With a positive
+		// viewport height, counter-clockwise in NDC is clockwise in the framebuffer (Vulkan's y points down).
+		bool frontFaceCW = cmdEncoder->getVkGraphics().pickRenderState(MVKRenderStateFlag::FrontFace).frontFace == MTLWindingClockwise;
+		drawInfo.conservativeFlags = (frontFaceCW != (vp.height < 0)) ? 1u : 0u;
+	}
+
+	// The Vulkan vertex stage is the Metal object stage. prepareDraw() binds vertex buffers to the
+	// classic vertex stage, so bind the same Vulkan vertex inputs to the object-stage indices consumed
+	// by the SPIRV-Cross manual vertex loader.
+	const auto& vkGraphics = cmdEncoder->getVkGraphics();
+	for (size_t binding : pipeline->getVkVertexBuffers()) {
+		const auto& vertexBuffer = vkGraphics._vertexBuffers[binding];
+		NSUInteger mtlIndex = pipeline->getMetalBufferIndexForVertexAttributeBinding((uint32_t)binding);
+		[mtlEncoder setObjectBuffer: vertexBuffer.mtlBuffer offset: vertexBuffer.offset atIndex: mtlIndex];
+		if (mtlIndex < std::size(drawInfo.vertexStrides)) { drawInfo.vertexStrides[mtlIndex] = vertexBuffer.stride; }
+	}
+
+	// Metal's primitive type gives the list or strip;
+	// adjacency comes from the geometry shader, and fans only from the pipeline's static topology.
+	bool adjacency = pipeline->getGeometryInputVertexCount() == 4 || pipeline->getGeometryInputVertexCount() == 6;
+	VkPrimitiveTopology topology;
+	switch (cmdEncoder->getMtlGraphics().getPrimitiveType()) {
+		case MTLPrimitiveTypePoint:     topology = VK_PRIMITIVE_TOPOLOGY_POINT_LIST; break;
+		case MTLPrimitiveTypeLine:      topology = adjacency ? VK_PRIMITIVE_TOPOLOGY_LINE_LIST_WITH_ADJACENCY : VK_PRIMITIVE_TOPOLOGY_LINE_LIST; break;
+		case MTLPrimitiveTypeLineStrip: topology = adjacency ? VK_PRIMITIVE_TOPOLOGY_LINE_STRIP_WITH_ADJACENCY : VK_PRIMITIVE_TOPOLOGY_LINE_STRIP; break;
+		case MTLPrimitiveTypeTriangleStrip: topology = adjacency ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP_WITH_ADJACENCY : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP; break;
+		default:
+			topology = (adjacency ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST_WITH_ADJACENCY :
+						pipeline->getVkPrimitiveTopology() == VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN ? VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN :
+						VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST);
+			break;
+	}
+	drawInfo.topology = topology;
+}
+
+// Matches spvXfbGeometry of the SPIRV-Cross mesh stage of a geometry shader with transform feedback.
+struct MVKXfbGeometry {
+	uint32_t mode;			// 0: off, 1: count, 2: capture
+	uint32_t countSize;
+	uint64_t counts;
+	uint64_t state;
+	uint64_t buffers[4];
+};
+
+// Binds the transform feedback state of a geometry shader to the mesh stage, using its buffers there.
+static void mvkBindXfbGeometry(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline, uint32_t mode,
+							   uint32_t countSize, const MVKMTLBufferAllocation* counts) {
+	id<MTLRenderCommandEncoder> mtlEncoder = cmdEncoder->_mtlRenderEncoder;
+	MVKXfbGeometry xfb = {};
+	xfb.mode = mode;
+	xfb.countSize = countSize;
+	if (mode) {
+		xfb.counts = counts->_mtlBuffer.gpuAddress + counts->_offset;
+		[mtlEncoder useResource: counts->_mtlBuffer usage: MTLResourceUsageRead | MTLResourceUsageWrite stages: MTLRenderStageMesh];
+	}
+	if (mode == 2) {
+		auto* state = cmdEncoder->_transformFeedbackState;
+		xfb.state = state->_mtlBuffer.gpuAddress + state->_offset;
+		[mtlEncoder useResource: state->_mtlBuffer usage: MTLResourceUsageRead | MTLResourceUsageWrite stages: MTLRenderStageMesh];
+		for (uint32_t i = 0; i < kMVKMaxTransformFeedbackBufferCount; i++) {
+			auto& b = cmdEncoder->_graphicsResourcesState._transformFeedbackBufferBindings[i];
+			if ( !b.mtlBuffer ) { continue; }
+			xfb.buffers[i] = b.mtlBuffer.gpuAddress + b.offset;
+			[mtlEncoder useResource: b.mtlBuffer usage: MTLResourceUsageWrite stages: MTLRenderStageMesh];
+		}
+	}
+	[mtlEncoder setMeshBytes: &xfb length: sizeof(xfb) atIndex: pipeline->getXfbGeometryBufferIndex()];
+}
+
+static void mvkDrawMeshThreadgroups(MVKCommandEncoder* cmdEncoder, NSUInteger threadCount, uint32_t instanceCount) {
+	[cmdEncoder->_mtlRenderEncoder drawMeshThreadgroups: MTLSizeMake(threadCount, instanceCount, 1)
+							 threadsPerObjectThreadgroup: MTLSizeMake(1, 1, 1)
+							   threadsPerMeshThreadgroup: MTLSizeMake(1, 1, 1)];
+}
+
+// Transform feedback from a geometry shader: a draw that only counts the primitives of each input primitive and
+// invocation, their prefix sums (after loading the capture offsets), and the draw that captures and rasterizes,
+// followed by advancing the offsets.
+static void mvkEncodeXfbGeometryDraw(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline, DrawInfo& drawInfo,
+									  NSUInteger threadCount, uint32_t instanceCount) {
+	uint32_t countSize = (uint32_t)threadCount * instanceCount * pipeline->getGeometryInvocations();
+	auto* counts = cmdEncoder->getTempMTLBuffer((countSize + 1) * sizeof(uint32_t), true);
+	mvkBindXfbGeometry(cmdEncoder, pipeline, 1, countSize, counts);
+	mvkDrawMeshThreadgroups(cmdEncoder, threadCount, instanceCount);
+
+	cmdEncoder->encodeStoreActions(true);
+	id<MTLComputeCommandEncoder> mtlCompute = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+	if (cmdEncoder->_transformFeedbackNeedsLoad) { cmdEncoder->encodeTransformFeedbackLoad(mtlCompute); }
+	auto& computeState = cmdEncoder->getMtlCompute();
+	id<MTLComputePipelineState> scanState = cmdEncoder->getCommandEncodingPool()->getCmdTransformFeedbackScanMTLComputePipelineState();
+	computeState.bindPipeline(mtlCompute, scanState);
+	computeState.bindBuffer(mtlCompute, counts->_mtlBuffer, counts->_offset, 0);
+	computeState.bindStructBytes(mtlCompute, &countSize, 1);
+	[mtlCompute dispatchThreadgroups: MTLSizeMake(1, 1, 1)
+			   threadsPerThreadgroup: MTLSizeMake(std::min<NSUInteger>(scanState.maxTotalThreadsPerThreadgroup, 1024), 1, 1)];
+	cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+
+	cmdEncoder->finalizeDrawState(kMVKGraphicsStageRasterization);
+	mvkPrepareMeshPipelineDraw(cmdEncoder, pipeline, drawInfo);
+	[cmdEncoder->_mtlRenderEncoder setObjectBytes: &drawInfo length: sizeof(drawInfo) atIndex: pipeline->getDrawInfoBufferIndex()];
+	mvkBindXfbGeometry(cmdEncoder, pipeline, 2, countSize, counts);
+	mvkDrawMeshThreadgroups(cmdEncoder, threadCount, instanceCount);
+
+	cmdEncoder->encodeStoreActions(true);
+	cmdEncoder->encodeTransformFeedbackCaptureEnd(cmdEncoder->getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl));
+	cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+}
+
+// Draws with a geometry or conservative rasterization pipeline: the vertex shader runs as the object
+// stage, one object threadgroup per input primitive, and launches the mesh threadgroups.
+static void encodeMeshPipelineDraw(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline, DrawInfo& drawInfo,
+                                   uint32_t vertexCount, uint32_t instanceCount) {
+	id<MTLRenderCommandEncoder> mtlEncoder = cmdEncoder->_mtlRenderEncoder;
+	mvkPrepareMeshPipelineDraw(cmdEncoder, pipeline, drawInfo);
+	NSUInteger threadCount = mvkMeshDrawPrimitiveCount((VkPrimitiveTopology)drawInfo.topology, vertexCount);
+	drawInfo.primitiveCount = (uint32_t)threadCount;
+	[mtlEncoder setObjectBytes: &drawInfo length: sizeof(drawInfo) atIndex: pipeline->getDrawInfoBufferIndex()];
+	if (pipeline->isGeometryTransformFeedbackPipeline()) {
+		if (cmdEncoder->_transformFeedbackRunning && threadCount && instanceCount) {
+			mvkEncodeXfbGeometryDraw(cmdEncoder, pipeline, drawInfo, threadCount, instanceCount);
+			return;
+		}
+		mvkBindXfbGeometry(cmdEncoder, pipeline, 0, 0, nullptr);
+	}
+	if (threadCount) {
+		[mtlEncoder drawMeshThreadgroups: MTLSizeMake(threadCount, instanceCount, 1)
+		     threadsPerObjectThreadgroup: MTLSizeMake(1, 1, 1)
+		       threadsPerMeshThreadgroup: MTLSizeMake(1, 1, 1)];
+	}
+}
+
+// Indirect draws with a geometry or conservative rasterization pipeline: a kernel makes each draw's DrawInfo
+// and object threadgroup dispatch from its arguments, then each draw dispatches the object stage indirectly.
+static void encodeMeshPipelineIndirectDraws(MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline,
+											id<MTLBuffer> indirectBuffer, VkDeviceSize indirectBufferOffset,
+											uint32_t indirectBufferStride, uint32_t drawCount,
+											const MVKIndexMTLBufferBinding* ibb) {
+	if ( !drawCount ) { return; }
+
+	// The draws' common DrawInfo, from the state of the draw.
+	cmdEncoder->_isIndexedDraw = ibb != nullptr;
+	cmdEncoder->finalizeDrawState(kMVKGraphicsStageRasterization);
+	if ( !pipeline->hasValidMTLPipelineStates() ) { return; }
+	DrawInfo drawInfo = {};
+	if (ibb) {
+		drawInfo.indexed = true;
+		drawInfo.indexSize = ibb->vkIndexType == VK_INDEX_TYPE_UINT8 ? 1 : (int32_t)mvkMTLIndexTypeSizeInBytes((MTLIndexType)ibb->mtlIndexType);
+		drawInfo.indexBuffer = ibb->mtlBuffer.gpuAddress + ibb->offset;
+	}
+	mvkPrepareMeshPipelineDraw(cmdEncoder, pipeline, drawInfo);
+
+	auto* drawInfos = cmdEncoder->getTempMTLBuffer(drawCount * sizeof(DrawInfo), true);
+	auto* dispatches = cmdEncoder->getTempMTLBuffer(drawCount * sizeof(MTLDispatchThreadgroupsIndirectArguments), true);
+	cmdEncoder->encodeStoreActions(true);
+	id<MTLComputeCommandEncoder> mtlConvertEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDrawIndirectConvertBuffers);
+	auto& mtlCompute = cmdEncoder->getMtlCompute();
+	id<MTLComputePipelineState> convertState = cmdEncoder->getCommandEncodingPool()->getCmdDrawMeshPipelineIndirectConvertMTLComputePipelineState();
+	mtlCompute.bindPipeline(mtlConvertEncoder, convertState);
+	mtlCompute.bindBuffer(mtlConvertEncoder, indirectBuffer, indirectBufferOffset, 0);
+	mtlCompute.bindBuffer(mtlConvertEncoder, drawInfos->_mtlBuffer, drawInfos->_offset, 1);
+	mtlCompute.bindBuffer(mtlConvertEncoder, dispatches->_mtlBuffer, dispatches->_offset, 2);
+	mtlCompute.bindBytes(mtlConvertEncoder, &drawInfo, sizeof(drawInfo), 3);
+	mtlCompute.bindStructBytes(mtlConvertEncoder, &indirectBufferStride, 4);
+	mtlCompute.bindStructBytes(mtlConvertEncoder, &drawCount, 5);
+	[mtlConvertEncoder dispatchThreadgroups: MTLSizeMake(mvkCeilingDivide<NSUInteger>(drawCount, convertState.threadExecutionWidth), 1, 1)
+					 threadsPerThreadgroup: MTLSizeMake(convertState.threadExecutionWidth, 1, 1)];
+	cmdEncoder->beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+
+	cmdEncoder->finalizeDrawState(kMVKGraphicsStageRasterization);
+	id<MTLRenderCommandEncoder> mtlEncoder = cmdEncoder->_mtlRenderEncoder;
+	DrawInfo rebind = drawInfo;
+	mvkPrepareMeshPipelineDraw(cmdEncoder, pipeline, rebind);	// Binds the object stage's vertex buffers to the new encoder.
+	if (ibb) { [mtlEncoder useResource: ibb->mtlBuffer usage: MTLResourceUsageRead stages: MTLRenderStageObject]; }
+	if (pipeline->isGeometryTransformFeedbackPipeline()) {
+		if (cmdEncoder->_transformFeedbackRunning) {
+			pipeline->reportMessage(MVK_CONFIG_LOG_LEVEL_WARNING, "Transform feedback from a geometry shader is not captured for indirect draws.");
+		}
+		mvkBindXfbGeometry(cmdEncoder, pipeline, 0, 0, nullptr);
+	}
+	for (uint32_t drawIdx = 0; drawIdx < drawCount; drawIdx++) {
+		[mtlEncoder setObjectBuffer: drawInfos->_mtlBuffer offset: drawInfos->_offset + drawIdx * sizeof(DrawInfo) atIndex: pipeline->getDrawInfoBufferIndex()];
+		[mtlEncoder drawMeshThreadgroupsWithIndirectBuffer: dispatches->_mtlBuffer
+									  indirectBufferOffset: dispatches->_offset + drawIdx * sizeof(MTLDispatchThreadgroupsIndirectArguments)
+								threadsPerObjectThreadgroup: MTLSizeMake(1, 1, 1)
+								  threadsPerMeshThreadgroup: MTLSizeMake(1, 1, 1)];
+	}
+}
