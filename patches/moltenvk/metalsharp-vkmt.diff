+
+void MVKDevice::initImplicitPipelineCache() {
+	std::string dir;
+	if (const char* env = getenv("MVK_CONFIG_PIPELINE_CACHE_PATH")) {
+		if ( !*env || !strcmp(env, "0") ) { return; }
+		dir = env;
+	} else {
+		const char* home = getenv("HOME");
+		if ( !home ) { return; }
+		dir = std::string(home) + "/Library/Caches/MoltenVK";
+	}
+	mkdir(dir.c_str(), 0755);
+
+	std::string app = getInstance()->getAppName();
+	if (app.empty()) { app = getprogname(); }
+	for (char& c : app) { if ( !isalnum((unsigned char)c) && c != '-' && c != '.' ) { c = '_'; } }
+	std::string basePath = dir + "/" + app + "-" + mvkPipelineCacheBuildID();
+	_implicitPipelineCachePath = basePath + ".mvkpc";
+
+	std::vector<char> data;
+	if (FILE* f = fopen(_implicitPipelineCachePath.c_str(), "rb")) {
+		fseek(f, 0, SEEK_END);
+		long size = ftell(f);
+		fseek(f, 0, SEEK_SET);
+		if (size > 0) {
+			data.resize(size);
+			if (fread(data.data(), 1, size, f) != (size_t)size) { data.clear(); }
+		}
+		fclose(f);
+	}
+
+	VkPipelineCacheCreateInfo pcInfo = { VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO };
+	pcInfo.initialDataSize = data.size();
+	pcInfo.pInitialData = data.data();
+	_implicitPipelineCache = new MVKPipelineCache(this, &pcInfo);
+	_implicitPipelineCacheQueue = dispatch_queue_create("MoltenVK pipeline cache", DISPATCH_QUEUE_SERIAL);
+	// Write it out once pipelines stop arriving for a few seconds: they arrive in bursts while a level loads, and
+	// each write is the whole cache (hundreds of MB after a game's shader precompile, rewritten every few seconds
+	// while it ran, and refused whenever the cache grew between taking its size and writing it). While they keep
+	// arriving it is still written once a minute (MVK_CONFIG_PIPELINE_CACHE_SAVE_INTERVAL, in milliseconds): a
+	// precompile runs for many minutes, and a game closed, crashed or killed before it ended lost all of it, so the
+	// next launch compiled everything again.
+	_implicitPipelineCacheTimer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, _implicitPipelineCacheQueue);
+	dispatch_source_set_timer(_implicitPipelineCacheTimer, dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC), 3 * NSEC_PER_SEC, NSEC_PER_SEC);
+	// The binary archive is written by the same rules: once a minute while pipelines keep arriving (every 5 minutes
+	// was too rare: a game played for a few minutes and quit never wrote it).
+	__block uint64_t lastSave = mvkGetTimestamp();
+	__block uint64_t lastArchiveSave = lastSave;
+	double saveInterval = (double)mvkGetEnvVarNumber("MVK_CONFIG_PIPELINE_CACHE_SAVE_INTERVAL", 60000);
+	dispatch_source_set_event_handler(_implicitPipelineCacheTimer, ^{
+		uint64_t changes = _implicitPipelineCacheChanges;
+		bool quiet = changes == _implicitPipelineCacheChangesSeen;
+		_implicitPipelineCacheChangesSeen = changes;
+		bool due = mvkGetElapsedMilliseconds(lastSave) >= saveInterval;
+		if (_implicitPipelineCacheDirty && (quiet || due)) {
+			saveImplicitPipelineCache();
+			lastSave = mvkGetTimestamp();
+		}
+		if (_binaryArchiveDirty && !_binaryArchiveSaveQueued && (quiet || mvkGetElapsedMilliseconds(lastArchiveSave) >= saveInterval)) {
+			_binaryArchiveSaveQueued = true;
+			dispatch_async(_binaryArchiveQueue, ^{
+				saveBinaryArchive();
+				_binaryArchiveSaveQueued = false;
+			});
+			lastArchiveSave = mvkGetTimestamp();
+		}
+	});
+	dispatch_resume(_implicitPipelineCacheTimer);
+	MVKLogInfo("Pipeline cache %s: loaded %zu bytes.", _implicitPipelineCachePath.c_str(), data.size());
+	mvkRegisterLiveDevice(this);
+	initBinaryArchive(basePath);
+}
