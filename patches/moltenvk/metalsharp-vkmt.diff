+	kMVKMSTracePresent  = 1u << 1,
+	kMVKMSTraceMemory   = 1u << 2,
+	kMVKMSTraceResource = 1u << 3,
+	kMVKMSTraceSync     = 1u << 4,
+	kMVKMSTraceGPU      = 1u << 5,
+	kMVKMSTraceCPU      = 1u << 6,
+	kMVKMSTraceAPI      = 1u << 7,
+	kMVKMSTracePass     = 1u << 8,
+};
+
+/** Categories turned on by METALSHARP_TRACE, and those turned on with +heavy. */
+uint32_t mvkMSTraceMask();
+uint32_t mvkMSTraceHeavyMask();
+
+/** The trace log, or stderr when tracing is off. */
+FILE* mvkMSTraceStream();
+
+/** Milliseconds since the trace started. */
+double mvkMSTraceTimeMS();
+
+/** Writes one line to the trace log: time, category, thread, message. */
+void mvkMSTracePrintf(uint32_t category, const char* format, ...) __printflike(2, 3);
+
+#define MVK_MS_TRACE_ON(cat)	((mvkMSTraceMask() & kMVKMSTrace##cat) != 0)
+#define MVK_MS_TRACE(cat, ...)	do { if (MVK_MS_TRACE_ON(cat)) { mvkMSTracePrintf(kMVKMSTrace##cat, __VA_ARGS__); } } while (0)
