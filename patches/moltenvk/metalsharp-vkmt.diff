+void MVKPhysicalDevice::initSparseResources() {
+	_supportsSparseResources = false;
+#if MVK_XCODE_26 && MVK_MACOS
+	if (mvkOSVersionIsAtLeast(26.0) && _gpuCapabilities.isAppleGPU && _metalFeatures.placementHeaps &&
+		[_mtlDevice respondsToSelector: @selector(newMTL4CommandQueueWithDescriptor:error:)] &&
+		[_mtlDevice sparseTileSizeInBytesForSparsePageSize: MTLSparsePageSize64] == kSparseBlockSize) {
+		_supportsSparseResources = true;
+	}
+#endif
+}
+
+// The Vulkan standard sparse block shapes (64 KiB) by texel block size, in blocks.
+static VkExtent3D mvkStandardSparseBlockShape2D(uint32_t bytesPerBlock) {
+	switch (bytesPerBlock) {
+		case 1:  return { 256, 256, 1 };
+		case 2:  return { 256, 128, 1 };
+		case 4:  return { 128, 128, 1 };
+		case 8:  return { 128,  64, 1 };
+		case 16: return {  64,  64, 1 };
+		default: return { 0, 0, 0 };
+	}
+}
