+VkResult MVKCmdExecuteGeneratedCommands::setContent(MVKCommandBuffer* cmdBuff, VkBool32 isPreprocessed,
+													const VkGeneratedCommandsInfoEXT* pInfo) {
+	MVKDevice* mvkDev = cmdBuff->getDevice();
+	_layout = (MVKIndirectCommandsLayout*)pInfo->indirectCommandsLayout;
+	_maxSequenceCount = pInfo->maxSequenceCount;
+	VkDeviceSize offset = 0;
+	MVKBuffer* stream = mvkDev->getBufferAtAddress(pInfo->indirectAddress, offset);
+	if ( !stream ) {
+		return cmdBuff->reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCmdExecuteGeneratedCommandsEXT(): No buffer at the indirect address.");
+	}
+	_mtlStream = stream->getMTLBuffer();
+	_mtlStreamOffset = stream->getMTLBufferOffset() + offset;
+	_mtlCount = nil;
+	_mtlCountOffset = 0;
+	if (pInfo->sequenceCountAddress) {
+		MVKBuffer* count = mvkDev->getBufferAtAddress(pInfo->sequenceCountAddress, offset, sizeof(uint32_t));
+		if ( !count ) {
+			return cmdBuff->reportError(VK_ERROR_INITIALIZATION_FAILED, "vkCmdExecuteGeneratedCommandsEXT(): No buffer at the sequence count address.");
+		}
+		_mtlCount = count->getMTLBuffer();
+		_mtlCountOffset = count->getMTLBufferOffset() + offset;
+	}
+	return VK_SUCCESS;
+}
