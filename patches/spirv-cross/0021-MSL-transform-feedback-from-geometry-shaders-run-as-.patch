+void CompilerMSL::analyze_geometry_xfb()
+{
+	geometry_xfb_outputs.clear();
+	for (auto &stride : geometry_xfb_strides)
+		stride = 0;
+	ir.for_each_typed_id<SPIRVariable>([&](uint32_t self, SPIRVariable &var) {
+		if (var.storage != StorageClassOutput || !interface_variable_exists_in_entry_point(self))
+			return;
+		auto &type = get_variable_data_type(var);
+		uint32_t buffer = get_decoration(self, DecorationXfbBuffer);
+		uint32_t stride = get_decoration(self, DecorationXfbStride);
+		auto add = [&](uint32_t member, uint32_t buf, uint32_t offset, uint32_t str) {
+			if (buf >= 4)
+				SPIRV_CROSS_THROW("Transform feedback buffer out of range.");
+			geometry_xfb_outputs.push_back({ self, member, buf, offset });
+			if (str)
+				geometry_xfb_strides[buf] = str;
+		};
+		if (type.basetype == SPIRType::Struct && has_decoration(type.self, DecorationBlock))
+		{
+			for (uint32_t i = 0; i < uint32_t(type.member_types.size()); i++)
+			{
+				if (!has_member_decoration(type.self, i, DecorationOffset))
+					continue;
+				uint32_t buf = has_member_decoration(type.self, i, DecorationXfbBuffer) ?
+				               get_member_decoration(type.self, i, DecorationXfbBuffer) : buffer;
+				uint32_t str = has_member_decoration(type.self, i, DecorationXfbStride) ?
+				               get_member_decoration(type.self, i, DecorationXfbStride) : stride;
+				add(i, buf, get_member_decoration(type.self, i, DecorationOffset), str);
+			}
+		}
+		else if (has_decoration(self, DecorationOffset))
+			add(~0u, buffer, get_decoration(self, DecorationOffset), stride);
+	});
+}
+
+// The value of a captured output of a geometry shader, as written to the stage output.
+string CompilerMSL::geometry_xfb_expression(const GeometryXfbOutput &output)
+{
+	if (output.member == ~0u)
+		return to_expression(output.var_id);
+	auto &type = get_variable_data_type(get<SPIRVariable>(output.var_id));
+	auto &qualified = get_member_qualified_name(type.self, output.member);
+	if (!qualified.empty())
+		return qualified;
+	if (has_member_decoration(type.self, output.member, DecorationBuiltIn))
+		return join(to_name(stage_out_var_id), ".",
+		            builtin_to_glsl(BuiltIn(get_member_decoration(type.self, output.member, DecorationBuiltIn)), StorageClassOutput));
+	return join(to_name(stage_out_var_id), ".", to_member_name(type, output.member));
+}
+
+uint32_t CompilerMSL::geometry_xfb_vertices_per_primitive() const
+{
+	auto &flags = get_entry_point().flags;
+	return flags.get(ExecutionModeOutputPoints) ? 1 : flags.get(ExecutionModeOutputLineStrip) ? 2 : 3;
+}
