From 4d7f703227df438bebc0eed7162e742c9a6461af Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Fri, 23 Oct 2026 18:32:12 -0600
Subject: [PATCH 16/25] MSL: emulated depth bounds test against a depth
 snapshot

---
 spirv_msl.cpp | 96 +++++++++++++++++++++++++++++++++++++++++++++++++++
 spirv_msl.hpp | 11 ++++++
 2 files changed, 107 insertions(+)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 307a3511..a4bfc2ec 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -1108,6 +1108,81 @@ void CompilerMSL::build_implicit_builtins()
 		conservative_bary_id = var_id;
 	}
 
+	if (msl_options.emulate_depth_bounds && get_execution_model() == ExecutionModelFragment)
+	{
+		// The depth bounds test needs the fragment position.
+		if (!builtin_frag_coord_id)
+		{
+			ir.for_each_typed_id<SPIRVariable>([&](uint32_t id, SPIRVariable &var) {
+				if (var.storage == StorageClassInput && has_decoration(id, DecorationBuiltIn) &&
+				    get_decoration(id, DecorationBuiltIn) == BuiltInFragCoord && interface_variable_exists_in_entry_point(id))
+					builtin_frag_coord_id = id;
+			});
+		}
+		if (!builtin_frag_coord_id)
+		{
+			uint32_t offset = ir.increase_bound_by(3);
+			uint32_t type_id = offset, type_ptr_id = offset + 1, var_id = offset + 2;
+			SPIRType vec4_type { OpTypeVector };
+			vec4_type.basetype = SPIRType::Float;
+			vec4_type.width = 32;
+			vec4_type.vecsize = 4;
+			set<SPIRType>(type_id, vec4_type);
+			SPIRType vec4_type_ptr = vec4_type;
+			vec4_type_ptr.op = OpTypePointer;
+			vec4_type_ptr.pointer = true;
+			vec4_type_ptr.pointer_depth++;
+			vec4_type_ptr.parent_type = type_id;
+			vec4_type_ptr.storage = StorageClassInput;
+			auto &ptr_type = set<SPIRType>(type_ptr_id, vec4_type_ptr);
+			ptr_type.self = type_id;
+			set<SPIRVariable>(var_id, type_ptr_id, StorageClassInput);
+			set_decoration(var_id, DecorationBuiltIn, BuiltInFragCoord);
+			builtin_frag_coord_id = var_id;
+			mark_implicit_builtin(StorageClassInput, BuiltInFragCoord, var_id);
+		}
+
+		// The depth snapshot: a sampled depth image (depth2d / depth2d_ms) bound outside any descriptor set.
+		uint32_t offset = ir.increase_bound_by(4);
+		uint32_t img_type_id = offset, ptr_type_id = offset + 1, var_id = offset + 2, float_type_id = offset + 3;
+		SPIRType float_type { OpTypeFloat };
+		float_type.basetype = SPIRType::Float;
+		float_type.width = 32;
+		float_type.vecsize = 1;
+		set<SPIRType>(float_type_id, float_type);
+		SPIRType img_type { OpTypeImage };
+		img_type.basetype = SPIRType::Image;
+		img_type.image.type = float_type_id;
+		img_type.image.dim = Dim2D;
+		img_type.image.depth = true;
+		img_type.image.ms = msl_options.depth_bounds_msaa;
+		img_type.image.sampled = 1;
+		img_type.image.format = ImageFormatUnknown;
+		set<SPIRType>(img_type_id, img_type);
+		SPIRType img_ptr = img_type;
+		img_ptr.op = OpTypePointer;
+		img_ptr.pointer = true;
+		img_ptr.pointer_depth++;
+		img_ptr.parent_type = img_type_id;
+		img_ptr.storage = StorageClassUniformConstant;
+		auto &img_ptr_type = set<SPIRType>(ptr_type_id, img_ptr);
+		img_ptr_type.self = img_type_id;
+		set<SPIRVariable>(var_id, ptr_type_id, StorageClassUniformConstant);
+		set_name(var_id, "spvDepthBoundsDepth");
+		// This should never match anything.
+		set_decoration(var_id, DecorationDescriptorSet, ~(8u));
+		set_decoration(var_id, DecorationBinding, msl_options.depth_bounds_texture_index);
+		set_extended_decoration(var_id, SPIRVCrossDecorationResourceIndexPrimary, msl_options.depth_bounds_texture_index);
+		depth_bounds_texture_id = var_id;
+
+		uint32_t buf_id = build_constant_uint_array_pointer();
+		set_name(buf_id, "spvDepthBounds");
+		set_decoration(buf_id, DecorationDescriptorSet, ~(8u));
+		set_decoration(buf_id, DecorationBinding, msl_options.depth_bounds_buffer_index);
+		set_extended_decoration(buf_id, SPIRVCrossDecorationResourceIndexPrimary, msl_options.depth_bounds_buffer_index);
+		depth_bounds_buffer_id = buf_id;
+	}
+
 	if (needs_atomic64_locks)
 	{
 		uint32_t var_id = build_device_uint_array_pointer();
@@ -2571,6 +2646,10 @@ string CompilerMSL::compile()
 		add_active_interface_variable(atomic64_lock_buffer_id);
 	if (conservative_bary_id)
 		add_active_interface_variable(conservative_bary_id);
+	if (depth_bounds_texture_id)
+		add_active_interface_variable(depth_bounds_texture_id);
+	if (depth_bounds_buffer_id)
+		add_active_interface_variable(depth_bounds_buffer_id);
 	if (acceleration_structure_address_table_id)
 		add_active_interface_variable(acceleration_structure_address_table_id);
 	if (view_mask_buffer_id)
@@ -2757,6 +2836,7 @@ void CompilerMSL::preprocess_op_codes()
 	// before then so that gl_SampleID will get added; so we also need to check if
 	// that function would add gl_FragCoord.
 	if (preproc.needs_sample_id || msl_options.force_sample_rate_shading ||
+	    (msl_options.emulate_depth_bounds && msl_options.depth_bounds_msaa && get_execution_model() == ExecutionModelFragment) ||
 	    (is_sample_rate() && (active_input_builtins.get(BuiltInFragCoord) ||
 	                          (need_subpass_input_ms && !msl_options.use_framebuffer_fetch_subpasses))))
 		needs_sample_id = true;
@@ -18245,6 +18325,22 @@ void CompilerMSL::fix_up_shader_inputs_outputs()
 		});
 	}
 
+	// Depth bounds test against the stored depth, before the shader runs.
+	if (depth_bounds_texture_id && depth_bounds_buffer_id && builtin_frag_coord_id)
+	{
+		entry_func.fixup_hooks_in.push_back([this]() {
+			string coord = join("uint2(", to_expression(builtin_frag_coord_id), ".xy)");
+			string sample = msl_options.depth_bounds_msaa ? join(", ", to_expression(builtin_sample_id_id)) : string();
+			statement("if (", to_expression(depth_bounds_buffer_id), "[0] != 0u)");
+			begin_scope();
+			statement("float spvStoredDepth = ", to_expression(depth_bounds_texture_id), ".read(", coord, sample, ").x;");
+			statement("if (spvStoredDepth < as_type<float>(", to_expression(depth_bounds_buffer_id), "[1]) || spvStoredDepth > as_type<float>(",
+			          to_expression(depth_bounds_buffer_id), "[2]))");
+			statement("    discard_fragment();");
+			end_scope();
+		});
+	}
+
 	// Logic operations replace each affected color output with op(output, destination).
 	logic_op_outputs.clear();
 	if (get_execution_model() == ExecutionModelFragment && msl_options.logic_op)
diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index 6429908f..0274a85b 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -638,6 +638,15 @@ public:
 		// from the barycentrics the conservative mesh stage passes along. Otherwise it is false.
 		bool conservative_raster_fragment = false;
 
+		// Depth bounds test for GPUs without Metal's: the fragment shader reads the stored depth from a
+		// snapshot of the depth attachment (a depth texture at depth_bounds_texture_index, multisampled if
+		// depth_bounds_msaa, which makes the shader run per sample) and discards outside the bounds in the
+		// buffer at depth_bounds_buffer_index: { uint enable; float min; float max; }.
+		bool emulate_depth_bounds = false;
+		bool depth_bounds_msaa = false;
+		uint32_t depth_bounds_texture_index = 0;
+		uint32_t depth_bounds_buffer_index = 0;
+
 		enum class PrimitiveTopology {
 			Triangles, TriangleStrip, Points
 		} input_primitive_type;
@@ -1386,6 +1395,8 @@ protected:
 	uint32_t view_mask_buffer_id = 0;
 	uint32_t atomic64_lock_buffer_id = 0;
 	uint32_t conservative_bary_id = 0;
+	uint32_t depth_bounds_texture_id = 0;
+	uint32_t depth_bounds_buffer_id = 0;
 	bool needs_atomic64_locks = false;
 	uint32_t draw_index_buffer_id = 0;
 	uint32_t dynamic_offsets_buffer_id = 0;
-- 
2.54.0 (Apple Git-157)

