From 37b90a317b123c2093693925dc84df217785a783 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Fri, 23 Oct 2026 19:26:16 -0600
Subject: [PATCH 19/20] MSL: transform feedback capture kernels keep their
 stage outputs in the thread

The capture stage only captures, so it no longer needs an output buffer sized
by the vertex and instance count (which indirect draws don't know).
---
 spirv_msl.cpp | 16 ++++++++++++----
 spirv_msl.hpp |  9 ++++++++-
 2 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 36360f47..2ab03244 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -5728,7 +5728,11 @@ uint32_t CompilerMSL::add_interface_block(StorageClass storage, bool patch, bool
 						// The first member of the indirect buffer is always the number of vertices
 						// to draw.
 						// We zero-base the InstanceID & VertexID variables for HLSL emulation elsewhere, so don't do it twice
-						if (vertex_shader_is_kernel())
+						if (is_xfb_capture_kernel())
+						{
+							statement(to_name(ir.default_entry_point), "_", ib_var_ref, " ", ib_var_ref, " = {};");
+						}
+						else if (vertex_shader_is_kernel())
 						{
 							statement("device ", to_name(ir.default_entry_point), "_", ib_var_ref, "& ", ib_var_ref,
 							          " = ", output_buffer_var_name, "[", to_expression(builtin_invocation_id_id),
@@ -17336,6 +17340,9 @@ string CompilerMSL::get_type_address_space(const SPIRType &type, uint32_t id, bo
 			if (get_execution_model() == ExecutionModelVertex && has_decoration(type.self, DecorationBlock))
 				addr_space = "thread";
 
+			if (!addr_space && is_xfb_capture_kernel())
+				addr_space = "thread";
+
 			if (!addr_space)
 				addr_space = "device";
 		}
@@ -17647,7 +17654,7 @@ void CompilerMSL::entry_point_args_builtin(string &ep_args)
 	{
 		// Add parameters to hold the indirect draw parameters and the shader output. This has to be handled
 		// specially because it needs to be a pointer, not a reference.
-		if (stage_out_var_id)
+		if (stage_out_var_id && !is_xfb_capture_kernel())
 		{
 			if (!ep_args.empty())
 				ep_args += ", ";
@@ -20604,8 +20611,9 @@ bool CompilerMSL::variable_decl_is_remapped_storage(const SPIRVariable &variable
 		if (is_tese_shader() && is_builtin_variable(variable) && (builtin == BuiltInTessCoord || builtin == BuiltInPrimitiveId))
 			return false;
 
-		// Transform feedback captures go to thread-local copies, written out to the buffers at the end.
-		if (variable.storage == StorageClassOutput && needs_transform_feedback() && xfb_captured_outputs.count(variable.self))
+		// The transform feedback capture stage keeps its outputs in the thread (captures go to thread-local
+		// copies, written out to the buffers at the end).
+		if (variable.storage == StorageClassOutput && is_xfb_capture_kernel())
 			return false;
 
 		// We won't be able to catch writes to control point outputs here since variable
diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index b56142f5..4c53133b 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -799,7 +799,14 @@ public:
 	// buffer if the shader needs it.
 	bool needs_output_buffer() const
 	{
-		return capture_output_to_buffer && stage_out_var_id != ID(0);
+		return capture_output_to_buffer && stage_out_var_id != ID(0) && !is_xfb_capture_kernel();
+	}
+
+	// The transform feedback capture stage only captures: its stage outputs stay in the thread.
+	bool is_xfb_capture_kernel() const
+	{
+		return needs_transform_feedback() && get_execution_model() == spv::ExecutionModelVertex &&
+		       !msl_options.vertex_for_tessellation;
 	}
 
 	// Provide feedback to calling API to allow it to pass a patch output
