 	if (acceleration_structure_address_table_id)
 		add_active_interface_variable(acceleration_structure_address_table_id);
 	if (view_mask_buffer_id)
@@ -9658,6 +9769,17 @@ void CompilerMSL::emit_custom_functions()
 			break;
 		}
 
+		case SPVFuncImplFullyCovered:
+			statement("// The pixel is fully covered when every barycentric of the original triangle stays");
+			statement("// non-negative over the pixel square (they are linear in screen space).");
+			statement("static inline bool spvFullyCovered(float3 b)");
+			begin_scope();
+			statement("float3 r = 0.5 * (abs(dfdx(b)) + abs(dfdy(b)));");
+			statement("return all(b - r >= 0.0);");
+			end_scope();
+			statement("");
