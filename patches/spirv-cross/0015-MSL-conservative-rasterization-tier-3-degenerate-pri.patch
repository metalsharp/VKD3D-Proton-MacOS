From af9637c8e45a8fea6b535b72300dcc36e2143702 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Fri, 23 Oct 2026 17:51:33 -0600
Subject: [PATCH 15/21] MSL: conservative rasterization tier 3: degenerate
 primitives, FullyCoveredEXT from screen-space barycentrics

---
 spirv_msl.cpp | 180 +++++++++++++++++++++++++++++++++++++++++++-------
 spirv_msl.hpp |   9 +++
 2 files changed, 166 insertions(+), 23 deletions(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index c659b8fd..307a3511 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -1081,6 +1081,33 @@ void CompilerMSL::build_implicit_builtins()
 		set_extended_decoration(var_id, SPIRVCrossDecorationResourceIndexPrimary, msl_options.buffer_size_buffer_index);
 		buffer_size_buffer_id = var_id;
 	}
+	if (msl_options.conservative_raster_fragment && get_execution_model() == ExecutionModelFragment &&
+	    active_input_builtins.get(BuiltInFullyCoveredEXT) && !conservative_bary_id)
+	{
+		// The screen-space barycentrics of the original triangle, from the conservative mesh stage.
+		uint32_t offset = ir.increase_bound_by(3);
+		uint32_t type_id = offset, type_ptr_id = offset + 1, var_id = offset + 2;
+		SPIRType vec3_type { OpTypeVector };
+		vec3_type.basetype = SPIRType::Float;
+		vec3_type.width = 32;
+		vec3_type.vecsize = 3;
+		set<SPIRType>(type_id, vec3_type);
+		SPIRType vec3_ptr = vec3_type;
+		vec3_ptr.op = OpTypePointer;
+		vec3_ptr.pointer = true;
+		vec3_ptr.pointer_depth++;
+		vec3_ptr.parent_type = type_id;
+		vec3_ptr.storage = StorageClassInput;
+		auto &ptr_type = set<SPIRType>(type_ptr_id, vec3_ptr);
+		ptr_type.self = type_id;
+		set<SPIRVariable>(var_id, type_ptr_id, StorageClassInput);
+		set_decoration(var_id, DecorationLocation, kConservativeBaryLocation);
+		set_decoration(var_id, DecorationNoPerspective);
+		set_name(var_id, "spvConservativeBary");
+		get_entry_point().interface_variables.push_back(var_id);
+		conservative_bary_id = var_id;
+	}
+
 	if (needs_atomic64_locks)
 	{
 		uint32_t var_id = build_device_uint_array_pointer();
@@ -1812,11 +1839,13 @@ static const char *get_variable_format_string(SPIRType::BaseType type) {
 }
 
 // Overestimating conservative rasterization for a vertex shader in a mesh pipeline. The mesh stage
-// emits the Minkowski sum of the projected triangle and the pixel box (at most 7 vertices: each
-// triangle vertex contributes the box corners between its edges' outward normals). Each new vertex
-// gets perspective-correct weights for the original vertices, so attributes and depth extrapolate
-// along the triangle's plane. Degenerate triangles are culled; triangles crossing w <= 0 are
-// passed through unexpanded.
+// emits the Minkowski sum of the projected primitive and the pixel box: at most 7 vertices for a
+// triangle (each vertex contributes the box corners between its edges' outward normals), 6 for a
+// degenerate triangle (a segment), 4 for a point. Triangle hull vertices get perspective-correct
+// weights for the original vertices, so attributes and depth extrapolate along the triangle's plane;
+// degenerate hull vertices take their endpoint's attributes. Each vertex also carries its screen-space
+// barycentrics in the original triangle (-1 for degenerates), from which the fragment shader derives
+// FullyCoveredEXT. Triangles crossing w <= 0 are passed through unexpanded.
 void CompilerMSL::emit_conservative_raster_mesh(const SPIRType &out_type)
 {
 	if (msl_options.input_primitive_type != Options::PrimitiveTopology::Triangles)
@@ -1831,29 +1860,72 @@ void CompilerMSL::emit_conservative_raster_mesh(const SPIRType &out_type)
 	if (pos.empty())
 		SPIRV_CROSS_THROW("Conservative rasterization needs a position output.");
 
+	// The vertex type: the vertex shader's outputs plus the barycentrics.
+	string cr_name = out_name + "_conservative";
+	statement("");
+	statement("struct ", cr_name);
+	begin_scope();
+	for (uint32_t i = 0; i < uint32_t(out_type.member_types.size()); i++)
+	{
+		auto &mtype = get<SPIRType>(out_type.member_types[i]);
+		statement(type_to_glsl(mtype), " ", to_member_name(out_type, i), type_to_array_glsl(mtype, 0),
+		          member_attribute_qualifier(out_type, i), ";");
+	}
+	statement("float3 spvConservativeBary [[user(locn", kConservativeBaryLocation, ")]];");
+	end_scope_decl();
 	statement("");
-	statement("[[mesh]] void ", get_entry_point().name, "_PassThru(mesh<", out_name,
+
+	statement("[[mesh]] void ", get_entry_point().name, "_PassThru(mesh<", cr_name,
 	          ", void, 7, 5, topology::triangle> outputMesh, const object_data Payload &payload [[payload]])");
 	begin_scope();
 	statement(out_name, " v[3] = { payload.vertices[0], payload.vertices[1], payload.vertices[2] };");
 	statement("float4 c[3] = { v[0].", pos, ", v[1].", pos, ", v[2].", pos, " };");
 	statement("float2 e = payload.conservativeExtent;");
-	statement("float3 w[7];");
+	statement("float2 corner[4] = { float2(e.x, e.y), float2(-e.x, e.y), float2(-e.x, -e.y), float2(e.x, -e.y) };");
+	statement("float3 w[7], bary[7];");
+	statement("uint src[7];");
+	statement("float2 off[7];");
 	statement("uint n = 0;");
-	statement("bool ccw = true;");
+	statement("bool ccw = true, degenerate = false;");
 	statement("if (c[0].w > 1e-6 && c[1].w > 1e-6 && c[2].w > 1e-6 && e.x > 0.0 && e.y > 0.0)");
 	begin_scope();
 	statement("float2 p[3] = { c[0].xy / c[0].w, c[1].xy / c[1].w, c[2].xy / c[2].w };");
 	statement("float2 d1 = p[1] - p[0], d2 = p[2] - p[0];");
 	statement("float area = d1.x * d2.y - d1.y * d2.x;");
-	statement("if (abs(area) < 1e-14)");
+	statement("// Degenerate after snapping: under 1e-5 of a pixel's area (4 e.x e.y in NDC).");
+	statement("if (abs(area) < 4e-5 * e.x * e.y)");
 	begin_scope();
-	statement("outputMesh.set_primitive_count(0);");
-	statement("return;");
+	statement("// A segment (or a point): walk the two-sided polygon a -> b -> a. It has no facing of its");
+	statement("// own, so give it the winding that is front-facing (conservativeFlags bit 0).");
+	statement("degenerate = true;");
+	statement("ccw = (payload.conservativeFlags & 1u) != 0;");
+	statement("uint a = 0, b = 1;");
+	statement("float best = length_squared(p[1] - p[0]);");
+	statement("if (length_squared(p[2] - p[0]) > best) { best = length_squared(p[2] - p[0]); b = 2; }");
+	statement("if (length_squared(p[2] - p[1]) > best) { best = length_squared(p[2] - p[1]); a = 1; b = 2; }");
+	statement("if (best < 1e-20)");
+	begin_scope();
+	statement("for (uint s = 0; s < 4; s++) { src[n] = a; off[n] = corner[s]; n++; }");
+	end_scope();
+	statement("else");
+	begin_scope();
+	statement("float2 d = p[b] - p[a];");
+	statement("float2 nrm = float2(d.y, -d.x);");
+	statement("uint qab = nrm.x >= 0.0 ? (nrm.y >= 0.0 ? 0u : 3u) : (nrm.y >= 0.0 ? 1u : 2u);");
+	statement("uint qba = (qab + 2u) & 3u;");
+	statement("uint ends[2] = { b, a }, from[2] = { qab, qba }, to[2] = { qba, qab };");
+	statement("for (uint k = 0; k < 2; k++)");
+	statement("    for (uint s = from[k];; s = (s + 1) & 3u)");
+	statement("    {");
+	statement("        src[n] = ends[k]; off[n] = corner[s]; n++;");
+	statement("        if (s == to[k] || n == 7) break;");
+	statement("    }");
 	end_scope();
+	end_scope();
+	statement("else");
+	begin_scope();
 	statement("ccw = area > 0.0;");
 	statement("uint order[3] = { 0u, ccw ? 1u : 2u, ccw ? 2u : 1u };");
-	statement("float2 corner[4] = { float2(e.x, e.y), float2(-e.x, e.y), float2(-e.x, -e.y), float2(e.x, -e.y) };");
 	statement("uint q[3];");
 	statement("for (uint k = 0; k < 3; k++)");
 	begin_scope();
@@ -1866,16 +1938,17 @@ void CompilerMSL::emit_conservative_raster_mesh(const SPIRType &out_type)
 	begin_scope();
 	statement("for (uint s = q[(k + 2) % 3];; s = (s + 1) & 3u)");
 	begin_scope();
-	statement("float2 h = p[order[k]] + corner[s];");
-	statement("float2 r = h - p[0];");
+	statement("float2 r = p[order[k]] + corner[s] - p[0];");
 	statement("float bs = (r.x * d2.y - r.y * d2.x) / area, bt = (d1.x * r.y - d1.y * r.x) / area;");
-	statement("float3 l = float3(1.0 - bs - bt, bs, bt) / float3(c[0].w, c[1].w, c[2].w);");
+	statement("float3 b3 = float3(1.0 - bs - bt, bs, bt);");
+	statement("float3 l = b3 / float3(c[0].w, c[1].w, c[2].w);");
 	statement("float sum = l.x + l.y + l.z;");
 	statement("if (!(sum > 0.0) || n == 7)");
 	begin_scope();
 	statement("ok = false;");
 	statement("break;");
 	end_scope();
+	statement("bary[n] = b3;");
 	statement("w[n++] = l / sum;");
 	statement("if (s == q[k])");
 	statement("    break;");
@@ -1884,33 +1957,62 @@ void CompilerMSL::emit_conservative_raster_mesh(const SPIRType &out_type)
 	statement("if (!ok)");
 	statement("    n = 0;");
 	end_scope();
+	end_scope();
 	statement("if (n == 0)");
 	begin_scope();
+	statement("degenerate = false;");
 	statement("n = 3;");
-	statement("w[0] = float3(1, 0, 0);");
-	statement("w[1] = ccw ? float3(0, 1, 0) : float3(0, 0, 1);");
-	statement("w[2] = ccw ? float3(0, 0, 1) : float3(0, 1, 0);");
+	statement("w[0] = bary[0] = float3(1, 0, 0);");
+	statement("w[1] = bary[1] = ccw ? float3(0, 1, 0) : float3(0, 0, 1);");
+	statement("w[2] = bary[2] = ccw ? float3(0, 0, 1) : float3(0, 1, 0);");
 	end_scope();
 
 	statement("for (uint k = 0; k < n; k++)");
 	begin_scope();
+	statement(cr_name, " o;");
+	statement("if (degenerate)");
+	begin_scope();
+	statement(out_name, " s = v[src[k]];");
+	for (uint32_t i = 0; i < uint32_t(out_type.member_types.size()); i++)
+	{
+		string m = to_member_name(out_type, i);
+		auto &mtype = get<SPIRType>(out_type.member_types[i]);
+		if (mtype.array.empty())
+			statement("o.", m, " = s.", m, ";");
+		else
+			statement("for (uint a = 0; a < ", mtype.array[0], "; a++) o.", m, "[a] = s.", m, "[a];");
+	}
+	statement("float4 cs = c[src[k]];");
+	statement("o.", pos, " = float4((cs.xy / cs.w + off[k]) * cs.w, cs.z, cs.w);");
+	statement("o.spvConservativeBary = float3(-1.0);");
+	end_scope();
+	statement("else");
+	begin_scope();
 	statement("float3 l = w[k];");
-	statement(out_name, " o = v[0];");
 	for (uint32_t i = 0; i < uint32_t(out_type.member_types.size()); i++)
 	{
 		auto &mtype = get<SPIRType>(out_type.member_types[i]);
-		if ((mtype.basetype != SPIRType::Float && mtype.basetype != SPIRType::Half) || mtype.columns != 1)
-			continue;
 		string m = to_member_name(out_type, i);
+		bool blend = (mtype.basetype == SPIRType::Float || mtype.basetype == SPIRType::Half) && mtype.columns == 1;
 		string elem_type = type_to_glsl(get<SPIRType>(mtype.self));
 		if (mtype.array.empty())
-			statement("o.", m, " = ", elem_type, "(v[0].", m, " * l.x + v[1].", m, " * l.y + v[2].", m, " * l.z);");
+		{
+			if (blend)
+				statement("o.", m, " = ", elem_type, "(v[0].", m, " * l.x + v[1].", m, " * l.y + v[2].", m, " * l.z);");
+			else
+				statement("o.", m, " = v[0].", m, ";");
+		}
 		else if (mtype.array.size() == 1 && mtype.array_size_literal[0])
 		{
 			statement("for (uint a = 0; a < ", mtype.array[0], "; a++)");
-			statement("    o.", m, "[a] = ", elem_type, "(v[0].", m, "[a] * l.x + v[1].", m, "[a] * l.y + v[2].", m, "[a] * l.z);");
+			if (blend)
+				statement("    o.", m, "[a] = ", elem_type, "(v[0].", m, "[a] * l.x + v[1].", m, "[a] * l.y + v[2].", m, "[a] * l.z);");
+			else
+				statement("    o.", m, "[a] = v[0].", m, "[a];");
 		}
