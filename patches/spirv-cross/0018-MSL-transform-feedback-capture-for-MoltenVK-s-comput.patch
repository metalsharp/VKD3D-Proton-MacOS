diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index 0274a85b..b56142f5 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -723,10 +723,12 @@ public:
 
 	// Provide feedback to calling API to allow runtime to bind buffers
 	// for transform feedback if a vertex pipeline shader requires it.
+	// Transform feedback is captured by a compute version of the shader (capture_output_to_buffer);
+	// a regular vertex function of the same shader rasterizes and ignores the Xfb decorations.
 	bool needs_transform_feedback() const
 	{
 		auto &execution = get_entry_point();
-		return execution.flags.get(spv::ExecutionModeXfb) &&
+		return execution.flags.get(spv::ExecutionModeXfb) && msl_options.capture_output_to_buffer &&
 		       (execution.model == spv::ExecutionModelVertex ||
