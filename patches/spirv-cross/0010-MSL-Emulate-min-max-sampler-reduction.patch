+bool CompilerMSL::is_sampler_reduction_variable(const SPIRVariable &var)
+{
+	if (!msl_options.emulate_sampler_reduction || var.storage != StorageClassUniformConstant || is_hidden_variable(var))
+		return false;
+	auto &type = get_variable_data_type(var);
+	bool sampler = type.basetype == SPIRType::Sampler ||
+	               (type.basetype == SPIRType::SampledImage && type.image.dim != DimBuffer);
+	if (!sampler || type.array.size() > 1 || !descriptor_set_is_argument_buffer(get_decoration(var.self, DecorationDescriptorSet)))
+		return false;
+	if (find_constexpr_sampler(var.basevariable ? var.basevariable : VariableID(var.self)))
+		return false;
+	return interface_variable_exists_in_entry_point(var.self);
+}
+
+// The reduction mode of the sampler expression: name + suffix, keeping any array index
+// (or the name alone, for its declaration).
+string CompilerMSL::to_sampler_reduction_expression(const string &sampler_expr, bool declaration)
+{
+	auto expr = sampler_expr;
+	if (expr.size() >= 3 && expr[0] == '(' && expr[1] == '*')
+		expr = expr.substr(2, expr.size() - 3);
+	auto index = expr.find_first_of('[');
+	string base = index == string::npos ? expr : expr.substr(0, index);
+	for (auto &c : base)
+		if (c == '.')
+			c = '_';
+	string reduction = base + sampler_reduction_name_suffix;
+	if (declaration)
+		return reduction;
+	return index == string::npos ? reduction + "[0]" : reduction + expr.substr(index);
+}
+
+// Samples through a min/max sampler reduce their footprint (see Options::emulate_sampler_reduction).
+// Returns false if the operation is emitted normally.
+bool CompilerMSL::emit_sampler_reduction_texture_op(const Instruction &i)
+{
+	if (!msl_options.emulate_sampler_reduction)
+		return false;
+	auto *ops = stream(i);
+	auto op = static_cast<Op>(i.op);
+	if (op != OpImageSampleImplicitLod && op != OpImageSampleExplicitLod)
+		return false;
+
+	uint32_t result_type_id = ops[0];
+	uint32_t id = ops[1];
+	uint32_t img = ops[2];
+	uint32_t coord = ops[3];
+	auto &imgtype = expression_type(img);
+	if (imgtype.image.dim != Dim2D || imgtype.image.ms || imgtype.image.depth)
+		return false;
+
+	// The sampler must be one whose reduction mode is in its set's constants.
+	auto *combined = maybe_get<SPIRCombinedImageSampler>(img);
+	auto *sampler_var = maybe_get_backing_variable(combined && combined->sampler ? uint32_t(combined->sampler) : img);
+	if (!sampler_var || !is_sampler_reduction_variable(*sampler_var))
+		return false;
+
+	uint32_t bias = 0, lod = 0, grad_x = 0, grad_y = 0, offset = 0, min_lod = 0;
+	if (i.length > 4)
+	{
+		uint32_t flags = ops[4];
+		uint32_t k = 5;
+		auto next = [&]() { return k < i.length ? ops[k++] : 0u; };
+		if (flags & ImageOperandsBiasMask)
+			bias = next();
+		if (flags & ImageOperandsLodMask)
+			lod = next();
+		if (flags & ImageOperandsGradMask)
+		{
+			grad_x = next();
+			grad_y = next();
+		}
+		if (flags & ImageOperandsConstOffsetMask)
+			offset = next();
+		if (flags & ImageOperandsOffsetMask)
+			offset = next();
+		if (flags & (ImageOperandsConstOffsetsMask | ImageOperandsSampleMask))
+			return false;
+		if (flags & ImageOperandsMinLodMask)
+			min_lod = next();
+	}
+
+	bool forward = false;
+	SmallVector<uint32_t> inherited_expressions;
+	string sample_expr = to_texture_op(i, false, &forward, inherited_expressions);
+
+	string tex_expr = to_expression(combined ? combined->image : VariableID(img));
+	string smp_expr = to_sampler_expression(img);
+	string coord_expr = to_enclosed_expression(coord);
+	bool arrayed = imgtype.image.arrayed;
+	string uv = join(coord_expr, ".xy");
+	string layer = arrayed ? join(", uint(max(rint(", coord_expr, ".z), 0.0))") : "";
+
+	string lod_expr;
+	if (lod)
+		lod_expr = join("float(", to_expression(lod), ")");
+	else if (grad_x)
+		lod_expr = join("log2(max(length(float2(", to_expression(grad_x), ") * float2(", tex_expr, ".get_width(), ", tex_expr,
+		                ".get_height())), length(float2(", to_expression(grad_y), ") * float2(", tex_expr, ".get_width(), ", tex_expr,
+		                ".get_height()))))");
+	else if (get_execution_model() == ExecutionModelFragment)
+		lod_expr = join(tex_expr, ".calculate_unclamped_lod(", smp_expr, ", ", uv, ")");
+	else
+		lod_expr = "0.0";
+	if (bias)
+		lod_expr = join("(", lod_expr, " + float(", to_expression(bias), "))");
+	if (min_lod)
+		lod_expr = join("max(", lod_expr, ", float(", to_expression(min_lod), "))");
+	string offset_expr = offset ? join(", int2(", to_expression(offset), ")") : ", int2(0)";
+
+	add_spv_func_and_recompile(SPVFuncImplSampleReduce);
+	string mode = join("(", to_sampler_reduction_expression(smp_expr), ")");
+	string reduced = join("spvSampleReduce(", tex_expr, ", ", smp_expr, ", ", uv, layer, ", ", lod_expr, ", ", mode, offset_expr, ")");
+	emit_op(result_type_id, id, join("((", mode, " & 3u) != 0u ? ", reduced, " : ", sample_expr, ")"), false);
+	for (auto &inherit : inherited_expressions)
+		inherit_expression_dependencies(id, inherit);
+	return true;
+}
+
