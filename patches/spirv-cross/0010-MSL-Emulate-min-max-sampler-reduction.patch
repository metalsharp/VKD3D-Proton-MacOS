+		if (var.storage == StorageClassUniformConstant && !is_hidden_variable(var) && is_sampler_reduction_variable(var))
+		{
+			entry_func.fixup_hooks_in.push_back([this, &type, &var, var_id]() {
+				uint32_t desc_set = get_decoration(var_id, DecorationDescriptorSet);
+				string sampler_expr = type.basetype == SPIRType::Sampler ? to_expression(var_id) : to_sampler_expression(var_id);
+				statement("constant uint* ", to_sampler_reduction_expression(sampler_expr, true), " = &",
+				          to_name(argument_buffer_ids[desc_set]), ".spvBufferSizeConstants[",
+				          convert_to_string(get_metal_resource_index(var, SPIRType::Sampler)), "];");
+			});
+		}
+
 		if (var.storage == StorageClassUniformConstant && !is_hidden_variable(var))
 		{
 			if (msl_options.swizzle_texture_samples && has_sampled_images && is_sampled_image_type(type))
@@ -21246,6 +21433,12 @@ void CompilerMSL::analyze_argument_buffers()
 				set_needs_buffer_sizes[desc_set] = true;
 				needs_buffer_sizes = true;
 			}
+			// Sampler reduction modes live in the same constants as buffer sizes.
+			if (is_sampler_reduction_variable(var))
+			{
+				set_needs_buffer_sizes[desc_set] = true;
+				needs_buffer_sizes = true;
+			}
 		}
 	});
 
