diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 5d5458fc..5b6501ef 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -6267,6 +6267,21 @@ void CompilerMSL::emit_custom_templates()
 // otherwise they will cause problems when linked together in a single Metallib.
 void CompilerMSL::emit_custom_functions()
 {
+	if (!logic_op_outputs.empty())
+	{
+		static const char *const ops[16] = {
+			"T(0)", "s & d", "s & ~d", "s", "~s & d", "d", "s ^ d", "s | d",
+			"~(s | d)", "~(s ^ d)", "~d", "s | ~d", "~s", "~s | d", "~(s & d)", "~T(0)",
+		};
+		statement("// The pipeline's logic operation on the attachment's bits.");
+		statement("template<typename T>");
+		statement("inline T spvLogicOp(T s, T d)");
+		begin_scope();
+		statement("return ", ops[(msl_options.logic_op - 1) & 15], ";");
+		end_scope();
+		statement("");
+	}
+
 	// Use when outputting overloaded functions to cover different address spaces.
 	static const char *texture_addr_spaces[] = { "device", "constant", "thread" };
 	static uint32_t texture_addr_space_count = sizeof(texture_addr_spaces) / sizeof(char*);
@@ -12187,6 +12202,75 @@ void CompilerMSL::emit_atomic_func_op(uint32_t result_type, uint32_t result_id,
 	flush_all_atomic_capable_variables();
 }
 
+void CompilerMSL::emit_logic_op(const SPIRVariable &var, uint32_t location, uint32_t kind)
+{
+	auto &type = get_variable_data_type(var);
+	uint32_t n = type.vecsize;
+	string out = to_expression(var.self);
+	string dst = join("spvLogicOpDst", location);
+	auto vec = [n](const char *base) { return n == 1 ? string(base) : join(base, n); };
+	string uintn = vec("uint"), intn = vec("int"), floatn = vec("float"), out_type = type_to_glsl(type);
+
+	if (kind == Options::LogicOpInteger)
+	{
+		statement(out, " = as_type<", out_type, ">(spvLogicOp(as_type<", uintn, ">(", out, "), as_type<", uintn, ">(", dst, ")));");
+		return;
+	}
+	if (kind == Options::LogicOpInteger8 || kind == Options::LogicOpInteger16 || kind == Options::LogicOpInteger10_10_10_2)
+	{
+		// Metal clamps out-of-range integer outputs, so keep the result within the channel width
+		// (sign-extended for signed formats).
+		static const uint32_t bits1010102[4] = { 10, 10, 10, 2 };
+		string shifts;
+		for (uint32_t i = 0; i < n; i++)
+		{
+			uint32_t bits = kind == Options::LogicOpInteger8 ? 8 : kind == Options::LogicOpInteger16 ? 16 : bits1010102[i];
+			shifts += join(i ? ", " : "", 32 - bits, "u");
+		}
+		begin_scope();
+		statement(uintn, " spvLogicOpShift = ", uintn, "(", shifts, ");");
+		statement(uintn, " spvLogicOpBits = spvLogicOp(as_type<", uintn, ">(", out, "), as_type<", uintn, ">(", dst, ")) << spvLogicOpShift;");
+		if (type.basetype == SPIRType::Int)
+			statement(out, " = as_type<", out_type, ">(as_type<", intn, ">(spvLogicOpBits) >> as_type<", intn, ">(spvLogicOpShift));");
+		else
+			statement(out, " = as_type<", out_type, ">(spvLogicOpBits >> spvLogicOpShift);");
+		end_scope();
+		return;
+	}
+
+	// Normalized formats: the operation applies to the fixed-point bits the attachment stores.
+	static const uint32_t unorm1010102[4] = { 1023, 1023, 1023, 3 };
+	string max_bits;
+	for (uint32_t i = 0; i < n; i++)
+	{
+		uint32_t m = kind == Options::LogicOpUNorm8 ? 255u : kind == Options::LogicOpUNorm16 ? 65535u :
+		             kind == Options::LogicOpUNorm10_10_10_2 ? unorm1010102[i] : kind == Options::LogicOpSNorm8 ? 255u : 65535u;
+		max_bits += join(i ? ", " : "", m, "u");
+	}
+	begin_scope();
+	statement(uintn, " spvLogicOpMask = ", uintn, "(", max_bits, ");");
+	if (kind == Options::LogicOpSNorm8 || kind == Options::LogicOpSNorm16)
+	{
+		uint32_t bits = kind == Options::LogicOpSNorm8 ? 8 : 16;
+		uint32_t scale = (1u << (bits - 1)) - 1;
+		auto encode = [&](const string &v) {
+			return join(uintn, "(", intn, "(rint(clamp(", floatn, "(", v, "), -1.0, 1.0) * ", scale, ".0))) & spvLogicOpMask");
+		};
+		statement(uintn, " spvLogicOpBits = spvLogicOp(", encode(out), ", ", encode(dst), ") & spvLogicOpMask;");
+		statement(out, " = ", out_type, "(max(", floatn, "(", intn, "(spvLogicOpBits << ", 32 - bits, "u) >> ", 32 - bits,
+		          ") / ", scale, ".0, -1.0));");
+	}
+	else
+	{
+		auto encode = [&](const string &v) {
+			return join(uintn, "(rint(saturate(", floatn, "(", v, ")) * ", floatn, "(spvLogicOpMask)))");
+		};
+		statement(out, " = ", out_type, "(", floatn, "(spvLogicOp(", encode(out), ", ", encode(dst),
+		          ") & spvLogicOpMask) / ", floatn, "(spvLogicOpMask));");
+	}
+	end_scope();
+}
+
 bool CompilerMSL::is_robust_buffer_variable(const SPIRVariable &var) const
 {
 	if (!msl_options.robust_storage_buffer_access && !msl_options.robust_uniform_buffer_access)
@@ -15522,6 +15606,15 @@ void CompilerMSL::entry_point_args_builtin(string &ep_args)
 {
 	depth_clip_viewport_idx_var_name = "";
 
+	for (auto &output : logic_op_outputs)
+	{
+		if (!ep_args.empty())
+			ep_args += ", ";
+		// Metal requires the destination to have the output's type.
+		auto &type = get_variable_data_type(get<SPIRVariable>(output.second));
+		ep_args += join(type_to_glsl(type), " spvLogicOpDst", output.first, " [[color(", output.first, ")]]");
+	}
+
 	// Builtin variables
 	SmallVector<pair<SPIRVariable *, BuiltIn>, 8> active_builtins;
 	ir.for_each_typed_id<SPIRVariable>([&](uint32_t var_id, SPIRVariable &var) {
@@ -16259,6 +16352,26 @@ void CompilerMSL::fix_up_shader_inputs_outputs()
 		});
 	}
 
+	// Logic operations replace each affected color output with op(output, destination).
+	logic_op_outputs.clear();
+	if (get_execution_model() == ExecutionModelFragment && msl_options.logic_op)
+	{
+		ir.for_each_typed_id<SPIRVariable>([&](uint32_t, SPIRVariable &var) {
+			if (var.storage != StorageClassOutput || is_builtin_variable(var) ||
+			    !has_decoration(var.self, DecorationLocation) || get_decoration(var.self, DecorationIndex) != 0 ||
+			    !interface_variable_exists_in_entry_point(var.self))
+				return;
+			uint32_t location = get_decoration(var.self, DecorationLocation);
+			auto &type = get_variable_data_type(var);
+			uint32_t kind = location < 8 ? (msl_options.logic_op_attachment_kinds >> (location * 4)) & 0xf : 0;
+			if (!kind || !type.array.empty() || type.columns != 1 ||
+			    !(msl_options.enable_frag_output_mask & (1u << location)))
+				return;
+			logic_op_outputs[location] = var.self;
+			entry_func.fixup_hooks_out.push_back([=, &var]() { emit_logic_op(var, location, kind); });
+		});
+	}
+
 	if (is_mesh_shader())
 	{
 		// If shader doesn't call SetMeshOutputsEXT, nothing should be rendered.
diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index 7ad4ddc8..8a748059 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -374,6 +374,20 @@ public:
 		// Enables specifick argument buffer format with extra information to track SSBO-length
 		bool runtime_array_rich_descriptor = false;
 
+		enum LogicOpKind
+		{
+			LogicOpNone = 0,
+			LogicOpUNorm8 = 1,
+			LogicOpUNorm16 = 2,
+			LogicOpUNorm10_10_10_2 = 3,
+			LogicOpSNorm8 = 4,
+			LogicOpSNorm16 = 5,
+			LogicOpInteger = 6, // 32-bit channels
+			LogicOpInteger8 = 7,
+			LogicOpInteger16 = 8,
+			LogicOpInteger10_10_10_2 = 9
+		};
+
 		// Bounds-check loads, stores and atomics through storage buffer (and, separately, uniform buffer)
 		// descriptors against the descriptor's range, as VK_EXT_robustness2 robustBufferAccess2 requires:
 		// out-of-bounds reads return zero and out-of-bounds writes and atomics are discarded.
@@ -383,6 +397,13 @@ public:
 		bool robust_storage_buffer_access = false;
 		bool robust_uniform_buffer_access = false;
 
+		// Fragment logic operations through framebuffer fetch (Metal has none for integer formats).
+		// logic_op is the VkLogicOp + 1 (0: disabled). logic_op_attachment_kinds holds 4 bits per
+		// color location 0-7 saying how the attachment stores bits (LogicOpKind; 0: no logic op,
+		// as for float and sRGB formats).
+		uint32_t logic_op = 0;
+		uint32_t logic_op_attachment_kinds = 0;
+
 		// Ensures vertex and instance indices start at zero. This reflects the behavior of HLSL with SV_VertexID and SV_InstanceID.
 		bool enable_base_index_zero = false;
 
@@ -1401,6 +1422,10 @@ protected:
 		std::string condition;
 	};
 	std::unordered_map<uint32_t, RobustAccessChain> robust_access_chains;
+
+	// Logic operations: the fragment outputs they apply to, by location, and their base types.
+	std::map<uint32_t, uint32_t> logic_op_outputs; // location -> output variable
+	void emit_logic_op(const SPIRVariable &var, uint32_t location, uint32_t kind);
 	bool is_robust_buffer_variable(const SPIRVariable &var) const;
 	void track_robust_access_chain(const uint32_t *ops, uint32_t length, bool ptr_chain);
 	std::string robust_access_condition(uint32_t ptr_id) const override;
