 static int vertex_count_in_primitive(CompilerMSL::Options::PrimitiveTopology top) {
-	if (top == CompilerMSL::Options::PrimitiveTopology::TriangleStrip) {
-		return 3;
-	} else if (top == CompilerMSL::Options::PrimitiveTopology::Triangles) {
-		return 3;
-	} else if (top == CompilerMSL::Options::PrimitiveTopology::Points) {
-		return 1;
+	switch (top) {
+	case CompilerMSL::Options::PrimitiveTopology::Points: return 1;
+	case CompilerMSL::Options::PrimitiveTopology::Lines: return 2;
+	case CompilerMSL::Options::PrimitiveTopology::LinesAdjacency: return 4;
+	case CompilerMSL::Options::PrimitiveTopology::Triangles:
+	case CompilerMSL::Options::PrimitiveTopology::TriangleStrip: return 3;
+	case CompilerMSL::Options::PrimitiveTopology::TrianglesAdjacency: return 6;
 	}
-
 	return 0;
 }
 
+// The input primitive of a geometry shader, from its execution mode.
+static CompilerMSL::Options::PrimitiveTopology geometry_input_primitive(const Bitset &flags) {
+	if (flags.get(ExecutionModeInputPoints)) return CompilerMSL::Options::PrimitiveTopology::Points;
+	if (flags.get(ExecutionModeInputLines)) return CompilerMSL::Options::PrimitiveTopology::Lines;
+	if (flags.get(ExecutionModeInputLinesAdjacency)) return CompilerMSL::Options::PrimitiveTopology::LinesAdjacency;
+	if (flags.get(ExecutionModeInputTrianglesAdjacency)) return CompilerMSL::Options::PrimitiveTopology::TrianglesAdjacency;
+	return CompilerMSL::Options::PrimitiveTopology::Triangles;
+}
