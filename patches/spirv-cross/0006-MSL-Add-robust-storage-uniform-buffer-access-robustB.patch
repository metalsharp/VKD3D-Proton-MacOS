 		         !is_hidden_variable(var))
 		{
 			if (buffer_requires_array_length(var.self))
@@ -16151,7 +16304,9 @@ void CompilerMSL::fix_up_shader_inputs_outputs()
 				entry_func.fixup_hooks_in.push_back(
 				    [this, &type, &var, var_id]()
 				    {
-					    bool is_array_type = !type.array.empty() && !is_var_runtime_size_array(var);
+					    // Without rich descriptors, a runtime array's ranges are in the buffer size buffer too.
+					    bool is_array_type = !type.array.empty() &&
+					                         (!is_var_runtime_size_array(var) || !msl_options.runtime_array_rich_descriptor);
 
 					    uint32_t desc_set = get_decoration(var_id, DecorationDescriptorSet);
 					    if (descriptor_set_is_argument_buffer(desc_set))
@@ -19921,6 +20076,11 @@ bool CompilerMSL::OpCodePreprocessor::handle(Op opcode, const uint32_t *args, ui
 		set<SPIRExpression>(id, "", result_type, true);
 		self.register_read(id, ptr, true);
 		self.ir.ids[id].set_allow_type_rewrite();
+
+		// Robust buffer accesses are checked against the descriptor's range.
+		auto *robust_var = self.maybe_get<SPIRVariable>(ptr);
+		if (robust_var && self.is_robust_buffer_variable(*robust_var))
+			self.buffers_requiring_array_length.insert(robust_var->self);
 		break;
 	}
 
diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index 7d8fe5f6..ffbf0111 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -374,6 +374,15 @@ public:
 		// Enables specifick argument buffer format with extra information to track SSBO-length
 		bool runtime_array_rich_descriptor = false;
 
+		// Bounds-check loads, stores and atomics through storage buffer (and, separately, uniform buffer)
+		// descriptors against the descriptor's range, as VK_EXT_robustness2 robustBufferAccess2 requires:
+		// out-of-bounds reads return zero and out-of-bounds writes and atomics are discarded.
+		// A null descriptor has range 0, so this also implements nullDescriptor for buffers.
+		// The range comes from the buffer size buffer (or spvBufferSizeConstants in argument buffers),
+		// which must hold the descriptor's range for every robust buffer.
+		bool robust_storage_buffer_access = false;
+		bool robust_uniform_buffer_access = false;
+
 		// Ensures vertex and instance indices start at zero. This reflects the behavior of HLSL with SV_VertexID and SV_InstanceID.
 		bool enable_base_index_zero = false;
 
@@ -1372,6 +1381,28 @@ protected:
 	const MSLConstexprSampler *find_constexpr_sampler(uint32_t id) const;
 
 	std::unordered_set<uint32_t> buffers_requiring_array_length;
+
+	// Robust buffer access: what an access chain into a robust buffer points at, and the
+	// bounds condition that must hold to dereference it.
+	struct RobustAccessChain
+	{
+		enum Kind
+		{
+			Block,       // The buffer block itself; the next index selects a member.
+			ArrayMember, // An array member of the block; the next index selects an element.
+			Interior     // Anything deeper; no further checks.
+		};
+		Kind kind = Interior;
+		uint32_t type_id = 0; // Block type (Block) or the block type containing the member (ArrayMember).
+		uint32_t member_offset = 0;
+		uint32_t member_stride = 0;
+		std::string size_expr;
+		std::string condition;
+	};
+	std::unordered_map<uint32_t, RobustAccessChain> robust_access_chains;
+	bool is_robust_buffer_variable(const SPIRVariable &var) const;
+	void track_robust_access_chain(const uint32_t *ops, uint32_t length, bool ptr_chain);
+	std::string robust_access_condition(uint32_t ptr_id) const override;
 	SmallVector<uint32_t> buffer_aliases_discrete;
 	std::unordered_set<uint32_t> atomic_image_vars_emulated; // Emulate texture2D atomic operations
 	std::unordered_set<uint32_t> pull_model_inputs;
