From 5ce7685c5819b54379213c276dea85a5065b15c2 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Fri, 23 Oct 2026 15:28:34 -0600
Subject: [PATCH 07/18] MSL: Drop restrict from aliased argument buffer
 descriptors

Aliases of an argument buffer descriptor are cast from the first variable at the
binding; if that variable was Restrict, the cast cast away the qualifier (an error
in Metal), and restrict is wrong for memory other variables alias anyway.
---
 spirv_msl.cpp | 7 +++++++
 spirv_msl.hpp | 1 +
 2 files changed, 8 insertions(+)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 6da0b507..5d5458fc 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -15398,6 +15398,9 @@ const char *CompilerMSL::to_restrict(uint32_t id, bool space)
 	else
 		flags = get_decoration_bitset(id);
 
+	if (overlapping_binding_var_ids.count(id))
+		return "";
+
 	return flags.get(DecorationRestrict) || flags.get(DecorationRestrictPointerEXT) ?
 	       (space ? "__restrict " : "__restrict") : "";
 }
@@ -21188,6 +21191,10 @@ void CompilerMSL::analyze_argument_buffers()
 					r2.overlapping_var_id = r1.var->self;
 
 				set_extended_decoration(r2.var->self, SPIRVCrossDecorationOverlappingBinding, r2.overlapping_var_id);
+
+				// Aliased descriptors are cast from the base, and restrict would be wrong for any of them.
+				overlapping_binding_var_ids.insert(r2.overlapping_var_id);
+				overlapping_binding_var_ids.insert(r2.var->self);
 			}
 		}
 
diff --git a/spirv_msl.hpp b/spirv_msl.hpp
index ffbf0111..7ad4ddc8 100644
--- a/spirv_msl.hpp
+++ b/spirv_msl.hpp
@@ -1381,6 +1381,7 @@ protected:
 	const MSLConstexprSampler *find_constexpr_sampler(uint32_t id) const;
 
 	std::unordered_set<uint32_t> buffers_requiring_array_length;
+	std::unordered_set<uint32_t> overlapping_binding_var_ids;
 
 	// Robust buffer access: what an access chain into a robust buffer points at, and the
 	// bounds condition that must hold to dereference it.
-- 
