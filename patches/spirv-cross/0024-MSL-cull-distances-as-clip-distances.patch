+	bool add_cull_distances_to_clip_distances(SPIRType &ib_type, CullAsClip &cull);
+	std::shared_ptr<CullAsClip> mesh_cull_as_clip;
+	void emit_cull_distances_as_clip_distances(const std::string &ib_var, const CullAsClip &cull);	// The Layer output a multiview tessellation evaluation, geometry or mesh shader writes.
 	uint32_t builtin_invocation_id_id = 0;
 	uint32_t builtin_primitive_id_id = 0;
 	uint32_t builtin_subgroup_invocation_id_id = 0;
