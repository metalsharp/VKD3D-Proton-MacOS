+		case SPVFuncImplSubgroup64:
+		{
+			statement("// 64-bit subgroup operations, which Metal lacks: bitwise ops and data movement work on the");
+			statement("// 32-bit halves, arithmetic combines the active lanes one at a time (in lane order).");
+			for (const char *t : { "ulong", "long" })
+			{
+				for (const char *f : { "simd_and", "simd_or", "simd_xor", "simd_broadcast_first" })
+					statement("static inline ", t, " ", f, "(", t, " v) { return as_type<", t, ">(", f, "(as_type<uint2>(v))); }");
+				for (const char *f : { "simd_broadcast", "simd_shuffle", "simd_shuffle_xor", "simd_shuffle_up", "simd_shuffle_down",
+				                       "simd_shuffle_rotate_down", "simd_shuffle_rotate_up", "quad_broadcast", "quad_shuffle",
+				                       "quad_shuffle_xor", "quad_shuffle_up", "quad_shuffle_down" })
+					statement("static inline ", t, " ", f, "(", t, " v, ushort l) { return as_type<", t, ">(", f, "(as_type<uint2>(v), l)); }");
+				struct { const char *name, *identity, *combine; } ops[] = {
+					{ "sum", "0", "r + x" }, { "product", "1", "r * x" }, { "min", nullptr, "min(r, x)" }, { "max", nullptr, "max(r, x)" },
+				};
+				for (auto &o : ops)
+				{
+					for (int scan = 0; scan < 3; scan++)
+					{
+						if (scan && !o.identity)
+							continue;
+						const char *prefix = scan == 0 ? "simd_" : scan == 1 ? "simd_prefix_inclusive_" : "simd_prefix_exclusive_";
+						statement("static inline ", t, " ", prefix, o.name, "(", t, " v)");
+						begin_scope();
+						statement("uint m = uint(ulong(simd_active_threads_mask()));");
+						if (scan)
+							statement("uint rank = simd_prefix_exclusive_sum(1u);");
+						statement("bool first = true;");
+						statement(t, " r = ", o.identity ? o.identity : "v", ";");
+						statement("for (uint k = 0; m != 0; k++, m &= m - 1)");
+						begin_scope();
+						statement(t, " x = simd_broadcast(v, ushort(ctz(m)));");
+						if (scan == 1)
+							statement("if (k > rank) break;");
+						else if (scan == 2)
+							statement("if (k >= rank) break;");
+						if (o.identity)
+							statement("r = ", o.combine, ";");
+						else
+							statement("r = first ? x : ", o.combine, ";");
+						statement("first = false;");
+						end_scope();
+						statement("return r;");
+						end_scope();
+					}
+				}
+			}
+			statement("");
+			break;
+		}
