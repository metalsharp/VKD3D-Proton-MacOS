 		end_scope(";");
 
 		// Emit struct with info about the draw call.
@@ -1830,6 +1972,10 @@ void CompilerMSL::emit_mesh_wrapper() {
 		statement("int32_t indexed;");
 		statement("int32_t indexSize;");
 		statement("int64_t indexBuffer;");
+		statement("int32_t baseVertex;");
