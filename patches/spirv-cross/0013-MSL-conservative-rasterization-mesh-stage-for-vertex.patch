+
 		statement("uint3 positionInGrid [[thread_position_in_grid]])");
 
 		begin_scope();
@@ -1874,7 +2025,7 @@ void CompilerMSL::emit_mesh_wrapper() {
 			SPIRV_CROSS_THROW("Input primitive type not supported");
 		}
 
-		statement("int instanceIndex = positionInGrid.y;");
+		statement("int instanceIndex = positionInGrid.y + drawInfo->baseInstance;");
 
 		statement("for (int i = 0; i < vertexCount; ++i)");
 		begin_scope();
@@ -1901,8 +2052,9 @@ void CompilerMSL::emit_mesh_wrapper() {
 			}
 		})END");
 
+			statement("vertexIndex += drawInfo->baseVertex;");
 		end_scope();
-		statement("else vertexIndex = startingIndex + i;");
+		statement("else vertexIndex = startingIndex + i + drawInfo->baseVertex;");
 
 		if (stage_in_var_id) {
 			auto in_var_type = get_variable_data_type(get<SPIRVariable>(stage_in_var_id));
@@ -1946,7 +2098,10 @@ void CompilerMSL::emit_mesh_wrapper() {
 			std::string type_name = get_variable_format_string(variable.format);
 			std::string component = type_name + get_vertex_loader_component_suffix(load_elements);
 			std::string packed = variable.vecsize > 1 ? "packed_" : "";
-			std::string load_string = "*(device " + packed + component + " *)(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + vertexIndex * " + std::to_string(variable.stride) + ")";
+			// A stride of ~0u marks a dynamic vertex stride, which comes with the draw.
+			std::string stride = variable.stride == ~0u ? join("drawInfo->vertexStrides[", variable.binding, "]")
+			                                            : std::to_string(variable.stride);
+			std::string load_string = "*(device " + packed + component + " *)(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + vertexIndex * " + stride + ")";
 			if (load_elements != parent_type.vecsize) {
 				component = type_name + get_vertex_loader_component_suffix(parent_type.vecsize);
 				load_string = component + "(" + load_string;
@@ -1965,6 +2120,10 @@ void CompilerMSL::emit_mesh_wrapper() {
 			need_semicolon = true;
 			statement(to_name(stage_in_var_id));
 		}
+		for (auto &name : arg_buffer_names) {
+			statement(need_semicolon ? ", " : "", name);
+			need_semicolon = true;
+		}
 
 		auto resources = get_sorted_entry_point_args(false);
 
@@ -1984,7 +2143,12 @@ void CompilerMSL::emit_mesh_wrapper() {
 					break;
 				}
 				case BuiltInBaseInstance: {
-					statement(need_semicolon ? ", " : "", "0");
+					statement(need_semicolon ? ", " : "", "drawInfo->baseInstance");
+					need_semicolon = true;
+					break;
+				}
+				case BuiltInBaseVertex: {
+					statement(need_semicolon ? ", " : "", "drawInfo->baseVertex");
 					need_semicolon = true;
 					break;
 				}
@@ -2005,9 +2169,14 @@ void CompilerMSL::emit_mesh_wrapper() {
 
 		end_scope();
 
+		if (msl_options.conservative_raster_mesh)
+			statement("payload.conservativeExtent = drawInfo->conservativeExtent;");
 		statement("meshGridProperties.set_threadgroups_per_grid(uint3(1, 1, 1));");
 
 		end_scope();
+
+		if (msl_options.conservative_raster_mesh)
+			emit_conservative_raster_mesh(out_var_type);
 	} else {
 		assert(execution.model == ExecutionModelGeometry);
 
@@ -2056,6 +2225,11 @@ void CompilerMSL::emit_mesh_wrapper() {
 		if (!mesh_arguments.empty()) mesh_arguments += ",";
 		statement(mesh_arguments);
 
+		SmallVector<string> arg_buffer_decls, arg_buffer_names;
+		mesh_wrapper_argument_buffers(arg_buffer_decls, arg_buffer_names);
+		for (auto &decl : arg_buffer_decls)
