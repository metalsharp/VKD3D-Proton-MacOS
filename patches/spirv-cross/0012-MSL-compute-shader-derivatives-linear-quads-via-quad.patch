 // Emits one of the atomic functions. In MSL, the atomic functions operate on pointers
+// Metal has no 64-bit atomics except non-returning min/max, so 64-bit buffer atomics take a
+// spin lock from a hashed lock table and do the read-modify-write on the two 32-bit halves.
+bool CompilerMSL::maybe_emit_atomic64_op(Op opcode, const uint32_t *ops)
+{
+	uint32_t ptr = opcode == OpAtomicStore ? ops[0] : ops[2];
+	auto &ptr_type = expression_type(ptr);
+	auto &type = get_pointee_type(ptr_type);
+	if (type.width != 64 || ptr_type.storage == StorageClassWorkgroup || ptr_type.storage == StorageClassImage ||
+	    !atomic64_lock_buffer_id)
+		return false;
+	if (!msl_options.supports_msl_version(3, 2))
+		SPIRV_CROSS_THROW("Emulated 64-bit atomics require MSL 3.2.");
+
+	uint32_t op_code;
+	uint32_t a = 0, b = 0;
+	bool a_is_one = false;
+	switch (opcode)
+	{
+	case OpAtomicIAdd: op_code = 0; a = ops[5]; break;
+	case OpAtomicIIncrement: op_code = 0; a_is_one = true; break;
+	case OpAtomicISub: op_code = 1; a = ops[5]; break;
+	case OpAtomicIDecrement: op_code = 1; a_is_one = true; break;
+	case OpAtomicSMin: op_code = 2; a = ops[5]; break;
+	case OpAtomicUMin: op_code = 3; a = ops[5]; break;
+	case OpAtomicSMax: op_code = 4; a = ops[5]; break;
+	case OpAtomicUMax: op_code = 5; a = ops[5]; break;
+	case OpAtomicAnd: op_code = 6; a = ops[5]; break;
+	case OpAtomicOr: op_code = 7; a = ops[5]; break;
+	case OpAtomicXor: op_code = 8; a = ops[5]; break;
+	case OpAtomicExchange: op_code = 9; a = ops[5]; break;
+	case OpAtomicCompareExchange: op_code = 10; a = ops[6]; b = ops[7]; break;
+	case OpAtomicLoad: op_code = 11; break;
+	case OpAtomicStore: op_code = 12; a = ops[3]; break;
+	default:
+		SPIRV_CROSS_THROW("Unsupported 64-bit atomic operation.");
+	}
+
+	add_spv_func_and_recompile(SPVFuncImplAtomic64);
+
+	auto to_u64 = [&](uint32_t id) -> string {
+		return id ? join("as_type<ulong>(", to_unpacked_expression(id), ")") : string("0ul");
+	};
+	string call = join("spvAtomic64(reinterpret_cast<device ulong *>(", to_enclosed_pointer_expression(ptr), "), ",
+	                   to_expression(atomic64_lock_buffer_id), ", ", op_code, "u, ",
+	                   a_is_one ? string("1ul") : to_u64(a), ", ", to_u64(b), ")");
+
+	// Atomics are skipped (and return zero) when not executed: a helper invocation,
+	// or an out-of-bounds robust buffer access.
+	string guard;
+	if (opcode != OpAtomicLoad && needs_frag_discard_checks())
+		guard = join("!", builtin_to_glsl(BuiltInHelperInvocation, StorageClassInput));
+	auto robust_condition = robust_access_condition(ptr);
+	if (!robust_condition.empty())
+		guard = guard.empty() ? robust_condition : join(guard, " && ", robust_condition);
+
+	if (opcode == OpAtomicStore)
+	{
+		if (guard.empty())
+			statement(call, ";");
+		else
+			statement("if (", guard, ") ", call, ";");
+		return true;
+	}
+
+	if (!guard.empty())
+		call = join("((", guard, ") ? ", call, " : 0ul)");
+
+	uint32_t result_type = ops[0];
+	uint32_t id = ops[1];
+	auto &res_type = get<SPIRType>(result_type);
+	if (res_type.basetype != SPIRType::UInt64)
+		call = join("as_type<", type_to_glsl(res_type), ">(", call, ")");
+	emit_op(result_type, id, call, false);
+	return true;
+}
