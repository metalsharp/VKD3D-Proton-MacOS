 		}
 	}
 
+	// Implicit LOD in a compute shader with derivatives: Metal kernels cannot sample with an
+	// implicit LOD, so pass the quad gradient of the coordinate (scaled by the bias, if any).
+	bool compute_grad = uses_compute_derivatives() && !lod && !grad_x && !grad_y && !args.base.is_fetch &&
+	                    !args.base.is_gather && imgtype.image.dim != DimBuffer && imgtype.image.sampled != 2 &&
+	                    (imgtype.image.dim != Dim1D || msl_options.texture_1D_as_2D);
+	if (compute_grad)
+	{
+		add_spv_func_and_recompile(SPVFuncImplComputeDerivatives);
+		string lane = to_expression(builtin_subgroup_invocation_id_id);
+		string coord_expr = to_enclosed_unpacked_expression(args.coord);
+		string grad_opt, grad_coord, dx, dy;
+		auto grad_of = [&](const string &v) {
+			return make_pair(join("spvDdxFine(", v, ", ", lane, ")"), join("spvDdyFine(", v, ", ", lane, ")"));
+		};
+		switch (imgtype.image.dim)
+		{
+		case Dim1D:
+		{
+			string x = expression_type(args.coord).vecsize > 1 ? coord_expr + ".x" : coord_expr;
+			auto g = grad_of(x);
+			grad_opt = "gradient2d";
+			dx = join("float2(", g.first, ", 0.0)");
+			dy = join("float2(", g.second, ", 0.0)");
+			break;
+		}
+		case Dim2D:
+		{
+			auto g = grad_of(coord_expr + ".xy");
+			grad_opt = "gradient2d";
+			dx = g.first;
+			dy = g.second;
+			break;
+		}
+		case Dim3D:
+		case DimCube:
+		{
+			auto g = grad_of(coord_expr + ".xyz");
+			dx = g.first;
+			dy = g.second;
+			if (imgtype.image.dim == Dim3D)
+				grad_opt = "gradient3d";
+			else if (msl_options.agx_manual_cube_grad_fixup)
+			{
+				add_spv_func_and_recompile(SPVFuncImplGradientCube);
+				grad_opt = "spvGradientCube";
+				grad_coord = tex_coords + ", ";
+			}
+			else
+				grad_opt = "gradientcube";
+			break;
+		}
+		default:
+			SPIRV_CROSS_THROW("Unsupported image dimension for implicit LOD sampling in compute.");
+		}
+		if (bias)
+		{
+			forward = forward && should_forward(bias);
+			string scale = join("exp2(", to_unpacked_expression(bias), ")");
+			dx = join("(", dx, ") * ", scale);
+			dy = join("(", dy, ") * ", scale);
+			bias = 0;
+		}
+		farg_str += join(", ", grad_opt, "(", grad_coord, dx, ", ", dy, ")");
+	}
+
 	// LOD Options
 	// Metal does not support LOD for 1D textures.
 	if (bias && (imgtype.image.dim != Dim1D || msl_options.texture_1D_as_2D))
