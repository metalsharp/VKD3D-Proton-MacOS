 // Returns the function args for a texture sampling function for the specified image and sampling characteristics.
+// SPV_KHR_compute_shader_derivatives (linear): a quad is four consecutive local invocations,
+// which on Metal are four consecutive SIMD lanes, so quad_shuffle() reaches the quad's lanes.
+bool CompilerMSL::uses_compute_derivatives() const
+{
+	auto model = get_execution_model();
+	if (model != ExecutionModelGLCompute && model != ExecutionModelTaskEXT && model != ExecutionModelMeshEXT)
+		return false;
+	auto &flags = get_entry_point().flags;
+	if (flags.get(ExecutionModeDerivativeGroupQuadsKHR))
+		SPIRV_CROSS_THROW("DerivativeGroupQuadsKHR is not supported in MSL; use DerivativeGroupLinearKHR.");
+	return flags.get(ExecutionModeDerivativeGroupLinearKHR);
+}
