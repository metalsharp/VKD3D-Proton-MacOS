+void CompilerMSL::emit_cull_distances_as_clip_distances(const std::string &ib_var, const CullAsClip &cull)
+{
+	for (uint32_t i = 0; i < uint32_t(cull.cull_names.size()); i++)
+	{
+		string c = join(ib_var, ".", cull.cull_names[i]);
+		statement(ib_var, ".", cull.clip_name, "[", cull.clip_count + i, "] = ", c, " < 0.0 ? ", c, " : 1e20;");
+	}
