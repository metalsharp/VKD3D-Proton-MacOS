+bool CompilerMSL::is_robust_buffer_variable(const SPIRVariable &var) const
+{
+	if (!msl_options.robust_storage_buffer_access && !msl_options.robust_uniform_buffer_access)
+		return false;
+	if (is_hidden_variable(var))
+		return false;
+
+	auto &type = get_variable_data_type(var);
+	if (type.basetype != SPIRType::Struct || type.array.size() > 1)
+		return false;
+
+	bool ssbo = var.storage == StorageClassStorageBuffer ||
+	            (var.storage == StorageClassUniform && has_decoration(type.self, DecorationBufferBlock));
+	if (ssbo)
+		return msl_options.robust_storage_buffer_access;
+
+	if (var.storage != StorageClassUniform)
+		return false;
+
+	// Inline uniform blocks have no range in the buffer size buffer.
+	SetBindingPair pair = { get_decoration(var.self, DecorationDescriptorSet),
+		                    get_decoration(var.self, DecorationBinding) };
+	if (inline_uniform_blocks.count(pair))
+		return false;
+	return msl_options.robust_uniform_buffer_access;
+}
+
+void CompilerMSL::track_robust_access_chain(const uint32_t *ops, uint32_t length, bool ptr_chain)
+{
+	if (!msl_options.robust_storage_buffer_access && !msl_options.robust_uniform_buffer_access)
+		return;
+	if (length < 3)
+		return;
+
+	uint32_t result_id = ops[1];
+	uint32_t base_id = ops[2];
+	const uint32_t *indices = ops + 3;
+	uint32_t count = length - 3;
+	robust_access_chains.erase(result_id);
+
+	RobustAccessChain chain;
+	auto itr = robust_access_chains.find(base_id);
+	if (itr != end(robust_access_chains))
+	{
+		chain = itr->second;
+	}
+	else
+	{
+		auto *var = maybe_get<SPIRVariable>(base_id);
+		if (!var || !is_robust_buffer_variable(*var))
+			return;
+
+		auto &type = get_variable_data_type(*var);
+		chain.kind = RobustAccessChain::Block;
+		chain.type_id = type.self;
+		chain.size_expr = to_buffer_size_expression(var->self);
+		if (!type.array.empty())
+		{
+			// An array of descriptors: the first index selects the descriptor and its range.
+			if (count == 0)
+				return;
+			chain.size_expr = join(chain.size_expr, "[", to_unpacked_expression(indices[0]), "]");
+			indices++;
+			count--;
+		}
+	}
+
+	// A pointer access chain into a block steps over whole blocks; only element 0 is in range.
+	if (ptr_chain && count)
+	{
+		auto *c = maybe_get<SPIRConstant>(indices[0]);
+		if (!c || c->scalar() != 0)
+			chain.kind = RobustAccessChain::Interior;
+		indices++;
+		count--;
+	}
+
+	auto add_condition = [&](const string &cond) {
+		chain.condition = chain.condition.empty() ? cond : join(chain.condition, " && ", cond);
+	};
+
+	for (uint32_t i = 0; i < count && chain.kind != RobustAccessChain::Interior; i++)
+	{
+		if (chain.kind == RobustAccessChain::Block)
+		{
+			auto *c = maybe_get<SPIRConstant>(indices[i]);
+			auto &type = get<SPIRType>(chain.type_id);
+			if (!c || type.basetype != SPIRType::Struct || c->scalar() >= type.member_types.size())
+			{
+				chain.kind = RobustAccessChain::Interior;
+				break;
+			}
+
+			uint32_t member = c->scalar();
+			auto &member_type = get<SPIRType>(type.member_types[member]);
+			uint32_t offset = type_struct_member_offset(type, member);
+			if (!member_type.array.empty())
+			{
+				chain.kind = RobustAccessChain::ArrayMember;
+				chain.member_offset = offset;
+				chain.member_stride = type_struct_member_array_stride(type, member);
+				if (chain.member_stride == 0)
+					chain.kind = RobustAccessChain::Interior;
+			}
+			else
+			{
+				uint32_t end_offset = offset + uint32_t(get_declared_struct_member_size(type, member));
+				add_condition(join("(", chain.size_expr, " >= ", end_offset, "u)"));
+				chain.kind = RobustAccessChain::Interior;
+			}
+		}
+		else
+		{
+			// Element i of an array member is in range if it ends within the descriptor's range.
+			string length_expr;
+			if (chain.member_offset)
+				length_expr = join("((", chain.size_expr, " - min(", chain.size_expr, ", ", chain.member_offset, "u)) / ",
+				                   chain.member_stride, "u)");
+			else
+				length_expr = join("(", chain.size_expr, " / ", chain.member_stride, "u)");
+			add_condition(join("(uint(", to_unpacked_expression(indices[i]), ") < ", length_expr, ")"));
+			chain.kind = RobustAccessChain::Interior;
+		}
+	}
+
+	robust_access_chains[result_id] = std::move(chain);
+}
+
+string CompilerMSL::robust_access_condition(uint32_t ptr_id) const
+{
+	auto itr = robust_access_chains.find(ptr_id);
+	return itr != end(robust_access_chains) ? itr->second.condition : string();
+}
