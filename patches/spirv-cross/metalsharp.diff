+					                             join("((", word, " >> ", low[i], "u) & 0x3ffu)");
+				fields[3] = rgb10a2_signed ? join("(int(", word, ") >> 30)") : join("(", word, " >> 30u)");
+				std::string load_string = join(rgb10a2_signed ? "int4(" : "uint4(", fields[0], ", ", fields[1], ", ",
