+						uint32_t count = std::min(to_array_size_literal(mbr_type), std::max(payload_it->second.vecsize, 1u));
+						for (uint32_t k = 0; k < count; k++)
+							statement(to_name(stage_in_var_id), ".", input_block_name, "[i].", member_name, "[", k, "] = out.in",
+							          payload_it->second.location, payload_it->second.vecsize > 1 ? join("[", k, "]") : "", ";");
+						continue;
+					}
+					statement(to_name(stage_in_var_id), ".", input_block_name, "[i].",
+					          member_name, " = out.in",
+					          std::to_string(payload_it->second.location), ";");
+				}
+				return;
+			}
+
+			if (!interface_variable_exists_in_entry_point(var.self))
+				return;
+
+			if (is_hidden_variable(var, true))
+				return;
+
+			uint32_t location = get_decoration(id, DecorationLocation);
+
+			bool is_builtin = is_builtin_variable(var);
+			std::string name = to_name(id);
+			MSLShaderInterfaceVariable variable;
+			bool found;
+
+			if (is_builtin) {
+				auto payload_it = inputs_by_builtin.find(get_decoration(id, DecorationBuiltIn));
+				if ((found = (payload_it != inputs_by_builtin.end())))
+					variable = payload_it->second;
+			} else {
+				LocationComponentPair key;
+				key.location  = location;
+				key.component = 0;
+				auto payload_it = inputs_by_location.find(key);
+				if ((found = (payload_it != inputs_by_location.end())))
+					variable = payload_it->second;
+			}
+
+			if (found) {
+				statement("if (i < sizeof(", name, ") / sizeof(", name, "[0]))");
+				statement("\t", name, "[i] = out.in", std::to_string(variable.location), ";");
+			}
+		});
+
+		end_scope();
+
+		// Captures are ordered by instance, then input primitive, then invocation.
+		string xfb_args;
+		if (needs_geometry_transform_feedback())
+			xfb_args = join(", spvXfbGeom, (payload.instance * payload.primitiveCount + payload.primitiveId) * ",
+			                std::max(execution.invocations, 1u), "u + tid");
+		statement(join(execution.name, "(outputMesh", xfb_args, stage_in_var_id ? ", " + to_name(stage_in_var_id) : string()));
+		for (auto &name : arg_buffer_names)
+			statement(", ", name);
+		// Same order as entry_point_args_discrete_descriptors().
+		for (auto &resource : get_sorted_entry_point_args(false))
+		{
+			string name = entry_point_call_arg_name(resource);
+			if (!name.empty())
+				statement(", ", name);
+		}
+		// Then the builtin inputs, in the order of the function's parameters.
+		ir.for_each_typed_id<SPIRVariable>([&](uint32_t var_id, SPIRVariable &var) {
+			if (var.storage != StorageClassInput || !is_builtin_variable(var) || !interface_variable_exists_in_entry_point(var_id))
+				return;
+			if (has_decoration(get<SPIRType>(var.basetype).self, DecorationBlock) || mesh_geometry_input_block_vars.count(var_id))
+				return;
+			// Per-vertex builtins (gl_in[]) come with the stage input.
+			switch (get_decoration(var_id, DecorationBuiltIn)) {
+			case BuiltInInvocationId: statement(", tid"); break;
+			case BuiltInPrimitiveId: statement(", payload.primitiveId"); break;
+			default: break;
+			}
+		});
+
+		statement(");");
+		end_scope();
+	}
+}
