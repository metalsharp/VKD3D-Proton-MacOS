+void CompilerMSL::emit_mesh_wrapper() {
+	auto &execution = get_entry_point();
+
+	if (execution.model == ExecutionModelVertex) {
+		auto out_var_type = get_variable_data_type(get<SPIRVariable>(stage_out_var_id));
+
+		// Emit the payload struct
+		// The primitive's fields come first: the mesh stage declares the vertexes from the interface it reads.
+		statement("struct Payload");
+		begin_scope();
+		statement("uint primitiveId;");
+		statement("uint instance;");
+		statement("uint primitiveCount;");
+		statement(join(type_to_glsl(out_var_type), " vertices[", std::to_string(vertex_count_in_primitive(msl_options.input_primitive_type)), "];"));
+		if (msl_options.conservative_raster_mesh)
+		{
+			statement("float2 conservativeExtent;");
+			statement("uint conservativeFlags;");
+		}
+		end_scope(";");
+
+		// Emit struct with info about the draw call.
+		statement("struct DrawInfo");
+		begin_scope();
+
+		statement("int32_t indexed;");
+		statement("int32_t indexSize;");
+		statement("int64_t indexBuffer;");
+		statement("int32_t baseVertex;");
+		statement("uint32_t baseInstance;");
+		statement("float2 conservativeExtent;");
+		statement("uint32_t conservativeFlags;");
+		statement("uint32_t vertexStrides[31];");
+		statement("uint32_t topology;");
+		statement("uint32_t primitiveCount;");
+		end_scope(";");
+
+		// Groups the draw's vertexes into primitives: the position (in the vertex or index sequence) of vertex i
+		// of primitive p, by VkPrimitiveTopology, for n primitives (geometry shader input order).
+		statement("static inline uint spvGeometryInputIndex(uint topology, uint p, uint i, uint n)");
+		begin_scope();
+		statement("switch (topology)");
+		begin_scope();
+		statement("case 0: return p;");
+		statement("case 1: return 2 * p + i;");
+		statement("case 2: return p + i;");
+		statement("case 3: return 3 * p + i;");
+		statement("case 4: return p + (i == 0 ? 0 : i == 1 ? 1 + (p & 1) : 2 - (p & 1));");
+		statement("case 5: return i == 0 ? p + 1 : i == 1 ? p + 2 : 0;");
+		statement("case 6: return 4 * p + i;");
+		statement("case 7: return p + i;");
+		statement("case 8: return 6 * p + i;");
+		statement("case 9:");
+		begin_scope();
+		statement("uint prev = p == 0 ? 1 : 2 * p - 2, next = p + 1 == n ? 2 * p + 5 : 2 * p + 6;");
+		statement("uint even[6] = { 2 * p, prev, 2 * p + 2, next, 2 * p + 4, 2 * p + 3 };");
+		statement("uint odd[6] = { 2 * p + 2, prev, 2 * p, 2 * p + 3, 2 * p + 4, next };");
+		statement("return (p & 1) ? odd[i] : even[i];");
+		end_scope();
+		statement("default: return 3 * p + i;");
+		end_scope();
+		end_scope();
+
+		// Object entry point.
+		statement("[[object]]  void ", execution.name, "(object_data Payload &payload [[payload]], mesh_grid_properties meshGridProperties, constant DrawInfo *drawInfo [[buffer(", std::to_string(get_msl_options().draw_info_index),")]],");
