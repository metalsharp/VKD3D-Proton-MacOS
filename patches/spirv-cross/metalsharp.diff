+// The object/mesh wrappers of a mesh pipeline own the buffer bindings; the wrapped function takes the
+// argument buffers right after its stage input (see entry_point_args_argument_buffer()).
+void CompilerMSL::mesh_wrapper_argument_buffers(SmallVector<string> &decls, SmallVector<string> &names)
+{
+	if (!msl_options.argument_buffers)
+		return;
+	Bitset claimed_bindings;
+	for (uint32_t i = 0; i < kMaxArgumentBuffers; i++)
+	{
+		uint32_t id = argument_buffer_ids[i];
+		if (id == 0)
+			continue;
+		auto &var = get<SPIRVariable>(id);
+		auto &type = get_variable_data_type(var);
+		uint32_t buffer_binding;
+		auto itr = resource_bindings.find({ get_entry_point().model, i, kArgumentBufferBinding });
+		if (itr != end(resource_bindings))
+			buffer_binding = itr->second.first.msl_buffer;
+		else
+			buffer_binding = claimed_bindings.get(i) ? next_metal_resource_index_buffer : i;
+		claimed_bindings.set(buffer_binding);
+		decls.push_back(join(get_variable_address_space(var), " ", type_to_glsl(type), "& ", to_name(id), " [[buffer(",
+		                     buffer_binding, ")]],"));
+		names.push_back(to_name(id));
+	}
+}
