+			statement("payload.conservativeExtent = drawInfo->conservativeExtent;");
+			statement("payload.conservativeFlags = drawInfo->conservativeFlags;");
+		}
+		statement("payload.primitiveId = positionInGrid.x;");
+		statement("payload.instance = positionInGrid.y;");
+		statement("payload.primitiveCount = drawInfo->primitiveCount;");
+		statement("meshGridProperties.set_threadgroups_per_grid(uint3(", std::max(msl_options.geometry_invocations, 1u), ", 1, 1));");
+
+		end_scope();
+
+		if (msl_options.conservative_raster_mesh)
+			emit_conservative_raster_mesh(out_var_type);
+	} else {
+		assert(execution.model == ExecutionModelGeometry);
+
+		// Emit the payload struct
+		statement("struct Payload");
+		begin_scope();
+		statement("struct payload_vertex");
+		begin_scope();
+
+		for (auto kv: inputs_by_location) {
+			std::string type_name = get_variable_format_string(kv.second.type);
+			if (kv.second.vecsize) type_name += get_vertex_loader_component_suffix(kv.second.vecsize);
