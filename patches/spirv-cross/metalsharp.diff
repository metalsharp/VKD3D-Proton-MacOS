+				if (variable.normalized)
+					load_string = rgb10a2_signed ?
+					                  join("max(float4(", load_string, ") * float4(1.f/511.f, 1.f/511.f, 1.f/511.f, 1.f), -1.f)") :
+					                  join("float4(", load_string, ") * float4(1.f/1023.f, 1.f/1023.f, 1.f/1023.f, 1.f/3.f)");
