+		case MSL_SHADER_VARIABLE_FORMAT_UINT8:
+		case MSL_SHADER_VARIABLE_FORMAT_UINT8_BGRA: return " * (1.f/255.f)";
+		// TODO: Proper positive sint normalization
+		case MSL_SHADER_VARIABLE_FORMAT_INT16: return " * (1.f/32768.f)";
+		case MSL_SHADER_VARIABLE_FORMAT_INT8:
+		case MSL_SHADER_VARIABLE_FORMAT_INT8_BGRA: return " * (1.f/128.f)";
+		default: return "";
+	}
