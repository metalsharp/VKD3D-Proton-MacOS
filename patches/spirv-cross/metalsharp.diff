+// Makes room in an output interface block's clip distance array (adding one if it has none) for its cull distances.
+bool CompilerMSL::add_cull_distances_to_clip_distances(SPIRType &ib_type, CullAsClip &cull)
+{
+	uint32_t clip_member = ~0u;
+	for (uint32_t i = 0; i < uint32_t(ib_type.member_types.size()); i++)
+	{
+		if (!has_member_decoration(ib_type.self, i, DecorationBuiltIn))
+			continue;
+		auto builtin = BuiltIn(get_member_decoration(ib_type.self, i, DecorationBuiltIn));
+		bool user = has_member_decoration(ib_type.self, i, DecorationIndex);
+		if (builtin == BuiltInClipDistance && !user)
+			clip_member = i;
+		else if (builtin == BuiltInCullDistance && user)
+			cull.cull_names.push_back(to_member_name(ib_type, i));
+	}
+	if (cull.cull_names.empty())
+		return false;
+
+	uint32_t next_id = ir.increase_bound_by(2);
+	uint32_t float_id = next_id + 1;
+	SPIRType float_type { OpTypeFloat };
+	float_type.basetype = SPIRType::Float;
+	float_type.width = 32;
+	set<SPIRType>(float_id, float_type).self = float_id;
+	SPIRType array_type = float_type;
+	if (clip_member != ~0u)
+	{
+		auto &clip_type = get<SPIRType>(ib_type.member_types[clip_member]);
+		cull.clip_count = to_array_size_literal(clip_type);
+		array_type = clip_type;
+		array_type.array.back() = cull.clip_count + uint32_t(cull.cull_names.size());
+	}
+	else
+	{
+		array_type.op = OpTypeArray;
+		array_type.parent_type = float_id;
+		array_type.array.push_back(uint32_t(cull.cull_names.size()));
+		array_type.array_size_literal.push_back(true);
+		clip_member = uint32_t(ib_type.member_types.size());
+		ib_type.member_types.push_back(0);
+		set_member_decoration(ib_type.self, clip_member, DecorationBuiltIn, BuiltInClipDistance);
+		set_member_name(ib_type.self, clip_member, builtin_to_glsl(BuiltInClipDistance, StorageClassOutput));
+		active_output_builtins.set(BuiltInClipDistance);
+	}
+	auto &t = set<SPIRType>(next_id, array_type);
+	t.self = next_id;
+	ib_type.member_types[clip_member] = next_id;
+	cull.clip_name = to_member_name(ib_type, clip_member);
+	return true;
+}
