From 6f54863342ea30cbe4f741fba3fd31a40db304a7 Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@Averys-MacBook-Air.local>
Date: Fri, 23 Oct 2026 20:30:48 -0600
Subject: [PATCH 22/22] MSL: 64-bit atomics on threadgroup memory; emulated
 64-bit atomics invalidate forwarded loads

- Workgroup 64-bit atomics use the lock table like buffer atomics (keyed by the
  threadgroup address, with threadgroup fences).
- An emulated 64-bit atomic registers a write to its variable: a load forwarded
  past it (a compare-exchange loop's expected value) is no longer reread after
  the atomic changed the memory.
---
 spirv_msl.cpp | 36 +++++++++++++++++++++++++++++-------
 1 file changed, 29 insertions(+), 7 deletions(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 6b95b9f5..26cf99fd 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -9922,7 +9922,9 @@ void CompilerMSL::emit_custom_functions()
 			statement("");
 			// The lock is taken and released in the same loop iteration, so lanes of one SIMD group
 			// contending for a lock cannot deadlock each other.
-			auto emit_locked = [&](const char *body_read, const char *body_write) {
+			const char *device_fence =
+			    "atomic_thread_fence(mem_flags::mem_device | mem_flags::mem_texture, memory_order_seq_cst, thread_scope_device);";
+			auto emit_locked = [&](const char *body_read, const char *body_write, const char *fence) {
 				statement("ulong old = 0;");
 				statement("bool done = false;");
 				statement("while (!done)");
@@ -9930,12 +9932,12 @@ void CompilerMSL::emit_custom_functions()
 				statement("uint expected = 0u;");
 				statement("if (atomic_compare_exchange_weak_explicit(lock, &expected, 1u, memory_order_relaxed, memory_order_relaxed))");
 				begin_scope();
-				statement("atomic_thread_fence(mem_flags::mem_device | mem_flags::mem_texture, memory_order_seq_cst, thread_scope_device);");
+				statement(fence);
 				statement(body_read);
 				statement("ulong v = spvAtomic64Op(old, op, a, b);");
 				statement("if (v != old)");
 				statement("    ", body_write);
-				statement("atomic_thread_fence(mem_flags::mem_device | mem_flags::mem_texture, memory_order_seq_cst, thread_scope_device);");
+				statement(fence);
 				statement("atomic_store_explicit(lock, 0u, memory_order_relaxed);");
 				statement("done = true;");
 				end_scope();
@@ -9948,7 +9950,20 @@ void CompilerMSL::emit_custom_functions()
 			statement("device atomic_uint *lock = spvAtomic64Lock(locks, uint(h) ^ uint(h >> 32));");
 			statement("device atomic_uint *w = reinterpret_cast<device atomic_uint *>(p);");
 			emit_locked("old = ulong(atomic_load_explicit(&w[0], memory_order_relaxed)) | (ulong(atomic_load_explicit(&w[1], memory_order_relaxed)) << 32);",
-			            "{ atomic_store_explicit(&w[0], uint(v), memory_order_relaxed); atomic_store_explicit(&w[1], uint(v >> 32), memory_order_relaxed); }");
+			            "{ atomic_store_explicit(&w[0], uint(v), memory_order_relaxed); atomic_store_explicit(&w[1], uint(v >> 32), memory_order_relaxed); }",
+			            device_fence);
+			end_scope();
+			statement("");
+			// Threadgroup memory: the device lock table, keyed by the address (shared with other threadgroups,
+			// which only serializes them).
+			statement("static inline ulong spvAtomic64Shared(threadgroup ulong *p, device uint *locks, uint op, ulong a, ulong b)");
+			begin_scope();
+			statement("uint h = uint(reinterpret_cast<uintptr_t>(p)) >> 3;");
+			statement("device atomic_uint *lock = spvAtomic64Lock(locks, h * 0x9e3779b1u);");
+			statement("threadgroup atomic_uint *w = reinterpret_cast<threadgroup atomic_uint *>(p);");
+			emit_locked("old = ulong(atomic_load_explicit(&w[0], memory_order_relaxed)) | (ulong(atomic_load_explicit(&w[1], memory_order_relaxed)) << 32);",
+			            "{ atomic_store_explicit(&w[0], uint(v), memory_order_relaxed); atomic_store_explicit(&w[1], uint(v >> 32), memory_order_relaxed); }",
+			            "atomic_thread_fence(mem_flags::mem_threadgroup, memory_order_seq_cst, thread_scope_threadgroup);");
 			end_scope();
 			statement("");
 			statement("// Image texels: the image must be memory_coherence_device. key identifies the texel.");
@@ -9962,7 +9977,7 @@ void CompilerMSL::emit_custom_functions()
 			begin_scope();
 			statement("device atomic_uint *lock = spvAtomic64Lock(locks, spvAtomic64Key(key));");
 			statement("using E = decltype(t.read(coord).x);");
-			emit_locked("old = as_type<ulong>(t.read(coord).x);", "t.write(vec<E, 4>(as_type<E>(v)), coord);");
+			emit_locked("old = as_type<ulong>(t.read(coord).x);", "t.write(vec<E, 4>(as_type<E>(v)), coord);", device_fence);
 			end_scope();
 			statement("");
 			statement("template <typename T, typename C>");
@@ -9970,7 +9985,7 @@ void CompilerMSL::emit_custom_functions()
 			begin_scope();
 			statement("device atomic_uint *lock = spvAtomic64Lock(locks, spvAtomic64Key(key));");
 			statement("using E = decltype(t.read(coord, layer).x);");
-			emit_locked("old = as_type<ulong>(t.read(coord, layer).x);", "t.write(vec<E, 4>(as_type<E>(v)), coord, layer);");
+			emit_locked("old = as_type<ulong>(t.read(coord, layer).x);", "t.write(vec<E, 4>(as_type<E>(v)), coord, layer);", device_fence);
 			end_scope();
 			statement("");
 			break;
@@ -13596,7 +13611,7 @@ bool CompilerMSL::maybe_emit_atomic64_op(Op opcode, const uint32_t *ops)
 	uint32_t ptr = opcode == OpAtomicStore ? ops[0] : ops[2];
 	auto &ptr_type = expression_type(ptr);
 	auto &type = get_pointee_type(ptr_type);
-	if (type.width != 64 || ptr_type.storage == StorageClassWorkgroup || !atomic64_lock_buffer_id)
+	if (type.width != 64 || !atomic64_lock_buffer_id)
 		return false;
 	if (!msl_options.supports_msl_version(3, 2))
 		SPIRV_CROSS_THROW("Emulated 64-bit atomics require MSL 3.2.");
@@ -13711,6 +13726,8 @@ bool CompilerMSL::maybe_emit_atomic64_op(Op opcode, const uint32_t *ops)
 	string call;
 	if (!image_expr.empty())
 		call = join(image_arrayed ? "spvImageAtomic64Array(" : "spvImageAtomic64(", image_expr, ", ", image_coord, ", ", image_key, ", ", args);
+	else if (ptr_type.storage == StorageClassWorkgroup)
+		call = join("spvAtomic64Shared(reinterpret_cast<threadgroup ulong *>(", to_enclosed_pointer_expression(ptr), "), ", args);
 	else
 		call = join("spvAtomic64(reinterpret_cast<device ulong *>(", to_enclosed_pointer_expression(ptr), "), ", args);
 
@@ -13723,12 +13740,15 @@ bool CompilerMSL::maybe_emit_atomic64_op(Op opcode, const uint32_t *ops)
 	if (!robust_condition.empty())
 		guard = guard.empty() ? robust_condition : join(guard, " && ", robust_condition);
 
+	// Like any atomic, this changes memory that forwarded loads may still refer to.
 	if (opcode == OpAtomicStore)
 	{
 		if (guard.empty())
 			statement(call, ";");
 		else
 			statement("if (", guard, ") ", call, ";");
+		register_write(ptr);
+		flush_all_atomic_capable_variables();
 		return true;
 	}
 
@@ -13741,6 +13761,8 @@ bool CompilerMSL::maybe_emit_atomic64_op(Op opcode, const uint32_t *ops)
 	if (res_type.basetype != SPIRType::UInt64)
 		call = join("as_type<", type_to_glsl(res_type), ">(", call, ")");
 	emit_op(result_type, id, call, false);
+	register_write(ptr);
+	flush_all_atomic_capable_variables();
 	return true;
 }
 
