#version 450
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer B { uint64_t sum; int64_t smax; uint64_t umin; uint64_t x; uint64_t cas; uint64_t exch; uint64_t ret[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    atomicAdd(sum, 0x100000001ul);
    atomicMax(smax, int64_t(i) - 2048l);
    atomicMin(umin, 0xFFFFFFFF00000000ul + uint64_t(i));
    if (i < 64u)
        atomicXor(x, 1ul << i);
    ret[i * 2u] = atomicCompSwap(cas, 0ul, uint64_t(i) + 1ul);
    ret[i * 2u + 1u] = atomicExchange(exch, uint64_t(i) | (1ul << 40));
}
