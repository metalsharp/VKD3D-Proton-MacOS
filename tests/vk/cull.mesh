#version 460
#extension GL_EXT_mesh_shader : require
layout(local_size_x = 1) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;
out gl_MeshPerVertexEXT { vec4 gl_Position; float gl_CullDistance[1]; } gl_MeshVerticesEXT[];
// The vertex shader's quads, one for each workgroup.
void main()
{
    uint q = gl_WorkGroupID.x;
    SetMeshOutputsEXT(4, 2);
    for (uint i = 0; i < 4; i++)
    {
        vec2 v = vec2(i & 1, i >> 1);
        gl_MeshVerticesEXT[i].gl_Position = vec4((float(q) + v.x) / 3.0 * 2.0 - 1.0, v.y * 2.0 - 1.0, 0.0, 1.0);
        gl_MeshVerticesEXT[i].gl_CullDistance[0] = q == 0 ? -1.0 : q == 1 ? (v.x == 0.0 ? -1.0 : 1.0) : 1.0;
    }
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 3);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(0, 3, 2);
}
