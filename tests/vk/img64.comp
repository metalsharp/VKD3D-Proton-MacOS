#version 450
#extension GL_EXT_shader_image_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, r64ui) uniform u64image2D img;
layout(set = 0, binding = 1, r64ui) uniform u64image2DArray arr;
layout(set = 0, binding = 2, r64i) uniform i64image2D simg;
layout(set = 0, binding = 3) buffer O { uint64_t o[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    imageAtomicOr(img, ivec2(i & 7u, 0), 1ul << (i & 63u));
    o[i] = imageAtomicAdd(arr, ivec3(i & 3u, 1, 2), 0x100000001ul);
    imageAtomicMin(simg, ivec2(0, 0), int64_t(i) - 32l);
}
