#version 460
#extension GL_ARB_sparse_texture2 : require
// Residency feedback from a 3D sparse image with one tile bound.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform sampler3D tex;
layout(set = 0, binding = 1) buffer Out { vec4 color[4]; uint resident[4]; } o;
void main()
{
    const ivec3 at[4] = { ivec3(130, 5, 2), ivec3(130, 5, 1), ivec3(5, 5, 2), ivec3(250, 120, 2) };
    for (int i = 0; i < 4; i++)
    {
        vec4 c;
        int r = sparseTexelFetchARB(tex, at[i], 0, c);
        o.color[i] = c;
        o.resident[i] = sparseTexelsResidentARB(r) ? 1u : 0u;
    }
}
