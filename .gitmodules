# dxvk/'s submodules (dxvk/.gitmodules is DXVK's own, which Git reads only at the top level)
[submodule "dxvk/include/native/directx"]
	path = dxvk/include/native/directx
	url = https://github.com/Joshua-Ashton/mingw-directx-headers
[submodule "dxvk/include/vulkan"]
	path = dxvk/include/vulkan
	url = https://github.com/KhronosGroup/Vulkan-Headers
[submodule "dxvk/include/spirv"]
	path = dxvk/include/spirv
	url = https://github.com/KhronosGroup/SPIRV-Headers.git
[submodule "dxvk/subprojects/libdisplay-info"]
	path = dxvk/subprojects/libdisplay-info
	url = https://github.com/doitsujin/libdisplay-info.git
	branch = windows
[submodule "dxvk/subprojects/dxbc-spirv"]
	path = dxvk/subprojects/dxbc-spirv
	url = https://github.com/doitsujin/dxbc-spirv.git
